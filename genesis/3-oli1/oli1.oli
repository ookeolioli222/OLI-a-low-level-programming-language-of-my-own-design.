-- oli1 - the Oli-- genesis oli-core compiler (layer 3), step 3.
-- Symbol table, expression parser with precedence, bindings and string literals:
--   name := <expr>              bind a name to a compile-time integer value
--   name := "text"              bind a name to a .rodata string (escapes of syntax §2.4)
--   name.addr / name.len        address / byte length of a string binding (factors)
--   ret <expr>                  exit(value of expr)
--   os.syscall(nr, e1 .. e6)    args are expressions/names too
-- expr = term (('+'|'-') term)* ;  term = factor ('*' factor)* ;
-- factor = int | name | name '.' ('addr'|'len')
-- The subset is entirely compile-time constant, so expressions are folded in the
-- compiler and lowered to `mov <reg>, imm32`; runtime evaluation (frames,
-- register allocation) arrives when non-constant sources (parameters, syscall
-- results) do. Scratch is a 2 MiB mmap: input [base,+1M), output [base+1M,+1.375M),
-- string pool [base+1.375M,+64K), code temp [base+1.4375M,+64K), symbol table
-- [base+1.5M,+2M). asm has no byte store, so emit_byte writes an 8-byte value
-- < 256 and advances one byte.
-- Output layout: 120-byte ELF header | string pool | code. Strings therefore have
-- a fixed address (0x400078 + pool offset) the moment they are bound; at finalize
-- the code is moved behind the pool and e_entry is patched to 0x400078 + pool size.
-- Symbol entry (32 bytes): name ptr, name len, value (int, or string address),
-- kind (0 = integer, string length + 1 = string).
-- Registers: r14 in base, r13 in end, r12 out base, rbx symtab base, r15 symbol
-- count, rbp string pool cursor, rdi emit ptr, rsi in cursor, r10 arg index
-- (saved across eval).
module oli1
proc start
    calls none
    entry
    machine x64
        mov rdi, 0
        mov rsi, 0x200000
        mov rdx, 3
        mov r10, 0x22
        mov r8, -1
        mov r9, 0
        mov rax, 9
        syscall
        mov r14, rax
        mov r12, r14
        add r12, 0x100000
        mov rbx, r14
        add rbx, 0x180000
        mov rbp, r14
        add rbp, 0x160000
        mov r15, 0
        mov rcx, r14
.rd:
        mov rdi, 0
        mov rsi, rcx
        mov rdx, 0x100000
        push rcx
        mov rax, 0
        syscall
        pop rcx
        cmp rax, 0
        jle .rd_done
        add rcx, rax
        jmp .rd
.rd_done:
        mov r13, rcx
        mov rdi, r12
        mov rsi, template
        mov rcx, 15
.hcpy:
        mov rax, [rsi]
        mov [rdi], rax
        add rsi, 8
        add rdi, 8
        sub rcx, 1
        cmp rcx, 0
        jne .hcpy
        mov rsi, r14
.stmt:
        cmp rsi, r13
        jae .finalize
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 0
        je .finalize
        mov r8, rsi
        call .skipname
        mov rcx, rsi
        sub rcx, r8
        cmp rcx, 0
        je .stmt_skip
        cmp rcx, 3
        jne .not_ret
        mov rax, [r8]
        and rax, 255
        cmp rax, 114
        jne .not_ret
        mov rax, [r8+1]
        and rax, 255
        cmp rax, 101
        jne .not_ret
        mov rax, [r8+2]
        and rax, 255
        cmp rax, 116
        jne .not_ret
        jmp .do_ret2
.not_ret:
        cmp rcx, 2
        jne .maybe_bind
        mov rax, [r8]
        and rax, 255
        cmp rax, 111
        jne .maybe_bind
        mov rax, [r8+1]
        and rax, 255
        cmp rax, 115
        jne .maybe_bind
        mov rax, [rsi]
        and rax, 255
        cmp rax, 46
        jne .maybe_bind
        jmp .do_os2
.maybe_bind:
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 58
        jne .stmt_skip
        add rsi, 1
        mov rax, [rsi]
        and rax, 255
        cmp rax, 61
        jne .stmt_skip
        add rsi, 1
        push r8
        push rcx
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 34
        jne .bind_int
        mov rax, rbp
        sub rax, r14
        sub rax, 0x160000
        add rax, 0x400078
        push rax
        push rbp
        call .pstr
        pop rax
        mov rdx, rbp
        sub rdx, rax
        add rdx, 1
        pop rax
        jmp .bind_store
.bind_int:
        call .eval_expr
        mov rdx, 0
.bind_store:
        pop rcx
        pop r8
        mov r11, r15
        shl r11, 5
        add r11, rbx
        mov [r11], r8
        mov [r11+8], rcx
        mov [r11+16], rax
        mov [r11+24], rdx
        add r15, 1
        call .eol
        jmp .stmt
.stmt_skip:
        call .eol
        jmp .stmt
.do_ret2:
        call .eval_expr
        mov rdx, rax
        mov rax, 191
        call .emit
        call .eimm
        mov rax, 184
        call .emit
        mov rdx, 60
        call .eimm
        mov rax, 15
        call .emit
        mov rax, 5
        call .emit
        call .eol
        jmp .stmt
.do_os2:
.os_paren:
        mov rax, [rsi]
        and rax, 255
        add rsi, 1
        cmp rax, 40
        jne .os_paren
        mov r10, 0
.os_arg:
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 41
        je .os_end
        push r10
        call .eval_expr
        pop r10
        mov rdx, rax
        cmp r10, 0
        je .os_rax
        cmp r10, 1
        je .os_rdi
        cmp r10, 2
        je .os_rsi
        cmp r10, 3
        je .os_rdx
        cmp r10, 4
        je .os_r10e
        cmp r10, 5
        je .os_r8e
        jmp .os_r9e
.os_after:
        add r10, 1
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 44
        jne .os_arg
        add rsi, 1
        jmp .os_arg
.os_rax:
        mov rax, 184
        call .emit
        call .eimm
        jmp .os_after
.os_rdi:
        mov rax, 191
        call .emit
        call .eimm
        jmp .os_after
.os_rsi:
        mov rax, 190
        call .emit
        call .eimm
        jmp .os_after
.os_rdx:
        mov rax, 186
        call .emit
        call .eimm
        jmp .os_after
.os_r10e:
        mov rax, 65
        call .emit
        mov rax, 186
        call .emit
        call .eimm
        jmp .os_after
.os_r8e:
        mov rax, 65
        call .emit
        mov rax, 184
        call .emit
        call .eimm
        jmp .os_after
.os_r9e:
        mov rax, 65
        call .emit
        mov rax, 185
        call .emit
        call .eimm
        jmp .os_after
.os_end:
        add rsi, 1
        mov rax, 15
        call .emit
        mov rax, 5
        call .emit
        call .eol
        jmp .stmt
.finalize:
        mov r8, rdi
        sub r8, r12
        sub r8, 120
        mov r9, rbp
        sub r9, r14
        sub r9, 0x160000
        mov rsi, r12
        add rsi, 120
        mov rdi, r14
        add rdi, 0x170000
        mov rcx, r8
        call .copy8
        mov rsi, r14
        add rsi, 0x160000
        mov rdi, r12
        add rdi, 120
        mov rcx, r9
        call .copy8
        mov rsi, r14
        add rsi, 0x170000
        mov rdi, r12
        add rdi, 120
        add rdi, r9
        mov rcx, r8
        call .copy8
        mov rax, r8
        add rax, r9
        add rax, 120
        mov [r12+96], rax
        mov [r12+104], rax
        mov rdx, r9
        add rdx, 0x400078
        mov [r12+24], rdx
        mov rdx, rax
        mov rdi, 1
        mov rsi, r12
        mov rax, 1
        syscall
        mov rdi, 0
        mov rax, 60
        syscall
.copy8:
        cmp rcx, 0
        jle .c8_done
        mov rax, [rsi]
        mov [rdi], rax
        add rsi, 8
        add rdi, 8
        sub rcx, 8
        jmp .copy8
.c8_done:
        ret
.pstr:
        add rsi, 1
.ps_l:
        cmp rsi, r13
        jae .err
        mov rax, [rsi]
        and rax, 255
        add rsi, 1
        cmp rax, 34
        je .ps_done
        cmp rax, 10
        je .err
        cmp rax, 0
        je .err
        cmp rax, 92
        jne .ps_put
        mov rax, [rsi]
        and rax, 255
        add rsi, 1
        cmp rax, 110
        je .ps_n
        cmp rax, 116
        je .ps_t
        cmp rax, 114
        je .ps_r
        cmp rax, 48
        je .ps_0
        cmp rax, 92
        je .ps_put
        cmp rax, 34
        je .ps_put
        cmp rax, 39
        je .ps_put
        cmp rax, 120
        je .ps_x
        jmp .err
.ps_n:
        mov rax, 10
        jmp .ps_put
.ps_t:
        mov rax, 9
        jmp .ps_put
.ps_r:
        mov rax, 13
        jmp .ps_put
.ps_0:
        mov rax, 0
        jmp .ps_put
.ps_x:
        mov rax, [rsi]
        and rax, 255
        add rsi, 1
        call .hexd
        shl rax, 4
        mov rdx, rax
        mov rax, [rsi]
        and rax, 255
        add rsi, 1
        call .hexd
        add rax, rdx
.ps_put:
        mov [rbp], rax
        add rbp, 1
        jmp .ps_l
.ps_done:
        ret
.hexd:
        sub rax, 48
        cmp rax, 9
        jbe .hd_ok
        sub rax, 7
        cmp rax, 10
        jb .err
        cmp rax, 15
        jbe .hd_ok
        sub rax, 32
        cmp rax, 10
        jb .err
        cmp rax, 15
        ja .err
.hd_ok:
        ret
.err:
        mov rdi, 2
        mov rsi, errmsg
        mov rdx, 12
        mov rax, 1
        syscall
        mov rdi, 2
        mov rax, 60
        syscall
.emit:
        mov [rdi], rax
        add rdi, 1
        ret
.eimm:
        mov rax, rdx
        and rax, 255
        call .emit
        mov rax, rdx
        shr rax, 8
        and rax, 255
        call .emit
        mov rax, rdx
        shr rax, 16
        and rax, 255
        call .emit
        mov rax, rdx
        shr rax, 24
        and rax, 255
        call .emit
        ret
.pint:
        mov rdx, 0
.pint_d:
        mov rax, [rsi]
        and rax, 255
        sub rax, 48
        cmp rax, 9
        ja .pint_done
        lea rdx, [rdx+rdx*4]
        add rdx, rdx
        add rdx, rax
        add rsi, 1
        jmp .pint_d
.pint_done:
        ret
.sksp:
        push rax
.sksp_l:
        mov rax, [rsi]
        and rax, 255
        cmp rax, 32
        je .sksp_a
        cmp rax, 9
        je .sksp_a
        pop rax
        ret
.sksp_a:
        add rsi, 1
        jmp .sksp_l
.eol:
        cmp rsi, r13
        jae .eol_ret
        mov rax, [rsi]
        and rax, 255
        add rsi, 1
        cmp rax, 10
        jne .eol
.eol_ret:
        ret
.skipname:
        mov rax, [rsi]
        and rax, 255
        cmp rax, 48
        jb .sn_chka
        cmp rax, 57
        jbe .sn_yes
.sn_chka:
        cmp rax, 65
        jb .sn_chku
        cmp rax, 90
        jbe .sn_yes
.sn_chku:
        cmp rax, 95
        je .sn_yes
        cmp rax, 97
        jb .sn_no
        cmp rax, 122
        jbe .sn_yes
.sn_no:
        ret
.sn_yes:
        add rsi, 1
        jmp .skipname
.eval_expr:
        call .eval_term
.ee_loop:
        call .sksp
        mov rcx, [rsi]
        and rcx, 255
        cmp rcx, 43
        je .ee_add
        cmp rcx, 45
        je .ee_sub
        ret
.ee_add:
        add rsi, 1
        push rax
        call .eval_term
        pop rcx
        add rax, rcx
        jmp .ee_loop
.ee_sub:
        add rsi, 1
        push rax
        call .eval_term
        pop rcx
        sub rcx, rax
        mov rax, rcx
        jmp .ee_loop
.eval_term:
        call .eval_factor
.et_loop:
        call .sksp
        mov rcx, [rsi]
        and rcx, 255
        cmp rcx, 42
        je .et_mul
        ret
.et_mul:
        add rsi, 1
        push rax
        call .eval_factor
        pop rcx
        imul rax, rcx
        jmp .et_loop
.eval_factor:
        call .sksp
        mov rax, [rsi]
        and rax, 255
        mov rcx, rax
        sub rcx, 48
        cmp rcx, 9
        jbe .ef_int
        jmp .ef_name
.ef_int:
        call .pint
        mov rax, rdx
        ret
.ef_name:
        mov r8, rsi
        call .skipname
        mov rcx, rsi
        sub rcx, r8
        call .lookup_name
        mov rdx, [rsi]
        and rdx, 255
        cmp rdx, 46
        jne .ef_ret
        add rsi, 1
        mov rdx, [r11+24]
        cmp rdx, 0
        je .err
        mov r8, rsi
        call .skipname
        mov rcx, rsi
        sub rcx, r8
        mov rax, [r8]
        and rax, 255
        cmp rax, 97
        je .ef_addr
        cmp rax, 108
        jne .err
        cmp rcx, 3
        jne .err
        mov rax, rdx
        sub rax, 1
        ret
.ef_addr:
        cmp rcx, 4
        jne .err
        mov rax, [r11+16]
        ret
.ef_ret:
        ret
.lookup_name:
        mov r9, 0
.ln_loop:
        cmp r9, r15
        jae .ln_notfound
        mov r11, r9
        shl r11, 5
        add r11, rbx
        mov rdx, [r11+8]
        cmp rdx, rcx
        jne .ln_next
        mov r11, [r11]
        mov rdx, 0
.ln_cmp:
        cmp rdx, rcx
        jae .ln_found
        mov rax, [r8+rdx]
        and rax, 255
        mov r10, [r11+rdx]
        and r10, 255
        cmp rax, r10
        jne .ln_next
        add rdx, 1
        jmp .ln_cmp
.ln_found:
        mov r11, r9
        shl r11, 5
        add r11, rbx
        mov rax, [r11+16]
        ret
.ln_next:
        add r9, 1
        jmp .ln_loop
.ln_notfound:
        jmp .err
    end
end
rodata errmsg
    ascii "oli1: error\n"
end
rodata template
    byte 0x7f, 0x45, 0x4c, 0x46, 0x02, 0x01, 0x01, 0x00
    byte 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    byte 0x02, 0x00, 0x3e, 0x00, 0x01, 0x00, 0x00, 0x00
    byte 0x78, 0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00
    byte 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    byte 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    byte 0x00, 0x00, 0x00, 0x00
    byte 0x40, 0x00, 0x38, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    byte 0x01, 0x00, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00
    byte 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    byte 0x00, 0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00
    byte 0x00, 0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00
    byte 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    byte 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    byte 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
end
