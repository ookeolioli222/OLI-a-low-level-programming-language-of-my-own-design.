        sub r8, r12
        sub r8, 120
        mov r9, rbp
        sub r9, r14
        sub r9, 0x400000
        mov rsi, r12
        add rsi, 120
        mov rdi, r14
        add rdi, 0x200000
        mov rcx, r8
        call .copy8
        mov rsi, r14
        add rsi, 0x400000
        mov rdi, r12
        add rdi, 120
        mov rcx, r9
        call .copy8
        mov rsi, r14
        add rsi, 0x200000
        mov rdi, r12
        add rdi, 120
        add rdi, r9
        mov rcx, r8
        call .copy8
        mov rax, r8
        add rax, r9
        add rax, 120
        mov [r12+96], rax
        mov [r12+104], rax
        mov rdx, r9
        add rdx, 0x400078
        add rdx, [r14+0x1F0030]
        sub rdx, r12
        sub rdx, 120
        mov [r12+24], rdx
        mov rdx, rax
        mov rdi, 1
        mov rsi, r12
        mov rax, 1
        syscall
        mov rdi, 0
        mov rax, 60
        syscall
.copy8:
        cmp rcx, 0
        jle .c8_done
        mov rax, [rsi]
        mov [rdi], rax
        add rsi, 8
        add rdi, 8
        sub rcx, 8
        jmp .copy8
.c8_done:
        ret
.pstr:
        add rsi, 1
.ps_l:
        cmp rsi, r13
        jae .err
        mov rax, [rsi]
        and rax, 255
        add rsi, 1
        cmp rax, 34
        je .ps_done
        cmp rax, 10
        je .err
        cmp rax, 0
        je .err
        cmp rax, 92
        jne .ps_put
        mov rax, [rsi]
        and rax, 255
        add rsi, 1
        cmp rax, 110
        je .ps_n
        cmp rax, 116
        je .ps_t
        cmp rax, 114
        je .ps_r
        cmp rax, 48
        je .ps_0
        cmp rax, 92
        je .ps_put
        cmp rax, 34
        je .ps_put
        cmp rax, 39
        je .ps_put
        cmp rax, 120
        je .ps_x
        jmp .err
.ps_n:
        mov rax, 10
        jmp .ps_put
.ps_t:
        mov rax, 9
        jmp .ps_put
.ps_r:
        mov rax, 13
        jmp .ps_put
.ps_0:
        mov rax, 0
        jmp .ps_put
.ps_x:
        mov rax, [rsi]
        and rax, 255
        add rsi, 1
        call .hexd
        shl rax, 4
        mov rdx, rax
        mov rax, [rsi]
        and rax, 255
        add rsi, 1
        call .hexd
        add rax, rdx
.ps_put:
        mov r10, rbp
        sub r10, r14
        cmp r10, 0x4FFFF0
        jae .err
        mov [rbp], rax
        add rbp, 1
        jmp .ps_l
.ps_done:
        ret
.hexd:
        sub rax, 48
        cmp rax, 9
        jbe .hd_ok
        sub rax, 7
        cmp rax, 10
        jb .err
        cmp rax, 15
        jbe .hd_ok
        sub rax, 32
        cmp rax, 10
        jb .err
        cmp rax, 15
        ja .err
.hd_ok:
        ret
.err:
        mov rcx, r14
        mov rdx, 1
.err_cnt:
        cmp rcx, rsi
        jae .err_cnt_done
        cmp rcx, r13
        jae .err_cnt_done
        mov rax, [rcx]
        and rax, 255
        cmp rax, 10
        jne .err_cnt_next
        add rdx, 1
.err_cnt_next:
        add rcx, 1
        jmp .err_cnt
.err_cnt_done:
        mov rax, rdx
        mov rdi, r12
        mov r9, 0
.err_dig:
        mov rdx, 0
        mov r8, 10
        div r8
        add rdx, 48
        mov [rdi+r9], rdx
        add r9, 1
        cmp rax, 0
        jne .err_dig
        mov rdi, 2
        mov rsi, errmsg
        mov rdx, 20
        mov rax, 1
        syscall
.err_out:
        cmp r9, 0
        je .err_nl
        sub r9, 1
        mov rsi, r12
        add rsi, r9
        mov rdi, 2
        mov rdx, 1
        mov rax, 1
        syscall
        jmp .err_out
.err_nl:
        mov rdi, 2
        mov rsi, nlmsg
        mov rdx, 1
        mov rax, 1
        syscall
        mov rdi, 2
        mov rax, 60
        syscall
    end
end
