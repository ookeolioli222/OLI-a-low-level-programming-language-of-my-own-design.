-- oli1 - the Oli-- genesis oli-core compiler (layer 3), step 6f.
-- A real code generator: integer bindings are stack-frame locals, expressions
-- are evaluated at run time (in rax, with push/pop for the right operand),
-- control flow is compiled to rel32 branches with forward fixups, procedures
-- follow the SysV register convention (docs/ABI.md), views are two-word values
-- (rax = addr, rdx = len), zones are (base, cursor, limit) triples.
--   [module path]  { NAME := <decimal>            module-level integer constant
--                  | layout NAME [packed] [align N] NL { f : T [align N] NL } end
--                  | proc NAME [(p: T, ...)] [-> T [or E]] [entry | calls ... | permit ...]* block end }
--   -> T or E                  fallible result (design 0007): T an integer or ref, E an
--                               integer type or none; tag in rax (0 ok, 1 fail), payload in rdx
--   ret v / fail [e]            in a fallible procedure: ok(v) / fail(e); bare fail only for none
--   f(args) else fail           propagate the failure to the caller (same E kind required)
--   f(args) else ret [v]        diverge; f(args) else v : default value of type T
--   case f(args) NL when ok [x] NL block when fail [e] NL block end   (either order;
--                               the second arm may be `else`); x : T, e : E are bindings
--   an unresolved fallible value anywhere else is a compile error
--   Name.size, Name.align      compile-time constants; Name.at(v) checks v.len and
--                               alignment and yields ref Name; z.make(Name) allocates one
--   r.f / r.f <- x              field load (zero/sign extended by the field type) / store
--   NAME(args)                  call (statement or factor); up to six argument words in
--                               rdi rsi rdx rcx r8 r9; result in rax (view: rax, rdx)
--   T(x) / T.wrap(x) / T.bits(x)   explicit conversion: T(x) is lossless and emits
--                               nothing, .wrap/.bits truncate to the width of T and
--                               extend again with its signedness; .sat/.checked reject
--   name := <expr>              bind a new local: one slot (int) or two (view)
--   name := "text"              bind a name to a .rodata string (escapes of syntax §2.4)
--   name <- <expr>              store into an existing local (same type)
--   [a] <- <expr>               raw word store; [a] is the raw word load
--   v[i] <- <expr>              byte store into a view (bounds checked)
--   zone z SIZE [at ADDR] NL block end   hosted zone (mmap, munmap at end) or raw memory
--   ret [<expr>]                in the entry procedure exit(value); elsewhere return it
--   if <expr> NL block { elif <expr> NL block } [ else NL block ] end
--   while <expr> NL block end ; break ; continue
--   os.syscall(e0 .. e6)        statement or factor; its value is the result
-- expr  = add [ ('=='|'!='|'<'|'<='|'>'|'>=') add ]     (result 1 or 0)
-- add   = mul { ('+'|'-') mul } ; mul = unary { ('*'|'/'|'%') unary }
-- unary = '-' unary | primary
-- primary = int | "text" | [expr] | (expr) | os.syscall(args) | NAME(args)
--         | name | name.addr | name.len | v[i] | v[a..b] | v[..b] | z.bytes(n)
--         | z.make(Name) | Name.size | Name.align | Name.at(v) | r.f
-- Type codes at compile time: 0 = integer word, 1 = view (addr, len), 2 = zone
-- handle (parameters only; an integer argument satisfies it), 3+i = ref to
-- layout i; a fallible result type adds 256 (bit 8) to the code of T and 512
-- (bit 9) when E is none — only results and call values carry these bits.
-- Symbol kinds: 0 int local (1 slot), 1 static string (addr, len
-- known), 2 view local (2 slots), 3 zone handle (slot holding the address of
-- the triple; a local zone keeps limit, cursor, base in three ascending-address
-- slots below it), 4 ref local (1 slot, extra = layout index).
-- A parameter type is `[rw] view ...` (1), `zone` (2), `[rw] ref Name` (3+i),
-- anything else an integer; the same words after `->` give the result type.
-- Scratch is a 16 MiB mmap: input [base,+1M), output [base+8M,+4M),
-- string pool [base+4M,+1M), code temp [base+2M,+2M),
-- call fixups [base+5M,+1M), procedure table [base+6M,+512K),
-- break-fixup stack [base+1.8125M,+64K), if-fixup stack [base+1.875M,+64K),
-- field table [base+1.5625M,+64K), layout table [base+1.625M,+64K),
-- state [base+1.9375M): +0 nslots, +8 loop start, +16 if-fixup top, +24 frame
-- field, +32 break-fixup top, +40 current proc is entry, +48 entry code pos,
-- +56 entry count, +64 proc count, +72 call fixup count, +80 type of the last
-- expression, +88 current proc result type, +96 zone depth, +104 zone depth at
-- loop start, +112 signature pass (0 declare, 1 define), +120 return address
-- of parse_sig, +128 layout count, +136 field count, +144 layout byte cursor,
-- +152 layout being parsed; symbols [base+1.5M).
-- Pass 0 reads every `layout` block, pass 1 every `proc` header, so that calls
-- are type- and arity-checked where they occur, whatever the declaration order.
-- Procedure entry (64 bytes): name ptr, name len, code pos, param words, param
-- type codes (8 bits each), unused, param count, result type. Call fixup
-- (24 bytes): rel32 field pos, proc index, unused; resolved at finalize.
-- Layout entry (64 bytes): name ptr, name len, size, align, first field, field
-- count, packed. Field entry (48 bytes): name ptr, name len, offset, size,
-- signed, type code (0 integer, 1 view).
-- Symbol entry (48 bytes): name ptr, name len, value (slot index, or string
-- address), kind, extra (string length; base slot of a hosted zone, -1 for at;
-- layout index of a ref); kind 5 is a module constant (value = the integer),
-- kept in a separate table (48-byte entries at [base+0x1F1000), count at state
-- +160) that name lookup searches after the procedure's locals.
-- asm has no byte store, so emit writes an 8-byte value < 256 and advances one.
-- Output layout: 120-byte ELF header | string pool | trap stub | code. Strings
-- have a fixed address (0x400078 + pool offset) the moment they are bound; at
-- finalize the code is moved behind the pool and e_entry is patched.
-- Generated code: push rbp; mov rbp,rsp; sub rsp,FRAME (patched); parameters are
-- spilled to slots 0..n-1; locals live at [rbp - 8*(slot+1)]; falling off the end
-- exits 0 in the entry procedure and returns 0 elsewhere. Traps (bounds, zone
-- exhausted, mmap failure) print `oli: trap` and exit 3.
-- Registers: r14 in base, r13 in end, r12 out base, rbx symtab base, r15 symbol
-- count, rbp string pool cursor, rdi emit ptr, rsi in cursor.
module oli1
proc start
    calls none
    entry
    machine x64
        mov rdi, 0
        mov rsi, 0x1000000
        mov rdx, 3
        mov r10, 0x22
        mov r8, -1
        mov r9, 0
        mov rax, 9
        syscall
        mov r14, rax
        mov r12, r14
        add r12, 0x800000
        mov rbx, r14
        add rbx, 0x180000
        mov rbp, r14
        add rbp, 0x400000
        mov r15, 0
        mov rax, 0
        mov [r14+0x1F0000], rax
        mov [r14+0x1F0008], rax
        mov [r14+0x1F0028], rax
        mov [r14+0x1F0030], rax
        mov [r14+0x1F0038], rax
        mov [r14+0x1F0040], rax
        mov [r14+0x1F0048], rax
        mov [r14+0x1F0050], rax
        mov [r14+0x1F0058], rax
        mov [r14+0x1F0060], rax
        mov [r14+0x1F0068], rax
        mov [r14+0x1F0070], rax
        mov [r14+0x1F0080], rax
        mov [r14+0x1F0088], rax
        mov [r14+0x1F00A0], rax
        mov rax, r14
        add rax, 0x1E0000
        mov [r14+0x1F0010], rax
        mov rax, r14
        add rax, 0x1D0000
        mov [r14+0x1F0020], rax
        mov rcx, r14
.rd:
        mov rdi, 0
        mov rsi, rcx
        mov rdx, 0x100000
        push rcx
        mov rax, 0
        syscall
        pop rcx
        cmp rax, 0
        jle .rd_done
        add rcx, rax
        jmp .rd
.rd_done:
        mov r13, rcx
        mov rdi, r12
        mov rsi, template
        mov rcx, 15
.hcpy:
        mov rax, [rsi]
        mov [rdi], rax
        add rsi, 8
        add rdi, 8
        sub rcx, 1
        cmp rcx, 0
        jne .hcpy
        mov rdx, trapmsg
        mov rcx, 10
.tcpy:
        mov rax, [rdx]
        and rax, 255
        mov [rbp], rax
        add rbp, 1
        add rdx, 1
        sub rcx, 1
        cmp rcx, 0
        jne .tcpy
        mov rdx, seq_trap
        mov rcx, 36
        call .ebytes
        mov rsi, r14
.pass0:
        cmp rsi, r13
        jae .pass0_done
        call .word
        cmp rcx, 6
        jne .pass0_skip
        mov rdx, kw_layout
        mov r9, 6
        call .iskw
        cmp rax, 1
        jne .pass0_skip
        call .parse_layout
        jmp .pass0
.pass0_skip:
        call .eol_blind
        jmp .pass0
.pass0_done:
        mov rsi, r14
.pass1:
        cmp rsi, r13
        jae .pass1_done
        call .word
        cmp rcx, 4
        jne .pass1_skip
        mov rdx, kw_proc
        mov r9, 4
        call .iskw
        cmp rax, 1
        jne .pass1_skip
        call .parse_sig
        pop r11
        jmp .pass1
.pass1_skip:
        call .eol_blind
        jmp .pass1
.pass1_done:
        mov rax, 1
        mov [r14+0x1F0070], rax
        mov rsi, r14
.hdr:
        cmp rsi, r13
        jae .finalize
        call .word
        cmp rcx, 0
        jne .hdr_word
        cmp rsi, r13
        jae .finalize
        call .blank
        jmp .hdr
.hdr_word:
        mov rdx, kw_module
        mov r9, 6
        call .iskw
        cmp rax, 1
        jne .hdr_layout
        call .eol_blind
        jmp .hdr
.hdr_layout:
        mov rdx, kw_layout
        mov r9, 6
        call .iskw
        cmp rax, 1
        jne .hdr_proc
        call .eol_blind
.hdr_layout_skip:
        cmp rsi, r13
        jae .err
        call .word
        cmp rcx, 3
        jne .hdr_layout_next
        mov rdx, kw_end
        mov r9, 3
        call .iskw
        cmp rax, 1
        je .hdr_layout_end
.hdr_layout_next:
        call .eol_blind
        jmp .hdr_layout_skip
.hdr_layout_end:
        call .eol
        jmp .hdr
.hdr_proc:
        mov rdx, kw_proc
        mov r9, 4
        call .iskw
        cmp rax, 1
        jne .hdr_const
        call .parse_sig
.hdr2:
        call .word
        cmp rcx, 0
        jne .hdr2_word
        call .blank
        jmp .hdr2
.hdr2_word:
        mov rdx, kw_entry
        mov r9, 5
        call .iskw
        cmp rax, 1
        je .hdr2_entry
        mov rdx, kw_calls
        mov r9, 5
        call .iskw
        cmp rax, 1
        je .hdr2_blind
        mov rdx, kw_permit
        mov r9, 6
        call .iskw
        cmp rax, 1
        je .hdr2_blind
        mov rsi, r8
        jmp .body
.hdr2_entry:
        mov rax, 1
        mov [r14+0x1F0028], rax
        mov rax, [r14+0x1F0038]
        add rax, 1
        mov [r14+0x1F0038], rax
        call .eol
        jmp .hdr2
.hdr2_blind:
        call .eol_blind
        jmp .hdr2
.body:
        pop r11
        mov [r11+16], rdi
        mov rax, [r14+0x1F0028]
        cmp rax, 0
        je .body_code
        mov rax, [r14+0x1F0058]
        cmp rax, 256
        jae .err
        mov [r14+0x1F0030], rdi
.body_code:
        mov rdx, seq_prologue
        mov rcx, 7
        call .ebytes
        mov [r14+0x1F0018], rdi
        mov rdx, 0
        call .eimm
        mov r9, 0
.spill:
        cmp r9, [r14+0x1F0000]
        jae .spill_done
        push r9
        mov rdx, spilltab
        lea rdx, [rdx+r9*2]
        add rdx, r9
        mov rcx, 3
        call .ebytes
        pop r9
        mov rdx, r9
        add rdx, 1
        shl rdx, 3
        neg rdx
        call .eimm
        add r9, 1
        jmp .spill
.spill_done:
        call .block
        cmp rax, 1
        jne .err
        mov rax, [r14+0x1F0028]
        cmp rax, 0
        je .body_leave
        mov rdx, seq_exit0
        mov rcx, 12
        call .ebytes
        jmp .body_frame
.body_leave:
        mov rdx, 0
        call .e_movimm
        mov rdx, seq_leave
        mov rcx, 4
        call .ebytes
.body_frame:
        mov rax, [r14+0x1F0000]
        shl rax, 3
        add rax, 15
        and rax, -16
        mov rcx, rax
        mov rdx, [r14+0x1F0018]
        call .put32
        jmp .hdr
.hdr_const:
        push r8
        push rcx
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 58
        jne .err
        mov rax, [rsi+1]
        and rax, 255
        cmp rax, 61
        jne .err
        add rsi, 2
        call .sksp
        mov rax, [rsi]
        and rax, 255
        sub rax, 48
        cmp rax, 9
        ja .err
        call .pint
        pop rcx
        pop r8
        push rdx
        call .glob_find
        cmp r11, 0
        jne .err
        mov r11, [r14+0x1F00A0]
        lea r11, [r11+r11*2]
        shl r11, 4
        add r11, r14
        add r11, 0x1F1000
        mov [r11], r8
        mov [r11+8], rcx
        pop rdx
        mov [r11+16], rdx
        mov rax, 5
        mov [r11+24], rax
        mov rax, 0
        mov [r11+32], rax
        mov rax, [r14+0x1F00A0]
        add rax, 1
        mov [r14+0x1F00A0], rax
        call .eol
        jmp .hdr
.glob_find:
        mov r9, [r14+0x1F00A0]
.gf_loop:
        cmp r9, 0
        je .gf_none
        sub r9, 1
        mov rdx, r9
        lea rdx, [rdx+rdx*2]
        shl rdx, 4
        add rdx, r14
        add rdx, 0x1F1000
        call .name_eq
        cmp rax, 1
        jne .gf_loop
        mov r11, rdx
        ret
.gf_none:
        mov r11, 0
        ret
.parse_sig:
        pop rax
        mov [r14+0x1F0078], rax
        call .word
        cmp rcx, 0
        je .err
        call .proc_find
        mov rax, [r14+0x1F0070]
        cmp rax, 0
        jne .sig_define
        cmp r11, 0
        jne .err
        call .proc_add
        jmp .sig_have
.sig_define:
        cmp r11, 0
        je .err
.sig_have:
        push r11
        mov r15, 0
        mov rax, 0
        mov [r14+0x1F0000], rax
        mov [r14+0x1F0008], rax
        mov [r14+0x1F0028], rax
        mov [r14+0x1F0058], rax
        mov [r14+0x1F0060], rax
        mov [r14+0x1F0068], rax
        mov [r11+24], rax
        mov [r11+32], rax
        mov [r11+40], rax
        mov [r11+48], rax
        mov [r11+56], rax
        mov rax, [rsi]
        and rax, 255
        cmp rax, 40
        jne .sig_noparams
        add rsi, 1
.sig_param:
        call .word
        cmp rcx, 0
        jne .sig_pname
        mov rax, 41
        call .expect
        jmp .sig_noparams
.sig_pname:
        mov r11, [rsp]
        mov rax, [r11+48]
        cmp rax, 6
        jae .err
        push r8
        push rcx
        mov rax, 58
        call .expect
        call .type_code
.sig_pt_rest:
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 44
        je .sig_pt_end
        cmp rax, 41
        je .sig_pt_end
        push r9
        call .word
        cmp rcx, 0
        je .err
        mov rdx, kw_or
        mov r9, 2
        call .iskw
        pop r9
        cmp rax, 1
        je .err
        jmp .sig_pt_rest
.sig_pt_end:
        pop rcx
        pop r8
        mov r11, [rsp]
        mov rax, [r14+0x1F0070]
        cmp rax, 0
        je .sig_pt_table
        push r9
        mov r10, [r14+0x1F0000]
        call .sym_new
        mov [r11+16], r10
        call .kind_of_code
        mov [r11+24], rax
        mov [r11+32], rdx
        pop r9
        mov r11, [rsp]
.sig_pt_table:
        mov rcx, [r11+48]
        shl rcx, 3
        mov rdx, r9
        shl rdx, cl
        or [r11+32], rdx
        mov rax, 1
        cmp r9, 1
        jne .sig_pt_words
        mov rax, 2
.sig_pt_words:
        add [r11+24], rax
        add [r14+0x1F0000], rax
        mov rcx, [r11+48]
        add rcx, 1
        mov [r11+48], rcx
        mov rax, [r11+24]
        cmp rax, 6
        ja .err
        mov rax, [rsi]
        and rax, 255
        cmp rax, 44
        jne .sig_param
        add rsi, 1
        jmp .sig_param
.sig_noparams:
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 45
        jne .sig_eol
        mov rax, [rsi+1]
        and rax, 255
        cmp rax, 62
        jne .err
        add rsi, 2
        call .type_code
        cmp r9, 2
        je .err
        mov r11, [rsp]
        mov [r11+56], r9
.sig_rtype_rest:
        call .sksp
        cmp rsi, r13
        jae .sig_eol
        mov rax, [rsi]
        and rax, 255
        cmp rax, 10
        je .sig_eol
        cmp rax, 13
        je .sig_eol
        cmp rax, 45
        je .sig_eol
        call .word
        cmp rcx, 0
        je .err
        cmp rcx, 2
        jne .sig_rtype_rest
        mov rdx, kw_or
        mov r9, 2
        call .iskw
        cmp rax, 1
        jne .sig_rtype_rest
        mov r11, [rsp]
        mov rax, [r11+56]
        cmp rax, 1
        je .err
        cmp rax, 256
        jae .err
        add rax, 256
        push rax
        call .word
        cmp rcx, 0
        je .err
        mov rdx, kw_none
        mov r9, 4
        call .iskw
        cmp rax, 1
        jne .sig_rtype_e
        pop rax
        add rax, 512
        jmp .sig_rtype_set
.sig_rtype_e:
        mov rdx, kw_view
        mov r9, 4
        call .iskw
        cmp rax, 1
        je .err
        mov rdx, kw_zone
        mov r9, 4
        call .iskw
        cmp rax, 1
        je .err
        mov rdx, kw_ref
        mov r9, 3
        call .iskw
        cmp rax, 1
        je .err
        mov rdx, kw_rw
        mov r9, 2
        call .iskw
        cmp rax, 1
        je .err
        pop rax
.sig_rtype_set:
        mov r11, [rsp]
        mov [r11+56], rax
        jmp .sig_rtype_rest
.sig_eol:
        call .eol
        mov r11, [rsp]
        mov rax, [r11+56]
        mov [r14+0x1F0058], rax
        mov rax, [r14+0x1F0078]
        push rax
        ret
.type_code:
        call .word
        cmp rcx, 0
        je .err
        mov rdx, kw_rw
        mov r9, 2
        call .iskw
        cmp rax, 1
        jne .tc_word
        call .word
        cmp rcx, 0
        je .err
.tc_word:
        mov rdx, kw_view
        mov r9, 4
        call .iskw
        cmp rax, 1
        je .tc_view
        mov rdx, kw_zone
        mov r9, 4
        call .iskw
        cmp rax, 1
        je .tc_zone
        mov rdx, kw_ref
        mov r9, 3
        call .iskw
        cmp rax, 1
        je .tc_ref
        mov r9, 0
        ret
.tc_view:
        mov r9, 1
        ret
.tc_zone:
        mov r9, 2
        ret
.tc_ref:
        call .word
        cmp rcx, 0
        je .err
        call .layout_find
        cmp r11, 0
        je .err
        add r9, 3
        ret
.kind_of_code:
        mov rdx, 0
        cmp r9, 0
        je .koc_int
        cmp r9, 1
        je .koc_view
        cmp r9, 2
        je .koc_zone
        mov rax, 4
        mov rdx, r9
        sub rdx, 3
        ret
.koc_int:
        mov rax, 0
        ret
.koc_view:
        mov rax, 2
        ret
.koc_zone:
        mov rax, 3
        ret
.name_eq:
        push r11
        push r10
        mov rax, [rdx+8]
        cmp rax, rcx
        jne .ne_no
        mov r11, 0
.ne_l:
        cmp r11, rcx
        jae .ne_yes
        mov rax, [r8+r11]
        and rax, 255
        mov r10, [rdx]
        mov r10, [r10+r11]
        and r10, 255
        cmp rax, r10
        jne .ne_no
        add r11, 1
        jmp .ne_l
.ne_yes:
        pop r10
        pop r11
        mov rax, 1
        ret
.ne_no:
        pop r10
        pop r11
        mov rax, 0
        ret
.layout_find:
        mov r9, [r14+0x1F0080]
.lf_loop:
        cmp r9, 0
        je .lf_none
        sub r9, 1
        mov rdx, r9
        shl rdx, 6
        add rdx, r14
        add rdx, 0x1A0000
        call .name_eq
        cmp rax, 1
        jne .lf_loop
        mov r11, rdx
        ret
.lf_none:
        mov r11, 0
        ret
.field_find:
        mov r10, [r11+32]
        mov r9, [r11+40]
        add r9, r10
.ff_loop:
        cmp r10, r9
        jae .err
        mov rdx, r10
        lea rdx, [rdx+rdx*2]
        shl rdx, 4
        add rdx, r14
        add rdx, 0x190000
        call .name_eq
        cmp rax, 1
        je .ff_hit
        add r10, 1
        jmp .ff_loop
.ff_hit:
        mov r10, rdx
        ret
.type_of:
        mov rdx, typetab
.to_l:
        mov rax, [rdx]
        and rax, 255
        cmp rax, 0
        je .err
        cmp rax, rcx
        jne .to_next
        mov r9, 0
.to_c:
        cmp r9, rcx
        jae .to_hit
        mov rax, [r8+r9]
        and rax, 255
        mov r10, [rdx+r9+1]
