-- oli1 - the Oli-- genesis oli-core compiler (layer 3), step 6a.
-- A real code generator: integer bindings are stack-frame locals, expressions
-- are evaluated at run time (in rax, with push/pop for the right operand),
-- control flow is compiled to rel32 branches with forward fixups, procedures
-- follow the SysV register convention (docs/ABI.md), views are two-word values
-- (rax = addr, rdx = len), zones are (base, cursor, limit) triples.
--   [module path]  { proc NAME [(p: T, ...)] [-> T] [entry | calls ... | permit ...]* block end }
--   NAME(args)                  call (statement or factor); up to six argument words in
--                               rdi rsi rdx rcx r8 r9; result in rax (view: rax, rdx)
--   name := <expr>              bind a new local: one slot (int) or two (view)
--   name := "text"              bind a name to a .rodata string (escapes of syntax §2.4)
--   name <- <expr>              store into an existing local (same type)
--   [a] <- <expr>               raw word store; [a] is the raw word load
--   v[i] <- <expr>              byte store into a view (bounds checked)
--   zone z SIZE [at ADDR] NL block end   hosted zone (mmap, munmap at end) or raw memory
--   ret [<expr>]                in the entry procedure exit(value); elsewhere return it
--   if <expr> NL block { elif <expr> NL block } [ else NL block ] end
--   while <expr> NL block end ; break ; continue
--   os.syscall(e0 .. e6)        statement or factor; its value is the result
-- expr  = add [ ('=='|'!='|'<'|'<='|'>'|'>=') add ]     (result 1 or 0)
-- add   = mul { ('+'|'-') mul } ; mul = unary { ('*'|'/'|'%') unary }
-- unary = '-' unary | primary
-- primary = int | "text" | [expr] | (expr) | os.syscall(args) | NAME(args)
--         | name | name.addr | name.len | v[i] | v[a..b] | v[..b] | z.bytes(n)
-- Types at compile time: 0 = integer word, 1 = view (addr, len). Symbol kinds:
-- 0 int local (1 slot), 1 static string (addr, len known), 2 view local
-- (2 slots), 3 zone handle (slot holding the address of the triple; a local
-- zone keeps limit, cursor, base in three ascending-address slots below it).
-- A parameter type whose first word is `view` is a view, `zone` a zone
-- handle, anything else an integer. Result type `-> view ...` is a view.
-- Scratch is a 2 MiB mmap: input [base,+1M), output [base+1M,+1.375M),
-- string pool [base+1.375M,+64K), code temp [base+1.4375M,+64K),
-- call fixups [base+1.6875M,+64K), procedure table [base+1.75M,+64K),
-- break-fixup stack [base+1.8125M,+64K), if-fixup stack [base+1.875M,+64K),
-- state [base+1.9375M): +0 nslots, +8 loop start, +16 if-fixup top, +24 frame
-- field, +32 break-fixup top, +40 current proc is entry, +48 entry code pos,
-- +56 entry count, +64 proc count, +72 call fixup count, +80 type of the last
-- expression, +88 current proc result type, +96 zone depth, +104 zone depth at
-- loop start, +112 signature pass (0 declare, 1 define), +120 return address
-- of parse_sig; symbols [base+1.5M).
-- Pass 1 reads every `proc` header into the procedure table so that calls are
-- type- and arity-checked where they occur, whatever the declaration order.
-- Procedure entry (64 bytes): name ptr, name len, code pos, param words, view
-- param bits, zone param bits, param count, result type. Call fixup (24 bytes):
-- rel32 field pos, proc index, unused; resolved at finalize.
-- Symbol entry (48 bytes): name ptr, name len, value (slot index, or string
-- address), kind, extra (string length; base slot of a hosted zone, -1 for at).
-- asm has no byte store, so emit writes an 8-byte value < 256 and advances one.
-- Output layout: 120-byte ELF header | string pool | trap stub | code. Strings
-- have a fixed address (0x400078 + pool offset) the moment they are bound; at
-- finalize the code is moved behind the pool and e_entry is patched.
-- Generated code: push rbp; mov rbp,rsp; sub rsp,FRAME (patched); parameters are
-- spilled to slots 0..n-1; locals live at [rbp - 8*(slot+1)]; falling off the end
-- exits 0 in the entry procedure and returns 0 elsewhere. Traps (bounds, zone
-- exhausted, mmap failure) print `oli: trap` and exit 3.
-- Registers: r14 in base, r13 in end, r12 out base, rbx symtab base, r15 symbol
-- count, rbp string pool cursor, rdi emit ptr, rsi in cursor.
module oli1
proc start
    calls none
    entry
    machine x64
        mov rdi, 0
        mov rsi, 0x200000
        mov rdx, 3
        mov r10, 0x22
        mov r8, -1
        mov r9, 0
        mov rax, 9
        syscall
        mov r14, rax
        mov r12, r14
        add r12, 0x100000
        mov rbx, r14
        add rbx, 0x180000
        mov rbp, r14
        add rbp, 0x160000
        mov r15, 0
        mov rax, 0
        mov [r14+0x1F0000], rax
        mov [r14+0x1F0008], rax
        mov [r14+0x1F0028], rax
        mov [r14+0x1F0030], rax
        mov [r14+0x1F0038], rax
        mov [r14+0x1F0040], rax
        mov [r14+0x1F0048], rax
        mov [r14+0x1F0050], rax
        mov [r14+0x1F0058], rax
        mov [r14+0x1F0060], rax
        mov [r14+0x1F0068], rax
        mov [r14+0x1F0070], rax
        mov rax, r14
        add rax, 0x1E0000
        mov [r14+0x1F0010], rax
        mov rax, r14
        add rax, 0x1D0000
        mov [r14+0x1F0020], rax
        mov rcx, r14
.rd:
        mov rdi, 0
        mov rsi, rcx
        mov rdx, 0x100000
        push rcx
        mov rax, 0
        syscall
        pop rcx
        cmp rax, 0
        jle .rd_done
        add rcx, rax
        jmp .rd
.rd_done:
        mov r13, rcx
        mov rdi, r12
        mov rsi, template
        mov rcx, 15
.hcpy:
        mov rax, [rsi]
        mov [rdi], rax
        add rsi, 8
        add rdi, 8
        sub rcx, 1
        cmp rcx, 0
        jne .hcpy
        mov rdx, trapmsg
        mov rcx, 10
.tcpy:
        mov rax, [rdx]
        and rax, 255
        mov [rbp], rax
        add rbp, 1
        add rdx, 1
        sub rcx, 1
        cmp rcx, 0
        jne .tcpy
        mov rdx, seq_trap
        mov rcx, 36
        call .ebytes
        mov rsi, r14
.pass1:
        cmp rsi, r13
        jae .pass1_done
        call .word
        cmp rcx, 4
        jne .pass1_skip
        mov rdx, kw_proc
        mov r9, 4
        call .iskw
        cmp rax, 1
        jne .pass1_skip
        call .parse_sig
        pop r11
        jmp .pass1
.pass1_skip:
        call .eol_blind
        jmp .pass1
.pass1_done:
        mov rax, 1
        mov [r14+0x1F0070], rax
        mov rsi, r14
.hdr:
        cmp rsi, r13
        jae .finalize
        call .word
        cmp rcx, 0
        jne .hdr_word
        cmp rsi, r13
        jae .finalize
        call .blank
        jmp .hdr
.hdr_word:
        mov rdx, kw_module
        mov r9, 6
        call .iskw
        cmp rax, 1
        jne .hdr_proc
        call .eol_blind
        jmp .hdr
.hdr_proc:
        mov rdx, kw_proc
        mov r9, 4
        call .iskw
        cmp rax, 1
        jne .err
        call .parse_sig
.hdr2:
        call .word
        cmp rcx, 0
        jne .hdr2_word
        call .blank
        jmp .hdr2
.hdr2_word:
        mov rdx, kw_entry
        mov r9, 5
        call .iskw
        cmp rax, 1
        je .hdr2_entry
        mov rdx, kw_calls
        mov r9, 5
        call .iskw
        cmp rax, 1
        je .hdr2_blind
        mov rdx, kw_permit
        mov r9, 6
        call .iskw
        cmp rax, 1
        je .hdr2_blind
        mov rsi, r8
        jmp .body
.hdr2_entry:
        mov rax, 1
        mov [r14+0x1F0028], rax
        mov rax, [r14+0x1F0038]
        add rax, 1
        mov [r14+0x1F0038], rax
        call .eol
        jmp .hdr2
.hdr2_blind:
        call .eol_blind
        jmp .hdr2
.body:
        pop r11
        mov [r11+16], rdi
        mov rax, [r14+0x1F0028]
        cmp rax, 0
        je .body_code
        mov [r14+0x1F0030], rdi
.body_code:
        mov rdx, seq_prologue
        mov rcx, 7
        call .ebytes
        mov [r14+0x1F0018], rdi
        mov rdx, 0
        call .eimm
        mov r9, 0
.spill:
        cmp r9, [r14+0x1F0000]
        jae .spill_done
        push r9
        mov rdx, spilltab
        lea rdx, [rdx+r9*2]
        add rdx, r9
        mov rcx, 3
        call .ebytes
        pop r9
        mov rdx, r9
        add rdx, 1
        shl rdx, 3
        neg rdx
        call .eimm
        add r9, 1
        jmp .spill
.spill_done:
        call .block
        cmp rax, 1
        jne .err
        mov rax, [r14+0x1F0028]
        cmp rax, 0
        je .body_leave
        mov rdx, seq_exit0
        mov rcx, 12
        call .ebytes
        jmp .body_frame
.body_leave:
        mov rdx, 0
        call .e_movimm
        mov rdx, seq_leave
        mov rcx, 4
        call .ebytes
.body_frame:
        mov rax, [r14+0x1F0000]
        shl rax, 3
        add rax, 15
        and rax, -16
        mov rcx, rax
        mov rdx, [r14+0x1F0018]
        call .put32
        jmp .hdr
.parse_sig:
        pop rax
        mov [r14+0x1F0078], rax
        call .word
        cmp rcx, 0
        je .err
        call .proc_find
        mov rax, [r14+0x1F0070]
        cmp rax, 0
        jne .sig_define
        cmp r11, 0
        jne .err
        call .proc_add
        jmp .sig_have
.sig_define:
        cmp r11, 0
        je .err
.sig_have:
        push r11
        mov r15, 0
        mov rax, 0
        mov [r14+0x1F0000], rax
        mov [r14+0x1F0008], rax
        mov [r14+0x1F0028], rax
        mov [r14+0x1F0058], rax
        mov [r14+0x1F0060], rax
        mov [r14+0x1F0068], rax
        mov [r11+24], rax
        mov [r11+32], rax
        mov [r11+40], rax
        mov [r11+48], rax
        mov [r11+56], rax
        mov rax, [rsi]
        and rax, 255
        cmp rax, 40
        jne .sig_noparams
        add rsi, 1
.sig_param:
        call .word
        cmp rcx, 0
        jne .sig_pname
        mov rax, 41
        call .expect
        jmp .sig_noparams
.sig_pname:
        mov r11, [rsp]
        mov rax, [r11+48]
        cmp rax, 6
        jae .err
        push r8
        push rcx
        mov rax, 58
        call .expect
        call .word
        cmp rcx, 0
        je .err
        mov r9, 0
        mov rdx, kw_view
        push r9
        mov r9, 4
        call .iskw
        pop r9
        cmp rax, 1
        jne .sig_pt_zone
        mov r9, 2
        jmp .sig_pt_rest
.sig_pt_zone:
        mov rdx, kw_zone
        push r9
        mov r9, 4
        call .iskw
        pop r9
        cmp rax, 1
        jne .sig_pt_rest
        mov r9, 3
.sig_pt_rest:
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 44
        je .sig_pt_end
        cmp rax, 41
        je .sig_pt_end
        push r9
        call .word
        pop r9
        cmp rcx, 0
        je .err
        jmp .sig_pt_rest
.sig_pt_end:
        pop rcx
        pop r8
        mov r11, [rsp]
        mov rax, [r14+0x1F0070]
        cmp rax, 0
        je .sig_pt_table
        push r9
        mov r10, [r14+0x1F0000]
        call .sym_new
        mov [r11+16], r10
        mov [r11+24], r9
        pop r9
        mov r11, [rsp]
.sig_pt_table:
        mov rcx, [r11+48]
        mov rdx, 1
        shl rdx, cl
        cmp r9, 2
        jne .sig_pt_notview
        or [r11+32], rdx
        mov rax, [r11+24]
        add rax, 2
        mov [r11+24], rax
        mov rax, [r14+0x1F0000]
        add rax, 2
        mov [r14+0x1F0000], rax
        jmp .sig_pt_count
.sig_pt_notview:
        cmp r9, 3
        jne .sig_pt_int
        or [r11+40], rdx
.sig_pt_int:
        mov rax, [r11+24]
        add rax, 1
        mov [r11+24], rax
        mov rax, [r14+0x1F0000]
        add rax, 1
        mov [r14+0x1F0000], rax
.sig_pt_count:
        add rcx, 1
        mov [r11+48], rcx
        mov rax, [r11+24]
        cmp rax, 6
        ja .err
        mov rax, [rsi]
        and rax, 255
        cmp rax, 44
        jne .sig_param
        add rsi, 1
        jmp .sig_param
.sig_noparams:
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 45
        jne .sig_eol
        mov rax, [rsi+1]
        and rax, 255
        cmp rax, 62
        jne .err
        add rsi, 2
        call .word
        cmp rcx, 0
        je .err
        mov rdx, kw_view
        mov r9, 4
        call .iskw
        cmp rax, 1
        jne .sig_rtype_rest
        mov r11, [rsp]
        mov [r11+56], rax
.sig_rtype_rest:
        call .sksp
        cmp rsi, r13
        jae .sig_eol
        mov rax, [rsi]
        and rax, 255
        cmp rax, 10
        je .sig_eol
        cmp rax, 13
        je .sig_eol
        cmp rax, 45
        je .sig_eol
        call .word
        cmp rcx, 0
        je .err
        jmp .sig_rtype_rest
.sig_eol:
        call .eol
        mov r11, [rsp]
        mov rax, [r11+56]
        mov [r14+0x1F0058], rax
        mov rax, [r14+0x1F0078]
        push rax
        ret
.proc_find:
        mov r9, [r14+0x1F0040]
.pf_loop:
        cmp r9, 0
        je .pf_none
        sub r9, 1
        mov r11, r9
        shl r11, 6
        add r11, r14
        add r11, 0x1C0000
        mov rdx, [r11+8]
        cmp rdx, rcx
        jne .pf_loop
        mov r11, [r11]
        mov rdx, 0
.pf_cmp:
        cmp rdx, rcx
        jae .pf_found
        mov rax, [r8+rdx]
        and rax, 255
        mov r10, [r11+rdx]
        and r10, 255
        cmp rax, r10
        jne .pf_loop
        add rdx, 1
        jmp .pf_cmp
.pf_found:
        mov r11, r9
        shl r11, 6
        add r11, r14
        add r11, 0x1C0000
        ret
.pf_none:
        mov r11, 0
        ret
.proc_add:
        mov r9, [r14+0x1F0040]
        mov r11, r9
        shl r11, 6
        add r11, r14
        add r11, 0x1C0000
        mov [r11], r8
        mov [r11+8], rcx
        mov rax, 0
        mov [r11+16], rax
        add r9, 1
        mov [r14+0x1F0040], r9
        ret
.sym_at:
        lea r11, [r11+r11*2]
        shl r11, 4
        add r11, rbx
        ret
.sym_new:
        push rax
        mov r11, r15
        call .sym_at
        mov [r11], r8
        mov [r11+8], rcx
        mov rax, 0
        mov [r11+16], rax
        mov [r11+24], rax
        mov [r11+32], rax
        add r15, 1
        pop rax
        ret
.block:
        cmp rsi, r13
        jae .blk_eof
        call .word
        cmp rcx, 0
        jne .blk_word
        cmp rsi, r13
        jae .blk_eof
        mov rax, [rsi]
        and rax, 255
        cmp rax, 91
        je .blk_rawstore
        call .blank
        jmp .block
.blk_eof:
        mov rax, 0
        ret
.blk_rawstore:
        add rsi, 1
        call .expr
        call .need_int
        mov rax, 93
        call .expect
        call .expect_store
        mov rax, 80
        call .emit
        call .expr
        call .need_int
        mov rdx, seq_rawstore
        mov rcx, 7
        call .ebytes
        call .eol
        jmp .block
.blk_word:
        mov rdx, kw_end
        mov r9, 3
        call .iskw
        cmp rax, 1
        jne .blk_elif
        call .eol
        mov rax, 1
        ret
.blk_elif:
        mov rdx, kw_elif
        mov r9, 4
        call .iskw
        cmp rax, 1
        jne .blk_else
        mov rax, 2
        ret
.blk_else:
        mov rdx, kw_else
        mov r9, 4
        call .iskw
        cmp rax, 1
        jne .blk_ret
        call .eol
        mov rax, 3
        ret
.blk_ret:
        mov rdx, kw_ret
        mov r9, 3
        call .iskw
        cmp rax, 1
        jne .blk_if
        call .s_ret
        jmp .block
.blk_if:
        mov rdx, kw_if
        mov r9, 2
        call .iskw
        cmp rax, 1
        jne .blk_while
        call .s_if
        jmp .block
.blk_while:
        mov rdx, kw_while
        mov r9, 5
        call .iskw
        cmp rax, 1
        jne .blk_break
        call .s_while
        jmp .block
.blk_break:
        mov rdx, kw_break
        mov r9, 5
        call .iskw
        cmp rax, 1
        jne .blk_continue
        call .s_break
        jmp .block
.blk_continue:
        mov rdx, kw_continue
        mov r9, 8
        call .iskw
        cmp rax, 1
        jne .blk_zone
        call .s_continue
        jmp .block
.blk_zone:
        mov rdx, kw_zone
        mov r9, 4
        call .iskw
        cmp rax, 1
        jne .blk_os
        call .s_zone
        jmp .block
.blk_os:
        mov rdx, kw_os
        mov r9, 2
        call .iskw
        cmp rax, 1
        jne .blk_name
        mov rsi, r8
        call .expr
        call .eol
        jmp .block
.blk_name:
        mov rax, [rsi]
        and rax, 255
        cmp rax, 40
        jne .blk_name_sub
        mov rsi, r8
        call .expr
        call .eol
        jmp .block
.blk_name_sub:
        cmp rax, 91
        jne .blk_name2
        call .s_substore
        jmp .block
.blk_name2:
        call .sksp
        mov rax, [rsi]
        and rax, 255
        mov rdx, [rsi+1]
        and rdx, 255
        cmp rax, 58
        jne .blk_store
        cmp rdx, 61
        jne .err
        add rsi, 2
        call .s_bind
        jmp .block
.blk_store:
        cmp rax, 60
        jne .err
        cmp rdx, 45
        jne .err
        add rsi, 2
        call .s_store
        jmp .block
.s_bind:
        push r8
        push rcx
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 34
        jne .bind_expr
        mov rax, rbp
        sub rax, r14
        sub rax, 0x160000
        add rax, 0x400078
        push rax
        push rbp
        call .pstr
        pop rax
        mov rdx, rbp
        sub rdx, rax
        pop rax
        pop rcx
        pop r8
        call .sym_new
        mov [r11+16], rax
        mov rax, 1
        mov [r11+24], rax
        mov [r11+32], rdx
        call .eol
        ret
.bind_expr:
        call .expr
        pop rcx
        pop r8
        call .sym_new
        mov rax, [r14+0x1F0000]
        mov [r11+16], rax
        mov rdx, [r14+0x1F0050]
        cmp rdx, 0
        jne .bind_view
        add rax, 1
        mov [r14+0x1F0000], rax
        mov rdx, [r11+16]
        call .e_store
        call .eol
        ret
.bind_view:
        add rax, 2
        mov [r14+0x1F0000], rax
        mov rdx, 2
        mov [r11+24], rdx
        mov rdx, [r11+16]
        push rdx
        call .e_store
        pop rdx
        add rdx, 1
        call .e_store_rdx
        call .eol
        ret
.s_store:
        call .lookup_name
        mov rdx, [r11+24]
        cmp rdx, 0
        je .store_int
        cmp rdx, 2
        jne .err
        push r11
        call .expr
        pop r11
        mov rax, [r14+0x1F0050]
        cmp rax, 1
        jne .err
        mov rdx, [r11+16]
        push rdx
        call .e_store
        pop rdx
        add rdx, 1
        call .e_store_rdx
        call .eol
        ret
.store_int:
        push r11
        call .expr
        call .need_int
        pop r11
        mov rdx, [r11+16]
        call .e_store
        call .eol
        ret
.s_substore:
        call .lookup_name
        mov rdx, [r11+24]
        cmp rdx, 2
        jne .err
        push r11
        add rsi, 1
        call .expr
        call .need_int
        mov rax, 93
        call .expect
        call .expect_store
        mov rax, 80
        call .emit
        call .expr
        call .need_int
        pop r11
        mov rdx, seq_swap
        mov rcx, 4
        call .ebytes
        call .e_bounds
        mov rdx, seq_substore
        mov rcx, 3
        call .ebytes
        call .eol
        ret
.expect_store:
        call .sksp
        mov rax, [rsi]
        and rax, 255
        cmp rax, 60
        jne .err
        mov rax, [rsi+1]
        and rax, 255
        cmp rax, 45
        jne .err
        add rsi, 2
        ret
.s_zone:
        call .word
        cmp rcx, 0
        je .err
        push r8
        push rcx
        call .expr
        call .need_int
        mov rax, 80
        call .emit
        call .word
        cmp rcx, 0
        jne .zone_at
        mov rsi, r8
        mov rdx, seq_mmap
        mov rcx, 53
        call .ebytes
        mov rax, 136
        call .e_jcc_trap
        mov rax, 89
        call .emit
        pop rcx
        pop r8
        call .sym_new
        mov rax, [r14+0x1F0000]
        mov [r11+32], rax
        jmp .zone_bind
