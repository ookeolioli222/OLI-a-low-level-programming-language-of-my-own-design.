proc start
    entry
    permit os.syscall
    s := "Hello Oli--\n"
    w := s[6..9]
    os.syscall(1, 1, w.addr, w.len)
    t := s[..5]
    os.syscall(1, 1, t.addr, t.len)
    u := t[1..]
    os.syscall(1, 1, u.addr, u.len)
    nl := "\n"
    os.syscall(1, 1, nl.addr, nl.len)
    ret w.len + t.len + u.len
end
