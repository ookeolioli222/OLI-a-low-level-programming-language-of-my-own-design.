module echo
proc start
    calls none
    entry
    permit os.syscall
    -- mmap(NULL, 4096, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
    buf := os.syscall(9, 0, 4096, 3, 34, -1, 0)
    n := os.syscall(0, 0, buf, 4096)
    if n > 0
        os.syscall(1, 1, buf, n)
    end
    ret n
end
