module places
-- Step 6e: typed places, a view place, `rw` in a field type and `loop`.
layout Buf
    data : rw view u8
    used : u64
end
proc fill(z: zone) -> u64
    b := z.make(Buf)
    v : view u8 <- "abcd"
    b.data <- v
    b.used <- v.len
    n : u64
    n <- 0
    i : u64 <- 0
    loop
        if i >= b.used
            break
        end
        n <- n + 1
        i <- i + 1
    end
    ret n * 10 + b.used
end
proc start
    entry
    zone z 4096
        ret fill(z)
    end
end
