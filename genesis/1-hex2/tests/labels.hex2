:start
e8 %f1              ; call f1 (rel32 forward)
b8 3c 00 00 00      ; mov eax, 60
0f 05               ; syscall
:f1
eb !f2              ; jmp f2 (rel8 forward)
bf 01 00 00 00      ; mov edi, 1 (skipped)
:f2
