module olic.io
-- Output and input helpers for the genesis olic (oli-core subset): raw Linux
-- read/write loops, no buffering, no libc.

proc put(fd: u64, v: view u8)
    permit os.syscall
    done : u64 <- 0
    while done < v.len
        w := os.syscall(1, fd, v.addr + done, v.len - done)
        if w <= 0
            ret
        end
        done <- done + u64.bits(w)
    end
end

-- 2^63: subtracting it from a word with the top bit set gives the low 63 bits.
HALF := 9223372036854775808

proc put_uint(fd: u64, tmp: rw view u8, n: u64)
    -- Decimal digits are built from the end of tmp (at least 20 bytes).
    -- oli-core divides signed, so a value >= 2^63 is printed as 2^63 + r.
    if n < 0
        r := n - HALF
        rem := 8 + r % 10
        put_uint(fd, tmp, r / 10 + 922337203685477580 + rem / 10)
        tmp[0] <- u8.wrap(48 + rem % 10)
        put(fd, tmp[..1])
        ret
    end
    i : uword <- tmp.len
    m : u64 <- n
    if m == 0
        i <- i - 1
        tmp[i] <- 48
    end
    while m > 0
        i <- i - 1
        tmp[i] <- u8.wrap(48 + m % 10)
        m <- m / 10
    end
    put(fd, tmp[i..])
end

proc read_all(z: zone, cap: u64) -> view u8
    -- Reads stdin into cap bytes of the zone; the view covers what was read.
    permit os.syscall
    buf := z.bytes(cap)
    n : u64 <- 0
    while n < cap
        r := os.syscall(0, 0, buf.addr + n, cap - n)
        if r <= 0
            break
        end
        n <- n + u64.bits(r)
    end
    ret buf[..n]
end
