module olic.oir
-- OIR (docs/OIR_SPEC.md): the instruction stream `olic` builds from the typed
-- body, the arenas the whole back end works in, and the printer of both block
-- forms — `--show-oir` and `--show-ssa`.
--
-- What this file is, precisely. It emits one instruction per value, in
-- evaluation order, with labels and jumps: the stream `compiler/cfg.oli` cuts
-- into the basic blocks of §3 and `compiler/ssa.oli` rewrites into the SSA
-- form with phi nodes. Every instruction of §4 that the subset below needs is
-- here and carries the same operands. `label` is the one addition, and it
-- survives only as long as the stream does: a block is the label.
--
-- A value is its instruction's index. A two-word value (a view) is two
-- instructions: `gen_expr` returns the address and leaves the length in
-- `ob.lastlen`, the same pairing `oli1` uses in rax/rdx.
--
-- The subset: procedures with SysV parameters and a result (a view result is
-- a pair), integer literals, characters, `true`/`false`, module constants,
-- string literals (statics), locals (bind, place, store), the arithmetic,
-- bit, shift and comparison operators, `-`/`~`/`not`, the short-circuiting
-- `and`/`or`, the explicit conversions, `if`/`elif`/`else`, `while`, `loop`,
-- `break`, `continue`, calls, `os.syscall`, zones from every source of
-- OIR_SPEC §4 (`zone z SIZE` from the operating system, `at ADDR`, `from` a
-- parent zone or a buffer, one inside another; `z.bytes(n)`, `z.try_bytes(n)`,
-- `z.make(Name)`; released at `end` and on every `ret`, `fail`, `break` or
-- `continue` that leaves the block), views (`v[i]`, `v[i] <- x`,
-- `v[a..b]`, `v[..b]`, `v[a..]`, `.addr`/`.len`) with an integer element,
-- `each` over a view, layouts (`Name.at(v)`, `Name.size`/`.align`, `r.f`
-- loads and stores of integer, view, ref, address and by-value layout
-- fields, `packed` and `align`), refs (`ref x` of a local or a field, as
-- parameters and results) and fallible results with an integer or `none`
-- error (`ret`/`fail` as the pair (tag, payload), `else fail`/`ret`/default,
-- `case … when ok [x] … when fail … / else …`), static places at module
-- level (`NAME : T [<- e]`, an array read as the view of its bytes), arrays
-- in a frame (`name : [N]T`, zero on declaration) and raw access `[p]`/
-- `[p] <- x` through an address.
-- A `choice` that fits eight bytes is its memory image in one word (ABI.md
-- §3): `fail VARIANT { f: e }` builds it, `case … when fail VARIANT { f }`
-- compares its tag byte and reads the fields back, `else fail` hands it on.
-- A `machine x64` block is `machine.in REG, %v` for each `in`, the block
-- (`machine x64`, assembled by compiler/asm.oli) and `%n = machine.out REG`
-- for each `out`, standing together in the stream.
-- A `T or E` the register pair cannot carry — a view, a layout or a wide
-- choice as the value, a layout or a wide choice as the failure — goes
-- through an area the caller owns, as a wide layout result does.
-- An element of an `mmio` view (`mem.mmio`) is `raw.load`/`raw.store` in
-- space `mmio` — printed `.mmio`, volatile for every pass (OIR_SPEC §1.4).
-- Anything else is refused with E0900 rather than approximated: an
-- aggregate constant, `each` or `Name.at` over device memory, and a
-- machine line the encoder does not know.
--
-- Plain arithmetic traps on overflow (design 0006), so every `+ - * / %` and
-- every `-x` carries the width of its type and the static that names its trap
-- site. `wrap(e)` clears the overflow site of every operator inside `e` and
-- keeps the width, which is what makes the result wrap; the two division
-- traps stay, because neither a zero divisor nor the most negative value over
-- -1 has a wrapped answer to name.
-- `sat(e)` clamps every operator inside `e` to the range of its type, and
-- `checked(e)` answers `T or Overflow` — the value when nothing inside `e`
-- overflowed, the failure otherwise — both from the same flag the trap would
-- have read (`gen_mode_bin`). `docs/MACHINE_MODEL.md` §4 fixes the trap
-- message: one per kind and line, built here where the module and the line
-- are in hand, written by the routine `compiler/x64.oli` emits when a site
-- exists.

-- The frame words a local owns: an integer one, a view two (address and
-- length), a zone three (base, cursor and limit), an array `[N]T` as many as
-- its bytes need. `gen_proc` lays the locals of each procedure out in order
-- and `local_off` gives each its first word.
LOCOFF_MAX := 8192
-- Zones open at once in one procedure: kind, triple and parent per entry.
ZSTK_MAX := 64
-- The hash table of common-subexpression elimination: heads, chained
-- through one cell per instruction.
CSE_H := 65536
CSE_MASK := 65535
-- The tables of a `machine x64` block (compiler/asm.oli): local labels and
-- the references to them, fixups for the ELF writer, and the blocks
-- themselves for `--show-asm`.
MLAB_MAX := 4096
MFIX_MAX := 65536
MBLK_MAX := 65536
-- "no register" in an operand record's base or index.
NOREG := 16

-- The arenas are sized for the compiler's own source and several times over
-- (design 0022: `olic` must compile `olic`). The zone they come from is
-- mapped lazily, so a limit costs nothing until a program needs it.
INS_MAX := 2097152
OPROC_MAX := 8192
STAT_MAX := 32768
DATA_MAX := 4194304
CODE_MAX := 16777216

-- Opcodes. The names follow OIR_SPEC §4. `label` and `arg` are the two the
-- stream adds: a label becomes a block, and the argument markers are what a
-- call reads its operands from while the lowering has no register allocator.
O_CONST := 1
O_SADDR := 2
O_SLEN := 3
O_LOAD := 4
O_STORE := 5
O_BIN := 6
O_UN := 7
O_TRUNC := 8
O_ARG := 9
O_CALL := 10
O_SYSCALL := 11
O_RET := 12
O_LABEL := 13
O_JMP := 14
O_BRANCH := 15
O_PARAM := 16
O_PHI := 17
O_TRAP := 18
-- An instruction a pass removed. It keeps its index, because a value is its
-- index and renumbering the stream would mean rewriting every operand in it.
O_DEAD := 19
-- Memory: the address of a place, raw access at an address, the checks that
-- make a view access safe, and the three zone operations (OIR_SPEC §4).
O_FADDR := 20
O_RLOAD := 21
O_RSTORE := 22
O_CHKB := 23
O_CHKR := 24
O_ZNEW := 25
O_ZEND := 26
O_ZALLOC := 27
-- The second register of the pair a view-returning call answers with.
O_RDX := 28
-- `check.align %addr, N`: a `Name.at` over a view whose address is not a
-- multiple of the layout's alignment traps `misaligned`.
O_CHKA := 29
-- `addr.of data.k`: a static place in the writable segment (ABI.md §7).
O_DADDR := 30
-- `ovf.of %v`: 1 when the operation `%v`, the instruction just before it,
-- overflowed the word — the flag the machine set, read before anything
-- else can set it. The `checked` and `sat` modes of a 64-bit operation.
O_OVF := 31
-- The other sources of a zone (OIR_SPEC §4): `zone.new.raw %t, %size, %addr`
-- lays the triple over memory that already exists — an address the program
-- named, or a buffer whose length `check.range` proved — and releases
-- nothing; `zone.new.from %t, %size, %parent` carves it from the cursor of an
-- enclosing zone, with the parent's `zone_exhausted` trap, and
-- `zone.end.from %t, %parent` gives the parent its cursor back.
O_ZRAW := 32
O_ZFROM := 33
O_ZENDF := 34
-- A `machine x64` block (design 0009): `machine.in REG, %v` names a value
-- loaded into a register just before the block, `machine x64` is the block
-- itself — its bytes come from compiler/asm.oli at lowering time — and
-- `%n = machine.out REG` is what a register holds right after it. The three
-- stand together in the stream, the ins before, the outs after.
O_MIN := 35
O_MACHINE := 36
O_MOUT := 37
-- `cpu.halt()`, `cpu.pause()`, `cpu.interrupts(off)`, `cpu.interrupts(on)`
-- (design 0015): one instruction each — `hlt`, `pause`, `cli`, `sti`;
-- `val` (0..3) says which.
O_CPU := 38
-- `hw.load port.uN %p` and `hw.store port.uN %p, %v` (design 0015): an I/O
-- port read or written at the width `b` (load) or `c` (store) names, in
-- bytes; volatile, class KERNEL, never removed or merged.
O_HWLOAD := 39
O_HWSTORE := 40
-- `hw.load arch.x64.crN` and `hw.store arch.x64.crN, %v` (design 0015): a
-- control register read into a value or written from one; `val` is N.
O_CRLOAD := 41
O_CRSTORE := 42
-- `atomic.OP.W %addr, %v[, %d] ORDER` (MACHINE_MODEL.md §5): `bop` is the
-- operation (0 load, 1 store, 2 add, 3 sub, 4 and, 5 or, 6 xor, 7 exchange,
-- 8 cas), `c` the width in bytes plus 16 when signed, `w` the order, `val`
-- the value swapped in by `cas`; the value is what was there. `cpu.fence
-- ORDER` is a barrier alone.
O_ATOMIC := 43
O_FENCE := 44
-- `mem.copy %dst, %src, %n`, `mem.set %dst, %b, %n`, `mem.zero %dst, %n`,
-- `mem.secure_zero %dst, %n` (OIR_SPEC §4): `bop` says which (0..3), `a`
-- the destination address, `b` the source address or the byte (the
-- destination again for zero), `val` the count. Never removed.
O_MEMOP := 45
-- The hardware places and commands of design 0015 beyond ports and control
-- registers: `hw.load cpu.stack|cpu.frame|arch.x64.tr`, `hw.cmd cpu.tsc`
-- (O_HWRD, `val` says which: 3 stack, 4 frame, 7 tr, 8 tsc); `hw.store
-- cpu.stack|cpu.frame|arch.x64.gdt|idt|tr, %v`, `hw.cmd cpu.jump %v`
-- (O_HWWR, `a` the value, `val` 3, 4, 5, 6, 7, 9); `hw.load arch.x64.msr %n`
-- (O_MSRRD, `a` the number); `hw.store arch.x64.msr %n, %v` (O_MSRWR);
-- `hw.cmd cpu.id %leaf, %area` (O_CPUID: the four registers into the
-- area, a `core.CpuId`); `hw.cmd cpu.call NAME` (O_HWCALL, `c` the
-- procedure); `hw.cmd arch.x64.segments %code, %data` (O_SEGS: `retfq`
-- to the next instruction with the code selector, then ds, es, ss, fs and
-- gs loaded with the data selector). All volatile, class KERNEL.
O_HWRD := 46
O_HWWR := 47
O_MSRRD := 48
O_MSRWR := 49
O_CPUID := 50
O_HWCALL := 51
O_SEGS := 52
-- Floats (MACHINE_MODEL.md 2): a float value is its IEEE-754 bits in a
-- word (binary32 zero-extended), moved to xmm0/xmm1 for the operation.
-- `fop.W %a, %b` (O_FBIN, `c` the B_* code of + - * /, `val` 32 or 64);
-- `fcmp.COND.W %a, %b` (O_FCMP, `c` B_EQ..B_GE, a bool); `fcvt.KIND %a`
-- (O_FCVT, `c`: 0 signed integer to float, 1 u64 to float, 2 float to
-- s64 truncated, 3 f32 to f64, 4 f64 to f32 rounded, 5 float to u64
-- truncated; `val` the float's width); `fret %a` (O_FRET: the value into
-- xmm0 before the `ret` of a float result) and `fres` (O_FRES: xmm0 right
-- after the call of a procedure with a float result), SysV (ABI.md 1).
O_FBIN := 53
O_FCMP := 54
O_FCVT := 55
O_FRET := 56
O_FRES := 57
-- Vectors (design 0024): `vop.OP.T %a, %b` (O_VBIN: the two sixteen-byte
-- operands at the addresses a and b, `c` the B_* operator, `val` the lane
-- code, `w` the frame word of the result area; the value is its address)
-- and `vcmp.OP.T %a, %b` (O_VCMP: a bool, the whole vector equal or not).
O_VBIN := 58
O_VCMP := 59

-- A local as the debug information describes it (compiler/elf.oli): the
-- procedure, its module and name token, a type class (DV_BASE and on) with
-- a code and a count, its first frame word, how many words, whether it
-- kept them through `mem2reg`, and whether it is a parameter.
DVAR_MAX := 32768
DV_N := 10
DV_Q := 0
DV_MOD := 1
DV_NAME := 2
DV_KIND := 3
DV_CODE := 4
DV_COUNT := 5
DV_OFF := 6
DV_WORDS := 7
DV_KEPT := 8
DV_PARAM := 9
DVK_BASE := 1
DVK_PTR := 2
DVK_ARRAY := 3
DVK_LAYOUT := 4
DVK_VIEW := 5
DVK_LREF := 6
-- The arithmetic modes: plain arithmetic traps, `wrap` wraps, `sat` clamps,
-- `checked` answers with a failure (design 0006).
AM_TRAP := 0
AM_WRAP := 1
AM_SAT := 2
AM_CHECKED := 3
DAT_MAX := 8192
SECT_MAX := 64
SNAME_MAX := 4096
DMAP_MAX := 65536

-- Arena limits of the block form.
BLK_MAX := 524288
PRED_MAX := 1048576
PHIARG_MAX := 1048576
LBLMAP_MAX := 2097152
DF_MAX := 1048576
-- One procedure's places (two words a local, then the compiler-made ones) and
-- the value of each of them at the end of each of its blocks.
SLOT_MAX := 4096
ENDDEF_MAX := 4194304

B_ADD := 1
B_SUB := 2
B_MUL := 3
B_DIV := 4
B_REM := 5
B_AND := 6
B_OR := 7
B_XOR := 8
B_SHL := 9
B_SHR := 10
B_EQ := 11
B_NE := 12
B_LT := 13
B_LE := 14
B_GT := 15
B_GE := 16

U1_NEG := 1
U1_BNOT := 2
U1_LNOT := 3

-- Trap kinds, numbered as `core.TrapKind` declares them.
TK_BOUNDS := 1
TK_OVF := 2
TK_DIV := 3
TK_MISALIGN := 4
TK_ZONE := 5
TMSG_MAX := 32768

-- Why a check could be removed (OIR_SPEC §6 and §8.7: never without one).
PR_CONST := 1
PR_DIVISOR := 2
PR_UNREACH := 3
PR_LOOP := 4
-- Dominance by an equal check (OIR_SPEC §6): the same operation with the
-- same check, or the same check, stands on every path here and trapped
-- first if this one would have.
PR_DOM := 5
PROOF_MAX := 1048576

layout Ins
    op : u64
    bop : u64
    a : u64
    b : u64
    c : u64
    val : u64
    node : u64
    w : u64
    site : u64
    site2 : u64
end

layout TMsg
    kind : u64
    line : u64
    stat : u64
    mod : u64
    fstat : u64
end

layout OProc
    pi : u64
    first : u64
    n : u64
    nloc : u64
    nval : u64
    isentry : u64
    codepos : u64
    codeend : u64
    mi : u64
    bfirst : u64
    nblk : u64
    ntmp : u64
    nphi : u64
    nwords : u64
    nsave : u64
    nocalls : u64
    isnever : u64
    boot : u64
    isint : u64
    isextern : u64
    symidx : u64
    sect : u64
end

layout Stat
    off : u64
    len : u64
    dead : u64
    alg : u64
end

layout Dat
    -- A static place: its offset in the writable segment, its size, and
    -- whether it starts as bytes in the file (`.data`) or as zero (`.bss`);
    -- `sect` is its section group (a zero static's), 0 for `.data`.
    off : u64
    size : u64
    init : u64
    val : u64
    sect : u64
end

layout Sect
    -- A section group of the image (FREESTANDING.md §2): its name in
    -- `ob.snames`, its kind (0 code, 1 zero statics), where it starts and
    -- how long it is — in the code for kind 0, in the writable segment for
    -- kind 1 — in the order the profile's `sections` list gives, then as
    -- first seen.
    noff : u64
    nlen : u64
    kind : u64
    start : u64
    size : u64
end

layout Blk
    -- A basic block (OIR_SPEC §3): the instructions `first .. first + n`, then
    -- exactly one terminator, which is held here rather than in the stream so
    -- that a block that falls through to a label can be given the `jump` the
    -- form requires without inserting an instruction and renumbering every
    -- value after it.
    first : u64
    n : u64
    top : u64
    ta : u64
    tb : u64
    tc : u64
    pfirst : u64
    npred : u64
    idom : u64
    rpo : u64
    dffirst : u64
    ndf : u64
    dead : u64
end

layout PhiArg
    blk : u64
    val : u64
end

layout Proof
    -- The removal of one check: where it stood, which of the two sites of
    -- that instruction it was, the value it named, and why it went.
    ins : u64
    kind : u64
    val : u64
    why : u64
end

layout Cell
    v : u64
end

layout Oir
    -- The locals of every procedure for the debug information: nine cells
    -- each (DV_*), `ndvar` of them; `dbgframe` from `-- debug: frame`.
    dvars : rw view u8
    ndvar : u64
    dbgframe : u64
    -- `F.bits(x)` in progress: the integer's bits are the float's.
    convbits : u64
    ins : rw view u8
    procs : rw view u8
    stats : rw view u8
    dats : rw view u8
    dmap : rw view u8
    dbytes : rw view u8
    tmsgs : rw view u8
    data : rw view u8
    code : rw view u8
    blks : rw view u8
    preds : rw view u8
    phiargs : rw view u8
    lblmap : rw view u8
    iblk : rw view u8
    order : rw view u8
    work : rw view u8
    df : rw view u8
    dfmark : rw view u8
    vmap : rw view u8
    cur : rw view u8
    noprom : rw view u8
    live : rw view u8
    livein : rw view u8
    enddef : rw view u8
    phin : rw view u8
    wl : rw view u8
    proofs : rw view u8
    nins : u64
    nproc : u64
    nstat : u64
    ndat : u64
    dsize : u64
    bsize : u64
    ntmsg : u64
    ndata : u64
    ncode : u64
    nlabel : u64
    nblk : u64
    npred : u64
    nphiarg : u64
    nord : u64
    ndf : u64
    nslot : u64
    nproof : u64
    cfgdirty : u64
    lastlen : u64
    lastpay : u64
    curp : u64
    curloc : u64
    curwords : u64
    locoff : rw view u8
    zstk : rw view u8
    cseh : rw view u8
    csen : rw view u8
    mops : rw view u8
    mlab : rw view u8
    mref : rw view u8
    mfix : rw view u8
    mblk : rw view u8
    mins : rw view u8
    fstats : rw view u8
    rmap : rw view u8
    base : u64
    nmlab : u64
    nmref : u64
    nmfix : u64
    nmblk : u64
    mdry : u64
    curtmp : u64
    curnode : u64
    zdepth : u64
    zloop : u64
    brk : u64
    cont : u64
    nerr : u64
    callstk : u64
    sretv : u64
    sretslot : u64
    sretsize : u64
    curint : u64
    widefall : u64
    paywide : u64
    entryp : u64
    sects : rw view u8
    nsect : u64
    snames : rw view u8
    nsname : u64
    amode : u64
    ovfacc : u64
    mbits : u64
    msg : u64
    vfail : u64
end

layout Opnd
    -- One operand of a machine instruction, as compiler/asm.oli reads it.
    kind : u64
    reg : u64
    width : u64
    imm : u64
    base : u64
    index : u64
    scale : u64
    disp : u64
    hasdisp : u64
    sym : u64
    issym : u64
    ro : u64
    node : u64
end

proc oir_new(z: zone) -> rw ref Oir
    ob := z.make(Oir)
    ob.ins <- z.bytes(INS_MAX * Ins.size)
    ob.procs <- z.bytes(OPROC_MAX * OProc.size)
    ob.stats <- z.bytes(STAT_MAX * Stat.size)
    ob.dats <- z.bytes(DAT_MAX * Dat.size)
    ob.dmap <- z.bytes(DMAP_MAX * Cell.size)
    ob.sects <- z.bytes(SECT_MAX * Sect.size)
    ob.snames <- z.bytes(SNAME_MAX)
    ob.dbytes <- z.bytes(DATA_MAX)
    ob.tmsgs <- z.bytes(TMSG_MAX * TMsg.size)
    ob.data <- z.bytes(DATA_MAX)
    ob.code <- z.bytes(CODE_MAX)
    ob.blks <- z.bytes(BLK_MAX * Blk.size)
    ob.preds <- z.bytes(PRED_MAX * Cell.size)
    ob.phiargs <- z.bytes(PHIARG_MAX * PhiArg.size)
    ob.lblmap <- z.bytes(LBLMAP_MAX * Cell.size)
    ob.iblk <- z.bytes(INS_MAX * Cell.size)
    ob.order <- z.bytes(BLK_MAX * Cell.size)
    ob.work <- z.bytes(BLK_MAX * Cell.size)
    ob.df <- z.bytes(DF_MAX * Cell.size)
    ob.dfmark <- z.bytes(BLK_MAX * Cell.size)
    ob.vmap <- z.bytes(INS_MAX * Cell.size)
    ob.cur <- z.bytes(SLOT_MAX * Cell.size)
    ob.noprom <- z.bytes(SLOT_MAX * Cell.size)
    ob.dvars <- z.bytes(DVAR_MAX * DV_N * Cell.size)
    ob.live <- z.bytes(SLOT_MAX * Cell.size)
    ob.livein <- z.bytes(ENDDEF_MAX * Cell.size)
    ob.enddef <- z.bytes(ENDDEF_MAX * Cell.size)
    ob.phin <- z.bytes(ENDDEF_MAX * Cell.size)
    ob.wl <- z.bytes(BLK_MAX * Cell.size)
    ob.proofs <- z.bytes(PROOF_MAX * Proof.size)
    ob.locoff <- z.bytes(LOCOFF_MAX * Cell.size)
    ob.zstk <- z.bytes(ZSTK_MAX * 3 * Cell.size)
    ob.cseh <- z.bytes(CSE_H * Cell.size)
    ob.csen <- z.bytes(INS_MAX * Cell.size)
    ob.mops <- z.bytes(8 * Opnd.size)
    ob.mlab <- z.bytes(MLAB_MAX * 2 * Cell.size)
    ob.mref <- z.bytes(MLAB_MAX * 2 * Cell.size)
    ob.mfix <- z.bytes(MFIX_MAX * 3 * Cell.size)
    ob.mblk <- z.bytes(MBLK_MAX * 5 * Cell.size)
    ob.mins <- z.bytes(64 * 3 * Cell.size)
    ob.fstats <- z.bytes(1024 * Cell.size)
    ob.rmap <- z.bytes(DMAP_MAX * Cell.size)
    oir_reset(ob)
    ret ob
end

proc oir_reset(ob: rw ref Oir)
    -- Everything the arenas hold, emptied. `oir_new` starts here, and a
    -- driver that builds the same program more than once starts here again.
    ob.nins <- 0
    ob.nproc <- 0
    ob.ndvar <- 0
    ob.nstat <- 0
    ob.ndat <- 0
    ob.dsize <- 0
    ob.bsize <- 0
    ob.ntmsg <- 0
    ob.ndata <- 0
    ob.ncode <- 0
    ob.nlabel <- 0
    ob.nblk <- 0
    ob.npred <- 0
    ob.nphiarg <- 0
    ob.nord <- 0
    ob.ndf <- 0
    ob.nslot <- 0
    ob.nproof <- 0
    ob.cfgdirty <- 0
    ob.lastlen <- 0
    ob.lastpay <- 0
    ob.curp <- 0
    ob.curloc <- 0
    ob.curwords <- 0
    ob.curtmp <- 0
    ob.curnode <- 0
    ob.nmlab <- 0
    ob.nmref <- 0
    ob.nmfix <- 0
    ob.nmblk <- 0
    ob.mdry <- 0
    ob.base <- 4194304
    r : u64 <- 0
    while r < DMAP_MAX
        cell_set(ob.rmap, r, 0)
        r <- r + 1
    end
    f : u64 <- 0
    while f < 1024
        cell_set(ob.fstats, f, 0)
        f <- f + 1
    end
    ob.zdepth <- 0
    ob.zloop <- 0
    ob.brk <- 0
    ob.cont <- 0
    ob.nerr <- 0
    ob.callstk <- 0
    ob.sretv <- 0
    ob.sretslot <- 0
    ob.sretsize <- 0
    ob.curint <- 0
    ob.widefall <- 0
    ob.paywide <- 0
    ob.entryp <- 0
    ob.nsect <- 0
    ob.nsname <- 0
    ob.amode <- 0
    ob.ovfacc <- 0
    ob.mbits <- 0
    ob.msg <- 0
    ob.vfail <- 0
end

proc ins_at(ob: ref Oir, i: u64) -> rw ref Ins
    t := ob.ins
    off := i * Ins.size
    ret Ins.at(t[off..off + Ins.size])
end

proc oproc_at(ob: ref Oir, i: u64) -> rw ref OProc
    t := ob.procs
    off := i * OProc.size
    ret OProc.at(t[off..off + OProc.size])
end

proc tmsg_at(ob: ref Oir, i: u64) -> rw ref TMsg
    t := ob.tmsgs
    off := i * TMsg.size
    ret TMsg.at(t[off..off + TMsg.size])
end

proc stat_at(ob: ref Oir, i: u64) -> rw ref Stat
    t := ob.stats
    off := i * Stat.size
    ret Stat.at(t[off..off + Stat.size])
end

proc ins_line(pg: ref Prog, mi: u64, node: u64) -> u64
    -- The source line an instruction came from: that of the statement's
    -- leftmost token, 0 for the instructions no statement produced (the
    -- parameters, the phis).
    if node == 0
        ret 0
    end
    cx := mod_ctx(pg, mi)
    t := ctok(cx, first_tok(pg, mi, node))
    ret t.line
end

proc sect_at(ob: ref Oir, i: u64) -> rw ref Sect
    t := ob.sects
    off := i * Sect.size
    ret Sect.at(t[off..off + Sect.size])
end

proc sect_name(ob: ref Oir, i: u64) -> view u8
    s := sect_at(ob, i)
    t := ob.snames
    ret t[s.noff..s.noff + s.nlen]
end

proc sect_find(ob: ref Oir, name: view u8, kind: u64) -> word
    i : u64 <- 0
    while i < ob.nsect
        s := sect_at(ob, i)
        if s.kind == kind
            if view_eq(sect_name(ob, i), name)
                ret word.bits(i)
            end
        end
        i <- i + 1
    end
    ret -1
end

proc sect_add(ob: rw ref Oir, name: view u8, kind: u64) -> u64
    -- A section group, once: its index.
    permit os.syscall
    f := sect_find(ob, name, kind)
    if f >= 0
        ret u64.bits(f)
    end
    if ob.nsect >= SECT_MAX
        put(2, "olic: section table exhausted\n")
        os.syscall(60, 4)
    end
    if ob.nsname + name.len > SNAME_MAX
        put(2, "olic: section names exhausted\n")
        os.syscall(60, 4)
    end
    t := ob.snames
    i : u64 <- 0
    while i < name.len
        t[ob.nsname + i] <- name[i]
        i <- i + 1
    end
    s := sect_at(ob, ob.nsect)
    s.noff <- ob.nsname
    s.nlen <- name.len
    s.kind <- kind
    s.start <- 0
    s.size <- 0
    ob.nsname <- ob.nsname + name.len
    ob.nsect <- ob.nsect + 1
    ret ob.nsect - 1
end

proc order_sections(pg: ref Prog, ob: rw ref Oir)
    -- The groups of the image: the profile's `sections` in its order first
    -- (those a procedure or a zero static uses, `.text` and `.bss` always),
    -- then every other name as first seen — `.text.boot` before `.text`
    -- without a profile, as it always was.
    if pg.hasprof == 1
        rank : u64 <- 0
        while rank < SECT_MAX
            any : u64 <- 0
            q : u64 <- 0
            while q < pg.nproc
                nm := proc_sect(pg, q)
                if profile_sect_index(pg, nm) == word.bits(rank)
                    sect_add(ob, nm, 0)
                    any <- 1
                end
                q <- q + 1
            end
            vi : u64 <- 0
            while vi < pg.nval
                v := val_at(pg, vi)
                if v.kind == 1
                    if static_in_text(pg, vi) == 0
                        if val_has_init(pg, vi) == 0
                            nm2 := static_sect(pg, vi, 0)
                            if profile_sect_index(pg, nm2) == word.bits(rank)
                                sect_add(ob, nm2, 1)
                                any <- 1
                            end
                        end
                    end
                end
                vi <- vi + 1
            end
            rank <- rank + 1
        end
    else
        q0 : u64 <- 0
        while q0 < pg.nproc
            if view_eq(proc_sect(pg, q0), ".text.boot")
                sect_add(ob, ".text.boot", 0)
            end
            q0 <- q0 + 1
        end
    end
    sect_add(ob, ".text", 0)
    q2 : u64 <- 0
    while q2 < pg.nproc
        sect_add(ob, proc_sect(pg, q2), 0)
        q2 <- q2 + 1
    end
    vi2 : u64 <- 0
    while vi2 < pg.nval
        v2 := val_at(pg, vi2)
        if v2.kind == 1
            if static_in_text(pg, vi2) == 0
                if val_has_init(pg, vi2) == 0
                    sect_add(ob, static_sect(pg, vi2, 0), 1)
                end
            end
        end
        vi2 <- vi2 + 1
    end
end

proc val_has_init(pg: ref Prog, vi: u64) -> u64
    v := val_at(pg, vi)
    cx := mod_ctx(pg, v.mod)
    vn := node_at(cx, v.node)
    if vn.sub == 1
        ret 1
    end
    ret 0
end

proc dat_at(ob: ref Oir, i: u64) -> rw ref Dat
    t := ob.dats
    off := i * Dat.size
    ret Dat.at(t[off..off + Dat.size])
end

proc blk_at(ob: ref Oir, i: u64) -> rw ref Blk
    t := ob.blks
    off := i * Blk.size
    ret Blk.at(t[off..off + Blk.size])
end

proc phiarg_at(ob: ref Oir, i: u64) -> rw ref PhiArg
    t := ob.phiargs
    off := i * PhiArg.size
    ret PhiArg.at(t[off..off + PhiArg.size])
end

proc proof_at(ob: ref Oir, i: u64) -> rw ref Proof
    t := ob.proofs
    off := i * Proof.size
    ret Proof.at(t[off..off + Proof.size])
end

proc add_proof(ob: rw ref Oir, i: u64, kind: u64, val: u64, why: u64)
    -- A check may leave only with one of these attached (§8.7). The printer
    -- shows it where the check stood.
    permit os.syscall
    if ob.nproof >= PROOF_MAX
        put(2, "olic: proof table exhausted\n")
        os.syscall(60, 4)
    end
    pr := proof_at(ob, ob.nproof)
    pr.ins <- i
    pr.kind <- kind
    pr.val <- val
    pr.why <- why
    ob.nproof <- ob.nproof + 1
end

proc kill_ins(ob: rw ref Oir, i: u64)
    -- An instruction a pass removed. Its checks must already have gone with a
    -- proof, so there is nothing left here to lose.
    ins := ins_at(ob, i)
    ins.op <- O_DEAD
    ins.site <- 0
    ins.site2 <- 0
end

proc live_blk(ob: ref Oir, b: u64) -> word
    -- A block a pass removed is not part of the program any more: it is not
    -- printed, not lowered, not verified, and the edges out of it are not
    -- edges. Being unreachable is not the same thing — the stream the front
    -- end emits contains unreachable blocks, and `--show-oir` shows them.
    bk := blk_at(ob, b)
    if bk.dead == 1
        ret 0
    end
    ret 1
end

proc cell_at(t: rw view u8, i: u64) -> rw ref Cell
    off := i * Cell.size
    ret Cell.at(t[off..off + Cell.size])
end

proc cell_get(t: rw view u8, i: u64) -> u64
    c := cell_at(t, i)
    ret c.v
end

proc cell_set(t: rw view u8, i: u64, v: u64)
    c := cell_at(t, i)
    c.v <- v
end

proc op_uses_a(op: u64) -> word
    if op == O_FCVT
        ret 1
    end
    if op == O_FRET
        ret 1
    end
    -- Which field of an instruction names a value, in one place: the walks
    -- that verify, count, rewrite and rebuild operands all ask here.
    if op == O_BIN
        ret 1
    end
    if op == O_UN
        ret 1
    end
    if op == O_TRUNC
        ret 1
    end
    if op == O_ARG
        ret 1
    end
    if op == O_RLOAD
        ret 1
    end
    if op == O_RSTORE
        ret 1
    end
    if op == O_HWLOAD
        ret 1
    end
    if op == O_HWSTORE
        ret 1
    end
    if op == O_CRSTORE
        ret 1
    end
    if op == O_ATOMIC
        ret 1
    end
    if op == O_MEMOP
        ret 1
    end
    if op == O_HWWR
        ret 1
    end
    if op == O_MSRRD
        ret 1
    end
    if op == O_MSRWR
        ret 1
    end
    if op == O_SEGS
        ret 1
    end
    if op == O_FBIN
        ret 1
    end
    if op == O_FCMP
        ret 1
    end
    if op == O_VBIN
        ret 1
    end
    if op == O_VCMP
        ret 1
    end
    if op == O_CPUID
        ret 1
    end
    if op == O_CHKB
        ret 1
    end
    if op == O_CHKR
        ret 1
    end
    if op == O_ZNEW
        ret 1
    end
    if op == O_ZEND
        ret 1
    end
    if op == O_ZALLOC
        ret 1
    end
    if op == O_CHKA
        ret 1
    end
    if op == O_OVF
        ret 1
    end
    if op == O_ZRAW
        ret 1
    end
    if op == O_ZFROM
        ret 1
    end
    if op == O_ZENDF
        ret 1
    end
    if op == O_MIN
        ret 1
    end
    ret 0
end

proc op_uses_b(op: u64) -> word
    if op == O_BIN
        ret 1
    end
    if op == O_STORE
        ret 1
    end
    if op == O_RSTORE
        ret 1
    end
    if op == O_HWSTORE
        ret 1
    end
    if op == O_ATOMIC
        ret 1
    end
    if op == O_MEMOP
        ret 1
    end
    if op == O_MSRWR
        ret 1
    end
    if op == O_SEGS
        ret 1
    end
    if op == O_FBIN
        ret 1
    end
    if op == O_FCMP
        ret 1
    end
    if op == O_VBIN
        ret 1
    end
    if op == O_VCMP
        ret 1
    end
    if op == O_CPUID
        ret 1
    end
    if op == O_CHKB
        ret 1
    end
    if op == O_CHKR
        ret 1
    end
    if op == O_ZNEW
        ret 1
    end
    if op == O_ZALLOC
        ret 1
    end
    if op == O_ZRAW
        ret 1
    end
    if op == O_ZFROM
        ret 1
    end
    if op == O_ZENDF
        ret 1
    end
    ret 0
end

proc op_uses_val(op: u64) -> word
    if op == O_CHKR
        ret 1
    end
    if op == O_ATOMIC
        ret 1
    end
    if op == O_ZRAW
        ret 1
    end
    if op == O_ZFROM
        ret 1
    end
    if op == O_MEMOP
        ret 1
    end
    ret 0
end

proc is_term(op: u64) -> word
    -- The three terminators this subset reaches (OIR_SPEC §3); `fail`, `trap`
    -- and `unreachable` arrive with the constructs that need them.
    if op == O_JMP
        ret 1
    end
    if op == O_BRANCH
        ret 1
    end
    if op == O_RET
        ret 1
    end
    ret 0
end

proc new_tmp(ob: rw ref Oir) -> u64
    -- A compiler-made place, past the locals: the one place `and`/`or` needs
    -- for the result two arms write. `mem2reg` promotes it to the phi that
    -- OIR_SPEC §3 wants there.
    t := ob.curtmp
    ob.curtmp <- t + 1
    ret ob.curwords + t
end

proc oir_err(ob: rw ref Oir, pg: rw ref Prog, mi: u64, code: u64, node: u64)
    ob.nerr <- ob.nerr + 1
    terr(pg, mi, code, node)
end

proc emit_ins(ob: rw ref Oir, op: u64, a: u64, b: u64, c: u64, val: u64) -> u64
    permit os.syscall
    n := ob.nins
    if n >= INS_MAX
        put(2, "olic: OIR arena exhausted\n")
        os.syscall(60, 4)
    end
    ins := ins_at(ob, n)
    ins.op <- op
    ins.bop <- 0
    ins.a <- a
    ins.b <- b
    ins.c <- c
    ins.val <- val
    ins.node <- ob.curnode
    ins.w <- 0
    ins.site <- 0
    ins.site2 <- 0
    ob.nins <- n + 1
    ret n
end

proc emit_bin(ob: rw ref Oir, bop: u64, a: u64, b: u64, signd: u64) -> u64
    n := emit_ins(ob, O_BIN, a, b, signd, 0)
    ins := ins_at(ob, n)
    ins.bop <- bop
    ret n
end

proc emit_un(ob: rw ref Oir, uop: u64, a: u64) -> u64
    n := emit_ins(ob, O_UN, a, 0, 0, 0)
    ins := ins_at(ob, n)
    ins.bop <- uop
    ret n
end

proc new_label(ob: rw ref Oir) -> u64
    l := ob.nlabel
    ob.nlabel <- l + 1
    ret l
end

-- Statics ---------------------------------------------------------------------

proc hexval(c: u64) -> u64
    if c >= 48
        if c <= 57
            ret c - 48
        end
    end
    if c >= 97
        if c <= 102
            ret c - 87
        end
    end
    ret c - 55
end

proc data_byte(ob: rw ref Oir, v: u64)
    permit os.syscall
    d := ob.data
    n := ob.ndata
    if n >= DATA_MAX
        put(2, "olic: static data arena exhausted\n")
        os.syscall(60, 4)
    end
    d[n] <- u8.wrap(v)
    ob.ndata <- n + 1
end

proc open_static(ob: rw ref Oir) -> u64
    -- A static built byte by byte rather than decoded from a token.
    permit os.syscall
    idx := ob.nstat
    if idx >= STAT_MAX
        put(2, "olic: static table exhausted\n")
        os.syscall(60, 4)
    end
    st := stat_at(ob, idx)
    st.off <- ob.ndata
    st.dead <- 0
    st.alg <- 1
    ob.nstat <- idx + 1
    ret idx
end

proc close_static(ob: rw ref Oir, idx: u64)
    st := stat_at(ob, idx)
    st.len <- ob.ndata - st.off
end

proc data_view(ob: rw ref Oir, s: view u8)
    i : u64 <- 0
    while i < s.len
        data_byte(ob, s[i])
        i <- i + 1
    end
end

proc data_uint(ob: rw ref Oir, v: u64)
    if v >= 10
        data_uint(ob, v / 10)
    end
    data_byte(ob, 48 + v % 10)
end

proc trap_kind_name(k: u64) -> view u8
    if k == TK_BOUNDS
        ret "bounds"
    end
    if k == TK_DIV
        ret "div_zero"
    end
    if k == TK_MISALIGN
        ret "misaligned"
    end
    if k == TK_ZONE
        ret "zone_exhausted"
    end
    ret "overflow"
end

proc trap_static(pg: ref Prog, ob: rw ref Oir, mi: u64, kind: u64, n: u64) -> u64
    -- `trap: <kind> at <module>:<line>` (MACHINE_MODEL.md §4). One static per
    -- kind and line: the sites on a line share it, and the routine that prints
    -- it needs no formatting code at all.
    permit os.syscall
    cx := mod_ctx(pg, mi)
    t := ctok(cx, first_tok(pg, mi, n))
    line := t.line
    i : u64 <- 0
    while i < ob.ntmsg
        m := tmsg_at(ob, i)
        if m.kind == kind
            if m.line == line
                ret m.stat
            end
        end
        i <- i + 1
    end
    if ob.ntmsg >= TMSG_MAX
        put(2, "olic: trap message table exhausted\n")
        os.syscall(60, 4)
    end
    idx := open_static(ob)
    data_view(ob, "trap: ")
    data_view(ob, trap_kind_name(kind))
    data_view(ob, " at ")
    data_view(ob, cx.file)
    data_view(ob, ":")
    data_uint(ob, line)
    data_byte(ob, 10)
    close_static(ob, idx)
    m2 := tmsg_at(ob, ob.ntmsg)
    m2.kind <- kind
    m2.line <- line
    m2.stat <- idx
    m2.mod <- mi
    m2.fstat <- 0
    if pg.fstanding == 1
        -- Freestanding: the `traps` procedure receives a `core.Site`, whose
        -- file is this static, one per module.
        m2.fstat <- file_static(ob, cx, mi) + 1
    end
    ob.ntmsg <- ob.ntmsg + 1
    ret idx
end

proc file_static(ob: rw ref Oir, cx: ref Ctx, mi: u64) -> u64
    if mi < 1024
        have := cell_get(ob.fstats, mi)
        if have > 0
            ret have - 1
        end
    end
    idx := open_static(ob)
    data_view(ob, cx.file)
    close_static(ob, idx)
    if mi < 1024
        cell_set(ob.fstats, mi, idx + 1)
    end
    ret idx
end

proc add_static(ob: rw ref Oir, raw: view u8) -> u64
    -- `raw` is the string token including its quotes; the escapes of syntax
    -- §2.4 are decoded here, where the bytes are finally needed.
    permit os.syscall
    idx := ob.nstat
    if idx >= STAT_MAX
        put(2, "olic: static table exhausted\n")
        os.syscall(60, 4)
    end
    st := stat_at(ob, idx)
    st.off <- ob.ndata
    st.dead <- 0
    st.alg <- 1
    i : u64 <- 1
    last : u64 <- raw.len
    if last > 0
        last <- last - 1
    end
    while i < last
        c : u64 <- raw[i]
        if c == 92
            i <- i + 1
            e : u64 <- raw[i]
            if e == 110
                data_byte(ob, 10)
            elif e == 116
                data_byte(ob, 9)
            elif e == 114
                data_byte(ob, 13)
            elif e == 48
                data_byte(ob, 0)
            elif e == 120
                hi := hexval(raw[i + 1])
                lo := hexval(raw[i + 2])
                data_byte(ob, hi * 16 + lo)
                i <- i + 2
            else
                data_byte(ob, e)
            end
        else
            data_byte(ob, c)
        end
        i <- i + 1
    end
    st.len <- ob.ndata - st.off
    ob.nstat <- idx + 1
    ret idx
end

-- Static places (ABI.md §7) ----------------------------------------------------
-- A module-level `NAME : T [<- e]` is a place in the writable segment. The
-- ones with an initialiser come first and their bytes are in the file
-- (`.data`); the ones without follow as zero (`.bss`), which the kernel
-- gives for free. The item stage typed them; here they get an offset each.

proc type_bytes(pg: ref Prog, t: view u8) -> u64
    -- The size of a type from its canonical text: `[N]T` is N of `T`.
    if starts_with(t, "[")
        n : u64 <- 0
        i : u64 <- 1
        while i < t.len
            c := t[i]
            if c == 93
                ret n * type_bytes(pg, t[i + 1..])
            end
            n <- n * 10 + (u64(c) - 48)
            i <- i + 1
        end
        ret 0
    end
    if is_view_type(t) == 1
        ret 16
    end
    b := mem_bits(t)
    if b > 0
        ret u64.bits(b) / 8
    end
    if view_eq(t, "bool")
        ret 1
    end
    it := item_find(pg, unqual(t))
    if it >= 0
        item := item_at(pg, u64.bits(it))
        ret item.size
    end
    ret 8
end

proc collect_data(pg: rw ref Prog, ob: rw ref Oir)
    permit os.syscall
    i : u64 <- 0
    while i < pg.nval
        v := val_at(pg, i)
        if v.kind == 1
            if static_in_text(pg, i) == 1
                add_rodata(pg, ob, i)
            else
                add_data(pg, ob, i)
            end
        end
        if v.kind == 0
            -- An aggregate constant — `NAME : [N]T := { … }`, a layout
            -- constant — lives in the read-only segment, like a static
            -- placed there.
            if is_aggregate_const(pg, i) == 1
                add_rodata(pg, ob, i)
            end
        end
        i <- i + 1
    end
    -- The zero statics follow the initialised ones, section group by
    -- section group in the order `order_sections` settled, each at its
    -- alignment: the natural one of its size, or what an `align N` clause
    -- asks for.
    order_sections(pg, ob)
    g : u64 <- 0
    while g < ob.nsect
        sg := sect_at(ob, g)
        if sg.kind == 1
            first : u64 <- 1
            k : u64 <- 0
            while k < ob.ndat
                d := dat_at(ob, k)
                if d.init == 0
                    if view_eq(static_sect(pg, d.val, 0), sect_name(ob, g))
                        here := round_up(ob.dsize + ob.bsize, static_align(pg, d.val, d.size))
                        if first == 1
                            sg.start <- here
                            first <- 0
                        end
                        d.off <- here
                        d.sect <- g
                        ob.bsize <- here + d.size - ob.dsize
                    end
                end
                k <- k + 1
            end
            if first == 1
                sg.start <- ob.dsize + ob.bsize
            end
            sg.size <- ob.dsize + ob.bsize - sg.start
        end
        g <- g + 1
    end
end

proc is_aggregate_const(pg: ref Prog, vi: u64) -> word
    -- A constant of array or layout type (a view is not: its bytes are a
    -- string's, which is E0900 still).
    t := val_type(pg, vi)
    if starts_with(t, "[")
        ret 1
    end
    if layout_param(pg, t) > 0
        ret 1
    end
    ret 0
end

proc static_align(pg: ref Prog, vi: u64, size: u64) -> u64
    -- The alignment of a static place: `align N` when the declaration says
    -- so, else the largest of 1, 2, 4 and 8 that divides its size.
    v := val_at(pg, vi)
    cx := mod_ctx(pg, v.mod)
    al : u64 <- 1
    if size % 8 == 0
        al <- 8
    elif size % 4 == 0
        al <- 4
    elif size % 2 == 0
        al <- 2
    end
    k : u64 <- kid1(cx, v.node)
    while k != 0
        kn := node_at(cx, k)
        if kn.kind == N_CLAUSE
            if kn.sub == C_ALIGN
                c := node_at(cx, kid1(cx, k))
                if c.val > al
                    al <- c.val
                end
            end
        end
        k <- sibling(cx, k)
    end
    ret al
end

proc add_data(pg: rw ref Prog, ob: rw ref Oir, vi: u64)
    permit os.syscall
    v := val_at(pg, vi)
    cx := mod_ctx(pg, v.mod)
    vn := node_at(cx, v.node)
    if ob.ndat >= DAT_MAX
        put(2, "olic: static table exhausted\n")
        os.syscall(60, 4)
    end
    if vi >= DMAP_MAX
        put(2, "olic: static map exhausted\n")
        os.syscall(60, 4)
    end
    t := val_type(pg, vi)
    sz := type_bytes(pg, t)
    k := ob.ndat
    d := dat_at(ob, k)
    d.size <- sz
    d.val <- vi
    d.init <- 0
    d.off <- 0
    d.sect <- 0
    cell_set(ob.dmap, vi, k + 1)
    ob.ndat <- k + 1
    if vn.sub == 1
        -- An initialiser: a constant at the place's width, an array literal
        -- element by element, or a layout literal field by field.
        if ob.dsize + sz + 8 > DATA_MAX
            put(2, "olic: static data arena exhausted\n")
            os.syscall(60, 4)
        end
        d.init <- 1
        d.off <- round_up(ob.dsize, static_align(pg, vi, sz))
        ob.dsize <- d.off
        put_bytes(ob.dbytes, ob.dsize, sz, 0)
        init_bytes(pg, ob, vi, ob.dbytes, d.off)
        ob.dsize <- ob.dsize + sz
    end
end

proc static_in_text(pg: ref Prog, vi: u64) -> word
    -- `section ".text…"` or `section ".rodata…"` on a static: it lives in
    -- the read-only segment, in front of the code — where a boot loader's
    -- header must be (FREESTANDING.md §8).
    v := val_at(pg, vi)
    cx := mod_ctx(pg, v.mod)
    k : u64 <- kid1(cx, v.node)
    while k != 0
        kn := node_at(cx, k)
        if kn.kind == N_CLAUSE
            if kn.sub == C_SECTION
                c := node_at(cx, kid1(cx, k))
                s := tok_text(cx, c.t0)
                if starts_with(s, "\".text")
                    ret 1
                end
                if starts_with(s, "\".rodata")
                    ret 1
                end
            end
        end
        k <- sibling(cx, k)
    end
    ret 0
end

proc add_rodata(pg: rw ref Prog, ob: rw ref Oir, vi: u64)
    -- A static in the read-only segment: padded to its alignment, its bytes
    -- from the initialiser (zero without one), reachable through `rmap`.
    permit os.syscall
    if vi >= DMAP_MAX
        put(2, "olic: static map exhausted\n")
        os.syscall(60, 4)
    end
    v := val_at(pg, vi)
    t := val_type(pg, vi)
    sz := type_bytes(pg, t)
    al := static_align(pg, vi, sz)
    while ob.ndata % al != 0
        data_byte(ob, 0)
    end
    idx := open_static(ob)
    ast := stat_at(ob, idx)
    -- The alignment survives `compact_statics` (compiler/opt.oli).
    ast.alg <- al
    off := ob.ndata
    i : u64 <- 0
    while i < sz
        data_byte(ob, 0)
        i <- i + 1
    end
    close_static(ob, idx)
    cx := mod_ctx(pg, v.mod)
    vn := node_at(cx, v.node)
    if vn.sub == 1
        init_bytes(pg, ob, vi, ob.data, off)
    end
    cell_set(ob.rmap, vi, idx + 1)
end

proc rodata_of(ob: ref Oir, vi: u64) -> word
    if vi >= DMAP_MAX
        ret -1
    end
    m := cell_get(ob.rmap, vi)
    if m == 0
        ret -1
    end
    ret word.bits(m - 1)
end

proc init_bytes(pg: rw ref Prog, ob: rw ref Oir, vi: u64, dst: rw view u8, off: u64)
    -- The initialiser of a static, written into `dst` at `off`: a constant
    -- at the place's width; `{ a, b, … }` for an array, element by element
    -- at the element's width, the rest zero; `Name { f: c, … }` for a
    -- layout, each field at its offset and width. Every value is a
    -- constant expression; anything else is E0900 at the initialiser.
    -- (Six argument words: the size is the type's.)
    v := val_at(pg, vi)
    cx := mod_ctx(pg, v.mod)
    vn := node_at(cx, v.node)
    t := val_type(pg, vi)
    sz := type_bytes(pg, t)
    init : u64 <- kid2(cx, v.node)
    if vn.val < 2
        init <- kid1(cx, v.node)
    end
    inn := node_at(cx, init)
    if inn.kind == N_ARRAY
        if starts_with(t, "[") == 0
            oir_err(ob, pg, v.mod, 900, init)
            ret
        end
        eb := type_bytes(pg, arr_elem(t))
        e : u64 <- kid1(cx, init)
        pos : u64 <- 0
        while e != 0
            if pos + eb > sz
                oir_err(ob, pg, v.mod, 900, e)
                ret
            end
            if is_float(arr_elem(t)) == 1
                put_bytes(dst, off + pos, eb, const_float(pg, v.mod, e, float_fmt(arr_elem(t))))
            else
                put_bytes(dst, off + pos, eb, const_value(pg, v.mod, e))
            end
            pos <- pos + eb
            e <- sibling(cx, e)
        end
        ret
    end
    if inn.kind == N_LIT
        it := layout_of(pg, t)
        if it < 0
            oir_err(ob, pg, v.mod, 900, init)
            ret
        end
        f : u64 <- kid2(cx, init)
        while f != 0
            fn := node_at(cx, f)
            fi := field_of(pg, u64.bits(it), tok_text(cx, fn.t0))
            if fi < 0
                oir_err(ob, pg, v.mod, 900, f)
                ret
            end
            fr := fld_at(pg, u64.bits(fi))
            ftn := node_at(cx, kid1(cx, fr.node))
            fw := type_size(pg, v.mod, ftn.t0, ftn.t1)
            if fr.off + fw > sz
                oir_err(ob, pg, v.mod, 900, f)
                ret
            end
            ftx := tok_text(cx, ftn.t0)
            if ftn.t1 == ftn.t0 + 1
                if is_float(ftx) == 1
                    put_bytes(dst, off + fr.off, fw, const_float(pg, v.mod, kid1(cx, f), float_fmt(ftx)))
                    f <- sibling(cx, f)
                    continue
                end
            end
            put_bytes(dst, off + fr.off, fw, const_value(pg, v.mod, kid1(cx, f)))
            f <- sibling(cx, f)
        end
        ret
    end
    if starts_with(t, "[")
        oir_err(ob, pg, v.mod, 900, init)
        ret
    end
    if is_float(t) == 1
        put_bytes(dst, off, sz, const_float(pg, v.mod, init, float_fmt(t)))
        ret
    end
    put_bytes(dst, off, sz, const_value(pg, v.mod, init))
end

proc put_bytes(b: rw view u8, off: u64, n: u64, v: u64)
    i : u64 <- 0
    x : u64 <- v
    while i < n
        b[off + i] <- u8.wrap(x)
        x <- x >> 8
        i <- i + 1
    end
end

proc data_of(ob: ref Oir, vi: u64) -> word
    -- The data index of a static, or -1 for a constant.
    if vi >= DMAP_MAX
        ret -1
    end
    m := cell_get(ob.dmap, vi)
    if m == 0
        ret -1
    end
    ret word.bits(m - 1)
end

proc gen_static(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, vi: u64) -> u64
    -- A static read as a value: an array is the view of its bytes, a scalar
    -- is loaded at its width.
    di := data_of(ob, vi)
    t := val_type(pg, vi)
    if di < 0
        -- A static in the read-only segment: read through its address.
        ri := rodata_of(ob, vi)
        if ri < 0
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        ra := emit_ins(ob, O_SADDR, u64.bits(ri), 0, 0, 0)
        if starts_with(t, "[")
            ob.lastlen <- emit_ins(ob, O_CONST, 0, 0, 0, arr_count(pg, t))
            ret ra
        end
        ob.lastlen <- 0
        if layout_param(pg, t) > 0
            ret ra
        end
        ret static_load(ob, ra, t)
    end
    a := emit_ins(ob, O_DADDR, u64.bits(di), 0, 0, 0)
    if layout_param(pg, t) > 0
        -- A layout held by value: its address, as a field of one is.
        ob.lastlen <- 0
        ret a
    end
    if starts_with(t, "[")
        d := dat_at(ob, u64.bits(di))
        eb := type_bytes(pg, arr_elem(t))
        cnt : u64 <- 0
        if eb > 0
            cnt <- d.size / eb
        end
        ob.lastlen <- emit_ins(ob, O_CONST, 0, 0, 0, cnt)
        ret a
    end
    ob.lastlen <- 0
    ret static_load(ob, a, t)
end

proc static_load(ob: rw ref Oir, a: u64, t: view u8) -> u64
    if is_view_type(t) == 1
        v := emit_ins(ob, O_RLOAD, a, 8, 0, 0)
        eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
        ob.lastlen <- emit_ins(ob, O_RLOAD, addr_add(ob, a, eight), 8, 0, 0)
        ret v
    end
    nb := mem_bits(t)
    sg : u64 <- 0
    if int_signed(t) == 1
        sg <- 1
    end
    if nb > 0
        ret emit_ins(ob, O_RLOAD, a, u64.bits(nb) / 8, sg, 0)
    end
    ret emit_ins(ob, O_RLOAD, a, 8, 0, 0)
end

proc gen_store_static(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, vi: u64)
    cx := mod_ctx(pg, mi)
    di := data_of(ob, vi)
    if di < 0
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    t := val_type(pg, vi)
    if starts_with(t, "[")
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    v := gen_expr(pg, ob, mi, kid2(cx, n), t)
    a := emit_ins(ob, O_DADDR, u64.bits(di), 0, 0, 0)
    if is_view_type(t) == 1
        ln := ob.lastlen
        emit_ins(ob, O_RSTORE, a, v, 8, 0)
        eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
        emit_ins(ob, O_RSTORE, addr_add(ob, a, eight), ln, 8, 0)
        ret
    end
    nb := mem_bits(t)
    if nb > 0
        emit_ins(ob, O_RSTORE, a, v, u64.bits(nb) / 8, 0)
        ret
    end
    emit_ins(ob, O_RSTORE, a, v, 8, 0)
end

-- Raw access (`permit memory.raw`) ---------------------------------------------

proc gen_rawload(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `[p]`: the element the address points at, at the width of its type.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    pe := kid1(cx, n)
    et := addr_elem(ety(pg, mi, pe, b[0..0]))
    p := gen_expr(pg, ob, mi, pe, b[0..0])
    ob.lastlen <- 0
    nb := mem_bits(et)
    if nb == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    sg : u64 <- 0
    if int_signed(et) == 1
        sg <- 1
    end
    ret emit_ins(ob, O_RLOAD, p, u64.bits(nb) / 8, sg, 0)
end

-- Hardware places (design 0015, `permit io.port`) ----------------------------

proc gen_hwload(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `port.uN[p]` read: `hw.load port.uN %p` — one `in` at the width;
    -- `arch.x64.crN` read: `hw.load arch.x64.crN`, one `mov rax, crN`.
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, n)
    if nd.sub == 1
        ob.lastlen <- 0
        ret emit_ins(ob, O_CRLOAD, 0, 0, 0, nd.val)
    end
    if nd.sub == 2
        -- `arch.x64.msr[n]`: `rdmsr`.
        mn := gen_expr(pg, ob, mi, kid1(cx, n), "u32")
        ob.lastlen <- 0
        ret emit_ins(ob, O_MSRRD, mn, 0, 0, 0)
    end
    if nd.sub >= 10
        -- An AArch64 system register (design 0025): only on AArch64, and
        -- ICC_EOIR1_EL1 is written, never read.
        if pg.arch64 == 0
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        if nd.sub == 20
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        if nd.sub == 24
            -- `eret` and `svc` are commands, not places.
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        if nd.sub == 25
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
    end
    if nd.sub >= 3
        if nd.sub == 5
            -- The descriptor tables are written, not read (no `sgdt`).
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        if nd.sub == 6
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        ob.lastlen <- 0
        ret emit_ins(ob, O_HWRD, 0, 0, 0, nd.sub)
    end
    p := gen_expr(pg, ob, mi, kid1(cx, n), "u16")
    ob.lastlen <- 0
    ret emit_ins(ob, O_HWLOAD, p, nd.val / 8, 0, 0)
end

proc gen_store_hw(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `port.uN[p] <- v`: `hw.store port.uN %p, %v` — one `out` at the width.
    cx := mod_ctx(pg, mi)
    tgt := kid1(cx, n)
    tn := node_at(cx, tgt)
    if tn.sub == 1
        -- `arch.x64.crN <- v`: `hw.store arch.x64.crN, %v`, one `mov crN, rax`.
        cv := gen_expr(pg, ob, mi, kid2(cx, n), cr_type(tn.val))
        emit_ins(ob, O_CRSTORE, cv, 0, 0, tn.val)
        ret
    end
    if tn.sub == 2
        -- `arch.x64.msr[n] <- v`: `wrmsr`.
        mn := gen_expr(pg, ob, mi, kid1(cx, tgt), "u32")
        mv := gen_expr(pg, ob, mi, kid2(cx, n), "u64")
        emit_ins(ob, O_MSRWR, mn, mv, 0, 0)
        ret
    end
    if tn.sub >= 10
        -- `vbar`, `cntv_ctl`, `cntv_tval`, `cpacr` and the ICC registers
        -- but `icc_iar1` are written; the rest are read only, and none
        -- exists off AArch64 (design 0025).
        bad : u64 <- 0
        if pg.arch64 == 0
            bad <- 1
        end
        if tn.sub > 12
            if tn.sub < 18
                -- ELR_EL1 alone of these is written (user mode, design 0025).
                if tn.sub != 15
                    bad <- 1
                end
            end
            if tn.sub == 19
                bad <- 1
            end
            if tn.sub == 24
                bad <- 1
            end
            if tn.sub == 25
                bad <- 1
            end
        end
        if bad == 1
            oir_err(ob, pg, mi, 900, n)
            ret
        end
    end
    if tn.sub >= 3
        -- The stack or frame pointer, a descriptor table, the task register.
        hv := gen_expr(pg, ob, mi, kid2(cx, n), hwplace_type(tn.sub))
        emit_ins(ob, O_HWWR, hv, 0, 0, tn.sub)
        ret
    end
    p := gen_expr(pg, ob, mi, kid1(cx, tgt), "u16")
    v := gen_expr(pg, ob, mi, kid2(cx, n), hw_type(tn.val))
    emit_ins(ob, O_HWSTORE, p, v, tn.val / 8, 0)
end

proc gen_store_raw(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    tgt := kid1(cx, n)
    pe := kid1(cx, tgt)
    et := addr_elem(ety(pg, mi, pe, b[0..0]))
    nb := mem_bits(et)
    if nb == 0
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    p := gen_expr(pg, ob, mi, pe, b[0..0])
    v := gen_expr(pg, ob, mi, kid2(cx, n), et)
    emit_ins(ob, O_RSTORE, p, v, u64.bits(nb) / 8, 0)
end

-- Frame slots -----------------------------------------------------------------
-- Every local owns two words (a view needs both); a value owns one. The
-- linear-scan allocator of OIR_SPEC §7 replaces this with registers later.

proc local_words(pg: ref Prog, t: view u8) -> u64
    -- How many frame words a local of this type owns.
    if is_view_type(t) == 1
        ret 2
    end
    if view_eq(t, "zone")
        ret 3
    end
    if starts_with(t, "[")
        ret (type_bytes(pg, t) + 7) / 8
    end
    lp := layout_param(pg, t)
    if lp > 0
        -- A layout held by value: its bytes, read and written through the
        -- address of its first word like a field of one.
        ret (lp + 7) / 8
    end
    ret 1
end

proc lay_out_locals(pg: rw ref Prog, ob: rw ref Oir) -> u64
    -- The first word of each local of the current procedure, in order, and
    -- the number of words they take together.
    permit os.syscall
    b := pg.sbuf
    cursor : u64 <- 0
    i : u64 <- pg.locbase
    while i < pg.nloc
        k := i - pg.locbase
        if k >= LOCOFF_MAX
            put(2, "olic: local table exhausted\n")
            os.syscall(60, 4)
        end
        l := loc_at(pg, i)
        cell_set(ob.locoff, k, cursor)
        cursor <- cursor + local_words(pg, b[l.t0..l.t1])
        i <- i + 1
    end
    ret cursor
end

proc local_off(ob: ref Oir, s: word) -> u64
    ret cell_get(ob.locoff, u64.bits(s))
end

proc local_base(pg: ref Prog, ob: rw ref Oir, name: view u8) -> u64
    -- `addr.of` the local as memory: the frame grows downward, one slot
    -- per word, so the bytes of a local that owns several words start at
    -- its last word and run upward through the others. A zone's triple, an
    -- array's elements and a `ref` to either all begin there.
    s := slot_of_local(pg, name)
    w := local_words(pg, loc_type(pg, name))
    ret emit_ins(ob, O_FADDR, local_off(ob, s) + w - 1, 0, 0, 0)
end

proc is_array_type(t: view u8) -> word
    if starts_with(t, "[")
        ret 1
    end
    ret 0
end

proc arr_or_view(t: view u8) -> word
    -- A view, or an array place read as the view of its bytes, or a vector
    -- whose lanes are indexed like elements.
    if is_vector(t) == 1
        ret 1
    end
    if is_view_type(t) == 1
        ret 1
    end
    ret is_array_type(t)
end

proc view_elem(t: view u8) -> view u8
    if is_vector(t) == 1
        ret vec_lane(t)
    end
    if is_array_type(t) == 1
        ret arr_elem(t)
    end
    ret elem_of(t)
end

proc arr_count(pg: ref Prog, t: view u8) -> u64
    eb := type_bytes(pg, arr_elem(t))
    if eb == 0
        ret 0
    end
    ret type_bytes(pg, t) / eb
end

proc slot_of_local(pg: ref Prog, name: view u8) -> word
    i := loc_find(pg, name)
    if i < 0
        ret -1
    end
    ret i - word.bits(pg.locbase)
end

-- Expressions -----------------------------------------------------------------

proc elem_bytes(pg: ref Prog, ob: rw ref Oir, mi: u64, t: view u8, n: u64) -> u64
    -- The size of one element of a view or an array: an integer's width, or
    -- a layout's size — an element that is a layout is reached by its
    -- address, like any layout held by value.
    et := view_elem(t)
    b := mem_bits(et)
    if b > 0
        ret u64.bits(b) / 8
    end
    if view_eq(et, "bool")
        ret 1
    end
    lp := layout_param(pg, et)
    if lp > 0
        ret lp
    end
    oir_err(ob, pg, mi, 900, n)
    ret 1
end

proc scale_by(ob: rw ref Oir, v: u64, sz: u64) -> u64
    -- `v * sz` as address arithmetic: no width, no trap. An index that got
    -- this far is already below a length that fits in a word, so the product
    -- cannot leave one.
    if sz == 1
        ret v
    end
    c := emit_ins(ob, O_CONST, 0, 0, 0, sz)
    ret emit_bin(ob, B_MUL, v, c, 0)
end

proc addr_add(ob: rw ref Oir, a: u64, off: u64) -> u64
    ret emit_bin(ob, B_ADD, a, off, 0)
end

proc is_view_type(t: view u8) -> word
    if starts_with(unqual(t), "view ")
        ret 1
    end
    ret 0
end

proc binop_code(op: view u8) -> u64
    if view_eq(op, "+")
        ret B_ADD
    end
    if view_eq(op, "-")
        ret B_SUB
    end
    if view_eq(op, "*")
        ret B_MUL
    end
    if view_eq(op, "/")
        ret B_DIV
    end
    if view_eq(op, "%")
        ret B_REM
    end
    if view_eq(op, "&")
        ret B_AND
    end
    if view_eq(op, "|")
        ret B_OR
    end
    if view_eq(op, "^")
        ret B_XOR
    end
    if view_eq(op, "<<")
        ret B_SHL
    end
    if view_eq(op, ">>")
        ret B_SHR
    end
    if view_eq(op, "==")
        ret B_EQ
    end
    if view_eq(op, "!=")
        ret B_NE
    end
    if view_eq(op, "<")
        ret B_LT
    end
    if view_eq(op, "<=")
        ret B_LE
    end
    if view_eq(op, ">")
        ret B_GT
    end
    if view_eq(op, ">=")
        ret B_GE
    end
    ret 0
end

proc gen_conv(ob: rw ref Oir, v: u64, src: view u8, dst: view u8) -> u64
    -- The representation change a conversion actually performs, in the terms
    -- of OIR_SPEC §4: nothing when the 64-bit image is already right, and
    -- `trunc` (re-extension to the width and signedness of the destination)
    -- when it is not.
    if int_bits(dst) == 0
        ret v
    end
    if int_bits(src) == 0
        ret v
    end
    if int_bits(dst) >= 64
        if int_signed(dst) == int_signed(src)
            ret v
        end
        ret v
    end
    if int_bits(src) <= int_bits(dst)
        if int_signed(src) == int_signed(dst)
            ret v
        end
        if int_signed(src) == 0
            ret v
        end
    end
    sg : u64 <- 0
    if int_signed(dst) == 1
        sg <- 1
    end
    ret emit_ins(ob, O_TRUNC, v, u64.bits(int_bits(dst)), sg, 0)
end

-- Where an argument travels (ABI.md §1-2, the SysV rule): the six integer
-- registers in order, and once an argument does not fit in the registers
-- left — a view needs two — that whole argument goes to the stack while a
-- later, smaller one may still take a register. A location is 0-5 for a
-- register and 6 and up for a word of the stack, the first stack word at
-- the lowest address. The two counters are locals of the walk, because an
-- argument can be a call with arguments of its own.

proc gen_call_args(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, pi: word, hidden: u64) -> u64
    -- Arguments in source order; each becomes an `arg` marker carrying the
    -- location it travels in, and a view argument becomes two. The count is
    -- what `call` consumes; the stack words are left in `ob.callstk`. With
    -- `hidden`, the `sret` area's address goes first, in rdi.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    regs : u64 <- 0
    stk : u64 <- 0
    xm : u64 <- 0
    a : u64 <- sibling(cx, kid1(cx, n))
    k : u64 <- 0
    nargs : u64 <- 0
    if hidden == 1
        emit_ins(ob, O_ARG, ob.sretv, 0, 0, 0)
        nargs <- 1
        regs <- 1
    end
    while a != 0
        want : view u8 <- b[0..0]
        words : u64 <- 1
        if pi >= 0
            want <- param_type(pg, u64.bits(pi), k)
            if is_view_type(want) == 1
                words <- 2
            end
        end
        lay : u64 <- 0
        if pi >= 0
            lay <- layout_param(pg, want)
            if is_vector(want) == 1
                if proc_is_extern(pg, u64.bits(pi)) == 1
                    -- SysV passes `__m128` in an xmm register (design 0024).
                    oir_err(ob, pg, mi, 900, a)
                end
            end
        end
        v := gen_expr(pg, ob, mi, a, want)
        if lay > 0
            -- A layout by value: its words, one `arg` each — in registers
            -- when it is sixteen bytes or less and they fit (SysV INTEGER
            -- class), on the stack otherwise (MEMORY class). The eightbytes
            -- are read whole; every object's storage is padded to a word.
            lw := (lay + 7) / 8
            loc1 : u64 <- 0
            if lay <= 16
                if regs + lw <= 6
                    loc1 <- regs
                    regs <- regs + lw
                else
                    loc1 <- 6 + stk
                    stk <- stk + lw
                end
            else
                loc1 <- 6 + stk
                stk <- stk + lw
            end
            w : u64 <- 0
            while w < lw
                src : u64 <- v
                if w > 0
                    off := emit_ins(ob, O_CONST, 0, 0, 0, w * 8)
                    src <- addr_add(ob, v, off)
                end
                wv := emit_ins(ob, O_RLOAD, src, 8, 0, 0)
                emit_ins(ob, O_ARG, wv, loc1 + w, 0, 0)
                nargs <- nargs + 1
                w <- w + 1
            end
            k <- k + 1
            a <- sibling(cx, a)
            continue
        end
        if is_float(want) == 1
            -- SysV SSE class: xmm0..xmm7 in order (location 1000 + k).
            if xm >= 8
                oir_err(ob, pg, mi, 900, a)
            end
            emit_ins(ob, O_ARG, v, 1000 + xm, 0, 0)
            xm <- xm + 1
            nargs <- nargs + 1
            k <- k + 1
            a <- sibling(cx, a)
            continue
        end
        loc : u64 <- 0
        if regs + words <= 6
            loc <- regs
            regs <- regs + words
        else
            loc <- 6 + stk
            stk <- stk + words
        end
        emit_ins(ob, O_ARG, v, loc, 0, 0)
        nargs <- nargs + 1
        if words == 2
            emit_ins(ob, O_ARG, ob.lastlen, loc + 1, 0, 0)
            nargs <- nargs + 1
        end
        k <- k + 1
        a <- sibling(cx, a)
    end
    ob.callstk <- stk
    ret nargs
end

proc gen_syscall(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    cx := mod_ctx(pg, mi)
    a : u64 <- sibling(cx, kid1(cx, n))
    nargs : u64 <- 0
    while a != 0
        v := gen_expr(pg, ob, mi, a, "word")
        emit_ins(ob, O_ARG, v, 0, 0, 0)
        nargs <- nargs + 1
        a <- sibling(cx, a)
    end
    if nargs > 7
        -- The number and six arguments are all the registers a system call
        -- has (ABI.md §5).
        oir_err(ob, pg, mi, 900, n)
    end
    ret emit_ins(ob, O_SYSCALL, 0, nargs, 0, 0)
end

proc gen_bytes(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `z.bytes(k)`: k bytes from the zone, or the trap that says there are
    -- not that many left. The view it answers with is the pair (address, k).
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    ce := kid1(cx, n)
    zv := gen_expr(pg, ob, mi, kid1(cx, ce), b[0..0])
    a := sibling(cx, ce)
    if a == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    sz := gen_expr(pg, ob, mi, a, "uword")
    r := emit_ins(ob, O_ZALLOC, zv, sz, 0, 0)
    ri := ins_at(ob, r)
    ri.site <- trap_static(pg, ob, mi, TK_ZONE, n) + 1
    ob.lastlen <- sz
    ret r
end

proc atomic_kind(m: view u8) -> u64
    if view_eq(m, "load")
        ret 0
    end
    if view_eq(m, "store")
        ret 1
    end
    if view_eq(m, "add")
        ret 2
    end
    if view_eq(m, "sub")
        ret 3
    end
    if view_eq(m, "and")
        ret 4
    end
    if view_eq(m, "or")
        ret 5
    end
    if view_eq(m, "xor")
        ret 6
    end
    if view_eq(m, "exchange")
        ret 7
    end
    ret 8
end

proc atomic_name(k: u64) -> view u8
    if k == 0
        ret "load"
    end
    if k == 1
        ret "store"
    end
    if k == 2
        ret "add"
    end
    if k == 3
        ret "sub"
    end
    if k == 4
        ret "and"
    end
    if k == 5
        ret "or"
    end
    if k == 6
        ret "xor"
    end
    if k == 7
        ret "exchange"
    end
    ret "cas"
end

proc order_code(m: view u8) -> u64
    if view_eq(m, "relaxed")
        ret 0
    end
    if view_eq(m, "acquire")
        ret 1
    end
    if view_eq(m, "release")
        ret 2
    end
    if view_eq(m, "acq_rel")
        ret 3
    end
    ret 4
end

proc order_name(o: u64) -> view u8
    if o == 0
        ret "relaxed"
    end
    if o == 1
        ret "acquire"
    end
    if o == 2
        ret "release"
    end
    if o == 3
        ret "acq_rel"
    end
    ret "seq_cst"
end

proc gen_atomic(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `atomic.OP(ref, …, order)`: one instruction over the ref's address,
    -- the value (the address again for a load), and, for `cas`, the value
    -- swapped in; the checker settled the shape.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    ce := kid1(cx, n)
    cn := node_at(cx, ce)
    kind := atomic_kind(tok_text(cx, cn.t0))
    a0 := sibling(cx, ce)
    et := ref_elem(ety(pg, mi, a0, b[0..0]))
    nb := u64.bits(int_bits(et)) / 8
    sg : u64 <- 0
    if int_signed(et) == 1
        sg <- 1
    end
    p := gen_expr(pg, ob, mi, a0, b[0..0])
    v : u64 <- p
    d : u64 <- p
    a1 := sibling(cx, a0)
    if kind >= 1
        v <- gen_expr(pg, ob, mi, a1, et)
        d <- v
    end
    if kind == 8
        d <- gen_expr(pg, ob, mi, sibling(cx, a1), et)
    end
    last : u64 <- a0
    while sibling(cx, last) != 0
        last <- sibling(cx, last)
    end
    ln := node_at(cx, last)
    i := emit_ins(ob, O_ATOMIC, p, v, nb + 16 * sg, d)
    ins := ins_at(ob, i)
    ins.bop <- kind
    ins.w <- order_code(tok_text(cx, ln.t0))
    ob.lastlen <- 0
    ret i
end

proc gen_memop(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, kind: u64) -> u64
    -- `mem.copy(dst, src, n)`: `n` within both views (`check.range`, the
    -- `bounds` trap), then the move; `mem.set(dst, b)`, `mem.zero(dst)` and
    -- `mem.secure_zero(dst)` over the whole destination.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    a0 := sibling(cx, kid1(cx, n))
    dst := gen_expr(pg, ob, mi, a0, "rw view u8")
    dlen := ob.lastlen
    a1 := sibling(cx, a0)
    if kind == 0
        src := gen_expr(pg, ob, mi, a1, "view u8")
        slen := ob.lastlen
        cnt := gen_expr(pg, ob, mi, sibling(cx, a1), "uword")
        zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
        ck1 := emit_ins(ob, O_CHKR, zero, cnt, 0, dlen)
        ci1 := ins_at(ob, ck1)
        ci1.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
        ck2 := emit_ins(ob, O_CHKR, zero, cnt, 0, slen)
        ci2 := ins_at(ob, ck2)
        ci2.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
        m := emit_ins(ob, O_MEMOP, dst, src, 0, cnt)
        mi0 := ins_at(ob, m)
        mi0.bop <- 0
        ob.lastlen <- 0
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    bv : u64 <- dst
    if kind == 1
        bv <- gen_expr(pg, ob, mi, a1, "u8")
    end
    m2 := emit_ins(ob, O_MEMOP, dst, bv, 0, dlen)
    mi2 := ins_at(ob, m2)
    mi2.bop <- kind
    ob.lastlen <- 0
    ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
end

proc memop_name(k: u64) -> view u8
    if k == 0
        ret "mem.copy"
    end
    if k == 1
        ret "mem.set"
    end
    if k == 2
        ret "mem.zero"
    end
    ret "mem.secure_zero"
end

proc gen_port_in(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `p.in()` on a `port T` value: `hw.load port.uN %p` at the width of `T`.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    base := kid1(cx, kid1(cx, n))
    w := u64.bits(int_bits(port_elem(ety(pg, mi, base, b[0..0])))) / 8
    pv := gen_expr(pg, ob, mi, base, b[0..0])
    ob.lastlen <- 0
    ret emit_ins(ob, O_HWLOAD, pv, w, 0, 0)
end

proc gen_port_out(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `p.out(v)`: `hw.store port.uN %p, %v`.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    base := kid1(cx, kid1(cx, n))
    et := port_elem(ety(pg, mi, base, b[0..0]))
    w := u64.bits(int_bits(et)) / 8
    pv := gen_expr(pg, ob, mi, base, b[0..0])
    v := gen_expr(pg, ob, mi, sibling(cx, kid1(cx, n)), et)
    emit_ins(ob, O_HWSTORE, pv, v, w, 0)
    ob.lastlen <- 0
    ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
end

proc gen_mmio(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `mem.mmio(T, a, n)`: the view (a, n) of device memory — no instruction
    -- of its own; what makes it `mmio` is every access through it, which
    -- is in space `mmio` (`gen_index`, `gen_store_index`).
    cx := mod_ctx(pg, mi)
    ce := kid1(cx, n)
    ta := sibling(cx, ce)
    if ta == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    an := sibling(cx, ta)
    if an == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    cn := sibling(cx, an)
    if cn == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    a := gen_expr(pg, ob, mi, an, "uword")
    ln := gen_expr(pg, ob, mi, cn, "uword")
    ob.lastlen <- ln
    ret a
end

proc gen_mem_get(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `mem.get_u16/u32/u64(v)`, `mem.get_be*(v)`, `mem.get_le*(v)`: the
    -- view must hold the width (a range check, `bounds` when short), then
    -- one load, byte-swapped for `be`.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    ce := kid1(cx, n)
    cn := node_at(cx, ce)
    name := tok_text(cx, cn.t0)
    w := u64.bits(mem_width(name))
    e := mem_endian(name)
    a := sibling(cx, ce)
    if a == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    v := gen_expr(pg, ob, mi, a, b[0..0])
    ln := ob.lastlen
    zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    wc := emit_ins(ob, O_CONST, 0, 0, 0, w / 8)
    ck := emit_ins(ob, O_CHKR, zero, wc, 0, ln)
    ci := ins_at(ob, ck)
    ci.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
    r := emit_ins(ob, O_RLOAD, v, w / 8, 0, 0)
    ob.lastlen <- 0
    if e == 1
        ret gen_bswap(ob, r, w)
    end
    ret r
end

proc gen_mem_put(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `mem.put_*(v, x)`: the same check, then one store, byte-swapped for
    -- `be`. A statement: the value is nothing.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    ce := kid1(cx, n)
    cn := node_at(cx, ce)
    name := tok_text(cx, cn.t0)
    w := u64.bits(mem_width(name))
    e := mem_endian(name)
    a := sibling(cx, ce)
    if a == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    x := sibling(cx, a)
    if x == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    v := gen_expr(pg, ob, mi, a, b[0..0])
    ln := ob.lastlen
    zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    wc := emit_ins(ob, O_CONST, 0, 0, 0, w / 8)
    ck := emit_ins(ob, O_CHKR, zero, wc, 0, ln)
    ci := ins_at(ob, ck)
    ci.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
    val : u64 <- gen_expr(pg, ob, mi, x, mem_type(w))
    if e == 1
        val <- gen_bswap(ob, val, w)
    end
    emit_ins(ob, O_RSTORE, v, val, w / 8, 0)
    ob.lastlen <- 0
    ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
end

proc mem_type(w: u64) -> view u8
    if w == 16
        ret "u16"
    end
    if w == 32
        ret "u32"
    end
    ret "u64"
end

proc gen_try_bytes(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `z.try_bytes(k)`: the same bytes as `z.bytes(k)`, but exhaustion is the
    -- failure of a `rw view u8 or none` and not a trap. The cursor is read,
    -- rounded to sixteen and compared with the limit in the stream itself,
    -- and moved only on the ok path; the value is the tag, the payload the
    -- pair (address, k) in `ob.lastpay` and `ob.lastlen`.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    ce := kid1(cx, n)
    zv := gen_expr(pg, ob, mi, kid1(cx, ce), b[0..0])
    a := sibling(cx, ce)
    if a == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    sz := gen_expr(pg, ob, mi, a, "uword")
    eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
    sixteen := emit_ins(ob, O_CONST, 0, 0, 0, 16)
    curp := addr_add(ob, zv, eight)
    cur := emit_ins(ob, O_RLOAD, curp, 8, 0, 0)
    lim := emit_ins(ob, O_RLOAD, addr_add(ob, zv, sixteen), 8, 0, 0)
    fifteen := emit_ins(ob, O_CONST, 0, 0, 0, 15)
    mask := emit_ins(ob, O_CONST, 0, 0, 0, 18446744073709551600)
    base := emit_bin(ob, B_AND, emit_bin(ob, B_ADD, cur, fifteen, 0), mask, 0)
    nxt := emit_bin(ob, B_ADD, base, sz, 0)
    past := emit_bin(ob, B_GT, nxt, lim, 0)
    wrapped := emit_bin(ob, B_LT, nxt, base, 0)
    tag := emit_bin(ob, B_OR, past, wrapped, 0)
    zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    isok := emit_bin(ob, B_EQ, tag, zero, 0)
    lskip := new_label(ob)
    emit_ins(ob, O_BRANCH, isok, 0, 0, lskip)
    emit_ins(ob, O_RSTORE, curp, nxt, 8, 0)
    emit_ins(ob, O_LABEL, lskip, 0, 0, 0)
    ob.lastpay <- base
    ob.lastlen <- sz
    ret tag
end

proc gen_call(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    cx := mod_ctx(pg, mi)
    ck := call_kind(pg, mi, n)
    if ck == CK_SYSCALL
        ret gen_syscall(pg, ob, mi, n)
    end
    if ck == CK_VMAKE
        ret gen_vmake(pg, ob, mi, n, 0)
    end
    if ck == CK_VSPLAT
        ret gen_vmake(pg, ob, mi, n, 1)
    end
    if ck == CK_VLOAD
        vp := gen_vspan(pg, ob, mi, n)
        varea := tmp_area(ob, 16)
        gen_copy(ob, varea, vp, 16)
        ret varea
    end
    if ck == CK_VSTORE
        sp := gen_vspan(pg, ob, mi, n)
        sx := sibling(cx, sibling(cx, kid2(cx, n)))
        sval := gen_expr(pg, ob, mi, sx, vcall_type(pg, mi, n))
        gen_copy(ob, sp, sval, 16)
        ob.lastlen <- 0
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    if ck == CK_BYTES
        ret gen_bytes(pg, ob, mi, n)
    end
    if ck == CK_TRYBYTES
        ret gen_try_bytes(pg, ob, mi, n)
    end
    if ck == CK_MAKE
        ret gen_make(pg, ob, mi, n)
    end
    if ck == CK_AT
        ret gen_at(pg, ob, mi, n)
    end
    if ck == CK_GET
        ret gen_mem_get(pg, ob, mi, n)
    end
    if ck == CK_PUT
        ret gen_mem_put(pg, ob, mi, n)
    end
    if ck == CK_MMIO
        ret gen_mmio(pg, ob, mi, n)
    end
    if ck == CK_HALT
        emit_ins(ob, O_CPU, 0, 0, 0, 0)
        ob.lastlen <- 0
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    if ck == CK_ATOMIC
        ret gen_atomic(pg, ob, mi, n)
    end
    if ck == CK_PIN
        ret gen_port_in(pg, ob, mi, n)
    end
    if ck == CK_CPUID
        -- `cpu.id(leaf)`: `cpuid` into a fresh area, a `core.CpuId` by value.
        leaf := gen_expr(pg, ob, mi, sibling(cx, kid1(cx, n)), "u32")
        area := tmp_area(ob, 16)
        emit_ins(ob, O_CPUID, leaf, area, 0, 0)
        ob.lastlen <- 0
        ret area
    end
    if ck == CK_TSC
        ob.lastlen <- 0
        ret emit_ins(ob, O_HWRD, 0, 0, 0, 8)
    end
    if ck == CK_SEGS
        ret gen_segments(pg, ob, mi, n)
    end
    if ck == CK_ERET
        -- `arch.a64.eret(p)`: ELR_EL1 the procedure's address, then `eret`
        -- (`hw.cmd arch.a64.eret NAME`, O_HWCALL with `val` 1).
        enn := node_at(cx, sibling(cx, kid1(cx, n)))
        epi := proc_find(pg, tok_text(cx, enn.t0))
        if epi < 0
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        if pg.arch64 == 0
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        emit_ins(ob, O_HWCALL, 0, 0, u64.bits(epi), 1)
        ob.lastlen <- 0
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    if ck == CK_SVC
        -- `arch.a64.svc(v)`: v in x0, `svc #0`, the answer in x0
        -- (`hw.cmd arch.a64.svc %v`, O_MSRRD with `val` 25).
        if pg.arch64 == 0
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        sv := gen_expr(pg, ob, mi, sibling(cx, kid1(cx, n)), "u64")
        ob.lastlen <- 0
        ret emit_ins(ob, O_MSRRD, sv, 0, 0, 25)
    end
    if ck == CK_CPUCALL
        -- `cpu.call(p)`: a bare `call` to the procedure, for an entry with
        -- no frame of its own.
        cnn := node_at(cx, sibling(cx, kid1(cx, n)))
        cpi := proc_find(pg, tok_text(cx, cnn.t0))
        if cpi < 0
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        emit_ins(ob, O_HWCALL, 0, 0, u64.bits(cpi), 0)
        ob.lastlen <- 0
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    if ck == CK_CPUJUMP
        ja := gen_expr(pg, ob, mi, sibling(cx, kid1(cx, n)), "addr u8")
        emit_ins(ob, O_HWWR, ja, 0, 0, 9)
        ob.lastlen <- 0
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    if ck == CK_POUT
        ret gen_port_out(pg, ob, mi, n)
    end
    if memop_kind(ck) >= 0
        ret gen_memop(pg, ob, mi, n, u64.bits(memop_kind(ck)))
    end
    if ck == CK_FENCE
        fa := sibling(cx, kid1(cx, n))
        fan := node_at(cx, fa)
        emit_ins(ob, O_FENCE, 0, 0, 0, order_code(tok_text(cx, fan.t0)))
        ob.lastlen <- 0
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    if ck == CK_INTS
        -- `cpu.interrupts(off)` is `cli`, `(on)` is `sti`; the checker let
        -- nothing else through.
        ia := sibling(cx, kid1(cx, n))
        if ia == 0
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        ian := node_at(cx, ia)
        if view_eq(tok_text(cx, ian.t0), "on")
            emit_ins(ob, O_CPU, 0, 0, 0, 3)
        else
            emit_ins(ob, O_CPU, 0, 0, 0, 2)
        end
        ob.lastlen <- 0
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    if ck == CK_PAUSE
        emit_ins(ob, O_CPU, 0, 0, 0, 1)
        ob.lastlen <- 0
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    if ck != CK_PROC
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    ce := kid1(cx, n)
    cn := node_at(cx, ce)
    if cn.kind != N_NAME
        -- `module.proc(...)`: the member token names the procedure, which
        -- the front end resolved as it does a bare name.
        if cn.kind != N_FIELD
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
    end
    pi := proc_find(pg, tok_text(cx, cn.t0))
    if pi < 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    rt := proc_result(pg, tok_text(cx, cn.t0))
    rl := layout_param(pg, rt)
    fw := fallible_wide(pg, rt)
    hidden : u64 <- 0
    if rl > 16
        -- SysV `sret`: the caller owns an area for the result and passes
        -- its address as a hidden first argument; the callee fills it and
        -- hands the address back in rax.
        ob.sretv <- tmp_area(ob, rl)
        hidden <- 1
    end
    if fw > 0
        ob.sretv <- tmp_area(ob, fw * 8)
        hidden <- 1
    end
    nargs := gen_call_args(pg, ob, mi, n, pi, hidden)
    r := emit_ins(ob, O_CALL, u64.bits(pi), nargs, ob.callstk, 0)
    ob.lastlen <- 0
    ob.lastpay <- 0
    ob.paywide <- 0
    if is_float(rt) == 1
        -- A float result arrives in xmm0.
        ret emit_ins(ob, O_FRES, 0, 0, 0, 0)
    end
    if proc_is_extern(pg, u64.bits(pi)) == 1
        -- A C function's narrow integer result has undefined upper bits.
        ret narrow_extend(ob, r, rt)
    end
    if rl > 16
        ret ob.sretv
    end
    if fw > 0
        -- The tag from the area; the payload after it — a view's two words,
        -- a word, or the address of the bytes of a layout or a wide choice.
        area := ob.sretv
        tag := emit_ins(ob, O_RLOAD, area, 8, 0, 0)
        eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
        p1 := addr_add(ob, area, eight)
        okt := ok_of(rt)
        if is_view_type(okt) == 1
            ob.lastpay <- emit_ins(ob, O_RLOAD, p1, 8, 0, 0)
            sixteen := emit_ins(ob, O_CONST, 0, 0, 0, 16)
            ob.lastlen <- emit_ins(ob, O_RLOAD, addr_add(ob, area, sixteen), 8, 0, 0)
        elif layout_param(pg, okt) > 0
            -- An aggregate held by its address, as a layout by value is.
            ob.lastpay <- p1
        else
            ob.lastpay <- emit_ins(ob, O_RLOAD, p1, 8, 0, 0)
        end
        et := err_of(rt)
        if view_eq(et, "none") == 0
            if pay_words(pg, et) > 1
                ob.paywide <- p1
            end
        end
        ret tag
    end
    if rl > 0
        -- A layout of sixteen bytes or less comes back in rax and rdx
        -- (ABI.md §2); its words go to a fresh area of the frame, whose
        -- address is the value.
        w1 : u64 <- 0
        if rl > 8
            w1 <- emit_ins(ob, O_RDX, 0, 0, 2, 0)
        end
        area := tmp_area(ob, rl)
        emit_ins(ob, O_RSTORE, area, r, 8, 0)
        if rl > 8
            eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
            emit_ins(ob, O_RSTORE, addr_add(ob, area, eight), w1, 8, 0)
        end
        ob.lastlen <- 0
        ret area
    end
    if is_view_type(rt) == 1
        -- A view comes back as the pair (address, length); the second half is
        -- read out before anything else can touch the register.
        ob.lastlen <- emit_ins(ob, O_RDX, 0, 0, 0, 0)
    elif is_fallible(rt) == 1
        -- A `T or E` comes back as the pair (tag, payload) — ABI.md §2, design
        -- 0007: the call's value is the tag, and the payload is read out here
        -- for the `else` or the `case` that must follow.
        ob.lastpay <- emit_ins(ob, O_RDX, 0, 0, 1, 0)
        if layout_param(pg, ok_of(rt)) > 0
            -- A layout of a word or less as the value: its word goes to a
            -- fresh area of the frame, whose address is the payload.
            la := tmp_area(ob, 8)
            emit_ins(ob, O_RSTORE, la, ob.lastpay, 8, 0)
            ob.lastpay <- la
        end
    end
    ret r
end

proc gen_name(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, n)
    name := tok_text(cx, nd.t0)
    nk := name_kind(pg, mi, n)
    if nk == 0
        -- A variant without fields, named on its own: the image is its tag.
        vi := variant_fields_of(pg, name)
        if vi >= 0
            vitem := item_at(pg, u64.bits(vi))
            if vitem.size > 8
                -- A wide choice: the image in a fresh area, the tag alone.
                wb := tmp_area(ob, vitem.size)
                wz := emit_ins(ob, O_CONST, 0, 0, 0, 0)
                wk : u64 <- 0
                while wk * 8 < vitem.size
                    wd : u64 <- wb
                    if wk > 0
                        wo := emit_ins(ob, O_CONST, 0, 0, 0, wk * 8)
                        wd <- addr_add(ob, wb, wo)
                    end
                    emit_ins(ob, O_RSTORE, wd, wz, 8, 0)
                    wk <- wk + 1
                end
                wt := emit_ins(ob, O_CONST, 0, 0, 0, variant_ordinal(pg, u64.bits(vi), name))
                emit_ins(ob, O_RSTORE, wb, wt, 1, 0)
                ob.lastlen <- 0
                ret wb
            end
            ob.lastlen <- 0
            ret emit_ins(ob, O_CONST, 0, 0, 0, variant_ordinal(pg, u64.bits(vi), name))
        end
    end
    if nk == 1
        s := slot_of_local(pg, name)
        off := local_off(ob, s)
        ob.lastlen <- 0
        if is_zone_handle(pg, name) == 1
            -- The value of a zone opened here is the address of the triple
            -- it lives in, which is what a `zone` parameter is given and what
            -- every zone operation works through (ABI.md §2).
            ret local_base(pg, ob, name)
        end
        lt := loc_type(pg, name)
        if is_array_type(lt) == 1
            -- An array place read as a value is the view of its bytes.
            a := local_base(pg, ob, name)
            ob.lastlen <- emit_ins(ob, O_CONST, 0, 0, 0, arr_count(pg, lt))
            ret a
        end
        if layout_param(pg, lt) > 0
            -- A layout held by value reads as the address of its bytes.
            ret local_base(pg, ob, name)
        end
        v := emit_ins(ob, O_LOAD, off, 0, 0, 0)
        if is_view_type(lt) == 1
            ob.lastlen <- emit_ins(ob, O_LOAD, off + 1, 0, 0, 0)
        end
        ret v
    end
    if nk == 2
        -- An integer constant is its value. An aggregate one — `[N]T` or a
        -- layout — is read from the read-only segment like a static placed
        -- there (an array as the view of its bytes, a layout by its
        -- address); a view constant is E0900 still, never a zero in its
        -- place.
        kb := pg.sbuf
        kt := ety(pg, mi, n, kb[0..0])
        if is_float(kt) == 1
            ret emit_ins(ob, O_CONST, 0, 0, 0, const_float(pg, mi, n, float_fmt(kt)))
        end
        if is_view_type(kt) == 1
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        if is_array_type(kt) == 1
            kvi := val_find(pg, name)
            if kvi >= 0
                ret gen_static(pg, ob, mi, n, u64.bits(kvi))
            end
        end
        if layout_param(pg, kt) > 0
            kvi2 := val_find(pg, name)
            if kvi2 >= 0
                ret gen_static(pg, ob, mi, n, u64.bits(kvi2))
            end
        end
        ret emit_ins(ob, O_CONST, 0, 0, 0, const_value(pg, mi, n))
    end
    if nk == 3
        vi := val_find(pg, name)
        if vi >= 0
            ret gen_static(pg, ob, mi, n, u64.bits(vi))
        end
    end
    oir_err(ob, pg, mi, 900, n)
    ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
end

-- Layouts ----------------------------------------------------------------------
-- The item stage laid every layout out (ABI.md §3): `Item` has the size and
-- the alignment, each `Fld` its offset, and the field's type is the tokens of
-- its declaration. `layout_of` takes a type text — `Name`, `ref Name` or
-- `rw ref Name` — to the item, and `field_of` a field name to its index.

proc layout_of(pg: ref Prog, t: view u8) -> word
    nm : view u8 <- t
    if starts_with(nm, "mmio ")
        nm <- nm[5..]
    end
    if starts_with(nm, "rw ")
        nm <- nm[3..]
    end
    if starts_with(nm, "ref ")
        nm <- nm[4..]
    end
    -- `core.Site`: the item is known by its own name.
    ret item_find(pg, last_part(nm))
end

proc field_of(pg: ref Prog, it: u64, fname: view u8) -> word
    -- The index into `pg.flds` of the field, or -1.
    item := item_at(pg, it)
    cx := mod_ctx(pg, item.mod)
    f : u64 <- 0
    while f < item.nfld
        fr := fld_at(pg, item.first + f)
        fn := node_at(cx, fr.node)
        if view_eq(tok_text(cx, fn.t0), fname)
            ret word.bits(item.first + f)
        end
        f <- f + 1
    end
    ret -1
end

proc field_text(pg: rw ref Prog, fi: u64) -> view u8
    -- The type of a field, as the text the rest of the compiler compares.
    fr := fld_at(pg, fi)
    cx := mod_ctx(pg, fr.mod)
    st := sbeg(pg)
    sput_type_node(pg, fr.mod, kid1(cx, fr.node))
    ret sdone(pg, st)
end

proc is_packed(pg: ref Prog, it: u64) -> word
    item := item_at(pg, it)
    cx := mod_ctx(pg, item.mod)
    nd := node_at(cx, item.node)
    if nd.sub == 1
        ret 1
    end
    ret 0
end

proc is_ref_type(t: view u8) -> word
    if starts_with(unqual(t), "ref ")
        ret 1
    end
    ret 0
end

proc gen_field_addr(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- The address of `r.f`: the ref plus the field's offset. The index of
    -- the field is left in `pg.lastft` for the caller, which needs its type.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    nd := node_at(cx, n)
    base := kid1(cx, n)
    bt := ety(pg, mi, base, b[0..0])
    it := layout_of(pg, bt)
    if it < 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    fi := field_of(pg, u64.bits(it), tok_text(cx, nd.t0))
    if fi < 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    r := gen_expr(pg, ob, mi, base, b[0..0])
    ob.lastlen <- 0
    fr := fld_at(pg, u64.bits(fi))
    pg.lastft <- u64.bits(fi)
    if fr.off == 0
        ret r
    end
    off := emit_ins(ob, O_CONST, 0, 0, 0, fr.off)
    ret addr_add(ob, r, off)
end

proc byte_order(t: view u8) -> u64
    -- 1 for a `be` field, 2 for `le`, 0 for the machine's own order.
    if starts_with(t, "be ")
        ret 1
    end
    if starts_with(t, "le ")
        ret 2
    end
    ret 0
end

proc gen_bswap(ob: rw ref Oir, v: u64, nb: u64) -> u64
    -- The bytes of an `nb`-bit value reversed, with the shifts, masks and
    -- ors of the integer group (no `bswap` instruction of its own yet): a
    -- `be` field on this little-endian machine.
    bytes := nb / 8
    m255 := emit_ins(ob, O_CONST, 0, 0, 0, 255)
    r : u64 <- 0
    k : u64 <- 0
    while k < bytes
        piece : u64 <- v
        if k > 0
            sh := emit_ins(ob, O_CONST, 0, 0, 0, k * 8)
            piece <- emit_bin(ob, B_SHR, v, sh, 0)
        end
        piece <- emit_bin(ob, B_AND, piece, m255, 0)
        up := (bytes - 1 - k) * 8
        if up > 0
            sh2 := emit_ins(ob, O_CONST, 0, 0, 0, up)
            piece <- emit_bin(ob, B_SHL, piece, sh2, 0)
        end
        if k == 0
            r <- piece
        else
            r <- emit_bin(ob, B_OR, r, piece, 0)
        end
        k <- k + 1
    end
    ret r
end

proc gen_field_load(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `r.f`, by the field's type: an integer at its width and signedness
    -- (a `be` one byte-swapped after the load, then re-extended), a view as
    -- its two words, a ref or an address as one word, and a layout held by
    -- value as the address of that part of the record.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    vol := u64.bits(is_mmio(ety(pg, mi, kid1(cx, n), b[0..0])))
    p := gen_field_addr(pg, ob, mi, n)
    ft0 := field_text(pg, pg.lastft)
    bo := byte_order(ft0)
    ft := native_int(ft0)
    if is_view_type(ft) == 1
        a := emit_ins(ob, O_RLOAD, p, 8, 0, vol)
        eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
        ob.lastlen <- emit_ins(ob, O_RLOAD, addr_add(ob, p, eight), 8, 0, vol)
        ret a
    end
    nb := mem_bits(ft)
    if nb > 0
        sg : u64 <- 0
        if int_signed(ft) == 1
            sg <- 1
        end
        ob.lastlen <- 0
        if bo == 1
            raw := emit_ins(ob, O_RLOAD, p, u64.bits(nb) / 8, 0, vol)
            sw := gen_bswap(ob, raw, u64.bits(nb))
            if sg == 1
                ret emit_ins(ob, O_TRUNC, sw, u64.bits(nb), 1, 0)
            end
            ret sw
        end
        ret emit_ins(ob, O_RLOAD, p, u64.bits(nb) / 8, sg, vol)
    end
    if is_ref_type(ft) == 1
        ob.lastlen <- 0
        ret emit_ins(ob, O_RLOAD, p, 8, 0, vol)
    end
    if starts_with(unqual(ft), "addr ")
        ob.lastlen <- 0
        ret emit_ins(ob, O_RLOAD, p, 8, 0, vol)
    end
    if layout_of(pg, ft) >= 0
        if vol == 1
            -- A record inside device memory as a value: not lowered.
            oir_err(ob, pg, mi, 900, n)
        end
        ob.lastlen <- 0
        ret p
    end
    oir_err(ob, pg, mi, 900, n)
    ret p
end

proc gen_store_field(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `r.f <- x`, by the field's type: the same widths as the load.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    tgt := kid1(cx, n)
    vol := u64.bits(is_mmio(ety(pg, mi, kid1(cx, tgt), b[0..0])))
    p := gen_field_addr(pg, ob, mi, tgt)
    fi := pg.lastft
    ft0 := field_text(pg, fi)
    bo := byte_order(ft0)
    ft := native_int(ft0)
    v0 := gen_expr(pg, ob, mi, kid2(cx, n), ft)
    v : u64 <- v0
    if bo == 1
        -- A `be` field: the bytes reversed before the store.
        v <- gen_bswap(ob, v0, u64.bits(int_bits(ft)))
    end
    if is_view_type(ft) == 1
        ln := ob.lastlen
        emit_ins(ob, O_RSTORE, p, v, 8, vol)
        eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
        emit_ins(ob, O_RSTORE, addr_add(ob, p, eight), ln, 8, vol)
        ret
    end
    nb := mem_bits(ft)
    if nb > 0
        emit_ins(ob, O_RSTORE, p, v, u64.bits(nb) / 8, vol)
        ret
    end
    if is_ref_type(ft) == 1
        emit_ins(ob, O_RSTORE, p, v, 8, vol)
        ret
    end
    if starts_with(unqual(ft), "addr ")
        emit_ins(ob, O_RSTORE, p, v, 8, vol)
        ret
    end
    lp := layout_param(pg, ft)
    if lp > 0
        gen_copy(ob, p, v, lp)
        ret
    end
    oir_err(ob, pg, mi, 900, n)
end

proc gen_make(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `z.make(Name)`: `Name.size` zeroed bytes from the zone, at the layout's
    -- alignment (the zone's own sixteen when that is more). A fresh mapping
    -- is zero and a zone never hands out a byte twice, so nothing is cleared.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    ce := kid1(cx, n)
    arg := sibling(cx, ce)
    an := node_at(cx, arg)
    it := item_find(pg, tok_text(cx, an.t0))
    if it < 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    item := item_at(pg, u64.bits(it))
    zv := gen_expr(pg, ob, mi, kid1(cx, ce), b[0..0])
    sz := emit_ins(ob, O_CONST, 0, 0, 0, item.size)
    r := emit_ins(ob, O_ZALLOC, zv, sz, item.alignv, 0)
    ri := ins_at(ob, r)
    ri.site <- trap_static(pg, ob, mi, TK_ZONE, n) + 1
    ob.lastlen <- 0
    ret r
end

proc gen_at(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `Name.at(v)`: a ref over the bytes of a view, which is the view's
    -- address once two checks hold — the view is at least `Name.size` long
    -- (`check.range 0, size, len`, the same condition as a subview) and,
    -- unless the layout is packed, aligned to `Name.align`.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    ce := kid1(cx, n)
    an := node_at(cx, kid1(cx, ce))
    it := item_find(pg, tok_text(cx, an.t0))
    if it < 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    item := item_at(pg, u64.bits(it))
    a := gen_expr(pg, ob, mi, sibling(cx, ce), b[0..0])
    ln := ob.lastlen
    zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    sz := emit_ins(ob, O_CONST, 0, 0, 0, item.size)
    ck := emit_ins(ob, O_CHKR, zero, sz, 0, ln)
    ci := ins_at(ob, ck)
    ci.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
    if item.alignv > 1
        if is_packed(pg, u64.bits(it)) == 0
            ca := emit_ins(ob, O_CHKA, a, item.alignv, 0, 0)
            cai := ins_at(ob, ca)
            cai.site <- trap_static(pg, ob, mi, TK_MISALIGN, n) + 1
        end
    end
    ob.lastlen <- 0
    ret a
end

proc is_zone_handle(pg: ref Prog, name: view u8) -> word
    -- A zone opened by `zone` owns its triple; a `zone` parameter was handed
    -- the address of someone else's, and reads like any other word.
    i := loc_find(pg, name)
    if i < 0
        ret 0
    end
    l := loc_at(pg, u64.bits(i))
    if l.kind == L_ZONE
        ret 1
    end
    ret 0
end

proc gen_field(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    nd := node_at(cx, n)
    m := tok_text(cx, nd.t0)
    base := kid1(cx, n)
    bn := node_at(cx, base)
    if bn.kind == N_FIELD
        -- `Name.field.offset` / `Name.field.size`: a constant.
        if field_const_kind(pg, mi, n) > 0
            ret emit_ins(ob, O_CONST, 0, 0, 0, const_value(pg, mi, n))
        end
    end
    if bn.kind == N_NAME
        if name_kind(pg, mi, base) == 0
            ci := val_find(pg, m)
            if ci >= 0
                ret emit_ins(ob, O_CONST, 0, 0, 0, const_of(pg, u64.bits(ci)))
            end
            ret emit_ins(ob, O_CONST, 0, 0, 0, const_value(pg, mi, n))
        end
    end
    -- A field of a layout first: a layout may well have a field named `len`
    -- or `addr` (the compiler's own `Tok` does), and it is the type of the
    -- base that says which is meant, not the name.
    if layout_of(pg, ety(pg, mi, base, b[0..0])) >= 0
        ret gen_field_load(pg, ob, mi, n)
    end
    if view_eq(m, "addr")
        v := gen_expr(pg, ob, mi, base, b[0..0])
        ob.lastlen <- 0
        ret v
    end
    if view_eq(m, "len")
        gen_expr(pg, ob, mi, base, b[0..0])
        l := ob.lastlen
        ob.lastlen <- 0
        ret l
    end
    oir_err(ob, pg, mi, 900, n)
    ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
end

proc gen_index_addr(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- The address of `v[i]`, with the bounds check that makes it an address
    -- inside the view. The element size is left in `ob.lastlen` for the
    -- caller, which loads or stores exactly that many bytes.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    base := kid1(cx, n)
    bt := ety(pg, mi, base, b[0..0])
    if arr_or_view(bt) == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    sz := elem_bytes(pg, ob, mi, bt, n)
    a := gen_expr(pg, ob, mi, base, b[0..0])
    ln : u64 <- ob.lastlen
    if is_vector(bt) == 1
        -- A vector's lanes: its address, and the count as the length.
        ln <- emit_ins(ob, O_CONST, 0, 0, 0, vec_count(bt))
    end
    idx := gen_expr(pg, ob, mi, kid2(cx, n), "uword")
    ck := emit_ins(ob, O_CHKB, idx, ln, 0, 0)
    ci := ins_at(ob, ck)
    ci.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
    p := addr_add(ob, a, scale_by(ob, idx, sz))
    ob.lastlen <- sz
    ret p
end

proc gen_index(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    ix := node_at(cx, kid2(cx, n))
    if ix.kind == N_RANGE
        ret gen_subview(pg, ob, mi, n)
    end
    p := gen_index_addr(pg, ob, mi, n)
    sz := ob.lastlen
    bt := ety(pg, mi, kid1(cx, n), b[0..0])
    et := view_elem(bt)
    ob.lastlen <- 0
    vol := u64.bits(is_mmio(bt))
    if layout_param(pg, et) > 0
        if vol == 1
            -- A layout in device memory would be read as plain memory.
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
        -- A layout element is its address.
        ret p
    end
    sg : u64 <- 0
    if int_signed(et) == 1
        sg <- 1
    end
    -- Through an `mmio` view the load is in space `mmio` (OIR_SPEC §1.4):
    -- volatile, so no pass removes, merges or reorders it.
    ret emit_ins(ob, O_RLOAD, p, sz, sg, vol)
end

proc gen_subview(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `v[a..b]`, `v[..b]`, `v[a..]`: one check that `a <= b <= v.len`, then
    -- the pair the new view is.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    base := kid1(cx, n)
    bt := ety(pg, mi, base, b[0..0])
    if arr_or_view(bt) == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    sz := elem_bytes(pg, ob, mi, bt, n)
    a := gen_expr(pg, ob, mi, base, b[0..0])
    ln := ob.lastlen
    rg := kid2(cx, n)
    lon := range_lo(cx, rg)
    hin := range_hi(cx, rg)
    lo : u64 <- 0
    if lon == 0
        lo <- emit_ins(ob, O_CONST, 0, 0, 0, 0)
    else
        lo <- gen_expr(pg, ob, mi, lon, "uword")
    end
    hi : u64 <- 0
    if hin == 0
        hi <- ln
    else
        hi <- gen_expr(pg, ob, mi, hin, "uword")
    end
    ck := emit_ins(ob, O_CHKR, lo, hi, 0, ln)
    ci := ins_at(ob, ck)
    ci.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
    p := addr_add(ob, a, scale_by(ob, lo, sz))
    ob.lastlen <- emit_bin(ob, B_SUB, hi, lo, 0)
    ret p
end

proc gen_binop(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, want: view u8) -> u64
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    nd := node_at(cx, n)
    op := tok_text(cx, nd.t0)
    if view_eq(op, "and")
        ret gen_andor(pg, ob, mi, n, 1)
    end
    if view_eq(op, "or")
        ret gen_andor(pg, ob, mi, n, 0)
    end
    code := binop_code(op)
    if code == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    ot := binop_operand_type(pg, mi, n)
    if is_float(ot) == 1
        ret gen_fbinop(pg, ob, mi, n, ot)
    end
    if is_vector(ot) == 1
        ret gen_vbinop(pg, ob, mi, n, ot)
    end
    if ot.len == 0
        -- Two float literals: the context names the format.
        if is_float(want) == 1
            if binop_is_compare(op) == 0
                ret gen_fbinop(pg, ob, mi, n, want)
            end
        end
    end
    lw : view u8 <- ot
    if binop_is_compare(op) == 0
        lw <- want
        if int_bits(lw) == 0
            lw <- ot
        end
    end
    lv := gen_expr(pg, ob, mi, kid1(cx, n), lw)
    rw2 : view u8 <- lw
    if is_shift(op)
        rw2 <- shift_count_type(pg, mi, kid2(cx, n))
    end
    rv := gen_expr(pg, ob, mi, kid2(cx, n), rw2)
    sg : u64 <- 0
    if int_signed(lw) == 1
        sg <- 1
    end
    ob.lastlen <- 0
    v := emit_bin(ob, code, lv, rv, sg)
    ins := ins_at(ob, v)
    ins.w <- u64.bits(int_bits(lw))
    if binop_traps(code) == 1
        if ins.w > 0
            if ob.amode >= AM_SAT
                if is_divide(code) == 0
                    -- `sat` and `checked`: the operation itself does not trap;
                    -- what it did is read afterwards and answered for.
                    ob.mbits <- ins.w
                    ob.msg <- sg
                    if ins.w < 64
                        -- Computed on the whole word, where two canonical
                        -- narrow operands cannot overflow, and clamped or
                        -- tested against the type's range afterwards.
                        ins.w <- 64
                    end
                    ret gen_mode_bin(pg, ob, mi, n, v)
                end
            end
            if is_divide(code) == 1
                -- A zero divisor has no answer any mode could name, so `/`
                -- and `%` keep that trap inside `wrap`. The overflow site is
                -- for `/` alone: `%` answers 0 where the quotient would not
                -- fit (design 0006; MACHINE_MODEL.md §7).
                ins.site <- trap_static(pg, ob, mi, TK_DIV, n) + 1
                if code == B_DIV
                    ins.site2 <- trap_static(pg, ob, mi, TK_OVF, n) + 1
                end
            elif ob.amode == 0
                ins.site <- trap_static(pg, ob, mi, TK_OVF, n) + 1
            end
        end
    end
    ret v
end

-- Range of an integer type, as the word patterns the constants are held in.

proc type_max(nbits: u64, sg: u64) -> u64
    if nbits >= 64
        if sg == 1
            ret 9223372036854775807
        end
        ret 18446744073709551615
    end
    one : u64 <- 1
    if sg == 1
        ret (one << (nbits - 1)) - 1
    end
    ret (one << nbits) - 1
end

proc type_min(nbits: u64, sg: u64) -> u64
    if sg != 1
        ret 0
    end
    if nbits >= 64
        ret 9223372036854775808
    end
    -- The pattern of `-2^(nbits-1)` on the word: `2^64 - 2^(nbits-1)`,
    -- written without the `2^64` no literal can hold.
    one : u64 <- 1
    ret 18446744073709551615 - (one << (nbits - 1)) + 1
end

proc gen_mode_bin(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, v: u64) -> u64
    -- `sat` or `checked` for the operation `v` of `ob.mbits` nbits and
    -- signedness `ob.msg`. A narrow type's overflow is a comparison of the
    -- whole-word result with the type's range; a 64-bit type's is the flag
    -- the machine set, read by `ovf.of` before anything else sets one.
    nbits := ob.mbits
    sg := ob.msg
    if nbits < 64
        -- The whole-word result of a narrow operation is compared with the
        -- range as a signed word wherever it can be negative — a signed
        -- type, an unsigned subtraction or negation — and as an unsigned one
        -- otherwise, where a product of two u32 can pass 2^63.
        ins0 := ins_at(ob, v)
        csg : u64 <- 1
        if sg == 0
            if ins0.op == O_BIN
                if ins0.bop != B_SUB
                    csg <- 0
                end
            end
        end
        mx := emit_ins(ob, O_CONST, 0, 0, 0, type_max(nbits, sg))
        mn := emit_ins(ob, O_CONST, 0, 0, 0, type_min(nbits, sg))
        gt := emit_bin(ob, B_GT, v, mx, csg)
        lt := emit_bin(ob, B_LT, v, mn, csg)
        if ob.amode == AM_CHECKED
            f := emit_bin(ob, B_OR, gt, lt, 0)
            note_overflow(ob, f)
            ret v
        end
        ret gen_select2(ob, v, gt, mx, lt, mn)
    end
    f2 := emit_ins(ob, O_OVF, v, 0, sg, 0)
    if ob.amode == AM_CHECKED
        note_overflow(ob, f2)
        ret v
    end
    -- Saturation on the whole word: the bound the true answer passed. For a
    -- signed operation the wrapped result has the opposite sign to the true
    -- one; for an unsigned one only `-` can go below zero.
    ins := ins_at(ob, v)
    bound : u64 <- 0
    if sg == 1
        zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
        neg := emit_bin(ob, B_LT, v, zero, 1)
        mxs := emit_ins(ob, O_CONST, 0, 0, 0, type_max(64, 1))
        mns := emit_ins(ob, O_CONST, 0, 0, 0, type_min(64, 1))
        bound <- gen_select(ob, neg, mxs, mns)
    elif ins.bop == B_SUB
        bound <- emit_ins(ob, O_CONST, 0, 0, 0, 0)
    else
        bound <- emit_ins(ob, O_CONST, 0, 0, 0, type_max(64, 0))
    end
    ret gen_select(ob, f2, bound, v)
end

proc note_overflow(ob: rw ref Oir, f: u64)
    -- `checked(e)`: every overflow inside `e` joins one flag, which the
    -- `else` or `case` that resolves the value branches on.
    t := ob.ovfacc
    if t == 0
        ret
    end
    cur := emit_ins(ob, O_LOAD, t - 1, 0, 0, 0)
    acc := emit_bin(ob, B_OR, cur, f, 0)
    emit_ins(ob, O_STORE, t - 1, acc, 0, 0)
end

proc gen_select(ob: rw ref Oir, c: u64, a: u64, b: u64) -> u64
    -- `c ? a : b` through a place, which `mem2reg` makes the phi.
    t := new_tmp(ob)
    emit_ins(ob, O_STORE, t, b, 0, 0)
    ldone := new_label(ob)
    emit_ins(ob, O_BRANCH, c, 0, 0, ldone)
    emit_ins(ob, O_STORE, t, a, 0, 0)
    emit_ins(ob, O_LABEL, ldone, 0, 0, 0)
    ret emit_ins(ob, O_LOAD, t, 0, 0, 0)
end

proc gen_select2(ob: rw ref Oir, v: u64, gt: u64, mx: u64, lt: u64, mn: u64) -> u64
    -- `gt ? mx : (lt ? mn : v)`: the clamp of a value to a range.
    t := new_tmp(ob)
    emit_ins(ob, O_STORE, t, v, 0, 0)
    lelse := new_label(ob)
    ldone := new_label(ob)
    emit_ins(ob, O_BRANCH, gt, 0, 0, lelse)
    emit_ins(ob, O_STORE, t, mx, 0, 0)
    emit_ins(ob, O_JMP, ldone, 0, 0, 0)
    emit_ins(ob, O_LABEL, lelse, 0, 0, 0)
    emit_ins(ob, O_BRANCH, lt, 0, 0, ldone)
    emit_ins(ob, O_STORE, t, mn, 0, 0)
    emit_ins(ob, O_LABEL, ldone, 0, 0, 0)
    ret emit_ins(ob, O_LOAD, t, 0, 0, 0)
end

proc gen_clamp(ob: rw ref Oir, v: u64, nbits: u64, sg: u64) -> u64
    -- `T.sat(x)`: `x` clamped to the range of `T`. `x` is read with the
    -- signedness of its own type, which `ob.msg` holds.
    mx := emit_ins(ob, O_CONST, 0, 0, 0, type_max(nbits, sg))
    mn := emit_ins(ob, O_CONST, 0, 0, 0, type_min(nbits, sg))
    gt := emit_bin(ob, B_GT, v, mx, ob.msg)
    lt := emit_bin(ob, B_LT, v, mn, ob.msg)
    ret gen_select2(ob, v, gt, mx, lt, mn)
end

proc gen_in_range(ob: rw ref Oir, v: u64, nbits: u64, sg: u64) -> u64
    -- `T.checked(x)`: 1 when `x` is outside the range of `T`.
    mx := emit_ins(ob, O_CONST, 0, 0, 0, type_max(nbits, sg))
    mn := emit_ins(ob, O_CONST, 0, 0, 0, type_min(nbits, sg))
    gt := emit_bin(ob, B_GT, v, mx, ob.msg)
    lt := emit_bin(ob, B_LT, v, mn, ob.msg)
    ret emit_bin(ob, B_OR, gt, lt, 0)
end

proc is_divide(code: u64) -> word
    if code == B_DIV
        ret 1
    end
    if code == B_REM
        ret 1
    end
    ret 0
end

proc binop_traps(code: u64) -> word
    -- `+ - * / %` trap on overflow; the bit operators, the shifts and the
    -- comparisons cannot (design 0006, MACHINE_MODEL.md §3).
    if code == B_ADD
        ret 1
    end
    if code == B_SUB
        ret 1
    end
    if code == B_MUL
        ret 1
    end
    if code == B_DIV
        ret 1
    end
    if code == B_REM
        ret 1
    end
    ret 0
end

proc gen_andor(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, isand: u64) -> u64
    -- `and` and `or` short-circuit, so the right operand sits under a branch
    -- and the result is one value written from two arms. That is a place with
    -- two definitions, so it is written as one: a compiler-made place that
    -- `mem2reg` promotes to the phi OIR_SPEC §5 shows at such a join.
    cx := mod_ctx(pg, mi)
    t := new_tmp(ob)
    lv := gen_expr(pg, ob, mi, kid1(cx, n), "bool")
    emit_ins(ob, O_STORE, t, lv, 0, 0)
    done := new_label(ob)
    if isand == 1
        emit_ins(ob, O_BRANCH, lv, 0, 0, done)
    else
        nv := emit_un(ob, U1_LNOT, lv)
        emit_ins(ob, O_BRANCH, nv, 0, 0, done)
    end
    rv := gen_expr(pg, ob, mi, kid2(cx, n), "bool")
    emit_ins(ob, O_STORE, t, rv, 0, 0)
    emit_ins(ob, O_LABEL, done, 0, 0, 0)
    ob.lastlen <- 0
    ret emit_ins(ob, O_LOAD, t, 0, 0, 0)
end

proc gen_unop(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, want: view u8) -> u64
    cx := mod_ctx(pg, mi)
    s := nd_sub(pg, mi, n)
    arg := kid1(cx, n)
    if s == U_NEG
        -- The width and the signedness decide both the flag the overflow
        -- check reads (`jo` signed, `jc` unsigned) and how the result is
        -- re-extended, so an operation without them is neither checked nor
        -- canonical.
        ut := ety(pg, mi, n, want)
        if is_float(ut) == 1
            -- A float's sign is its top bit.
            fv := gen_expr(pg, ob, mi, arg, ut)
            sgn := emit_ins(ob, O_CONST, 0, 0, 0, float_sign(float_fmt(ut)))
            ob.lastlen <- 0
            ret emit_bin(ob, B_XOR, fv, sgn, 0)
        end
        v := gen_expr(pg, ob, mi, arg, want)
        u := emit_un(ob, U1_NEG, v)
        iu := ins_at(ob, u)
        iu.w <- u64.bits(int_bits(ut))
        iu.c <- u64.bits(int_signed(ut))
        if iu.w > 0
            if ob.amode >= AM_SAT
                ob.mbits <- iu.w
                ob.msg <- iu.c
                if iu.w < 64
                    iu.w <- 64
                end
                iu.bop <- U1_NEG
                ret gen_mode_neg(pg, ob, mi, n, u)
            end
            if ob.amode == 0
                iu.site <- trap_static(pg, ob, mi, TK_OVF, n) + 1
            end
        end
        ret u
    end
    if s == U_BITNOT
        ut2 := ety(pg, mi, n, want)
        v2 := gen_expr(pg, ob, mi, arg, want)
        u2 := emit_un(ob, U1_BNOT, v2)
        iu2 := ins_at(ob, u2)
        iu2.w <- u64.bits(int_bits(ut2))
        iu2.c <- u64.bits(int_signed(ut2))
        ret u2
    end
    if s == U_NOT
        v3 := gen_expr(pg, ob, mi, arg, "bool")
        ret emit_un(ob, U1_LNOT, v3)
    end
    if s == U_REFOF
        -- `ref x`: the address of a place. A local keeps its frame words
        -- once its address is taken (`mem2reg`, OIR_SPEC §2.1); a field is
        -- the address of that part of the record.
        pn := node_at(cx, arg)
        if pn.kind == N_NAME
            sl := slot_of_local(pg, tok_text(cx, pn.t0))
            if sl >= 0
                ob.lastlen <- 0
                ret local_base(pg, ob, tok_text(cx, pn.t0))
            end
            if name_kind(pg, mi, arg) >= 2
                -- A static: its address in the writable or the read-only
                -- segment; an aggregate constant: its address in the
                -- read-only one (an integer constant has none, E0900).
                svi := val_find(pg, tok_text(cx, pn.t0))
                if svi >= 0
                    ob.lastlen <- 0
                    sdi := data_of(ob, u64.bits(svi))
                    if sdi >= 0
                        ret emit_ins(ob, O_DADDR, u64.bits(sdi), 0, 0, 0)
                    end
                    sri := rodata_of(ob, u64.bits(svi))
                    if sri >= 0
                        ret emit_ins(ob, O_SADDR, u64.bits(sri), 0, 0, 0)
                    end
                end
            end
        end
        if pn.kind == N_FIELD
            pa := gen_field_addr(pg, ob, mi, arg)
            ob.lastlen <- 0
            ret pa
        end
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    if s == U_WRAP
        save := ob.amode
        ob.amode <- AM_WRAP
        vw := gen_expr(pg, ob, mi, arg, want)
        ob.amode <- save
        ret vw
    end
    if s == U_SAT
        save2 := ob.amode
        ob.amode <- AM_SAT
        vs := gen_expr(pg, ob, mi, arg, want)
        ob.amode <- save2
        ret vs
    end
    if s == U_CHECKED
        -- Only `else` and `case` can resolve what `checked` answers, and
        -- they generate it themselves (`gen_fallible`); reached here it has
        -- nowhere to put its failure.
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    oir_err(ob, pg, mi, 900, n)
    ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
end

proc gen_mode_neg(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, u: u64) -> u64
    -- `sat`/`checked` for a negation: a narrow type by the range, a 64-bit
    -- one by the flag; an unsigned negation of anything but 0 is the
    -- overflow, and saturates to 0.
    nbits := ob.mbits
    sg := ob.msg
    if nbits < 64
        ob.mbits <- nbits
        ret gen_mode_bin(pg, ob, mi, n, u)
    end
    f := emit_ins(ob, O_OVF, u, 0, sg, 0)
    if ob.amode == AM_CHECKED
        note_overflow(ob, f)
        ret u
    end
    bound : u64 <- 0
    if sg == 1
        -- Only MIN overflows, and its negation saturates to MAX.
        bound <- emit_ins(ob, O_CONST, 0, 0, 0, type_max(64, 1))
    else
        bound <- emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    ret gen_select(ob, f, bound, u)
end

proc gen_checked(pg: rw ref Prog, ob: rw ref Oir, mi: u64, e: u64, want: view u8) -> u64
    -- `checked(e)`: the value of `e` with every overflow inside it joined
    -- into one flag, which is left in `ob.lastpay`'s place: the tag of the
    -- fallible value, 0 for ok, as a call's tag is.
    t := new_tmp(ob)
    zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    emit_ins(ob, O_STORE, t, zero, 0, 0)
    saveacc := ob.ovfacc
    savemode := ob.amode
    ob.ovfacc <- t + 1
    ob.amode <- AM_CHECKED
    v := gen_expr(pg, ob, mi, e, want)
    ob.amode <- savemode
    ob.ovfacc <- saveacc
    ob.lastpay <- v
    ret emit_ins(ob, O_LOAD, t, 0, 0, 0)
end

proc gen_fallible(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- The tag of a fallible value — 0 for ok — with its payload in
    -- `ob.lastpay`: a call answering `T or E`, `checked(e)`, or
    -- `T.checked(x)`. Returns 0 with `ob.lastpay` 0 when `n` is none.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    nd := node_at(cx, n)
    if nd.kind == N_UNOP
        if nd.sub == U_CHECKED
            ret gen_checked(pg, ob, mi, kid1(cx, n), ety(pg, mi, n, b[0..0]))
        end
    end
    if nd.kind == N_CONVERT
        mn := node_at(cx, kid1(cx, n))
        if mn.kind == N_MODE
            if view_eq(tok_text(cx, mn.t0), "checked")
                -- `T.checked(x)`: outside the range of `T` is the failure.
                arg := sibling(cx, kid1(cx, n))
                dst := ety(pg, mi, n, b[0..0])
                src := ety(pg, mi, arg, b[0..0])
                v := gen_expr(pg, ob, mi, arg, b[0..0])
                ob.msg <- u64.bits(int_signed(src))
                f := gen_in_range(ob, v, u64.bits(int_bits(dst)), u64.bits(int_signed(dst)))
                ob.lastpay <- v
                ret f
            end
        end
    end
    ct := ety(pg, mi, n, b[0..0])
    if is_fallible(ct) == 0
        ob.lastpay <- 0
        ret 0
    end
    tag := gen_expr(pg, ob, mi, n, b[0..0])
    ret tag
end

proc nd_sub(pg: ref Prog, mi: u64, n: u64) -> u64
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, n)
    ret nd.sub
end

proc narrow_extend(ob: rw ref Oir, v: u64, t: view u8) -> u64
    -- An integer narrower than a word, or a `bool`, re-extended from its
    -- low bits to the canonical word (sign for a signed type); any other
    -- value as it is.
    nb : u64 <- 0
    if int_bits(t) > 0
        nb <- u64.bits(int_bits(t))
    end
    if view_eq(t, "bool")
        nb <- 8
    end
    if nb == 0
        ret v
    end
    if nb >= 64
        ret v
    end
    sg : u64 <- 0
    if int_signed(t) == 1
        sg <- 1
    end
    ret emit_ins(ob, O_TRUNC, v, nb, sg, 0)
end

proc gen_to_float(ob: rw ref Oir, v: u64, src: view u8, dst: view u8) -> u64
    -- A value converted to the float `dst`: a literal or a float of the
    -- same format as it is; `f32` to `f64` and back; an integer through
    -- `cvtsi2sd`/`cvtsi2ss` (a u64 above 2^63 halved and doubled);
    -- `F.bits(u)` as the same bits.
    if src.len == 0
        ret v
    end
    if view_eq(src, dst)
        ret v
    end
    if is_float(src) == 1
        if view_eq(dst, "f64")
            ret emit_ins(ob, O_FCVT, v, 0, 3, 64)
        end
        ret emit_ins(ob, O_FCVT, v, 0, 4, 32)
    end
    if int_bits(src) == 0
        ret v
    end
    if ob.convbits == 1
        ret v
    end
    k : u64 <- 0
    if int_bits(src) == 64
        if int_signed(src) == 0
            k <- 1
        end
    end
    ret emit_ins(ob, O_FCVT, v, 0, k, float_width(dst))
end

proc gen_convert(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    mnode := kid1(cx, n)
    mn := node_at(cx, mnode)
    arg : u64 <- mnode
    if mn.kind == N_MODE
        arg <- sibling(cx, mnode)
    end
    dst := ety(pg, mi, n, b[0..0])
    src := ety(pg, mi, arg, b[0..0])
    ob.convbits <- 0
    if mn.kind == N_MODE
        if view_eq(tok_text(cx, mn.t0), "bits")
            ob.convbits <- 1
        end
    end
    pg.convbits <- ob.convbits
    v := gen_expr(pg, ob, mi, arg, conv_operand_want(pg, mi, arg, dst))
    pg.convbits <- 0
    if is_float(dst) == 1
        ret gen_to_float(ob, v, src, dst)
    end
    if is_float(src) == 1
        if mn.kind == N_MODE
            if view_eq(tok_text(cx, mn.t0), "bits")
                -- The same bits read as the unsigned integer of the width.
                if view_eq(src, "f32")
                    ret gen_conv(ob, v, "u32", dst)
                end
                ret gen_conv(ob, v, "u64", dst)
            end
        end
        -- `T.wrap(f)`: truncated toward zero to 64 bits, then wrapped.
        if int_bits(dst) == 64
            if int_signed(dst) == 0
                ret emit_ins(ob, O_FCVT, v, 0, 5, float_width(src))
            end
        end
        t64 := emit_ins(ob, O_FCVT, v, 0, 2, float_width(src))
        ret gen_conv(ob, t64, "s64", dst)
    end
    if starts_with(dst, "own ")
        -- `own T (e)` and `T(h)`: the same bits, ZERO (design 0002).
        ret v
    end
    if starts_with(src, "own ")
        ret v
    end
    if mn.kind == N_MODE
        if view_eq(tok_text(cx, mn.t0), "wrap")
            ret gen_conv(ob, v, src, dst)
        end
        if view_eq(tok_text(cx, mn.t0), "bits")
            ret gen_conv(ob, v, src, dst)
        end
        if view_eq(tok_text(cx, mn.t0), "sat")
            -- `T.sat(x)`: `x` clamped to the range of `T`, read as its own
            -- type says.
            ob.msg <- u64.bits(int_signed(src))
            ret gen_clamp(ob, v, u64.bits(int_bits(dst)), u64.bits(int_signed(dst)))
        end
        oir_err(ob, pg, mi, 900, n)
        ret v
    end
    ret gen_conv(ob, v, src, dst)
end

proc gen_expr(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, want: view u8) -> u64
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    nd := node_at(cx, n)
    k := nd.kind
    ob.lastlen <- 0
    if k == N_FLOAT
        ret emit_ins(ob, O_CONST, 0, 0, 0, const_float(pg, mi, n, float_fmt(want)))
    end
    if k == N_INT
        if is_float(want) == 1
            ret emit_ins(ob, O_CONST, 0, 0, 0, float_int_bits(nd.val, u64(nd.sub), float_fmt(want)))
        end
        v : u64 <- nd.val
        if nd.sub == 1
            -- The two's complement image of a negative literal, without the
            -- `0 - v` that would trap on the unsigned word it is computed in.
            if v != 0
                v <- 18446744073709551615 - v + 1
            end
        end
        ret emit_ins(ob, O_CONST, 0, 0, 0, v)
    end
    if k == N_CHAR
        t := ctok(cx, nd.t0)
        ret emit_ins(ob, O_CONST, 0, 0, 0, t.val)
    end
    if k == N_TRUE
        ret emit_ins(ob, O_CONST, 0, 0, 0, 1)
    end
    if k == N_FALSE
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    if k == N_STR
        si := add_static(ob, tok_text(cx, nd.t0))
        st := stat_at(ob, si)
        a := emit_ins(ob, O_SADDR, si, 0, 0, 0)
        ob.lastlen <- emit_ins(ob, O_SLEN, si, 0, 0, 0)
        ret a
    end
    if k == N_NAME
        ret gen_name(pg, ob, mi, n)
    end
    if k == N_LIT
        ret gen_variant_lit(pg, ob, mi, n)
    end
    if k == N_FIELD
        ret gen_field(pg, ob, mi, n)
    end
    if k == N_INDEX
        ret gen_index(pg, ob, mi, n)
    end
    if k == N_BINOP
        ret gen_binop(pg, ob, mi, n, want)
    end
    if k == N_UNOP
        ret gen_unop(pg, ob, mi, n, want)
    end
    if k == N_CONVERT
        ret gen_convert(pg, ob, mi, n)
    end
    if k == N_CALL
        ret gen_call(pg, ob, mi, n)
    end
    if k == N_FALLBACK
        ret gen_fallback(pg, ob, mi, n)
    end
    if k == N_RAWLOAD
        ret gen_rawload(pg, ob, mi, n)
    end
    if k == N_HWPLACE
        ret gen_hwload(pg, ob, mi, n)
    end
    oir_err(ob, pg, mi, 900, n)
    ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
end

-- Statements ------------------------------------------------------------------

proc gen_store_local(pg: rw ref Prog, ob: rw ref Oir, mi: u64, name: view u8, val: u64)
    -- oli-core passes six argument words, and a view costs two, so the node
    -- for a diagnostic is taken from `pg.curstmt` instead of a parameter.
    s := slot_of_local(pg, name)
    if s < 0
        oir_err(ob, pg, mi, 900, pg.curstmt)
        ret
    end
    off := local_off(ob, s)
    lt := loc_type(pg, name)
    lp := layout_param(pg, lt)
    if lp > 0
        -- A layout by value: the bytes are copied into the local's words.
        gen_copy(ob, local_base(pg, ob, name), val, lp)
        ret
    end
    emit_ins(ob, O_STORE, off, val, 0, 0)
    if is_view_type(lt) == 1
        emit_ins(ob, O_STORE, off + 1, ob.lastlen, 0, 0)
    end
end

proc gen_copy(ob: rw ref Oir, dst: u64, src: u64, n: u64)
    -- `n` bytes from `src` to `dst`, exactly: words, then a 4, a 2 and a
    -- 1 for what is left, so nothing past the object is touched (the COPY
    -- cost class, one move per piece).
    pos : u64 <- 0
    while pos + 8 <= n
        copy_piece(ob, dst, src, pos, 8)
        pos <- pos + 8
    end
    if pos + 4 <= n
        copy_piece(ob, dst, src, pos, 4)
        pos <- pos + 4
    end
    if pos + 2 <= n
        copy_piece(ob, dst, src, pos, 2)
        pos <- pos + 2
    end
    if pos < n
        copy_piece(ob, dst, src, pos, 1)
    end
end

proc copy_piece(ob: rw ref Oir, dst: u64, src: u64, pos: u64, w: u64)
    s : u64 <- src
    d : u64 <- dst
    if pos > 0
        off := emit_ins(ob, O_CONST, 0, 0, 0, pos)
        s <- addr_add(ob, src, off)
        d <- addr_add(ob, dst, off)
    end
    v := emit_ins(ob, O_RLOAD, s, w, 0, 0)
    emit_ins(ob, O_RSTORE, d, v, w, 0)
end

proc tmp_area(ob: rw ref Oir, nbytes: u64) -> u64
    -- The address of a fresh area of the frame that holds `nbytes`: as many
    -- compiler-made words as it takes, the last one first in memory.
    nw := (nbytes + 7) / 8
    last : u64 <- 0
    k : u64 <- 0
    while k < nw
        last <- new_tmp(ob)
        k <- k + 1
    end
    ret emit_ins(ob, O_FADDR, last, 0, 0, 0)
end

proc gen_bind(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, n)
    name := tok_text(cx, nd.t0)
    v : u64 <- kid1(cx, n)
    if nd.val >= 2
        v <- sibling(cx, v)
    end
    val := gen_expr(pg, ob, mi, v, loc_type(pg, name))
    gen_store_local(pg, ob, mi, name, val)
end

proc gen_place(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, n)
    name := tok_text(cx, nd.t0)
    init := kid2(cx, n)
    lt := loc_type(pg, name)
    if is_array_type(lt) == 1
        -- An array place starts zero (docs/COMMANDS.md §1): a loop over its
        -- words, since a frame is not a fresh mapping.
        gen_zero_array(pg, ob, name, local_words(pg, lt))
        ret
    end
    if init == 0
        ret
    end
    val := gen_expr(pg, ob, mi, init, loc_type(pg, name))
    gen_store_local(pg, ob, mi, name, val)
end

proc gen_zero_array(pg: rw ref Prog, ob: rw ref Oir, name: view u8, words: u64)
    base := local_base(pg, ob, name)
    limit := emit_ins(ob, O_CONST, 0, 0, 0, words)
    zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    t := new_tmp(ob)
    emit_ins(ob, O_STORE, t, zero, 0, 0)
    top := new_label(ob)
    out := new_label(ob)
    emit_ins(ob, O_LABEL, top, 0, 0, 0)
    i := emit_ins(ob, O_LOAD, t, 0, 0, 0)
    c := emit_bin(ob, B_LT, i, limit, 0)
    emit_ins(ob, O_BRANCH, c, 0, 0, out)
    p := addr_add(ob, base, scale_by(ob, i, 8))
    emit_ins(ob, O_RSTORE, p, zero, 8, 0)
    one := emit_ins(ob, O_CONST, 0, 0, 0, 1)
    nx := emit_bin(ob, B_ADD, i, one, 0)
    emit_ins(ob, O_STORE, t, nx, 0, 0)
    emit_ins(ob, O_JMP, top, 0, 0, 0)
    emit_ins(ob, O_LABEL, out, 0, 0, 0)
end

proc gen_store(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    tgt := kid1(cx, n)
    tn := node_at(cx, tgt)
    if tn.kind == N_INDEX
        gen_store_index(pg, ob, mi, n)
        ret
    end
    if tn.kind == N_FIELD
        gen_store_field(pg, ob, mi, n)
        ret
    end
    if tn.kind == N_RAWLOAD
        gen_store_raw(pg, ob, mi, n)
        ret
    end
    if tn.kind == N_HWPLACE
        gen_store_hw(pg, ob, mi, n)
        ret
    end
    if tn.kind != N_NAME
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    name := tok_text(cx, tn.t0)
    if name_kind(pg, mi, tgt) == 3
        vi := val_find(pg, name)
        if vi >= 0
            gen_store_static(pg, ob, mi, n, u64.bits(vi))
            ret
        end
    end
    val := gen_expr(pg, ob, mi, kid2(cx, n), ety(pg, mi, tgt, b[0..0]))
    gen_store_local(pg, ob, mi, name, val)
end

proc gen_store_index(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `v[i] <- x`: the address the index names, then the element written
    -- there. The bounds check is the same one a read of it carries.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    tgt := kid1(cx, n)
    ix := node_at(cx, kid2(cx, tgt))
    if ix.kind == N_RANGE
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    p := gen_index_addr(pg, ob, mi, tgt)
    sz := ob.lastlen
    bt := ety(pg, mi, kid1(cx, tgt), b[0..0])
    et := view_elem(bt)
    v := gen_expr(pg, ob, mi, kid2(cx, n), et)
    vol := u64.bits(is_mmio(bt))
    if layout_param(pg, et) > 0
        if vol == 1
            oir_err(ob, pg, mi, 900, n)
            ret
        end
        gen_copy(ob, p, v, sz)
        ret
    end
    -- Through an `mmio` view the store is volatile (space `mmio`).
    emit_ins(ob, O_RSTORE, p, v, sz, vol)
end

proc gen_ret(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- A `ret` inside a zone releases every zone it leaves, innermost first,
    -- after the value is computed and before the procedure is left: the
    -- release on every exit edge that `spec/OLI_MEMORY_V0.md` §3 asks for.
    cx := mod_ctx(pg, mi)
    rv := kid1(cx, n)
    if rv == 0
        gen_release_to(ob, 0)
        emit_ins(ob, O_RET, 0, 0, 0, 0)
        ret
    end
    gen_ret_value(pg, ob, mi, rv)
end

proc gen_ret_value(pg: rw ref Prog, ob: rw ref Oir, mi: u64, rv: u64)
    -- The `ret v` of the current procedure: a view is its pair, a `T or E` is
    -- the pair (tag 0, v) — design 0007, ABI.md §2 — or, when the pair cannot
    -- carry it (`ob.widefall`), tag and value written into the caller's area;
    -- anything else is one word.
    full := cur_result(pg)
    rt := ok_of(full)
    if is_fallible(full) == 1
        if ob.widefall > 0
            -- Into the caller's area: tag 0, then the value's words.
            v0 := gen_expr(pg, ob, mi, rv, rt)
            ln0 := ob.lastlen
            area := emit_ins(ob, O_LOAD, ob.sretslot - 1, 0, 0, 0)
            zero0 := emit_ins(ob, O_CONST, 0, 0, 0, 0)
            emit_ins(ob, O_RSTORE, area, zero0, 8, 0)
            eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
            p1 := addr_add(ob, area, eight)
            lp0 := layout_param(pg, rt)
            if is_view_type(rt) == 1
                emit_ins(ob, O_RSTORE, p1, v0, 8, 0)
                sixteen := emit_ins(ob, O_CONST, 0, 0, 0, 16)
                emit_ins(ob, O_RSTORE, addr_add(ob, area, sixteen), ln0, 8, 0)
            elif lp0 > 0
                -- A layout or a wide choice: its bytes, exactly.
                gen_copy(ob, p1, v0, lp0)
            else
                emit_ins(ob, O_RSTORE, p1, v0, 8, 0)
            end
            gen_release_to(ob, 0)
            emit_ins(ob, O_RET, area, 0, 1, 0)
            ret
        end
        if is_view_type(rt) == 1
            oir_err(ob, pg, mi, 900, pg.curstmt)
            ret
        end
        v1 := gen_expr(pg, ob, mi, rv, rt)
        v : u64 <- v1
        lp1 := layout_param(pg, rt)
        if lp1 > 0
            -- A layout of a word or less: its bytes, copied exactly into a
            -- zeroed word of the frame, travel in rdx as that word.
            wa := tmp_area(ob, 8)
            wz := emit_ins(ob, O_CONST, 0, 0, 0, 0)
            emit_ins(ob, O_RSTORE, wa, wz, 8, 0)
            gen_copy(ob, wa, v1, lp1)
            v <- emit_ins(ob, O_RLOAD, wa, 8, 0, 0)
        end
        zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
        gen_release_to(ob, 0)
        emit_ins(ob, O_RET, zero, v, 2, 0)
        ret
    end
    v2 := gen_expr(pg, ob, mi, rv, rt)
    ln := ob.lastlen
    rl := layout_param(pg, rt)
    if rl > 16
        -- `sret`: the bytes go to the caller's area, whose address comes
        -- back in rax.
        if ob.sretslot == 0
            oir_err(ob, pg, mi, 900, pg.curstmt)
            ret
        end
        dst := emit_ins(ob, O_LOAD, ob.sretslot - 1, 0, 0, 0)
        gen_copy(ob, dst, v2, rl)
        gen_release_to(ob, 0)
        emit_ins(ob, O_RET, dst, 0, 1, 0)
        ret
    end
    if rl > 0
        -- A layout by value: its eightbytes in rax and rdx, sixteen bytes
        -- at most.
        w0 := emit_ins(ob, O_RLOAD, v2, 8, 0, 0)
        w1 : u64 <- 0
        if rl > 8
            eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
            w1 <- emit_ins(ob, O_RLOAD, addr_add(ob, v2, eight), 8, 0, 0)
        end
        gen_release_to(ob, 0)
        if rl > 8
            emit_ins(ob, O_RET, w0, w1, 2, 0)
        else
            emit_ins(ob, O_RET, w0, 0, 1, 0)
        end
        ret
    end
    gen_release_to(ob, 0)
    if is_view_type(rt) == 1
        emit_ins(ob, O_RET, v2, ln, 2, 0)
        ret
    end
    if is_float(rt) == 1
        -- A float result leaves in xmm0 (SysV), after every release.
        emit_ins(ob, O_FRET, v2, 0, 0, 0)
    end
    emit_ins(ob, O_RET, v2, 0, 1, 0)
end

proc gen_fail(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `fail [e]`: the pair (tag 1, e), or (1, 0) when `E` is `none`.
    cx := mod_ctx(pg, mi)
    full := cur_result(pg)
    if is_fallible(full) == 0
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    ev := kid1(cx, n)
    one := emit_ins(ob, O_CONST, 0, 0, 0, 1)
    if ob.widefall > 0
        gen_fail_wide(pg, ob, mi, n)
        ret
    end
    if ev == 0
        zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
        gen_release_to(ob, 0)
        emit_ins(ob, O_RET, one, zero, 2, 0)
        ret
    end
    et := err_of(full)
    if is_view_type(et) == 1
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    ci := layout_of(pg, et)
    if ci >= 0
        item := item_at(pg, u64.bits(ci))
        if item.kind == 1
            -- A `choice` error: its image, one word when it fits (ABI.md §3).
            if choice_fits(pg, ob, mi, u64.bits(ci), n) == 0
                ret
            end
        else
            -- A layout error (`os.Error`): its bytes as the payload word,
            -- eight at most; wider would need memory the caller owns.
            if item.size > 8
                oir_err(ob, pg, mi, 900, n)
                ret
            end
            la := gen_expr(pg, ob, mi, ev, et)
            lw := emit_ins(ob, O_RLOAD, la, item.size, 0, 0)
            gen_release_to(ob, 0)
            emit_ins(ob, O_RET, one, lw, 2, 0)
            ret
        end
    end
    e := gen_expr(pg, ob, mi, ev, et)
    gen_release_to(ob, 0)
    emit_ins(ob, O_RET, one, e, 2, 0)
end

proc gen_fail_wide(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `fail [e]` of a procedure whose result lives in the caller's area:
    -- tag 1, then the failure — a word, a view's two, or the bytes of a
    -- layout or of a choice wider than a word — and the area's address
    -- back in rax.
    cx := mod_ctx(pg, mi)
    full := cur_result(pg)
    et := err_of(full)
    ev := kid1(cx, n)
    area := emit_ins(ob, O_LOAD, ob.sretslot - 1, 0, 0, 0)
    one := emit_ins(ob, O_CONST, 0, 0, 0, 1)
    emit_ins(ob, O_RSTORE, area, one, 8, 0)
    eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
    p1 := addr_add(ob, area, eight)
    if ev != 0
        e := gen_expr(pg, ob, mi, ev, et)
        eln := ob.lastlen
        elp := layout_param(pg, et)
        if elp > 0
            gen_copy(ob, p1, e, elp)
        elif is_view_type(et) == 1
            -- A view: its two words.
            emit_ins(ob, O_RSTORE, p1, e, 8, 0)
            sixteen := emit_ins(ob, O_CONST, 0, 0, 0, 16)
            emit_ins(ob, O_RSTORE, addr_add(ob, area, sixteen), eln, 8, 0)
        else
            emit_ins(ob, O_RSTORE, p1, e, 8, 0)
        end
    end
    gen_release_to(ob, 0)
    emit_ins(ob, O_RET, area, 0, 1, 0)
end

proc gen_fallback(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `e else handler`: the call, a branch on its tag, and in the fail block
    -- the handler — `fail` passes the payload on as this procedure's own
    -- failure, `ret [v]` leaves, a default value joins the ok path through a
    -- place `mem2reg` turns into the phi. The value is the payload.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    call := kid1(cx, n)
    ct := ety(pg, mi, call, b[0..0])
    tag := gen_fallible(pg, ob, mi, call)
    pay := ob.lastpay
    paylen := ob.lastlen
    paywide := ob.paywide
    if pay == 0
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    -- A view payload — `z.try_bytes(k)` — is the pair (address, length):
    -- two places for the default to join through, two words to hand on.
    isview := is_view_type(ok_of(ct))
    if isview == 1
        if paylen == 0
            oir_err(ob, pg, mi, 900, n)
            ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
        end
    end
    h := kid2(cx, n)
    hn := node_at(cx, h)
    zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    isok := emit_bin(ob, B_EQ, tag, zero, 0)
    if hn.kind == N_DEFAULT
        t := new_tmp(ob)
        t2 := new_tmp(ob)
        emit_ins(ob, O_STORE, t, pay, 0, 0)
        if isview == 1
            emit_ins(ob, O_STORE, t2, paylen, 0, 0)
        end
        lfail := new_label(ob)
        ldone := new_label(ob)
        emit_ins(ob, O_BRANCH, isok, 0, 0, lfail)
        emit_ins(ob, O_JMP, ldone, 0, 0, 0)
        emit_ins(ob, O_LABEL, lfail, 0, 0, 0)
        d := gen_expr(pg, ob, mi, kid1(cx, h), ok_of(ct))
        emit_ins(ob, O_STORE, t, d, 0, 0)
        if isview == 1
            emit_ins(ob, O_STORE, t2, ob.lastlen, 0, 0)
        end
        emit_ins(ob, O_LABEL, ldone, 0, 0, 0)
        ob.lastlen <- 0
        ob.lastpay <- 0
        r := emit_ins(ob, O_LOAD, t, 0, 0, 0)
        if isview == 1
            ob.lastlen <- emit_ins(ob, O_LOAD, t2, 0, 0, 0)
        end
        ret r
    end
    lfail2 := new_label(ob)
    lok := new_label(ob)
    emit_ins(ob, O_BRANCH, isok, 0, 0, lfail2)
    emit_ins(ob, O_JMP, lok, 0, 0, 0)
    emit_ins(ob, O_LABEL, lfail2, 0, 0, 0)
    if hn.kind == N_FAIL
        -- The callee's payload is this procedure's payload: the front end
        -- requires the same `E`.
        if is_fallible(cur_result(pg)) == 0
            oir_err(ob, pg, mi, 900, n)
        end
        one := emit_ins(ob, O_CONST, 0, 0, 0, 1)
        if ob.widefall > 0
            -- Into this procedure's own area: the tag, then the failure's
            -- word or bytes copied from the callee's area.
            area2 := emit_ins(ob, O_LOAD, ob.sretslot - 1, 0, 0, 0)
            emit_ins(ob, O_RSTORE, area2, one, 8, 0)
            eight2 := emit_ins(ob, O_CONST, 0, 0, 0, 8)
            q1 := addr_add(ob, area2, eight2)
            if paywide > 0
                ew2 := pay_words(pg, err_of(cur_result(pg)))
                gen_copy(ob, q1, paywide, ew2 * 8)
            else
                emit_ins(ob, O_RSTORE, q1, pay, 8, 0)
            end
            gen_release_to(ob, 0)
            emit_ins(ob, O_RET, area2, 0, 1, 0)
        else
            gen_release_to(ob, 0)
            emit_ins(ob, O_RET, one, pay, 2, 0)
        end
    elif hn.kind == N_RET
        rv := kid1(cx, h)
        if rv == 0
            gen_release_to(ob, 0)
            emit_ins(ob, O_RET, 0, 0, 0, 0)
        else
            gen_ret_value(pg, ob, mi, rv)
        end
    else
        oir_err(ob, pg, mi, 900, n)
    end
    emit_ins(ob, O_LABEL, lok, 0, 0, 0)
    ob.lastlen <- paylen
    ob.lastpay <- 0
    ret pay
end

proc gen_case(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `case e when ok [x] … when fail [VARIANT { f … }] … end` over a
    -- `T or E`: the tag decides ok from fail, the ok arm's name is bound to
    -- the payload. A `when fail` naming a variant compares the first byte of
    -- the payload — the image of the choice, ABI.md §3 — with the variant's
    -- tag, arm after arm in the order written, and binds each field named
    -- from the bits at the field's offset; a bare `when fail` or an `else`
    -- takes whatever remains.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    subj := kid1(cx, n)
    ct := ety(pg, mi, subj, b[0..0])
    if is_fallible(ct) == 0
        -- `checked(e)` is typed as its `T` (compiler/SPEC.md's known gap)
        -- but is a fallible value all the same.
        if is_checked_node(cx, subj) == 0
            gen_case_value(pg, ob, mi, n)
            ret
        end
    end
    tag := gen_fallible(pg, ob, mi, subj)
    pay := ob.lastpay
    paylen := ob.lastlen
    paywide := ob.paywide
    if pay == 0
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    okarm : u64 <- 0
    failarm : u64 <- 0
    elsearm : u64 <- 0
    npat : u64 <- 0
    arm : u64 <- kid2(cx, n)
    while arm != 0
        an := node_at(cx, arm)
        if an.kind == N_ELSE
            elsearm <- arm
        else
            pn := node_at(cx, kid1(cx, arm))
            if pn.kind == N_PATOK
                okarm <- arm
            elif pn.kind == N_PATFAIL
                if kid1(cx, kid1(cx, arm)) != 0
                    npat <- npat + 1
                else
                    failarm <- arm
                end
            else
                oir_err(ob, pg, mi, 900, arm)
                ret
            end
        end
        arm <- sibling(cx, arm)
    end
    ci : word <- -1
    if npat > 0
        ci <- item_find(pg, err_of(ct))
        if ci < 0
            oir_err(ob, pg, mi, 900, n)
            ret
        end
        if paywide == 0
            if choice_fits(pg, ob, mi, u64.bits(ci), n) == 0
                ret
            end
        end
    end
    zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    isok := emit_bin(ob, B_EQ, tag, zero, 0)
    lfail := new_label(ob)
    ldone := new_label(ob)
    emit_ins(ob, O_BRANCH, isok, 0, 0, lfail)
    if okarm != 0
        pn2 := node_at(cx, kid1(cx, okarm))
        if pn2.t1 > pn2.t0
            -- The name resolves as the front end declared it: at the pattern.
            pg.curstmt <- kid1(cx, okarm)
            ob.lastlen <- paylen
            gen_store_local(pg, ob, mi, tok_text(cx, pn2.t0), pay)
        end
        gen_block(pg, ob, mi, kid2(cx, okarm))
    elif elsearm != 0
        gen_block(pg, ob, mi, kid1(cx, elsearm))
    end
    emit_ins(ob, O_JMP, ldone, 0, 0, 0)
    emit_ins(ob, O_LABEL, lfail, 0, 0, 0)
    if npat > 0
        ob.lastpay <- pay
        ob.paywide <- paywide
        gen_fail_arms(pg, ob, mi, n, u64.bits(ci), ldone)
    end
    if failarm != 0
        gen_block(pg, ob, mi, kid2(cx, failarm))
    elif elsearm != 0
        gen_block(pg, ob, mi, kid1(cx, elsearm))
    end
    emit_ins(ob, O_LABEL, ldone, 0, 0, 0)
end

proc is_checked_node(cx: ref Ctx, n: u64) -> word
    nd := node_at(cx, n)
    if nd.kind == N_UNOP
        if nd.sub == U_CHECKED
            ret 1
        end
    end
    if nd.kind == N_CONVERT
        mn := node_at(cx, kid1(cx, n))
        if mn.kind == N_MODE
            if view_eq(tok_text(cx, mn.t0), "checked")
                ret 1
            end
        end
    end
    ret 0
end

proc gen_case_value(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `case v when … end` over a `bool`, an integer or a plain `choice`:
    -- the arms in the order written, each a compare and a jump past it —
    -- `true`/`false` and an integer against the value, a variant against
    -- the tag byte of the image (in the word, or in memory at the address
    -- the value is when the choice is wider) with its fields bound — and
    -- `else` takes the rest.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    subj := kid1(cx, n)
    ct := ety(pg, mi, subj, b[0..0])
    v := gen_expr(pg, ob, mi, subj, b[0..0])
    ci : word <- -1
    if layout_of(pg, ct) >= 0
        ci <- item_find(pg, last_part(ct))
        if ci >= 0
            it := item_at(pg, u64.bits(ci))
            if it.kind != 1
                ci <- -1
            end
        end
    end
    tagv : u64 <- v
    wide : u64 <- 0
    if ci >= 0
        cit := item_at(pg, u64.bits(ci))
        if cit.size > 8
            wide <- 1
            tagv <- emit_ins(ob, O_RLOAD, v, 1, 0, 0)
        else
            m255 := emit_ins(ob, O_CONST, 0, 0, 0, 255)
            tagv <- emit_bin(ob, B_AND, v, m255, 0)
        end
    end
    ldone := new_label(ob)
    elsearm : u64 <- 0
    arm : u64 <- kid2(cx, n)
    while arm != 0
        an := node_at(cx, arm)
        if an.kind == N_ELSE
            elsearm <- arm
        else
            pat := kid1(cx, arm)
            pn := node_at(cx, pat)
            want : u64 <- 0
            if pn.kind == N_PAT
                if ci < 0
                    oir_err(ob, pg, mi, 900, arm)
                    ret
                end
                want <- emit_ins(ob, O_CONST, 0, 0, 0, variant_ordinal(pg, u64.bits(ci), tok_text(cx, pn.t0)))
            elif pn.kind == N_TRUE
                want <- emit_ins(ob, O_CONST, 0, 0, 0, 1)
            elif pn.kind == N_FALSE
                want <- emit_ins(ob, O_CONST, 0, 0, 0, 0)
            elif pn.kind == N_INT
                want <- emit_ins(ob, O_CONST, 0, 0, 0, const_value(pg, mi, pat))
            elif pn.kind == N_UNOP
                want <- emit_ins(ob, O_CONST, 0, 0, 0, const_value(pg, mi, pat))
            else
                oir_err(ob, pg, mi, 900, arm)
                ret
            end
            c := emit_bin(ob, B_EQ, tagv, want, 0)
            lnext := new_label(ob)
            emit_ins(ob, O_BRANCH, c, 0, 0, lnext)
            if pn.kind == N_PAT
                pg.curstmt <- pat
                f : u64 <- kid1(cx, pat)
                while f != 0
                    if wide > 0
                        gen_bind_field_mem(pg, ob, mi, v, pat, f)
                    else
                        gen_bind_field(pg, ob, mi, v, pat, f)
                    end
                    f <- sibling(cx, f)
                end
            end
            gen_block(pg, ob, mi, kid2(cx, arm))
            emit_ins(ob, O_JMP, ldone, 0, 0, 0)
            emit_ins(ob, O_LABEL, lnext, 0, 0, 0)
        end
        arm <- sibling(cx, arm)
    end
    if elsearm != 0
        gen_block(pg, ob, mi, kid1(cx, elsearm))
    end
    emit_ins(ob, O_LABEL, ldone, 0, 0, 0)
end

proc gen_fail_arms(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, ci: u64, ldone: u64)
    -- The `when fail VARIANT [{ f … }]` arms of a `case`, each a compare of
    -- the tag byte and a jump past the arm when it is another variant. Falls
    -- through, after the last one, to the arm that takes the rest. The
    -- payload arrives in `ob.lastpay`: oli-core passes six words.
    cx := mod_ctx(pg, mi)
    pay := ob.lastpay
    wide := ob.paywide
    tagv : u64 <- 0
    if wide > 0
        -- The image lies in memory: its first byte is the tag.
        tagv <- emit_ins(ob, O_RLOAD, wide, 1, 0, 0)
    else
        m255 := emit_ins(ob, O_CONST, 0, 0, 0, 255)
        tagv <- emit_bin(ob, B_AND, pay, m255, 0)
    end
    arm : u64 <- kid2(cx, n)
    while arm != 0
        an := node_at(cx, arm)
        if an.kind != N_ELSE
            pn := node_at(cx, kid1(cx, arm))
            if pn.kind == N_PATFAIL
                pat := kid1(cx, kid1(cx, arm))
                if pat != 0
                    vn := node_at(cx, pat)
                    vname := tok_text(cx, vn.t0)
                    want := emit_ins(ob, O_CONST, 0, 0, 0, variant_ordinal(pg, ci, vname))
                    c := emit_bin(ob, B_EQ, tagv, want, 0)
                    lnext := new_label(ob)
                    emit_ins(ob, O_BRANCH, c, 0, 0, lnext)
                    -- The fields resolve as the front end declared them: at
                    -- the pattern, so a name two arms bind finds its own.
                    pg.curstmt <- kid1(cx, arm)
                    f : u64 <- kid1(cx, pat)
                    while f != 0
                        if wide > 0
                            gen_bind_field_mem(pg, ob, mi, wide, pat, f)
                        else
                            gen_bind_field(pg, ob, mi, pay, pat, f)
                        end
                        f <- sibling(cx, f)
                    end
                    gen_block(pg, ob, mi, kid2(cx, arm))
                    emit_ins(ob, O_JMP, ldone, 0, 0, 0)
                    emit_ins(ob, O_LABEL, lnext, 0, 0, 0)
                end
            end
        end
        arm <- sibling(cx, arm)
    end
end

proc gen_bind_field(pg: rw ref Prog, ob: rw ref Oir, mi: u64, pay: u64, pat: u64, f: u64)
    -- One field of a pattern: the bits at its offset in the image, read at
    -- the field's width and signedness, stored into the local the pattern
    -- declared. `pat` is the pattern node that names the variant.
    cx := mod_ctx(pg, mi)
    fn := node_at(cx, f)
    vn := node_at(cx, pat)
    vname := tok_text(cx, vn.t0)
    fname := tok_text(cx, fn.t0)
    vi := variant_fields_of(pg, vname)
    if vi < 0
        oir_err(ob, pg, mi, 900, pat)
        ret
    end
    ci := u64.bits(vi)
    ft := variant_field_type(pg, vname, fname)
    nb := field_bits(ft)
    sg : u64 <- 0
    if int_signed(ft) == 1
        sg <- 1
    end
    off := variant_field_off(pg, ci, vname, fname)
    v : u64 <- pay
    if off > 0
        sh := emit_ins(ob, O_CONST, 0, 0, 0, off * 8)
        v <- emit_bin(ob, B_SHR, pay, sh, 0)
    end
    if nb < 64
        v <- emit_ins(ob, O_TRUNC, v, nb, sg, 0)
    end
    ob.lastlen <- 0
    gen_store_local(pg, ob, mi, fname, v)
end

proc gen_bind_field_mem(pg: rw ref Prog, ob: rw ref Oir, mi: u64, base: u64, pat: u64, f: u64)
    -- One field of a pattern over a choice whose image lies in memory at
    -- `base`: loaded at its offset, width and signedness.
    cx := mod_ctx(pg, mi)
    fn := node_at(cx, f)
    vn := node_at(cx, pat)
    vname := tok_text(cx, vn.t0)
    fname := tok_text(cx, fn.t0)
    vi := variant_fields_of(pg, vname)
    if vi < 0
        oir_err(ob, pg, mi, 900, pat)
        ret
    end
    ci := u64.bits(vi)
    ft := variant_field_type(pg, vname, fname)
    nb := field_bits(ft)
    sg : u64 <- 0
    if int_signed(ft) == 1
        sg <- 1
    end
    off := variant_field_off(pg, ci, vname, fname)
    p : u64 <- base
    if off > 0
        oc := emit_ins(ob, O_CONST, 0, 0, 0, off)
        p <- addr_add(ob, base, oc)
    end
    v := emit_ins(ob, O_RLOAD, p, nb / 8, sg, 0)
    ob.lastlen <- 0
    gen_store_local(pg, ob, mi, fname, v)
end

proc gen_variant_lit(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `VARIANT { f: e, … }`: the image of the choice as one word — the tag in
    -- its first byte, each field's bits at the field's offset (ABI.md §3).
    -- A layout literal by value is not lowered.
    cx := mod_ctx(pg, mi)
    hn := node_at(cx, kid1(cx, n))
    vname : view u8 <- tok_text(cx, hn.t0)
    if hn.t1 > hn.t0 + 1
        -- `os.Error { … }`: the item by its own name.
        vname <- last_part(mod_text(cx, hn.t0, hn.t1))
    end
    vi := variant_fields_of(pg, vname)
    if vi < 0
        li := item_find(pg, vname)
        if li >= 0
            ret gen_layout_lit(pg, ob, mi, n, u64.bits(li))
        end
        oir_err(ob, pg, mi, 900, n)
        ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
    end
    ci := u64.bits(vi)
    citem := item_at(pg, ci)
    if citem.size > 8
        ret gen_variant_mem(pg, ob, mi, n, ci)
    end
    img : u64 <- emit_ins(ob, O_CONST, 0, 0, 0, variant_ordinal(pg, ci, vname))
    f : u64 <- kid2(cx, n)
    while f != 0
        fn := node_at(cx, f)
        fname := tok_text(cx, fn.t0)
        ft := variant_field_type(pg, vname, fname)
        nb := field_bits(ft)
        off := variant_field_off(pg, ci, vname, fname)
        v : u64 <- gen_expr(pg, ob, mi, kid1(cx, f), ft)
        if nb < 64
            -- The field's own bits: a signed value is sign-extended in its
            -- word and must not spill into the neighbours.
            mask := emit_ins(ob, O_CONST, 0, 0, 0, (one_u64() << nb) - 1)
            v <- emit_bin(ob, B_AND, v, mask, 0)
        end
        if off > 0
            sh := emit_ins(ob, O_CONST, 0, 0, 0, off * 8)
            v <- emit_bin(ob, B_SHL, v, sh, 0)
        end
        img <- emit_bin(ob, B_OR, img, v, 0)
        f <- sibling(cx, f)
    end
    ob.lastlen <- 0
    ret img
end

proc one_u64() -> u64
    ret 1
end

proc gen_variant_mem(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, ci: u64) -> u64
    -- A variant of a choice wider than a word: its image in a fresh area
    -- of the frame — the tag in the first byte, each field at its offset —
    -- and the value is the area's address, as for a layout held by value.
    cx := mod_ctx(pg, mi)
    hn := node_at(cx, kid1(cx, n))
    vname := tok_text(cx, hn.t0)
    item := item_at(pg, ci)
    base := tmp_area(ob, item.size)
    zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    k : u64 <- 0
    while k * 8 < item.size
        d : u64 <- base
        if k > 0
            off := emit_ins(ob, O_CONST, 0, 0, 0, k * 8)
            d <- addr_add(ob, base, off)
        end
        emit_ins(ob, O_RSTORE, d, zero, 8, 0)
        k <- k + 1
    end
    tagc := emit_ins(ob, O_CONST, 0, 0, 0, variant_ordinal(pg, ci, vname))
    emit_ins(ob, O_RSTORE, base, tagc, 1, 0)
    f : u64 <- kid2(cx, n)
    while f != 0
        fn := node_at(cx, f)
        fname := tok_text(cx, fn.t0)
        ft := variant_field_type(pg, vname, fname)
        v := gen_expr(pg, ob, mi, kid1(cx, f), ft)
        off2 := variant_field_off(pg, ci, vname, fname)
        p : u64 <- base
        if off2 > 0
            oc := emit_ins(ob, O_CONST, 0, 0, 0, off2)
            p <- addr_add(ob, base, oc)
        end
        gen_store_typed(pg, ob, p, v, ft)
        f <- sibling(cx, f)
    end
    ob.lastlen <- 0
    ret base
end

proc gen_layout_lit(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, li: u64) -> u64
    -- `Name { f: e, … }` as a value: a fresh area of the frame, zeroed word
    -- by word, each field written at its offset and width; the value is the
    -- area's address, as every layout held by value is.
    cx := mod_ctx(pg, mi)
    item := item_at(pg, li)
    base := tmp_area(ob, item.size)
    zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    k : u64 <- 0
    while k * 8 < item.size
        d : u64 <- base
        if k > 0
            off := emit_ins(ob, O_CONST, 0, 0, 0, k * 8)
            d <- addr_add(ob, base, off)
        end
        emit_ins(ob, O_RSTORE, d, zero, 8, 0)
        k <- k + 1
    end
    f : u64 <- kid2(cx, n)
    while f != 0
        fn := node_at(cx, f)
        fi := field_of(pg, li, tok_text(cx, fn.t0))
        if fi < 0
            oir_err(ob, pg, mi, 900, f)
            ret base
        end
        fr := fld_at(pg, u64.bits(fi))
        ft := field_text(pg, u64.bits(fi))
        v := gen_expr(pg, ob, mi, kid1(cx, f), ft)
        p : u64 <- base
        if fr.off > 0
            off2 := emit_ins(ob, O_CONST, 0, 0, 0, fr.off)
            p <- addr_add(ob, base, off2)
        end
        gen_store_typed(pg, ob, p, v, ft)
        f <- sibling(cx, f)
    end
    ob.lastlen <- 0
    ret base
end

proc gen_store_typed(pg: rw ref Prog, ob: rw ref Oir, p: u64, v: u64, ft: view u8)
    -- A value of type `ft` written at `p`: the widths of a field store.
    -- (Six argument words: the view is two.)
    if is_view_type(ft) == 1
        ln := ob.lastlen
        emit_ins(ob, O_RSTORE, p, v, 8, 0)
        eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
        emit_ins(ob, O_RSTORE, addr_add(ob, p, eight), ln, 8, 0)
        ret
    end
    nb := mem_bits(ft)
    if nb > 0
        emit_ins(ob, O_RSTORE, p, v, u64.bits(nb) / 8, 0)
        ret
    end
    if view_eq(ft, "bool")
        emit_ins(ob, O_RSTORE, p, v, 1, 0)
        ret
    end
    lp := layout_param(pg, ft)
    if lp > 0
        gen_copy(ob, p, v, lp)
        ret
    end
    emit_ins(ob, O_RSTORE, p, v, 8, 0)
end

proc field_bits(t: view u8) -> u64
    -- The width of a field of a variant: an integer's own, a `bool`'s byte.
    nb := mem_bits(t)
    if nb > 0
        ret u64.bits(nb)
    end
    if view_eq(t, "bool")
        ret 8
    end
    ret 64
end

proc choice_fits(pg: rw ref Prog, ob: rw ref Oir, mi: u64, ci: u64, n: u64) -> word
    -- The guard of the paths that carry a choice as its image in one word.
    -- A wider one lies in memory and is held by its address instead —
    -- `gen_variant_mem`, `gen_fail_wide`, `gen_case_value` — so it does not
    -- reach these paths; were it to, E0900 rather than an approximation.
    it := item_at(pg, ci)
    if it.size > 8
        oir_err(ob, pg, mi, 900, n)
        ret 0
    end
    ret 1
end

proc variant_ordinal(pg: ref Prog, ci: u64, vname: view u8) -> u64
    -- The tag of a variant: its position among the variants, from 0.
    it := item_at(pg, ci)
    cx := mod_ctx(pg, it.mod)
    k : u64 <- 0
    v : u64 <- kid1(cx, it.node)
    while v != 0
        vn := node_at(cx, v)
        if vn.kind == N_VARIANT
            if view_eq(tok_text(cx, vn.t0), vname)
                ret k
            end
            k <- k + 1
        end
        v <- sibling(cx, v)
    end
    ret 0
end

proc variant_field_off(pg: ref Prog, ci: u64, vname: view u8, fname: view u8) -> u64
    -- The byte offset of a field inside the image, as `resolve_choice` laid
    -- it out: after the tag, at the field's own alignment.
    it := item_at(pg, ci)
    cx := mod_ctx(pg, it.mod)
    f : u64 <- 0
    while f < it.nfld
        fr := fld_at(pg, it.first + f)
        vn := node_at(cx, fr.variant)
        if view_eq(tok_text(cx, vn.t0), vname)
            fn := node_at(cx, fr.node)
            if view_eq(tok_text(cx, fn.t0), fname)
                ret fr.off
            end
        end
        f <- f + 1
    end
    ret 0
end

proc gen_if(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `kid1` is the condition and `kid2` starts the chain of `then`, `elif`
    -- and `else` branches, the shape `pif_stmt` prints.
    cx := mod_ctx(pg, mi)
    done := new_label(ob)
    nxt : u64 <- new_label(ob)
    c := gen_expr(pg, ob, mi, kid1(cx, n), "bool")
    emit_ins(ob, O_BRANCH, c, 0, 0, nxt)
    br : u64 <- kid2(cx, n)
    while br != 0
        bn := node_at(cx, br)
        if bn.kind == N_THEN
            gen_block(pg, ob, mi, kid1(cx, br))
            emit_ins(ob, O_JMP, done, 0, 0, 0)
            emit_ins(ob, O_LABEL, nxt, 0, 0, 0)
        end
        if bn.kind == N_ELIF
            nxt <- new_label(ob)
            c2 := gen_expr(pg, ob, mi, kid1(cx, br), "bool")
            emit_ins(ob, O_BRANCH, c2, 0, 0, nxt)
            gen_block(pg, ob, mi, kid2(cx, br))
            emit_ins(ob, O_JMP, done, 0, 0, 0)
            emit_ins(ob, O_LABEL, nxt, 0, 0, 0)
        end
        if bn.kind == N_ELSE
            gen_block(pg, ob, mi, kid1(cx, br))
        end
        br <- sibling(cx, br)
    end
    emit_ins(ob, O_LABEL, done, 0, 0, 0)
end

proc gen_ifthen(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    cx := mod_ctx(pg, mi)
    done := new_label(ob)
    c := gen_expr(pg, ob, mi, kid1(cx, n), "bool")
    emit_ins(ob, O_BRANCH, c, 0, 0, done)
    gen_block(pg, ob, mi, kid2(cx, n))
    emit_ins(ob, O_LABEL, done, 0, 0, 0)
end

proc gen_while(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    cx := mod_ctx(pg, mi)
    top := new_label(ob)
    out := new_label(ob)
    savb := ob.brk
    savc := ob.cont
    savz := ob.zloop
    ob.brk <- out + 1
    ob.cont <- top + 1
    ob.zloop <- ob.zdepth
    emit_ins(ob, O_LABEL, top, 0, 0, 0)
    c := gen_expr(pg, ob, mi, kid1(cx, n), "bool")
    emit_ins(ob, O_BRANCH, c, 0, 0, out)
    gen_block(pg, ob, mi, kid1(cx, kid2(cx, n)))
    emit_ins(ob, O_JMP, top, 0, 0, 0)
    emit_ins(ob, O_LABEL, out, 0, 0, 0)
    ob.brk <- savb
    ob.cont <- savc
    ob.zloop <- savz
end

proc gen_loop(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    cx := mod_ctx(pg, mi)
    top := new_label(ob)
    out := new_label(ob)
    savb := ob.brk
    savc := ob.cont
    savz := ob.zloop
    ob.brk <- out + 1
    ob.cont <- top + 1
    ob.zloop <- ob.zdepth
    emit_ins(ob, O_LABEL, top, 0, 0, 0)
    gen_block(pg, ob, mi, kid1(cx, kid1(cx, n)))
    emit_ins(ob, O_JMP, top, 0, 0, 0)
    emit_ins(ob, O_LABEL, out, 0, 0, 0)
    ob.brk <- savb
    ob.cont <- savc
    ob.zloop <- savz
end

proc gen_zone(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `zone z SIZE ... end`, from any of the sources of OIR_SPEC §4. The
    -- triple lives in the frame; what fills it and what releases it depends
    -- on the source: the operating system (`zone.new`, `zone.end`), an
    -- address the program named or a buffer it owns (`zone.new.raw`, nothing
    -- to release), or an enclosing zone (`zone.new.from`, `zone.end.from`).
    -- The zone joins the stack that `gen_release_to` walks, so a `ret`,
    -- `fail`, `break` or `continue` inside the block releases it on its way
    -- out, and the block's own `end` releases it here.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    nd := node_at(cx, n)
    if ob.zdepth >= ZSTK_MAX
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    s := slot_of_local(pg, tok_text(cx, nd.t0))
    if s < 0
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    a := local_base(pg, ob, tok_text(cx, nd.t0))
    sizen := kid1(cx, n)
    sz := gen_expr(pg, ob, mi, sizen, "uword")
    kind : u64 <- 0
    parent : u64 <- 0
    if nd.sub == 0
        zn := emit_ins(ob, O_ZNEW, a, sz, 0, 0)
        zi := ins_at(ob, zn)
        zi.site <- trap_static(pg, ob, mi, TK_ZONE, n) + 1
    elif nd.sub == 1
        -- `at ADDR`: raw memory the program vouches for (`permit memory.raw`
        -- is the front end's business).
        kind <- 1
        ra := gen_expr(pg, ob, mi, sibling(cx, sizen), b[0..0])
        emit_ins(ob, O_ZRAW, a, sz, 0, ra)
    else
        srcn := sibling(cx, sizen)
        st := ety(pg, mi, srcn, b[0..0])
        if view_eq(st, "zone")
            kind <- 2
            parent <- gen_expr(pg, ob, mi, srcn, b[0..0])
            zf := emit_ins(ob, O_ZFROM, a, sz, 0, parent)
            fi := ins_at(ob, zf)
            fi.site <- trap_static(pg, ob, mi, TK_ZONE, n) + 1
        elif arr_or_view(st) == 1
            -- A buffer: the zone is raw memory at its address, once its length
            -- is proved to hold SIZE bytes — a bounds check at the zone's line.
            kind <- 1
            bufa := gen_expr(pg, ob, mi, srcn, b[0..0])
            ln := ob.lastlen
            zero := emit_ins(ob, O_CONST, 0, 0, 0, 0)
            ck := emit_ins(ob, O_CHKR, zero, sz, 0, ln)
            ci := ins_at(ob, ck)
            ci.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
            emit_ins(ob, O_ZRAW, a, sz, 0, bufa)
        else
            oir_err(ob, pg, mi, 900, n)
            ret
        end
    end
    d := ob.zdepth
    cell_set(ob.zstk, d * 3, kind)
    cell_set(ob.zstk, d * 3 + 1, a)
    cell_set(ob.zstk, d * 3 + 2, parent)
    ob.zdepth <- d + 1
    k : u64 <- sizen
    while k != 0
        kn := node_at(cx, k)
        if kn.kind == N_BODY
            gen_block(pg, ob, mi, kid1(cx, k))
            k <- 0
        else
            k <- sibling(cx, k)
        end
    end
    ob.zdepth <- d
    gen_release_one(ob, d)
end

proc gen_machine(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `machine x64 … end` (design 0009): the block is assembled once now, a
    -- dry run into the empty code arena, so that a line the encoder does not
    -- know is E0900 here and nothing is written; the lowering assembles it
    -- again in place. Each `in REG <- e` is evaluated first, then named by a
    -- `machine.in` just before the block, each `out REG -> place` is a
    -- `machine.out` just after it, stored where the program said; a
    -- register the block names among rbx, r12..r15 is kept for the caller.
    cx := mod_ctx(pg, mi)
    mark := ob.ncode
    bad := asm_block(pg, ob, mi, n, 1)
    ob.ncode <- mark
    if bad > 0
        ret
    end
    nin : u64 <- 0
    k : u64 <- kid1(cx, n)
    while k != 0
        kn := node_at(cx, k)
        if kn.kind == N_MIN
            name := tok_text(cx, kn.t0)
            r := io_reg(name)
            if r < 0
                oir_err(ob, pg, mi, 900, k)
                ret
            end
            if nin >= 64
                oir_err(ob, pg, mi, 900, k)
                ret
            end
            v := gen_expr(pg, ob, mi, kid1(cx, k), reg_type(name))
            cell_set(ob.mins, nin * 3, u64.bits(r))
            cell_set(ob.mins, nin * 3 + 1, reg_width(name))
            cell_set(ob.mins, nin * 3 + 2, v)
            nin <- nin + 1
        end
        if kn.kind == N_MOUT
            if io_reg(tok_text(cx, kn.t0)) < 0
                oir_err(ob, pg, mi, 900, k)
                ret
            end
        end
        k <- sibling(cx, k)
    end
    j : u64 <- 0
    while j < nin
        emit_ins(ob, O_MIN, cell_get(ob.mins, j * 3 + 2), 0, cell_get(ob.mins, j * 3 + 1), 0)
        mi2 := ins_at(ob, ob.nins - 1)
        mi2.w <- cell_get(ob.mins, j * 3)
        j <- j + 1
    end
    m := emit_ins(ob, O_MACHINE, 0, 0, mi, n)
    mn := ins_at(ob, m)
    mn.w <- saved_mask(pg, mi, n)
    op := oproc_at(ob, ob.curp)
    op.nsave <- 5
    -- The outs: every `machine.out` first, so they stand right after the
    -- block, then the stores.
    nout : u64 <- 0
    k2 : u64 <- kid1(cx, n)
    while k2 != 0
        kn2 := node_at(cx, k2)
        if kn2.kind == N_MOUT
            name2 := tok_text(cx, kn2.t0)
            o := emit_ins(ob, O_MOUT, 0, 0, reg_width(name2), 0)
            oi := ins_at(ob, o)
            oi.w <- u64.bits(io_reg(name2))
            cell_set(ob.mins, nout * 3, o)
            cell_set(ob.mins, nout * 3 + 1, k2)
            nout <- nout + 1
        end
        k2 <- sibling(cx, k2)
    end
    j2 : u64 <- 0
    while j2 < nout
        gen_store_value(pg, ob, mi, kid1(cx, cell_get(ob.mins, j2 * 3 + 1)), cell_get(ob.mins, j2 * 3))
        j2 <- j2 + 1
    end
end

proc io_reg(name: view u8) -> word
    -- A register an `in` or `out` may name: r64 or r32, never the stack or
    -- frame pointer.
    r := reg_code_any(name)
    if r == 4
        ret -1
    end
    if r == 5
        ret -1
    end
    ret r
end

proc reg_width(name: view u8) -> u64
    if reg32(name) >= 0
        ret 32
    end
    ret 64
end

proc gen_store_value(pg: rw ref Prog, ob: rw ref Oir, mi: u64, tgt: u64, v: u64)
    -- A value into the place a name means: a local, or a static of an
    -- integer type. Anything else an `out` names is not lowered.
    cx := mod_ctx(pg, mi)
    tn := node_at(cx, tgt)
    if tn.kind != N_NAME
        oir_err(ob, pg, mi, 900, tgt)
        ret
    end
    name := tok_text(cx, tn.t0)
    if name_kind(pg, mi, tgt) == 3
        vi := val_find(pg, name)
        if vi < 0
            oir_err(ob, pg, mi, 900, tgt)
            ret
        end
        di := data_of(ob, u64.bits(vi))
        if di < 0
            oir_err(ob, pg, mi, 900, tgt)
            ret
        end
        nb := mem_bits(val_type(pg, u64.bits(vi)))
        if nb <= 0
            oir_err(ob, pg, mi, 900, tgt)
            ret
        end
        a := emit_ins(ob, O_DADDR, u64.bits(di), 0, 0, 0)
        emit_ins(ob, O_RSTORE, a, v, u64.bits(nb) / 8, 0)
        ret
    end
    ob.lastlen <- 0
    gen_store_local(pg, ob, mi, name, v)
end

proc gen_each_range(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `each i in a..b`: `i` runs from `a` while it is below `b` — the counter
    -- is a place `mem2reg` turns into the phi at the head, and the bound is
    -- computed once. Both bounds are `uword` (the front end says so).
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, n)
    it := kid1(cx, n)
    itn := node_at(cx, it)
    if itn.sub != 3
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    lo := gen_expr(pg, ob, mi, range_lo(cx, it), "uword")
    hi := gen_expr(pg, ob, mi, range_hi(cx, it), "uword")
    t := new_tmp(ob)
    emit_ins(ob, O_STORE, t, lo, 0, 0)
    top := new_label(ob)
    out := new_label(ob)
    savb := ob.brk
    savc := ob.cont
    savz := ob.zloop
    cont := new_label(ob)
    ob.brk <- out + 1
    ob.cont <- cont + 1
    ob.zloop <- ob.zdepth
    emit_ins(ob, O_LABEL, top, 0, 0, 0)
    i := emit_ins(ob, O_LOAD, t, 0, 0, 0)
    c := emit_bin(ob, B_LT, i, hi, 0)
    emit_ins(ob, O_BRANCH, c, 0, 0, out)
    ob.lastlen <- 0
    gen_store_local(pg, ob, mi, tok_text(cx, nd.t0), i)
    gen_block(pg, ob, mi, kid1(cx, kid2(cx, n)))
    emit_ins(ob, O_LABEL, cont, 0, 0, 0)
    i2 := emit_ins(ob, O_LOAD, t, 0, 0, 0)
    one := emit_ins(ob, O_CONST, 0, 0, 0, 1)
    nx := emit_bin(ob, B_ADD, i2, one, 0)
    emit_ins(ob, O_STORE, t, nx, 0, 0)
    emit_ins(ob, O_JMP, top, 0, 0, 0)
    emit_ins(ob, O_LABEL, out, 0, 0, 0)
    ob.brk <- savb
    ob.cont <- savc
    ob.zloop <- savz
end

proc gen_release_one(ob: rw ref Oir, d: u64)
    -- The release of the zone at depth `d` of the stack, whatever its source.
    kind := cell_get(ob.zstk, d * 3)
    a := cell_get(ob.zstk, d * 3 + 1)
    if kind == 0
        emit_ins(ob, O_ZEND, a, 0, 0, 0)
    elif kind == 2
        emit_ins(ob, O_ZENDF, a, cell_get(ob.zstk, d * 3 + 2), 0, 0)
    end
end

proc gen_release_to(ob: rw ref Oir, depth: u64)
    -- Every zone open above `depth`, released innermost first: what a jump
    -- out of the blocks between here and there must do on its way.
    d : u64 <- ob.zdepth
    while d > depth
        d <- d - 1
        gen_release_one(ob, d)
    end
end

proc gen_each(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    -- `each x in v`: a loop over a counter the loop owns, with the element
    -- access checked like any other. The check is emitted rather than left
    -- out, because a check is an instruction (OIR_SPEC §2.2) and leaves only
    -- with a proof: the loop-bound proof of §5 is what removes it, in
    -- `compiler/opt.oli`. The counter is a place, which `mem2reg` turns into
    -- the phi §5 shows at the head of the loop.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    nd := node_at(cx, n)
    it := kid1(cx, n)
    itn := node_at(cx, it)
    if itn.kind == N_RANGE
        gen_each_range(pg, ob, mi, n)
        ret
    end
    bt := ety(pg, mi, it, b[0..0])
    if arr_or_view(bt) == 0
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    if is_mmio(bt) == 1
        -- `each` over device memory is not lowered: index it.
        oir_err(ob, pg, mi, 900, n)
        ret
    end
    sz := elem_bytes(pg, ob, mi, bt, n)
    et := view_elem(bt)
    sg : u64 <- 0
    if int_signed(et) == 1
        sg <- 1
    end
    a := gen_expr(pg, ob, mi, it, b[0..0])
    ln := ob.lastlen
    t := new_tmp(ob)
    z := emit_ins(ob, O_CONST, 0, 0, 0, 0)
    emit_ins(ob, O_STORE, t, z, 0, 0)
    top := new_label(ob)
    out := new_label(ob)
    savb := ob.brk
    savc := ob.cont
    savz := ob.zloop
    cont := new_label(ob)
    ob.brk <- out + 1
    ob.cont <- cont + 1
    ob.zloop <- ob.zdepth
    emit_ins(ob, O_LABEL, top, 0, 0, 0)
    i := emit_ins(ob, O_LOAD, t, 0, 0, 0)
    c := emit_bin(ob, B_LT, i, ln, 0)
    emit_ins(ob, O_BRANCH, c, 0, 0, out)
    ck := emit_ins(ob, O_CHKB, i, ln, 0, 0)
    ci := ins_at(ob, ck)
    ci.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
    p := addr_add(ob, a, scale_by(ob, i, sz))
    e : u64 <- p
    if layout_param(pg, et) == 0
        e <- emit_ins(ob, O_RLOAD, p, sz, sg, 0)
    end
    ob.lastlen <- 0
    gen_store_local(pg, ob, mi, tok_text(cx, nd.t0), e)
    gen_block(pg, ob, mi, kid1(cx, kid2(cx, n)))
    emit_ins(ob, O_LABEL, cont, 0, 0, 0)
    i2 := emit_ins(ob, O_LOAD, t, 0, 0, 0)
    one := emit_ins(ob, O_CONST, 0, 0, 0, 1)
    nx := emit_bin(ob, B_ADD, i2, one, 0)
    emit_ins(ob, O_STORE, t, nx, 0, 0)
    emit_ins(ob, O_JMP, top, 0, 0, 0)
    emit_ins(ob, O_LABEL, out, 0, 0, 0)
    ob.brk <- savb
    ob.cont <- savc
    ob.zloop <- savz
end

proc gen_stmt(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64)
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    nd := node_at(cx, n)
    k := nd.kind
    pg.curstmt <- n
    -- Every instruction of the statement remembers it: `--explain` reports
    -- the cost of a line from the instructions that came from it.
    ob.curnode <- n
    if k == N_BIND
        gen_bind(pg, ob, mi, n)
        ret
    end
    if k == N_PLACE
        gen_place(pg, ob, mi, n)
        ret
    end
    if k == N_STORE
        gen_store(pg, ob, mi, n)
        ret
    end
    if k == N_MOVE
        -- `place <~ e`: the handle stored; the linearity was checked.
        gen_store(pg, ob, mi, n)
        ret
    end
    if k == N_EXPR
        gen_expr(pg, ob, mi, kid1(cx, n), b[0..0])
        ret
    end
    if k == N_RET
        gen_ret(pg, ob, mi, n)
        ret
    end
    if k == N_IF
        gen_if(pg, ob, mi, n)
        ret
    end
    if k == N_IFTHEN
        gen_ifthen(pg, ob, mi, n)
        ret
    end
    if k == N_WHILE
        gen_while(pg, ob, mi, n)
        ret
    end
    if k == N_LOOP
        gen_loop(pg, ob, mi, n)
        ret
    end
    if k == N_EACH
        gen_each(pg, ob, mi, n)
        ret
    end
    if k == N_FAIL
        gen_fail(pg, ob, mi, n)
        ret
    end
    if k == N_CASE
        gen_case(pg, ob, mi, n)
        ret
    end
    if k == N_ZONE
        gen_zone(pg, ob, mi, n)
        ret
    end
    if k == N_MACHINE
        gen_machine(pg, ob, mi, n)
        ret
    end
    if k == N_BREAK
        if ob.brk == 0
            oir_err(ob, pg, mi, 900, n)
            ret
        end
        -- The zones opened inside the loop are released on the way out.
        gen_release_to(ob, ob.zloop)
        emit_ins(ob, O_JMP, ob.brk - 1, 0, 0, 0)
        ret
    end
    if k == N_CONTINUE
        if ob.cont == 0
            oir_err(ob, pg, mi, 900, n)
            ret
        end
        gen_release_to(ob, ob.zloop)
        emit_ins(ob, O_JMP, ob.cont - 1, 0, 0, 0)
        ret
    end
    if k == N_BODY
        gen_block(pg, ob, mi, kid1(cx, n))
        ret
    end
    oir_err(ob, pg, mi, 900, n)
end

proc gen_block(pg: rw ref Prog, ob: rw ref Oir, mi: u64, first: u64)
    cx := mod_ctx(pg, mi)
    s : u64 <- first
    while s != 0
        gen_stmt(pg, ob, mi, s)
        s <- sibling(cx, s)
    end
end

-- Procedures ------------------------------------------------------------------

proc proc_clause(pg: ref Prog, pi: u64, which: u64) -> u64
    -- The node of clause `which` on a procedure, or 0.
    v := proc_at(pg, pi)
    cx := mod_ctx(pg, v.mod)
    k : u64 <- kid1(cx, v.node)
    while k != 0
        kn := node_at(cx, k)
        if kn.kind == N_CLAUSE
            if kn.sub == which
                ret k
            end
        end
        k <- sibling(cx, k)
    end
    ret 0
end

proc proc_calls_none(pg: ref Prog, pi: u64) -> u64
    c := proc_clause(pg, pi, C_CALLS)
    if c == 0
        ret 0
    end
    v := proc_at(pg, pi)
    cx := mod_ctx(pg, v.mod)
    cn := node_at(cx, kid1(cx, c))
    if view_eq(tok_text(cx, cn.t0), "none")
        ret 1
    end
    ret 0
end

proc proc_calls_interrupt(pg: ref Prog, pi: u64) -> u64
    c := proc_clause(pg, pi, C_CALLS)
    if c == 0
        ret 0
    end
    v := proc_at(pg, pi)
    cx := mod_ctx(pg, v.mod)
    cn := node_at(cx, kid1(cx, c))
    if view_eq(tok_text(cx, cn.t0), "interrupt")
        ret 1
    end
    ret 0
end

proc proc_in_boot(pg: ref Prog, pi: u64) -> u64
    -- `section ".text.boot"`: the procedure is placed first in the code.
    c := proc_clause(pg, pi, C_SECTION)
    if c == 0
        ret 0
    end
    v := proc_at(pg, pi)
    cx := mod_ctx(pg, v.mod)
    cn := node_at(cx, kid1(cx, c))
    if view_eq(tok_text(cx, cn.t0), "\".text.boot\"")
        ret 1
    end
    ret 0
end

proc proc_traps(pg: ref Prog) -> word
    -- The procedure that receives traps (`traps` clause), or -1.
    q : u64 <- 0
    while q < pg.nproc
        if proc_clause(pg, q, C_TRAPS) != 0
            ret word.bits(q)
        end
        q <- q + 1
    end
    ret -1
end

proc body_is_machine(pg: ref Prog, mi: u64, node: u64) -> word
    -- A `calls none` body (FREESTANDING.md §3): machine blocks without
    -- `in`/`out`, hardware statements — a store into `cpu.stack`,
    -- `cpu.frame`, a descriptor table or the task register, `cpu.call`,
    -- `cpu.jump`, `cpu.halt`, `cpu.pause`, `cpu.interrupts` — and `loop`s
    -- of those; nothing that needs a frame.
    cx := mod_ctx(pg, mi)
    k : u64 <- kid1(cx, node)
    while k != 0
        kn := node_at(cx, k)
        if kn.kind == N_BODY
            if hw_stmts_ok(pg, mi, kid1(cx, k)) == 0
                ret 0
            end
        end
        k <- sibling(cx, k)
    end
    ret 1
end

proc hw_stmts_ok(pg: ref Prog, mi: u64, first: u64) -> word
    cx := mod_ctx(pg, mi)
    s : u64 <- first
    while s != 0
        sn := node_at(cx, s)
        if sn.kind == N_MACHINE
            m : u64 <- kid1(cx, s)
            while m != 0
                mn := node_at(cx, m)
                if mn.kind == N_MIN
                    ret 0
                end
                if mn.kind == N_MOUT
                    ret 0
                end
                m <- sibling(cx, m)
            end
        elif sn.kind == N_STORE
            tn := node_at(cx, kid1(cx, s))
            if tn.kind != N_HWPLACE
                ret 0
            end
        elif sn.kind == N_EXPR
            if hw_call_ok(pg, mi, kid1(cx, s)) == 0
                ret 0
            end
        elif sn.kind == N_LOOP
            b : u64 <- kid1(cx, s)
            while b != 0
                bn := node_at(cx, b)
                if bn.kind == N_BODY
                    if hw_stmts_ok(pg, mi, kid1(cx, b)) == 0
                        ret 0
                    end
                end
                b <- sibling(cx, b)
            end
        else
            ret 0
        end
        s <- sibling(cx, s)
    end
    ret 1
end

proc vec_name(c: u64) -> view u8
    if c == 0
        ret "f32x4"
    end
    if c == 1
        ret "f64x2"
    end
    if c == 2
        ret "i8x16"
    end
    if c == 3
        ret "i16x8"
    end
    if c == 4
        ret "i32x4"
    end
    ret "i64x2"
end

proc area_word(ob: rw ref Oir, nbytes: u64) -> u64
    -- The lowest frame word of a fresh area of `nbytes`, for an operation
    -- that writes its result there itself (O_VBIN).
    nw := (nbytes + 7) / 8
    last : u64 <- 0
    k : u64 <- 0
    while k < nw
        last <- new_tmp(ob)
        k <- k + 1
    end
    ret last
end

proc gen_vbinop(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, ot: view u8) -> u64
    -- A vector operator: both operands are addresses of sixteen bytes.
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, n)
    code := binop_code(tok_text(cx, nd.t0))
    la := gen_expr(pg, ob, mi, kid1(cx, n), ot)
    ra := gen_expr(pg, ob, mi, kid2(cx, n), ot)
    ob.lastlen <- 0
    if code >= B_EQ
        ret emit_ins(ob, O_VCMP, la, ra, code, vec_code(ot))
    end
    w := area_word(ob, 16)
    v := emit_ins(ob, O_VBIN, la, ra, code, vec_code(ot))
    vi := ins_at(ob, v)
    vi.w <- w
    ret v
end

proc gen_vmake(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, splat: u64) -> u64
    -- `T(lanes…)` / `T.splat(x)`: a sixteen-byte area of the frame, each
    -- lane stored at its width.
    cx := mod_ctx(pg, mi)
    vt := vcall_type(pg, mi, n)
    lane := vec_lane(vt)
    lb := u64.bits(mem_bits(lane)) / 8
    area := tmp_area(ob, 16)
    a : u64 <- kid2(cx, n)
    sv : u64 <- 0
    if splat == 1
        sv <- gen_expr(pg, ob, mi, a, lane)
    end
    k : u64 <- 0
    while k < vec_count(vt)
        v : u64 <- sv
        if splat == 0
            v <- gen_expr(pg, ob, mi, a, lane)
            a <- sibling(cx, a)
        end
        off := emit_ins(ob, O_CONST, 0, 0, 0, k * lb)
        emit_ins(ob, O_RSTORE, addr_add(ob, area, off), v, lb, 0)
        k <- k + 1
    end
    ob.lastlen <- 0
    ret area
end

proc gen_vspan(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- The address of lanes `v[i..i+N]` of the view argument of
    -- `T.load`/`T.store`, with a bounds check on the first and the last.
    cx := mod_ctx(pg, mi)
    b := pg.sbuf
    vt := vcall_type(pg, mi, n)
    lb := u64.bits(mem_bits(vec_lane(vt))) / 8
    a0 := kid2(cx, n)
    va := gen_expr(pg, ob, mi, a0, b[0..0])
    ln := ob.lastlen
    idx := gen_expr(pg, ob, mi, sibling(cx, a0), "uword")
    c1 := emit_ins(ob, O_CHKB, idx, ln, 0, 0)
    i1 := ins_at(ob, c1)
    i1.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
    lastv := emit_bin(ob, B_ADD, idx, emit_ins(ob, O_CONST, 0, 0, 0, vec_count(vt) - 1), 0)
    c2 := emit_ins(ob, O_CHKB, lastv, ln, 0, 0)
    i2 := ins_at(ob, c2)
    i2.site <- trap_static(pg, ob, mi, TK_BOUNDS, n) + 1
    ob.lastlen <- 0
    ret addr_add(ob, va, scale_by(ob, idx, lb))
end

proc fcvt_name(k: u64) -> view u8
    if k == 0
        ret "fcvt.from_signed"
    end
    if k == 1
        ret "fcvt.from_u64"
    end
    if k == 2
        ret "fcvt.to_s64"
    end
    if k == 3
        ret "fcvt.f32_to_f64"
    end
    if k == 4
        ret "fcvt.f64_to_f32"
    end
    ret "fcvt.to_u64"
end

proc float_sign(fmt: u64) -> u64
    if fmt == 1
        ret 2147483648
    end
    ret 9223372036854775808
end

proc float_int_bits(v: u64, neg: u64, fmt: u64) -> u64
    -- The binary64 (fmt 0) or binary32 (fmt 1) bits of the integer `v`
    -- (negative when `neg`), rounded to nearest, ties to even.
    if v == 0
        ret 0
    end
    p := fmt_p(fmt)
    l : u64 <- 0
    x : u64 <- v
    while x != 0
        l <- l + 1
        x <- x >> 1
    end
    e : u64 <- l - 1
    q : u64 <- 0
    if l <= p
        q <- v << (p - l)
    else
        shift := l - p
        q <- v >> shift
        one : u64 <- 1
        rest := v & ((one << shift) - 1)
        half := one << (shift - 1)
        up : u64 <- 0
        if rest > half
            up <- 1
        elif rest == half
            if q & 1 == 1
                up <- 1
            end
        end
        q <- q + up
        if q == one << p
            q <- q >> 1
            e <- e + 1
        end
    end
    lone : u64 <- 1
    r := ((e + fmt_emax(fmt)) << (p - 1)) | (q - (lone << (p - 1)))
    if neg == 1
        ret r | float_sign(fmt)
    end
    ret r
end

proc float_fmt(t: view u8) -> u64
    if view_eq(t, "f32")
        ret 1
    end
    ret 0
end

proc const_float(pg: ref Prog, mi: u64, n: u64, fmt: u64) -> u64
    -- A constant float expression: a literal, an integer literal, a
    -- negation, or a float constant by name.
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, n)
    k := nd.kind
    if k == N_FLOAT
        t := ctok(cx, nd.t0)
        if fmt == 1
            ret t.sub
        end
        ret t.val
    end
    if k == N_INT
        ret float_int_bits(nd.val, u64(nd.sub), fmt)
    end
    if k == N_UNOP
        if nd.sub == U_NEG
            c := const_float(pg, mi, kid1(cx, n), fmt)
            sg := float_sign(fmt)
            if c >= sg
                ret c - sg
            end
            ret c + sg
        end
    end
    if k == N_NAME
        vi := val_find(pg, tok_text(cx, nd.t0))
        if vi >= 0
            v := val_at(pg, u64.bits(vi))
            vcx := mod_ctx(pg, v.mod)
            vn := node_at(vcx, v.node)
            e : u64 <- kid1(vcx, v.node)
            if vn.val >= 2
                e <- sibling(vcx, e)
            end
            ret const_float(pg, v.mod, e, fmt)
        end
    end
    ret 0
end

proc gen_fbinop(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64, ot: view u8) -> u64
    -- `a + b`, `a < b`, … on two floats of type `ot`.
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, n)
    code := binop_code(tok_text(cx, nd.t0))
    lv := gen_expr(pg, ob, mi, kid1(cx, n), ot)
    rv := gen_expr(pg, ob, mi, kid2(cx, n), ot)
    ob.lastlen <- 0
    if code >= B_EQ
        ret emit_ins(ob, O_FCMP, lv, rv, code, float_width(ot))
    end
    ret emit_ins(ob, O_FBIN, lv, rv, code, float_width(ot))
end

proc gen_segments(pg: rw ref Prog, ob: rw ref Oir, mi: u64, n: u64) -> u64
    -- `arch.x64.segments(code, data)`: the two selectors as values, one
    -- `hw.cmd` that reloads every segment register (design 0015).
    cx := mod_ctx(pg, mi)
    a1 := sibling(cx, kid1(cx, n))
    cv := gen_expr(pg, ob, mi, a1, "u16")
    dv := gen_expr(pg, ob, mi, sibling(cx, a1), "u16")
    emit_ins(ob, O_SEGS, cv, dv, 0, 0)
    ob.lastlen <- 0
    ret emit_ins(ob, O_CONST, 0, 0, 0, 0)
end

proc hw_call_ok(pg: ref Prog, mi: u64, n: u64) -> word
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, n)
    if nd.kind != N_CALL
        ret 0
    end
    ck := call_kind(pg, mi, n)
    if ck == CK_HALT
        ret 1
    end
    if ck == CK_PAUSE
        ret 1
    end
    if ck == CK_INTS
        ret 1
    end
    if ck == CK_CPUCALL
        ret 1
    end
    if ck == CK_CPUJUMP
        ret 1
    end
    if ck == CK_SEGS
        ret 1
    end
    ret 0
end

proc count_locals(pg: ref Prog) -> u64
    ret pg.nloc - pg.locbase
end

proc pay_words(pg: ref Prog, t: view u8) -> u64
    -- The words a payload of type `t` takes: a view two, a choice or a
    -- layout as many as its bytes, anything else one.
    if is_view_type(t) == 1
        ret 2
    end
    it := layout_of(pg, t)
    if it >= 0
        if is_ref_type(t) == 0
            item := item_at(pg, u64.bits(it))
            ret (item.size + 7) / 8
        end
    end
    ret 1
end

proc fallible_wide(pg: ref Prog, t: view u8) -> u64
    -- A `T or E` that does not fit rax and rdx: the words of its area — the
    -- tag and the wider payload — or 0 when the pair carries it.
    if is_fallible(t) == 0
        ret 0
    end
    ok := pay_words(pg, ok_of(t))
    e := err_of(t)
    ew : u64 <- 1
    if view_eq(e, "none") == 0
        ew <- pay_words(pg, e)
    end
    w : u64 <- ok
    if ew > w
        w <- ew
    end
    if w <= 1
        ret 0
    end
    ret 1 + w
end

proc layout_param(pg: ref Prog, t: view u8) -> u64
    -- The size of an aggregate held by its address — a layout by value, or
    -- a choice wider than a word, whose image lies in memory — and 0 for
    -- any other type; a choice that fits a word travels as that word. A
    -- 128-bit vector (design 0024) is one of sixteen bytes.
    if is_vector(t) == 1
        ret 16
    end
    if is_view_type(t) == 1
        ret 0
    end
    if is_ref_type(t) == 1
        ret 0
    end
    if starts_with(unqual(t), "addr ")
        ret 0
    end
    it := layout_of(pg, t)
    if it < 0
        ret 0
    end
    item := item_at(pg, u64.bits(it))
    if item.kind == 1
        if item.size > 8
            ret item.size
        end
        ret 0
    end
    if item.kind != 0
        ret 0
    end
    ret item.size
end

proc gen_params(pg: rw ref Prog, ob: rw ref Oir, node: u64)
    -- Parameters are values (OIR_SPEC §3), stored into the places the body
    -- reads. A view is two words and so two `param` values. Each carries the
    -- location it arrives in, placed by the same rule the caller used, so
    -- the two sides agree by construction. `mem2reg` promotes the places back
    -- to values wherever it can, which is why this is not an optimization
    -- being undone: it is the one form in which a parameter can be reassigned.
    b := pg.sbuf
    regs : u64 <- 0
    stk : u64 <- 0
    xm : u64 <- 0
    ob.sretslot <- 0
    if ob.sretsize > 16
        -- The `sret` pointer arrives in rdi and waits in a compiler-made
        -- word for the `ret` that fills the area it names.
        sp := emit_ins(ob, O_PARAM, 0, 0, 0, 0)
        st := new_tmp(ob)
        emit_ins(ob, O_STORE, st, sp, 0, 0)
        ob.sretslot <- st + 1
        regs <- 1
    end
    if ob.widefall > 0
        -- The same for a fallible result the register pair cannot carry.
        sp2 := emit_ins(ob, O_PARAM, 0, 0, 0, 0)
        st2 := new_tmp(ob)
        emit_ins(ob, O_STORE, st2, sp2, 0, 0)
        ob.sretslot <- st2 + 1
        regs <- 1
    end
    i : u64 <- pg.locbase
    while i < pg.nloc
        l := loc_at(pg, i)
        if l.kind == L_PARAM
            s := i - pg.locbase
            pt := b[l.t0..l.t1]
            if ob.curint == 1
                -- The one parameter of an interrupt handler is the frame the
                -- CPU pushed, a `ref core.x64.InterruptFrame`: its address,
                -- above the registers the prologue saved.
                if regs > 0
                    oir_err(ob, pg, pg.curmod, 900, node)
                end
                if is_ref_type(pt) == 0
                    oir_err(ob, pg, pg.curmod, 900, node)
                end
                fp := emit_ins(ob, O_PARAM, 0, 0, 2, 0)
                emit_ins(ob, O_STORE, local_off(ob, word.bits(s)), fp, 0, 0)
                regs <- 1
                i <- i + 1
                continue
            end
            words : u64 <- 1
            if is_view_type(pt) == 1
                words <- 2
            end
            off := local_off(ob, word.bits(s))
            lay := layout_param(pg, pt)
            if lay > 0
                lw := (lay + 7) / 8
                if lay <= 16
                    -- SysV INTEGER class: one or two eightbytes, placed like
                    -- the words of a view, stored into the local's words —
                    -- the first eightbyte at the lower address.
                    loc0 : u64 <- 0
                    if regs + lw <= 6
                        loc0 <- regs
                        regs <- regs + lw
                    else
                        loc0 <- 6 + stk
                        stk <- stk + lw
                    end
                    e0 := emit_ins(ob, O_PARAM, loc0, 0, 0, 0)
                    e1 : u64 <- 0
                    if lw == 2
                        e1 <- emit_ins(ob, O_PARAM, loc0 + 1, 0, 0, 0)
                    end
                    -- Through the address: the words are memory from here on.
                    pb := emit_ins(ob, O_FADDR, off + lw - 1, 0, 0, 0)
                    emit_ins(ob, O_RSTORE, pb, e0, 8, 0)
                    if lw == 2
                        eight := emit_ins(ob, O_CONST, 0, 0, 0, 8)
                        emit_ins(ob, O_RSTORE, addr_add(ob, pb, eight), e1, 8, 0)
                    end
                else
                    -- SysV MEMORY class: the caller left the bytes above the
                    -- return address; they are copied into the local's words
                    -- so that the local reads like any layout held by value.
                    pv0 := emit_ins(ob, O_PARAM, 6 + stk, 0, 1, 0)
                    stk <- stk + lw
                    gen_copy(ob, emit_ins(ob, O_FADDR, off + lw - 1, 0, 0, 0), pv0, lay)
                end
            elif is_float(pt) == 1
                -- SysV SSE class: xmm0..xmm7 in order.
                if xm >= 8
                    oir_err(ob, pg, pg.curmod, 900, node)
                end
                fp2 := emit_ins(ob, O_PARAM, 1000 + xm, 0, 0, 0)
                emit_ins(ob, O_STORE, off, fp2, 0, 0)
                xm <- xm + 1
            else
                loc : u64 <- 0
                if regs + words <= 6
                    loc <- regs
                    regs <- regs + words
                else
                    loc <- 6 + stk
                    stk <- stk + words
                end
                pv0 := emit_ins(ob, O_PARAM, loc, 0, 0, 0)
                pv : u64 <- pv0
                if proc_clause(pg, pg.curproc, C_EXPORT) != 0
                    -- Callable from C, which leaves the bits above a narrow
                    -- integer undefined (SysV): extended here, once.
                    pv <- narrow_extend(ob, pv0, pt)
                end
                emit_ins(ob, O_STORE, off, pv, 0, 0)
                if words == 2
                    pv2 := emit_ins(ob, O_PARAM, loc + 1, 0, 0, 0)
                    emit_ins(ob, O_STORE, off + 1, pv2, 0, 0)
                end
            end
        end
        i <- i + 1
    end
end

proc gen_extern_proc(pg: rw ref Prog, ob: rw ref Oir, pi: u64)
    -- An `extern proc`: an `OProc` with no instructions and no blocks, so
    -- that procedure and `OProc` indices stay one; the object file carries
    -- it as an undefined symbol and every call to it as a relocation.
    v := proc_at(pg, pi)
    op := oproc_at(ob, ob.nproc)
    op.pi <- pi
    op.mi <- v.mod
    op.first <- ob.nins
    op.n <- 0
    op.nval <- 0
    op.nloc <- 0
    op.nwords <- 0
    op.ntmp <- 0
    op.isentry <- 0
    op.codepos <- 0
    op.codeend <- 0
    op.nphi <- 0
    op.nsave <- 0
    op.nocalls <- 0
    op.isint <- 0
    op.isnever <- 0
    op.boot <- 0
    op.isextern <- 1
    op.symidx <- 0
    op.sect <- 0
    build_blocks(ob, ob.nproc)
    ob.nproc <- ob.nproc + 1
end

proc dv_base(t: view u8) -> word
    -- The base-type code of an integer or `bool`: 0..3 u8..u64, 4..7
    -- s8..s64 by width, 8 bool; -1 for anything else.
    if view_eq(t, "bool")
        ret 8
    end
    nb := int_bits(t)
    if nb == 0
        ret -1
    end
    k : word <- 3
    if nb == 8
        k <- 0
    elif nb == 16
        k <- 1
    elif nb == 32
        k <- 2
    end
    if int_signed(t) == 1
        k <- k + 4
    end
    ret k
end

proc dv_set(ob: rw ref Oir, i: u64, f: u64, v: u64)
    cell_set(ob.dvars, i * DV_N + f, v)
end

proc dv_get(ob: ref Oir, i: u64, f: u64) -> u64
    ret cell_get(ob.dvars, i * DV_N + f)
end

proc dv_class(pg: ref Prog, ob: rw ref Oir, i: u64, t: view u8) -> word
    -- The type class of local `i` from its type text; 0 when the debug
    -- information has no type for it (a zone, a choice, a port).
    b := dv_base(t)
    if b >= 0
        dv_set(ob, i, DV_CODE, u64.bits(b))
        ret DVK_BASE
    end
    if view_eq(t, "physaddr")
        dv_set(ob, i, DV_CODE, 3)
        ret DVK_BASE
    end
    if is_view_type(t) == 1
        vb := dv_base(elem_of(t))
        if vb < 0
            dv_set(ob, i, DV_CODE, 9)
        else
            dv_set(ob, i, DV_CODE, u64.bits(vb))
        end
        ret DVK_VIEW
    end
    if is_array_type(t) == 1
        eb := dv_base(arr_elem(t))
        if eb < 0
            ret 0
        end
        dv_set(ob, i, DV_CODE, u64.bits(eb))
        dv_set(ob, i, DV_COUNT, arr_count(pg, t))
        ret DVK_ARRAY
    end
    it := layout_of(pg, t)
    if it >= 0
        item := item_at(pg, u64.bits(it))
        if item.kind != 0
            ret 0
        end
        dv_set(ob, i, DV_CODE, u64.bits(it))
        if is_ref_type(t) == 1
            ret DVK_LREF
        end
        ret DVK_LAYOUT
    end
    p : view u8 <- t
    if starts_with(p, "rw ")
        p <- p[3..]
    end
    if starts_with(p, "ref ")
        pb := dv_base(p[4..])
        if pb < 0
            dv_set(ob, i, DV_CODE, 9)
        else
            dv_set(ob, i, DV_CODE, u64.bits(pb))
        end
        ret DVK_PTR
    end
    if starts_with(p, "addr ")
        ab := dv_base(p[5..])
        if ab < 0
            dv_set(ob, i, DV_CODE, 9)
        else
            dv_set(ob, i, DV_CODE, u64.bits(ab))
        end
        ret DVK_PTR
    end
    if view_eq(p, "addr")
        dv_set(ob, i, DV_CODE, 9)
        ret DVK_PTR
    end
    ret 0
end

proc dv_record_all(pg: ref Prog, ob: rw ref Oir, q: u64)
    -- Every local of the procedure being built whose type the debug
    -- information can name, with its frame words; kept or not is settled
    -- after `mem2reg` (dv_mark_kept in compiler/ssa.oli).
    b := pg.sbuf
    k : u64 <- pg.locbase
    while k < pg.nloc
        if ob.ndvar < DVAR_MAX
            l := loc_at(pg, k)
            i := ob.ndvar
            dv_set(ob, i, DV_COUNT, 0)
            dv_set(ob, i, DV_CODE, 0)
            c := dv_class(pg, ob, i, b[l.t0..l.t1])
            if c > 0
                s := k - pg.locbase
                dv_set(ob, i, DV_Q, q)
                dv_set(ob, i, DV_MOD, l.mod)
                dv_set(ob, i, DV_NAME, l.name)
                dv_set(ob, i, DV_KIND, u64.bits(c))
                dv_set(ob, i, DV_OFF, local_off(ob, word.bits(s)))
                dv_set(ob, i, DV_WORDS, local_words(pg, b[l.t0..l.t1]))
                dv_set(ob, i, DV_KEPT, 0)
                isp : u64 <- 0
                if l.kind == L_PARAM
                    isp <- 1
                end
                dv_set(ob, i, DV_PARAM, isp)
                ob.ndvar <- i + 1
            end
        end
        k <- k + 1
    end
end

proc gen_proc(pg: rw ref Prog, ob: rw ref Oir, pi: u64)
    -- No statement yet: the parameters belong to no line of the last one.
    if proc_is_extern(pg, pi) == 1
        gen_extern_proc(pg, ob, pi)
        ret
    end
    ob.curnode <- 0
    v := proc_at(pg, pi)
    mi := v.mod
    cx := mod_ctx(pg, mi)
    nd := node_at(cx, v.node)
    collect_locals(pg, mi, v.node)
    pg.sbase <- pg.soff
    pg.curproc <- pi
    op := oproc_at(ob, ob.nproc)
    op.pi <- pi
    op.mi <- mi
    op.first <- ob.nins
    op.nloc <- count_locals(pg)
    op.nwords <- lay_out_locals(pg, ob)
    ob.dbgframe <- pg.dbgframe
    dv_record_all(pg, ob, ob.nproc)
    op.isentry <- 0
    op.codepos <- 0
    op.codeend <- 0
    op.isextern <- 0
    op.symidx <- 0
    op.sect <- 0
    op.bfirst <- 0
    op.nblk <- 0
    op.nphi <- 0
    op.nsave <- 0
    op.nocalls <- proc_calls_none(pg, pi)
    op.isint <- proc_calls_interrupt(pg, pi)
    ob.curint <- op.isint
    if op.isint == 1
        -- An interrupt handler answers nothing: `iretq` is its return.
        if nd.val == 1
            oir_err(ob, pg, mi, 900, v.node)
        end
    end
    op.isnever <- 0
    if view_eq(proc_result(pg, tok_text(cx, nd.t0)), "never")
        op.isnever <- 1
    end
    op.boot <- proc_in_boot(pg, pi)
    if op.nocalls == 1
        -- `calls none`: no frame, so the body is machine blocks alone, with
        -- nothing to load into or store out of them.
        if body_is_machine(pg, mi, v.node) == 0
            oir_err(ob, pg, mi, 900, v.node)
        end
    end
    ob.curloc <- op.nloc
    ob.curwords <- op.nwords
    ob.curtmp <- 0
    if v.node == pg.entrynode
        if mi == pg.entrymod
            op.isentry <- 1
            ob.entryp <- ob.nproc
        end
    end
    ob.curp <- ob.nproc
    ob.brk <- 0
    ob.cont <- 0
    ob.sretsize <- layout_param(pg, proc_result(pg, tok_text(cx, nd.t0)))
    ob.widefall <- fallible_wide(pg, proc_result(pg, tok_text(cx, nd.t0)))
    gen_params(pg, ob, v.node)
    params := kid1(cx, v.node)
    k : u64 <- sibling(cx, params)
    if nd.val == 1
        k <- sibling(cx, k)
    end
    while k != 0
        kn := node_at(cx, k)
        if kn.kind == N_BODY
            gen_block(pg, ob, mi, kid1(cx, k))
            k <- 0
        else
            k <- sibling(cx, k)
        end
    end
    -- Every block ends in a terminator, so a body that can fall off its end
    -- gets the `ret` the machine would have executed anyway.
    need : u64 <- 1
    if ob.nins > op.first
        tail := ins_at(ob, ob.nins - 1)
        if tail.op == O_RET
            need <- 0
        end
    end
    if need == 1
        emit_ins(ob, O_RET, 0, 0, 0, 0)
    end
    op2 := oproc_at(ob, ob.nproc)
    op2.n <- ob.nins - op2.first
    op2.nval <- op2.n
    op2.ntmp <- ob.curtmp
    build_blocks(ob, ob.nproc)
    ob.nproc <- ob.nproc + 1
end

proc build_oir(pg: rw ref Prog, ob: rw ref Oir)
    ob.base <- pg.loadaddr
    collect_data(pg, ob)
    q : u64 <- 0
    while q < pg.nproc
        gen_proc(pg, ob, q)
        q <- q + 1
    end
end

-- `--show-oir` -----------------------------------------------------------------

proc oir_op_name(op: u64) -> view u8
    if op == O_CONST
        ret "const"
    end
    if op == O_SADDR
        ret "addr.of static"
    end
    if op == O_SLEN
        ret "len.of static"
    end
    if op == O_LOAD
        ret "load frame"
    end
    if op == O_STORE
        ret "store frame"
    end
    if op == O_BIN
        ret "bin"
    end
    if op == O_UN
        ret "un"
    end
    if op == O_TRUNC
        ret "trunc"
    end
    if op == O_ARG
        ret "arg"
    end
    if op == O_CALL
        ret "call"
    end
    if op == O_SYSCALL
        ret "syscall"
    end
    if op == O_RET
        ret "ret"
    end
    if op == O_LABEL
        ret "label"
    end
    if op == O_JMP
        ret "jump"
    end
    if op == O_BRANCH
        ret "branch"
    end
    if op == O_PARAM
        ret "param"
    end
    if op == O_TRAP
        ret "trap"
    end
    if op == O_FADDR
        ret "addr.of frame"
    end
    if op == O_RLOAD
        ret "raw.load"
    end
    if op == O_RSTORE
        ret "raw.store"
    end
    if op == O_CHKB
        ret "check.bounds"
    end
    if op == O_CHKR
        ret "check.range"
    end
    if op == O_ZNEW
        ret "zone.new"
    end
    if op == O_ZEND
        ret "zone.end"
    end
    if op == O_ZRAW
        ret "zone.new.raw"
    end
    if op == O_ZFROM
        ret "zone.new.from"
    end
    if op == O_ZENDF
        ret "zone.end.from"
    end
    if op == O_MIN
        ret "machine.in"
    end
    if op == O_MACHINE
        ret "machine"
    end
    if op == O_MOUT
        ret "machine.out"
    end
    if op == O_CPU
        ret "cpu"
    end
    if op == O_HWLOAD
        ret "hw.load"
    end
    if op == O_HWSTORE
        ret "hw.store"
    end
    if op == O_CRLOAD
        ret "hw.load"
    end
    if op == O_CRSTORE
        ret "hw.store"
    end
    if op == O_ATOMIC
        ret "atomic"
    end
    if op == O_FENCE
        ret "cpu.fence"
    end
    if op == O_MEMOP
        ret "mem"
    end
    if op == O_HWRD
        ret "hw.load"
    end
    if op == O_HWWR
        ret "hw.store"
    end
    if op == O_MSRRD
        ret "hw.load"
    end
    if op == O_MSRWR
        ret "hw.store"
    end
    if op == O_CPUID
        ret "hw.cmd"
    end
    if op == O_HWCALL
        ret "hw.cmd"
    end
    if op == O_SEGS
        ret "hw.cmd"
    end
    if op == O_FBIN
        ret "fop"
    end
    if op == O_FCMP
        ret "fcmp"
    end
    if op == O_FCVT
        ret "fcvt"
    end
    if op == O_FRET
        ret "fret"
    end
    if op == O_FRES
        ret "fres"
    end
    if op == O_VBIN
        ret "vop"
    end
    if op == O_VCMP
        ret "vcmp"
    end
    if op == O_ZALLOC
        ret "zone.alloc"
    end
    if op == O_RDX
        ret "call.len"
    end
    if op == O_CHKA
        ret "check.align"
    end
    if op == O_DADDR
        ret "addr.of data"
    end
    if op == O_OVF
        ret "ovf.of"
    end
    if op == O_DEAD
        ret "dead"
    end
    ret "phi"
end

proc oir_bin_name(c: u64) -> view u8
    if c == B_ADD
        ret "add"
    end
    if c == B_SUB
        ret "sub"
    end
    if c == B_MUL
        ret "mul"
    end
    if c == B_DIV
        ret "div"
    end
    if c == B_REM
        ret "rem"
    end
    if c == B_AND
        ret "and"
    end
    if c == B_OR
        ret "or"
    end
    if c == B_XOR
        ret "xor"
    end
    if c == B_SHL
        ret "shl"
    end
    if c == B_SHR
        ret "shr"
    end
    if c == B_EQ
        ret "cmp.eq"
    end
    if c == B_NE
        ret "cmp.ne"
    end
    if c == B_LT
        ret "cmp.lt"
    end
    if c == B_LE
        ret "cmp.le"
    end
    if c == B_GT
        ret "cmp.gt"
    end
    ret "cmp.ge"
end

proc oir_un_name(c: u64) -> view u8
    if c == U1_NEG
        ret "neg"
    end
    if c == U1_BNOT
        ret "not.bits"
    end
    ret "not"
end

proc pv(ob: ref Oir, pg: ref Prog, v: u64)
    -- Values are numbered from the start of their procedure, like the blocks:
    -- the same procedure prints the same names whatever precedes it, and a
    -- rebuilt stream does not renumber the whole program.
    op := oproc_at(ob, ob.curp)
    put(1, "%")
    put_uint(1, pg.tmp, v - op.first)
end

proc print_oir(pg: ref Prog, ob: rw ref Oir)
    tmp := pg.tmp
    put(1, "(oir")
    s : u64 <- 0
    while s < ob.nstat
        st := stat_at(ob, s)
        put(1, "\n  (static ")
        put_uint(1, tmp, s)
        if st.dead == 1
            put(1, " removed)")
        else
            put(1, " len=")
            put_uint(1, tmp, st.len)
            put(1, ")")
        end
        s <- s + 1
    end
    k : u64 <- 0
    while k < ob.ndat
        d := dat_at(ob, k)
        put(1, "\n  (data ")
        put_uint(1, tmp, k)
        put(1, " size=")
        put_uint(1, tmp, d.size)
        if d.init == 1
            put(1, " init")
        else
            put(1, " zero")
        end
        put(1, ")")
        k <- k + 1
    end
    q : u64 <- 0
    while q < ob.nproc
        print_oproc(pg, ob, q)
        q <- q + 1
    end
    put(1, ")\n")
end

proc pbb(ob: ref Oir, pg: ref Prog, b: u64)
    -- Blocks are numbered from the start of their procedure, so the same
    -- program prints the same names whatever precedes it.
    op := oproc_at(ob, ob.curp)
    put(1, "bb")
    put_uint(1, pg.tmp, b - op.bfirst)
end

proc print_oproc(pg: ref Prog, ob: rw ref Oir, q: u64)
    tmp := pg.tmp
    op := oproc_at(ob, q)
    v := proc_at(pg, op.pi)
    cx := mod_ctx(pg, v.mod)
    nd := node_at(cx, v.node)
    ob.curp <- q
    put(1, "\n  (proc ")
    put(1, tok_text(cx, nd.t0))
    put(1, " locals=")
    put_uint(1, tmp, op.nloc)
    if op.ntmp > 0
        put(1, " temps=")
        put_uint(1, tmp, op.ntmp)
    end
    if op.isentry == 1
        put(1, " entry")
    end
    b : u64 <- op.bfirst
    last := op.bfirst + op.nblk
    while b < last
        if live_blk(ob, b) == 1
            print_blk(pg, ob, b)
        end
        b <- b + 1
    end
    put(1, ")")
end

proc print_blk(pg: ref Prog, ob: ref Oir, b: u64)
    bk := blk_at(ob, b)
    put(1, "\n    (")
    pbb(ob, pg, b)
    if bk.npred > 0
        put(1, " preds")
        k : u64 <- 0
        while k < bk.npred
            put(1, " ")
            pbb(ob, pg, cell_get(ob.preds, bk.pfirst + k))
            k <- k + 1
        end
    end
    i : u64 <- bk.first
    last := bk.first + bk.n
    while i < last
        ins := ins_at(ob, i)
        if ins.op != O_DEAD
            put(1, "\n      ")
            print_ins(pg, ob, i)
        end
        print_proofs(pg, ob, i)
        i <- i + 1
    end
    put(1, "\n      ")
    print_term(pg, ob, b)
    put(1, ")")
end

proc print_proofs(pg: ref Prog, ob: ref Oir, i: u64)
    -- A check that went, written where it stood, with the proof that let it
    -- (OIR_SPEC §5 prints a removal exactly this way).
    k : u64 <- 0
    while k < ob.nproof
        pr := proof_at(ob, k)
        if pr.ins == i
            put(1, "\n      ; check.")
            put(1, trap_kind_name(pr.kind))
            put(1, " ")
            pv(ob, pg, pr.val)
            put(1, " -- removed: proof(")
            put(1, proof_name(pr.why))
            put(1, ")")
        end
        k <- k + 1
    end
end

proc proof_name(why: u64) -> view u8
    if why == PR_CONST
        ret "constant"
    end
    if why == PR_DIVISOR
        ret "divisor"
    end
    if why == PR_LOOP
        ret "loop-bound"
    end
    if why == PR_DOM
        ret "dominance"
    end
    ret "unreachable"
end

proc print_term(pg: ref Prog, ob: ref Oir, b: u64)
    bk := blk_at(ob, b)
    if bk.top == O_JMP
        put(1, "jump ")
        pbb(ob, pg, bk.ta)
        ret
    end
    if bk.top == O_BRANCH
        put(1, "branch ")
        pv(ob, pg, bk.ta)
        put(1, ", ")
        pbb(ob, pg, bk.tb)
        put(1, ", ")
        pbb(ob, pg, bk.tc)
        ret
    end
    put(1, "ret")
    if bk.tc > 0
        put(1, " ")
        pv(ob, pg, bk.ta)
    end
    if bk.tc == 2
        -- A pair: the address and length of a view, or the tag and payload
        -- of a `T or E`.
        put(1, ", ")
        pv(ob, pg, bk.tb)
    end
end

proc print_checks(pg: ref Prog, ob: ref Oir, i: u64)
    -- The checks a trapping operation carries, printed as the separate
    -- instructions OIR_SPEC §4 names them. A divide carries its zero check on
    -- the divisor; only `/` also carries the MIN/-1 check, because `%` has the
    -- answer 0 there and does not trap (design 0006).
    ins := ins_at(ob, i)
    if ins.op == O_BIN
        if is_divide(ins.bop) == 1
            if ins.site > 0
                put(1, "\n      check.div_zero ")
                pv(ob, pg, ins.b)
            end
            if ins.site2 > 0
                put(1, "\n      check.overflow ")
                pv(ob, pg, i)
            end
            ret
        end
    end
    if ins.site > 0
        put(1, "\n      check.overflow ")
        pv(ob, pg, i)
    end
end

proc print_ins(pg: ref Prog, ob: ref Oir, i: u64)
    tmp := pg.tmp
    ins := ins_at(ob, i)
    op := ins.op
    if op == O_STORE
        put(1, "store frame.")
        put_uint(1, tmp, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_ARG
        if ins.b >= 6
            put(1, "arg.stack.")
            put_uint(1, tmp, ins.b - 6)
            put(1, " ")
        else
            put(1, "arg ")
        end
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_RSTORE
        put(1, "raw.store.")
        put_uint(1, tmp, ins.c * 8)
        if ins.val == 1
            put(1, ".mmio")
        end
        put(1, " ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_HWSTORE
        put(1, "hw.store port.")
        put(1, hw_type(ins.c * 8))
        put(1, " ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_CRSTORE
        put(1, "hw.store arch.x64.")
        put(1, cr_name(ins.val))
        put(1, ", ")
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_FENCE
        put(1, "cpu.fence ")
        put(1, order_name(ins.val))
        ret
    end
    if op == O_HWWR
        if ins.val == 9
            put(1, "hw.cmd cpu.jump ")
        else
            put(1, "hw.store ")
            put(1, hwplace_name(ins.val))
            put(1, ", ")
        end
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_MSRWR
        put(1, "hw.store arch.x64.msr ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_CPUID
        put(1, "hw.cmd cpu.id ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_FBIN
        put(1, "f")
        put(1, oir_bin_name(ins.c))
        put(1, ".")
        put_uint(1, tmp, ins.val)
        put(1, " ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_FCMP
        put(1, "fcmp.")
        put(1, oir_bin_name(ins.c))
        put(1, ".")
        put_uint(1, tmp, ins.val)
        put(1, " ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_FCVT
        put(1, fcvt_name(ins.c))
        put(1, " ")
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_FRET
        put(1, "fret ")
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_FRES
        put(1, "fres")
        ret
    end
    if op == O_VBIN
        put(1, "v")
        put(1, oir_bin_name(ins.c))
        put(1, ".")
        put(1, vec_name(ins.val))
        put(1, " ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_VCMP
        put(1, "vcmp.")
        put(1, oir_bin_name(ins.c))
        put(1, ".")
        put(1, vec_name(ins.val))
        put(1, " ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_SEGS
        put(1, "hw.cmd arch.x64.segments ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_HWCALL
        if ins.val == 1
            put(1, "hw.cmd arch.a64.eret ")
        else
            put(1, "hw.cmd cpu.call ")
        end
        cpv := proc_at(pg, ins.c)
        ccx := mod_ctx(pg, cpv.mod)
        cnd := node_at(ccx, cpv.node)
        put(1, tok_text(ccx, cnd.t0))
        ret
    end
    if op == O_MEMOP
        put(1, memop_name(ins.bop))
        put(1, " ")
        pv(ob, pg, ins.a)
        if ins.bop <= 1
            put(1, ", ")
            pv(ob, pg, ins.b)
        end
        put(1, ", ")
        pv(ob, pg, ins.val)
        ret
    end
    if op == O_CHKB
        put(1, "check.bounds ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_CHKA
        put(1, "check.align ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        put_uint(1, tmp, ins.b)
        ret
    end
    if op == O_CHKR
        put(1, "check.range ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        put(1, ", ")
        pv(ob, pg, ins.val)
        ret
    end
    if op == O_ZNEW
        put(1, "zone.new ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_ZEND
        put(1, "zone.end ")
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_ZRAW
        put(1, "zone.new.raw ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        put(1, ", ")
        pv(ob, pg, ins.val)
        ret
    end
    if op == O_ZFROM
        put(1, "zone.new.from ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        put(1, ", ")
        pv(ob, pg, ins.val)
        ret
    end
    if op == O_ZENDF
        put(1, "zone.end.from ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        ret
    end
    if op == O_MIN
        put(1, "machine.in ")
        put(1, reg_name(ins.w, ins.c))
        put(1, ", ")
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_MACHINE
        put(1, "machine x64")
        ret
    end
    if op == O_CPU
        if ins.val == 0
            put(1, "cpu.halt")
        elif ins.val == 2
            put(1, "cpu.interrupts off")
        elif ins.val == 3
            put(1, "cpu.interrupts on")
        else
            put(1, "cpu.pause")
        end
        ret
    end
    if op == O_MOUT
        pv(ob, pg, i)
        put(1, " = machine.out ")
        put(1, reg_name(ins.w, ins.c))
        ret
    end
    pv(ob, pg, i)
    put(1, " = ")
    if op == O_CONST
        put(1, "const ")
        put_uint(1, tmp, ins.val)
        ret
    end
    if op == O_SADDR
        put(1, "addr.of static.")
        put_uint(1, tmp, ins.a)
        ret
    end
    if op == O_SLEN
        put(1, "len.of static.")
        put_uint(1, tmp, ins.a)
        ret
    end
    if op == O_LOAD
        put(1, "load frame.")
        put_uint(1, tmp, ins.a)
        ret
    end
    if op == O_BIN
        put(1, oir_bin_name(ins.bop))
        if ins.c == 1
            put(1, ".s")
        end
        put(1, " ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        print_checks(pg, ob, i)
        ret
    end
    if op == O_UN
        put(1, oir_un_name(ins.bop))
        put(1, " ")
        pv(ob, pg, ins.a)
        print_checks(pg, ob, i)
        ret
    end
    if op == O_TRUNC
        put(1, "trunc.")
        put_uint(1, tmp, ins.b)
        if ins.c == 1
            put(1, ".s")
        end
        put(1, " ")
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_CALL
        v := proc_at(pg, ins.a)
        cx := mod_ctx(pg, v.mod)
        nd := node_at(cx, v.node)
        put(1, "call ")
        put(1, tok_text(cx, nd.t0))
        put(1, "/")
        put_uint(1, tmp, ins.b)
        ret
    end
    if op == O_SYSCALL
        put(1, "syscall/")
        put_uint(1, tmp, ins.b)
        ret
    end
    if op == O_TRAP
        -- The operation folded to the trap it always took (§6): its operands
        -- were constants and the answer was one the type cannot hold. It
        -- keeps the index the operation had, because the operands that named
        -- it still do; nothing reads what it leaves, as it does not return.
        put(1, "trap ")
        put(1, trap_kind_name(ins.c))
        ret
    end
    if op == O_PARAM
        if ins.a >= 6
            put(1, "param stack.")
            put_uint(1, tmp, ins.a - 6)
        else
            put(1, "param ")
            put_uint(1, tmp, ins.a)
        end
        ret
    end
    if op == O_FADDR
        put(1, "addr.of frame.")
        put_uint(1, tmp, ins.a)
        ret
    end
    if op == O_DADDR
        put(1, "addr.of data.")
        put_uint(1, tmp, ins.a)
        ret
    end
    if op == O_OVF
        put(1, "ovf.of ")
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_RLOAD
        put(1, "raw.load.")
        put_uint(1, tmp, ins.b * 8)
        if ins.c == 1
            put(1, ".s")
        end
        if ins.val == 1
            put(1, ".mmio")
        end
        put(1, " ")
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_HWLOAD
        put(1, "hw.load port.")
        put(1, hw_type(ins.b * 8))
        put(1, " ")
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_CRLOAD
        put(1, "hw.load arch.x64.")
        put(1, cr_name(ins.val))
        ret
    end
    if op == O_HWRD
        if ins.val == 8
            put(1, "hw.cmd cpu.tsc")
        else
            put(1, "hw.load ")
            put(1, hwplace_name(ins.val))
        end
        ret
    end
    if op == O_MSRRD
        if ins.val == 25
            put(1, "hw.cmd arch.a64.svc ")
        else
            put(1, "hw.load arch.x64.msr ")
        end
        pv(ob, pg, ins.a)
        ret
    end
    if op == O_ATOMIC
        put(1, "atomic.")
        put(1, atomic_name(ins.bop))
        put(1, ".")
        put_uint(1, tmp, (ins.c % 16) * 8)
        if ins.c >= 16
            put(1, ".s")
        end
        put(1, " ")
        pv(ob, pg, ins.a)
        if ins.bop >= 1
            put(1, ", ")
            pv(ob, pg, ins.b)
        end
        if ins.bop == 8
            put(1, ", ")
            pv(ob, pg, ins.val)
        end
        put(1, " ")
        put(1, order_name(ins.w))
        ret
    end
    if op == O_ZALLOC
        put(1, "zone.alloc ")
        pv(ob, pg, ins.a)
        put(1, ", ")
        pv(ob, pg, ins.b)
        if ins.c > 16
            put(1, " align=")
            put_uint(1, tmp, ins.c)
        end
        ret
    end
    if op == O_RDX
        if ins.c == 1
            put(1, "call.payload")
        elif ins.c == 2
            put(1, "call.word1")
        else
            put(1, "call.len")
        end
        ret
    end
    if op == O_PHI
        put(1, "phi")
        k : u64 <- 0
        while k < ins.b
            pa := phiarg_at(ob, ins.a + k)
            put(1, " [")
            pbb(ob, pg, pa.blk)
            put(1, " ")
            pv(ob, pg, pa.val)
            put(1, "]")
            k <- k + 1
        end
        ret
    end
    put(1, oir_op_name(op))
end
