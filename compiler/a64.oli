module olic.a64
-- The AArch64 back end (docs/COMPILER_ARCHITECTURE.md): the same OIR as
-- compiler/x64.oli, lowered to A64 instructions for Linux, selected by a
-- target profile with `arch = "aarch64"`. Values get the callee-saved
-- registers x19-x23 from the linear scan of compiler/x64.oli (its rbx and
-- r12-r15, one for one), the rest their frame words; the back end lowers: constants, frame places, arithmetic with every trap of MACHINE_MODEL
-- §4 (the flags of `adds`/`subs`, `smulh`/`umulh`, the re-extension of a
-- narrow type), comparisons, conversions of width, raw loads and stores,
-- statics, views and their checks, calls (six argument words in x0-x5,
-- the rest on the stack), system calls (`svc #0`, the number in x8), the
-- entry's exit, zones (mmap/munmap), `mem.copy`/`set`/`zero`, the
-- `sat`/`checked` modes, `f32`/`f64` (FP registers, d0-d7 across calls),
-- 128-bit vectors (NEON), atomics (`ldaxr`/`stlxr`) and fences (`dmb`).
-- the generic hardware commands (`cpu.stack`/`frame`, `cpu.call`/`jump`,
-- `cpu.halt` as `wfi`, `cpu.interrupts` as `msr daif…`, `cpu.tsc` as
-- cntvct_el0), `calls none` procedures (their values in x19-x28, no frame),
-- object files (R_AARCH64_* relocations) and freestanding images. What is
-- x86 by nature — machine x64 blocks, ports, control registers, MSRs,
-- descriptor tables, interrupt procedures — is E0900 at the procedure,
-- never an approximation.
--
-- Registers: x0-x5 arguments and results, x8 the system-call number, x9-x12
-- scratch, x16/x17 address scratch, x29 the frame pointer, x30 the link.
-- A value's word is [x29 - 8 * (slot + 1)], the slot numbering of
-- compiler/x64.oli (`val_slot`, `scratch_slot`).

-- Fixup kinds: AF_* in compiler/x64.oli, beside that back end's own.

-- Condition codes.
AC_EQ := 0
AC_NE := 1
AC_HS := 2
AC_LO := 3
AC_VC := 7
AC_HI := 8
AC_LS := 9
AC_GE := 10
AC_LT := 11
AC_GT := 12
AC_LE := 13

proc aw(ob: rw ref Oir, v: u64)
    -- One instruction word, little-endian.
    c32(ob, v)
end

proc a_movz(ob: rw ref Oir, d: u64, imm: u64, hw: u64)
    aw(ob, 3531603968 | (hw << 21) | (imm << 5) | d)
end

proc a_movk(ob: rw ref Oir, d: u64, imm: u64, hw: u64)
    aw(ob, 4068474880 | (hw << 21) | (imm << 5) | d)
end

proc a_imm(ob: rw ref Oir, d: u64, v: u64)
    -- `movz` and a `movk` for each other non-zero half-word.
    a_movz(ob, d, v & 65535, 0)
    h : u64 <- 1
    while h < 4
        part := (v >> (h * 16)) & 65535
        if part != 0
            a_movk(ob, d, part, h)
        end
        h <- h + 1
    end
end

proc a_rrr(ob: rw ref Oir, base: u64, d: u64, n: u64, m: u64)
    -- A three-register data-processing instruction.
    aw(ob, base | (m << 16) | (n << 5) | d)
end

proc a_mov(ob: rw ref Oir, d: u64, m: u64)
    -- `orr xd, xzr, xm`
    aw(ob, 2852127712 | (m << 16) | d)
end

proc a_cmp(ob: rw ref Oir, n: u64, m: u64)
    -- `subs xzr, xn, xm`
    aw(ob, 3942645791 | (m << 16) | (n << 5))
end

proc a_cset(ob: rw ref Oir, d: u64, cond: u64)
    -- `csinc xd, xzr, xzr, !cond`
    aw(ob, 2594113504 | ((cond ^ 1) << 12) | d)
end

proc a_slot_disp(s: u64) -> u64
    ret (s + 1) * 8
end

proc a_ldr_slot(ob: rw ref Oir, t: u64, s: u64)
    -- The word of slot `s` into xt: `ldur` when the displacement fits nine
    -- signed bits, else through x17.
    disp := a_slot_disp(s)
    if disp <= 256
        aw(ob, 4164943872 | (((512 - disp) & 511) << 12) | (29 << 5) | t)
        ret
    end
    a_imm(ob, 16, disp)
    a_rrr(ob, 3405774848, 17, 29, 16)
    aw(ob, 4181721088 | (17 << 5) | t)
end

proc a_str_slot(ob: rw ref Oir, t: u64, s: u64)
    disp := a_slot_disp(s)
    if disp <= 256
        aw(ob, 4160749568 | (((512 - disp) & 511) << 12) | (29 << 5) | t)
        ret
    end
    a_imm(ob, 16, disp)
    a_rrr(ob, 3405774848, 17, 29, 16)
    aw(ob, 4177526784 | (17 << 5) | t)
end

proc a_lea_slot(ob: rw ref Oir, d: u64, s: u64)
    -- The address of slot `s`: x29 - disp.
    a_imm(ob, 16, a_slot_disp(s))
    a_rrr(ob, 3405774848, d, 29, 16)
end

proc a_ldr_off(ob: rw ref Oir, t: u64, n: u64, off: u64)
    -- `ldr xt, [xn, #off]` (off a multiple of eight below 32768).
    aw(ob, 4181721088 | ((off / 8) << 10) | (n << 5) | t)
end

proc a_str_off(ob: rw ref Oir, t: u64, n: u64, off: u64)
    aw(ob, 4177526784 | ((off / 8) << 10) | (n << 5) | t)
end

proc a_add_imm(ob: rw ref Oir, d: u64, n: u64, imm: u64)
    -- `add xd, xn, #imm` (imm below 4096; sp may be d or n).
    aw(ob, 2432696320 | (imm << 10) | (n << 5) | d)
end

proc a_sub_imm(ob: rw ref Oir, d: u64, n: u64, imm: u64)
    aw(ob, 3506438144 | (imm << 10) | (n << 5) | d)
end

proc a_reg_of(l: u64) -> u64
    -- The register `mc.loc` names: 100 + n is xn itself (a frameless
    -- procedure, a_none_assign); otherwise the x86-64 code the linear scan
    -- of compiler/x64.oli chose, mapped to its AArch64 callee-saved twin —
    -- rbx x19, r12 x20, r13 x21, r14 x22, r15 x23.
    if l >= 100
        ret l - 100
    end
    if l == 3
        ret 19
    end
    ret l + 8
end

proc a_ld(ob: rw ref Oir, mc: ref Mach, r: u64, v: u64)
    -- A value from the register the allocation gave it, else its frame word.
    l := cell_get(mc.loc, v)
    if l > 0
        x := a_reg_of(l - 1)
        if x != r
            a_mov(ob, r, x)
        end
        ret
    end
    a_ldr_slot(ob, r, val_slot(mc, v))
end

proc a_st(ob: rw ref Oir, mc: ref Mach, r: u64, v: u64)
    l := cell_get(mc.loc, v)
    if l > 0
        x := a_reg_of(l - 1)
        if x != r
            a_mov(ob, x, r)
        end
        ret
    end
    a_str_slot(ob, r, val_slot(mc, v))
end

proc a_save_regs(ob: rw ref Oir, mc: ref Mach, restore: u64)
    -- The callee-saved registers the allocation used, into (or back from)
    -- the frame words compiler/x64.oli `save_regs` keeps them in.
    base := mc.curloc + mc.curtmp + mc.curnval + mc.curnphi + 5
    k : u64 <- 0
    while k < 5
        r := alloc_reg(k)
        if mc.usedmask & (1 << r) != 0
            if restore == 1
                a_ldr_slot(ob, a_reg_of(r), base + k)
            else
                a_str_slot(ob, a_reg_of(r), base + k)
            end
        end
        k <- k + 1
    end
end

proc a_extend(ob: rw ref Oir, d: u64, n: u64, w: u64, signd: u64)
    -- xd <- xn re-extended from `w` bits: sxtb/sxth/sxtw or uxtb/uxth/uxtw
    -- (SBFM/UBFM); a plain move for a word.
    imms : u64 <- 63
    if w == 8
        imms <- 7
    elif w == 16
        imms <- 15
    elif w == 32
        imms <- 31
    end
    if imms == 63
        if d != n
            a_mov(ob, d, n)
        end
        ret
    end
    if signd == 1
        aw(ob, 2470445056 | (imms << 10) | (n << 5) | d)
    else
        aw(ob, 3544186880 | (imms << 10) | (n << 5) | d)
    end
end

-- Traps -------------------------------------------------------------------

proc a_trap_seq(ob: rw ref Oir, mc: rw ref Mach, si: u64)
    -- Hosted: x0 the message (`adr`, the read-only segment precedes the
    -- code), x1 its length, `bl` the trap routine. Freestanding: x0 the
    -- kind, x1/x2 the file's static and length, x3 the line — the
    -- `core.Site` the routine hands to the `traps` procedure — or `udf`
    -- when the program has none.
    if mc.fstand == 1
        if mc.trapproc == 0
            aw(ob, 0)
            ret
        end
        m := tmsg_of(ob, si - 1)
        fs := stat_at(ob, m.fstat - 1)
        a_imm(ob, 0, m.kind - 1)
        add_fix(mc, ob.ncode, AF_ADR, fs.off)
        aw(ob, 268435456 | 1)
        a_imm(ob, 2, fs.len)
        a_imm(ob, 3, m.line)
        add_fix(mc, ob.ncode, AF_TRAP, 0)
        aw(ob, 2483027968)
        mc.ntrap <- mc.ntrap + 1
        ret
    end
    st := stat_at(ob, si - 1)
    add_fix(mc, ob.ncode, AF_ADR, st.off)
    aw(ob, 268435456)
    a_movz(ob, 1, st.len & 65535, 0)
    add_fix(mc, ob.ncode, AF_TRAP, 0)
    aw(ob, 2483027968)
    mc.ntrap <- mc.ntrap + 1
end

proc a_trap_unless(ob: rw ref Oir, mc: rw ref Mach, cond: u64, si: u64)
    -- `b.cond` over the three words of the trap when nothing traps.
    if si == 0
        ret
    end
    pos := ob.ncode
    aw(ob, 1409286144 | cond)
    a_trap_seq(ob, mc, si)
    a_or32(ob, pos, ((ob.ncode - pos) / 4) << 5)
end

proc a_width_check(ob: rw ref Oir, mc: rw ref Mach, w: u64, signd: u64, si: u64)
    -- x9 re-extended to its type; a difference was an overflow no flag saw.
    if w == 0
        ret
    end
    if w >= 64
        ret
    end
    a_extend(ob, 11, 9, w, signd)
    if si > 0
        a_cmp(ob, 9, 11)
        a_trap_unless(ob, mc, AC_EQ, si)
    end
    a_mov(ob, 9, 11)
end

proc a_trap_routine(ob: rw ref Oir, mc: rw ref Mach)
    -- `core.trap` for a hosted program: write(2, x0, x1), exit_group(134).
    -- Freestanding: the CPU stops where it trapped — `wfi` forever, the
    -- message still in x0/x1 for a debugger (the `traps` procedure of
    -- x86-64 is not called on AArch64 yet).
    mc.trappos <- ob.ncode
    if mc.fstand == 1
        -- The `core.Site` (file address, length, line: 24 bytes, passed in
        -- memory) on the stack at the call, the kind in x0, the `traps`
        -- procedure called; it never returns, and `wfi` stands after it.
        a_sub_imm(ob, 31, 31, 32)
        a_str_off(ob, 1, 31, 0)
        a_str_off(ob, 2, 31, 8)
        a_str_off(ob, 3, 31, 16)
        add_fix(mc, ob.ncode, AF_CALL, mc.trapproc - 1)
        aw(ob, 2483027968)
        aw(ob, 3573751935)
        aw(ob, 335544320 | 67108863)
        ret
    end
    a_mov(ob, 2, 1)
    a_mov(ob, 1, 0)
    a_movz(ob, 0, 2, 0)
    a_movz(ob, 8, 64, 0)
    aw(ob, 3556769793)
    a_movz(ob, 0, 134, 0)
    a_movz(ob, 8, 94, 0)
    aw(ob, 3556769793)
end

-- Instructions ------------------------------------------------------------

proc a_bin(ob: rw ref Oir, mc: rw ref Mach, i: u64)
    ins := ins_at(ob, i)
    bop := ins.bop
    a_ld(ob, mc, 9, ins.a)
    a_ld(ob, mc, 10, ins.b)
    sg := ins.c
    if bop == B_ADD
        a_rrr(ob, 2868903936, 9, 9, 10)
        if sg == 1
            a_trap_unless(ob, mc, AC_VC, ins.site)
        else
            a_trap_unless(ob, mc, AC_LO, ins.site)
        end
        a_width_check(ob, mc, ins.w, sg, ins.site)
    elif bop == B_SUB
        a_rrr(ob, 3942645760, 9, 9, 10)
        if sg == 1
            a_trap_unless(ob, mc, AC_VC, ins.site)
        else
            a_trap_unless(ob, mc, AC_HS, ins.site)
        end
        a_width_check(ob, mc, ins.w, sg, ins.site)
    elif bop == B_MUL
        a_rrr(ob, 2600500224, 11, 9, 10)
        if ins.site > 0
            if sg == 1
                -- smulh x12; the high half must be the sign of the low one.
                a_rrr(ob, 2604694528, 12, 9, 10)
                aw(ob, 3951098911 | (11 << 16) | (12 << 5))
            else
                -- umulh x12 must be zero.
                a_rrr(ob, 2613083136, 12, 9, 10)
                a_cmp(ob, 12, 31)
            end
            a_trap_unless(ob, mc, AC_EQ, ins.site)
        end
        a_mov(ob, 9, 11)
        a_width_check(ob, mc, ins.w, sg, ins.site)
    elif bop == B_AND
        a_rrr(ob, 2315255808, 9, 9, 10)
    elif bop == B_OR
        a_rrr(ob, 2852126720, 9, 9, 10)
    elif bop == B_XOR
        a_rrr(ob, 3388997632, 9, 9, 10)
    elif bop == B_SHL
        a_mask_count(ob, ins.w)
        a_rrr(ob, 2596282368, 9, 9, 10)
        a_width_check(ob, mc, ins.w, sg, 0)
    elif bop == B_SHR
        a_mask_count(ob, ins.w)
        if sg == 1
            a_rrr(ob, 2596284416, 9, 9, 10)
        else
            a_rrr(ob, 2596283392, 9, 9, 10)
        end
    elif bop == B_DIV
        a_divide(ob, mc, ins, 0)
    elif bop == B_REM
        a_divide(ob, mc, ins, 1)
    else
        a_cmp(ob, 9, 10)
        a_cset(ob, 9, a_cond(bop, sg))
    end
    a_st(ob, mc, 9, i)
end

proc a_mask_count(ob: rw ref Oir, w: u64)
    -- A narrow shift count is masked to its width, as on x86-64 (a 64-bit
    -- one the instruction masks itself).
    if w == 0
        ret
    end
    if w >= 64
        ret
    end
    a_imm(ob, 11, w - 1)
    a_rrr(ob, 2315255808, 10, 10, 11)
end

proc a_cond(bop: u64, signd: u64) -> u64
    if bop == B_EQ
        ret AC_EQ
    end
    if bop == B_NE
        ret AC_NE
    end
    if signd == 1
        if bop == B_LT
            ret AC_LT
        end
        if bop == B_LE
            ret AC_LE
        end
        if bop == B_GT
            ret AC_GT
        end
        ret AC_GE
    end
    if bop == B_LT
        ret AC_LO
    end
    if bop == B_LE
        ret AC_LS
    end
    if bop == B_GT
        ret AC_HI
    end
    ret AC_HS
end

proc a_divide(ob: rw ref Oir, mc: rw ref Mach, ins: ref Ins, rem: u64)
    -- A zero divisor traps (site); `/` of the most negative value by -1
    -- traps (site2). `sdiv` itself never faults, and `msub` gives the
    -- remainder 0 for that pair, which `%` answers.
    if ins.site > 0
        a_cmp(ob, 10, 31)
        a_trap_unless(ob, mc, AC_NE, ins.site)
    end
    if ins.c == 1
        if rem == 0
            if ins.site2 > 0
                -- x9 == 2^63 and x10 == -1: both compared, the second only
                -- when the first held (`b.ne` over the rest).
                a_movz(ob, 11, 32768, 3)
                a_cmp(ob, 9, 11)
                aw(ob, 1409286144 | (6 << 5) | AC_NE)
                a_imm(ob, 11, 18446744073709551615)
                a_cmp(ob, 10, 11)
                a_trap_unless(ob, mc, AC_NE, ins.site2)
            end
        end
        a_rrr(ob, 2596277248, 11, 9, 10)
    else
        a_rrr(ob, 2596276224, 11, 9, 10)
    end
    if rem == 1
        -- msub x9, x11, x10, x9
        aw(ob, 2600501248 | (10 << 16) | (9 << 10) | (11 << 5) | 9)
    else
        a_mov(ob, 9, 11)
    end
    a_width_check(ob, mc, ins.w, ins.c, ins.site2)
end

proc a_un(ob: rw ref Oir, mc: rw ref Mach, i: u64)
    ins := ins_at(ob, i)
    a_ld(ob, mc, 9, ins.a)
    if ins.bop == U1_NEG
        if ins.c == 1
            -- negs x9, x9: V set for the most negative value.
            aw(ob, 3943236585)
            a_trap_unless(ob, mc, AC_VC, ins.site)
        else
            -- An unsigned negation overflows unless the value is 0.
            if ins.site > 0
                a_cmp(ob, 9, 31)
                a_trap_unless(ob, mc, AC_EQ, ins.site)
            end
            aw(ob, 3406365673)
        end
        a_width_check(ob, mc, ins.w, ins.c, ins.site)
    elif ins.bop == U1_BNOT
        -- orn x9, xzr, x9
        aw(ob, 2854814697)
        a_width_check(ob, mc, ins.w, ins.c, 0)
    else
        a_cmp(ob, 9, 31)
        a_cset(ob, 9, AC_EQ)
    end
    a_st(ob, mc, 9, i)
end

proc a_rload(ob: rw ref Oir, mc: ref Mach, i: u64)
    -- ldrb/ldrh/ldr w/ldr x, or the sign-extending ldrsb/ldrsh/ldrsw.
    ins := ins_at(ob, i)
    a_ld(ob, mc, 9, ins.a)
    sz := ins.b
    base : u64 <- 4181721088
    if sz == 1
        base <- 960495616
        if ins.c == 1
            base <- 964689920
        end
    elif sz == 2
        base <- 2034237440
        if ins.c == 1
            base <- 2038431744
        end
    elif sz == 4
        base <- 3107979264
        if ins.c == 1
            base <- 3112173568
        end
    end
    aw(ob, base | (9 << 5) | 9)
    a_st(ob, mc, 9, i)
end

proc a_rstore(ob: rw ref Oir, mc: ref Mach, i: u64)
    ins := ins_at(ob, i)
    a_ld(ob, mc, 9, ins.a)
    a_ld(ob, mc, 10, ins.b)
    sz := ins.c
    base : u64 <- 4177526784
    if sz == 1
        base <- 956301312
    elif sz == 2
        base <- 2030043136
    elif sz == 4
        base <- 3103784960
    end
    aw(ob, base | (9 << 5) | 10)
end

proc a_load_args(ob: rw ref Oir, mc: ref Mach, i: u64, nargs: u64, issys: u64) -> word
    -- The argument markers of this call, as compiler/x64.oli walks them;
    -- a word past the sixth is not lowered yet (-1).
    j : u64 <- i
    skip : u64 <- 0
    k : u64 <- nargs
    while k > 0
        if j == 0
            ret 0
        end
        j <- j - 1
        ins := ins_at(ob, j)
        if ins.op == O_ARG
            if skip > 0
                skip <- skip - 1
            else
                k <- k - 1
                if issys == 1
                    if k == 0
                        a_ld(ob, mc, 8, ins.a)
                    else
                        a_ld(ob, mc, k - 1, ins.a)
                    end
                elif ins.b >= 1000
                    -- A float argument into d(b - 1000).
                    a_ld(ob, mc, 9, ins.a)
                    a_fmov_dx(ob, ins.b - 1000, 9)
                elif ins.b < 6
                    a_ld(ob, mc, ins.b, ins.a)
                else
                    -- A stack word: [sp + 8 * (location - 6)], the area the
                    -- call reserved (a_call).
                    a_ld(ob, mc, 9, ins.a)
                    a_str_off(ob, 9, 31, (ins.b - 6) * 8)
                end
            end
        end
        if ins.op == O_CALL
            skip <- skip + ins.b
        end
        if ins.op == O_SYSCALL
            skip <- skip + ins.b
        end
    end
    ret 0
end

proc a_refuse(pg: rw ref Prog, ob: rw ref Oir, mc: ref Mach)
    -- E0900 at the procedure being lowered.
    op := oproc_at(ob, mc.curq)
    pv := proc_at(pg, op.pi)
    oir_err(ob, pg, op.mi, 900, pv.node)
end

proc a_ins(pg: rw ref Prog, ob: rw ref Oir, mc: rw ref Mach, i: u64)
    ins := ins_at(ob, i)
    op := ins.op
    if op == O_CONST
        a_imm(ob, 9, ins.val)
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_SLEN
        st := stat_at(ob, ins.a)
        a_imm(ob, 9, st.len)
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_SADDR
        st2 := stat_at(ob, ins.a)
        add_fix(mc, ob.ncode, AF_ADR, st2.off)
        aw(ob, 268435456 | 9)
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_DADDR
        d := dat_at(ob, ins.a)
        add_fix(mc, ob.ncode, AF_ADRP, d.off)
        aw(ob, 2415919104 | 9)
        aw(ob, 2432696320 | (9 << 5) | 9)
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_LOAD
        a_ldr_slot(ob, 9, ins.a)
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_STORE
        a_ld(ob, mc, 9, ins.b)
        a_str_slot(ob, 9, ins.a)
        ret
    end
    if op == O_FADDR
        a_lea_slot(ob, 9, ins.a)
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_BIN
        a_bin(ob, mc, i)
        ret
    end
    if op == O_UN
        a_un(ob, mc, i)
        ret
    end
    if op == O_TRUNC
        a_ld(ob, mc, 9, ins.a)
        a_extend(ob, 9, 9, ins.b, ins.c)
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_ARG
        ret
    end
    if op == O_CALL
        -- Stack words (ins.c) below the caller's sp, sixteen-byte aligned.
        stk := (ins.c * 8 + 15) / 16 * 16
        if stk > 0
            a_sub_imm(ob, 31, 31, stk)
        end
        a_load_args(ob, mc, i, ins.b, 0)
        add_fix(mc, ob.ncode, AF_CALL, ins.a)
        aw(ob, 2483027968)
        if stk > 0
            a_add_imm(ob, 31, 31, stk)
        end
        a_st(ob, mc, 0, i)
        ret
    end
    if op == O_RDX
        a_st(ob, mc, 1, i)
        ret
    end
    if op == O_SYSCALL
        a_load_args(ob, mc, i, ins.b, 1)
        aw(ob, 3556769793)
        a_st(ob, mc, 0, i)
        ret
    end
    if op == O_PARAM
        if ins.c == 2
            -- An exception handler's frame: the saved registers, whose
            -- address its vector-table slot passes in x0 (design 0025).
            a_st(ob, mc, 0, i)
            ret
        end
        if ins.a >= 1000
            -- A float: from d(a - 1000) (AAPCS64 v0-v7).
            a_fmov_xd(ob, 9, ins.a - 1000)
            a_st(ob, mc, 9, i)
            ret
        end
        if ins.a < 6
            a_st(ob, mc, ins.a, i)
            ret
        end
        -- Past the sixth word: above the saved x29/x30, at x29 + 16.
        if ins.c == 1
            -- A layout's bytes there: the parameter is their address.
            a_add_imm(ob, 9, 29, 16 + (ins.a - 6) * 8)
        else
            a_ldr_off(ob, 9, 29, 16 + (ins.a - 6) * 8)
        end
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_ZNEW
        a_znew(ob, mc, i)
        ret
    end
    if op == O_ZEND
        -- munmap(base, limit - base)
        a_ld(ob, mc, 11, ins.a)
        a_ldr_off(ob, 0, 11, 0)
        a_ldr_off(ob, 1, 11, 16)
        a_rrr(ob, 3405774848, 1, 1, 0)
        a_movz(ob, 8, 215, 0)
        aw(ob, 3556769793)
        ret
    end
    if op == O_ZALLOC
        al : u64 <- 16
        if ins.c > 16
            al <- ins.c
        end
        a_alloc_core(ob, mc, ins.a, ins.b, al, ins.site)
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_ZRAW
        -- (addr, addr, addr + size) over memory already there.
        a_ld(ob, mc, 9, ins.val)
        a_ld(ob, mc, 10, ins.b)
        a_ld(ob, mc, 11, ins.a)
        a_str_off(ob, 9, 11, 0)
        a_str_off(ob, 9, 11, 8)
        a_rrr(ob, 2332033024, 10, 10, 9)
        a_str_off(ob, 10, 11, 16)
        ret
    end
    if op == O_ZFROM
        -- Carved from the parent like an allocation, the child laid over it.
        a_alloc_core(ob, mc, ins.val, ins.b, 16, ins.site)
        a_ld(ob, mc, 11, ins.a)
        a_str_off(ob, 9, 11, 0)
        a_str_off(ob, 9, 11, 8)
        a_rrr(ob, 2332033024, 9, 9, 10)
        a_str_off(ob, 9, 11, 16)
        ret
    end
    if op == O_ZENDF
        -- The parent's cursor back to the child's base.
        a_ld(ob, mc, 11, ins.a)
        a_ldr_off(ob, 9, 11, 0)
        a_ld(ob, mc, 11, ins.b)
        a_str_off(ob, 9, 11, 8)
        ret
    end
    if op == O_MEMOP
        a_memop(ob, mc, i)
        ret
    end
    if op == O_OVF
        a_ovf(ob, mc, i)
        ret
    end
    if op == O_FBIN
        a_fbin(ob, mc, i)
        ret
    end
    if op == O_FCMP
        a_fcmp(ob, mc, i)
        ret
    end
    if op == O_FCVT
        a_fcvt(ob, mc, i)
        ret
    end
    if op == O_FRET
        -- A float result in d0 (AAPCS64).
        a_ld(ob, mc, 9, ins.a)
        a_fmov_dx(ob, 0, 9)
        ret
    end
    if op == O_FRES
        a_fmov_xd(ob, 9, 0)
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_VBIN
        a_vbin(ob, mc, i)
        ret
    end
    if op == O_VCMP
        a_vcmp(ob, mc, i)
        ret
    end
    if op == O_ATOMIC
        a_atomic(ob, mc, i)
        ret
    end
    if op == O_FENCE
        -- `cpu.fence`: relaxed is nothing, acquire `dmb ishld`, any other
        -- order `dmb ish`.
        if ins.val == 1
            aw(ob, 3573758399)
        elif ins.val > 1
            aw(ob, 3573758911)
        end
        ret
    end
    if op == O_CPU
        -- halt `wfi`, pause `yield`, interrupts off/on `msr daifset/daifclr, #2`
        if ins.val == 0
            aw(ob, 3573751935)
        elif ins.val == 1
            aw(ob, 3573751871)
        elif ins.val == 2
            aw(ob, 3573760735)
        else
            aw(ob, 3573760767)
        end
        ret
    end
    if op == O_HWWR
        a_ld(ob, mc, 9, ins.a)
        if ins.val == 3
            -- `cpu.stack <-`: mov sp, x9
            aw(ob, 2432696639)
        elif ins.val == 4
            -- `cpu.frame <-`: mov x29, x9
            a_mov(ob, 29, 9)
        elif ins.val == 9
            -- `cpu.jump(a)`: br x9
            aw(ob, 3592356128)
        elif ins.val == 10
            -- `arch.a64.vbar <-`: msr vbar_el1, x9; isb
            a_sys(ob, 0, a_sysenc(10), 9)
            aw(ob, 3573759967)
        elif ins.val == 11
            a_sys(ob, 0, a_sysenc(11), 9)
        elif ins.val == 12
            a_sys(ob, 0, a_sysenc(12), 9)
        elif ins.val == 18
            -- `arch.a64.cpacr <-`: msr cpacr_el1, x9; isb
            a_sys(ob, 0, a_sysenc(18), 9)
            aw(ob, 3573759967)
        else
            a_refuse(pg, ob, mc)
        end
        ret
    end
    if op == O_HWRD
        if ins.val == 3
            -- mov x9, sp
            aw(ob, 2432697321)
        elif ins.val == 4
            a_mov(ob, 9, 29)
        elif ins.val == 8
            -- `cpu.tsc()`: mrs x9, cntvct_el0
            aw(ob, 3577471049)
        elif ins.val == 17
            -- `arch.a64.vectors`: adr x9, the table (built after the code).
            if mc.objmode == 1
                a_refuse(pg, ob, mc)
                ret
            end
            mc.wantvec <- 1
            add_fix(mc, ob.ncode, AF_VEC, 0)
            aw(ob, 268435465)
        elif ins.val >= 10
            -- mrs x9, the system register
            a_sys(ob, 1, a_sysenc(ins.val), 9)
        else
            a_refuse(pg, ob, mc)
            ret
        end
        a_st(ob, mc, 9, i)
        ret
    end
    if op == O_HWCALL
        -- `cpu.call(p)`: bl
        add_fix(mc, ob.ncode, AF_CALL, ins.c)
        aw(ob, 2483027968)
        ret
    end
    if op == O_RLOAD
        -- A volatile (`mmio`) access is the same instruction: this back end
        -- keeps every access where the program wrote it and merges none.
        a_rload(ob, mc, i)
        ret
    end
    if op == O_RSTORE
        a_rstore(ob, mc, i)
        ret
    end
    if op == O_CHKB
        -- An index below the length, unsigned.
        a_ld(ob, mc, 9, ins.a)
        a_ld(ob, mc, 10, ins.b)
        a_cmp(ob, 9, 10)
        a_trap_unless(ob, mc, AC_LO, ins.site)
        ret
    end
    if op == O_CHKR
        -- `a <= b <= len`.
        a_ld(ob, mc, 9, ins.a)
        a_ld(ob, mc, 10, ins.b)
        a_cmp(ob, 9, 10)
        a_trap_unless(ob, mc, AC_LS, ins.site)
        a_ld(ob, mc, 9, ins.b)
        a_ld(ob, mc, 10, ins.val)
        a_cmp(ob, 9, 10)
        a_trap_unless(ob, mc, AC_LS, ins.site)
        ret
    end
    if op == O_CHKA
        -- The low bits of the address clear: `tst x9, x10`.
        a_ld(ob, mc, 9, ins.a)
        a_imm(ob, 10, ins.b - 1)
        aw(ob, 3925868575 | (10 << 16) | (9 << 5))
        a_trap_unless(ob, mc, AC_EQ, ins.site)
        ret
    end
    if op == O_TRAP
        a_trap_seq(ob, mc, ins.site)
        ret
    end
    -- Zones, floats, vectors, atomics, machine blocks and the hardware
    -- places of x86-64 are not lowered for AArch64 yet.
    a_refuse(pg, ob, mc)
end

proc a_znew(ob: rw ref Oir, mc: rw ref Mach, i: u64)
    -- mmap(0, size rounded up to a page, 3, 34, -1, 0) (222); a refusal
    -- (an answer of -4096 or above) is the zone that could not be had; then
    -- the triple (base, base, base + rounded size).
    ins := ins_at(ob, i)
    a_ld(ob, mc, 9, ins.b)
    a_add_imm(ob, 9, 9, 4095)
    aw(ob, 3545038121)
    aw(ob, 3547647273)
    a_movz(ob, 0, 0, 0)
    a_mov(ob, 1, 9)
    a_movz(ob, 2, 3, 0)
    a_movz(ob, 3, 34, 0)
    a_imm(ob, 4, 18446744073709551615)
    a_movz(ob, 5, 0, 0)
    a_movz(ob, 8, 222, 0)
    aw(ob, 3556769793)
    a_imm(ob, 10, 18446744073709547520)
    a_cmp(ob, 0, 10)
    a_trap_unless(ob, mc, AC_LO, ins.site)
    a_ld(ob, mc, 11, ins.a)
    a_str_off(ob, 0, 11, 0)
    a_str_off(ob, 0, 11, 8)
    a_rrr(ob, 2332033024, 12, 0, 9)
    a_str_off(ob, 12, 11, 16)
end

proc a_alloc_core(ob: rw ref Oir, mc: rw ref Mach, zv: u64, szv: u64, al: u64, site: u64)
    -- x9 the cursor rounded up to `al` (the answer), x12 past the bytes: a
    -- carry or a pass of the limit is `zone_exhausted`; the cursor moves.
    a_ld(ob, mc, 11, zv)
    a_ldr_off(ob, 9, 11, 8)
    a_imm(ob, 12, al - 1)
    a_rrr(ob, 2332033024, 9, 9, 12)
    a_imm(ob, 12, 18446744073709551615 - (al - 1))
    a_rrr(ob, 2315255808, 9, 9, 12)
    a_ld(ob, mc, 10, szv)
    a_rrr(ob, 2868903936, 12, 9, 10)
    a_trap_unless(ob, mc, AC_LO, site)
    a_ldr_off(ob, 10, 11, 16)
    a_cmp(ob, 12, 10)
    a_trap_unless(ob, mc, AC_LS, site)
    a_str_off(ob, 12, 11, 8)
end

proc a_memop(ob: rw ref Oir, mc: ref Mach, i: u64)
    -- Byte loops: `mem.copy` forwards when the destination is not above the
    -- source and backwards from the end otherwise, so an overlap copies
    -- right; `mem.set`/`zero`/`secure_zero` a store per byte. x0 the
    -- destination, x1 the source, x2 the count, w3 the byte.
    ins := ins_at(ob, i)
    a_ld(ob, mc, 0, ins.a)
    a_ld(ob, mc, 2, ins.val)
    if ins.bop == 0
        a_ld(ob, mc, 1, ins.b)
        -- cmp x0, x1; b.hi backward
        a_cmp(ob, 0, 1)
        aw(ob, 1409286144 | (6 << 5) | AC_HI)
        -- forward: cbz x2, done; ldrb w3, [x1], #1; strb w3, [x0], #1;
        -- sub x2, x2, #1; b forward
        aw(ob, 3019898882 | (12 << 5))
        aw(ob, 943723555)
        aw(ob, 939529219)
        a_sub_imm(ob, 2, 2, 1)
        aw(ob, 335544320 | 67108860)
        -- backward: add x1, x1, x2; add x0, x0, x2; then the loop down.
        a_rrr(ob, 2332033024, 1, 1, 2)
        a_rrr(ob, 2332033024, 0, 0, 2)
        aw(ob, 3019898882 | (5 << 5))
        aw(ob, 945814563)
        aw(ob, 941620227)
        a_sub_imm(ob, 2, 2, 1)
        aw(ob, 335544320 | 67108860)
        ret
    end
    if ins.bop == 1
        a_ld(ob, mc, 3, ins.b)
    else
        a_movz(ob, 3, 0, 0)
    end
    -- cbz x2, done; strb w3, [x0], #1; sub x2, x2, #1; b loop
    aw(ob, 3019898882 | (4 << 5))
    aw(ob, 939529219)
    a_sub_imm(ob, 2, 2, 1)
    aw(ob, 335544320 | 67108861)
end

proc a_ovf(ob: rw ref Oir, mc: ref Mach, i: u64)
    -- `ovf.of %v`: 1 when the 64-bit operation `v` overflowed, computed
    -- again from its operands (AArch64 reads no flag across the store):
    -- adds/subs and V or C, the high half of the product, a negation.
    ins := ins_at(ob, i)
    v := ins_at(ob, ins.a)
    sg := ins.c
    a_ld(ob, mc, 9, v.a)
    if v.op == O_UN
        if sg == 1
            aw(ob, 3943236585)
            a_cset(ob, 9, 6)
        else
            a_cmp(ob, 9, 31)
            a_cset(ob, 9, AC_NE)
        end
        a_st(ob, mc, 9, i)
        ret
    end
    a_ld(ob, mc, 10, v.b)
    if v.bop == B_ADD
        a_rrr(ob, 2868903936, 11, 9, 10)
        if sg == 1
            a_cset(ob, 9, 6)
        else
            a_cset(ob, 9, AC_HS)
        end
    elif v.bop == B_SUB
        a_rrr(ob, 3942645760, 11, 9, 10)
        if sg == 1
            a_cset(ob, 9, 6)
        else
            a_cset(ob, 9, AC_LO)
        end
    else
        a_rrr(ob, 2600500224, 11, 9, 10)
        if sg == 1
            a_rrr(ob, 2604694528, 12, 9, 10)
            aw(ob, 3951098911 | (11 << 16) | (12 << 5))
        else
            a_rrr(ob, 2613083136, 12, 9, 10)
            a_cmp(ob, 12, 31)
        end
        a_cset(ob, 9, AC_NE)
    end
    a_st(ob, mc, 9, i)
end

-- Floats, vectors, atomics --------------------------------------------------

proc a_fmov_dx(ob: rw ref Oir, d: u64, n: u64)
    -- `fmov dd, xn`: the word's bits into an FP register.
    aw(ob, 2657550336 | (n << 5) | d)
end

proc a_fmov_xd(ob: rw ref Oir, d: u64, n: u64)
    -- `fmov xd, dn`
    aw(ob, 2657484800 | (n << 5) | d)
end

proc a_fres32(ob: rw ref Oir, w: u64)
    -- The result from d0/s0 into x9: all eight bytes of an f64, `fmov w9,
    -- s0` (upper half zero) for an f32.
    if w == 64
        a_fmov_xd(ob, 9, 0)
    else
        aw(ob, 505806857)
    end
end

proc a_fbin(ob: rw ref Oir, mc: ref Mach, i: u64)
    -- fadd/fsub/fmul/fdiv d0, d0, d1 (s for f32).
    ins := ins_at(ob, i)
    a_ld(ob, mc, 9, ins.a)
    a_ld(ob, mc, 10, ins.b)
    a_fmov_dx(ob, 0, 9)
    a_fmov_dx(ob, 1, 10)
    base : u64 <- 509618176
    if ins.c == B_SUB
        base <- 509622272
    elif ins.c == B_MUL
        base <- 509609984
    elif ins.c == B_DIV
        base <- 509614080
    end
    if ins.val == 32
        base <- base - 4194304
    end
    aw(ob, base | (1 << 16))
    a_fres32(ob, ins.val)
    a_st(ob, mc, 9, i)
end

proc a_fcmp(ob: rw ref Oir, mc: ref Mach, i: u64)
    -- `fcmp d0, d1` and the flags into a bool. An unordered pair sets C and
    -- V: eq, mi, ls, gt and ge are all false on it, ne true.
    ins := ins_at(ob, i)
    a_ld(ob, mc, 9, ins.a)
    a_ld(ob, mc, 10, ins.b)
    a_fmov_dx(ob, 0, 9)
    a_fmov_dx(ob, 1, 10)
    if ins.val == 32
        aw(ob, 505421824 | (1 << 16))
    else
        aw(ob, 509616128 | (1 << 16))
    end
    c := ins.c
    cond : u64 <- AC_GE
    if c == B_EQ
        cond <- AC_EQ
    elif c == B_NE
        cond <- AC_NE
    elif c == B_LT
        cond <- 4
    elif c == B_LE
        cond <- AC_LS
    elif c == B_GT
        cond <- AC_GT
    end
    a_cset(ob, 9, cond)
    a_st(ob, mc, 9, i)
end

proc a_fcvt(ob: rw ref Oir, mc: ref Mach, i: u64)
    -- scvtf/ucvtf, fcvtzs/fcvtzu (toward zero; AArch64 saturates an
    -- out-of-range value and gives 0 for a NaN), fcvt between the formats.
    ins := ins_at(ob, i)
    a_ld(ob, mc, 9, ins.a)
    k := ins.c
    w := ins.val
    sgl : u64 <- 0
    if w == 32
        sgl <- 4194304
    end
    if k == 0
        aw(ob, (2657222656 - sgl) | (9 << 5))
        a_fres32(ob, w)
    elif k == 1
        aw(ob, (2657288192 - sgl) | (9 << 5))
        a_fres32(ob, w)
    elif k == 2
        a_fmov_dx(ob, 0, 9)
        aw(ob, (2658664448 - sgl) | 9)
    elif k == 5
        a_fmov_dx(ob, 0, 9)
        aw(ob, (2658729984 - sgl) | 9)
    elif k == 3
        a_fmov_dx(ob, 0, 9)
        aw(ob, 505593856)
        a_fmov_xd(ob, 9, 0)
    else
        a_fmov_dx(ob, 0, 9)
        aw(ob, 509755392)
        a_fres32(ob, 32)
    end
    a_st(ob, mc, 9, i)
end

proc a_vop(c: u64, lane: u64) -> u64
    -- The NEON instruction for B_* `c` on lane code `lane` (design 0024),
    -- with v0 = v0 op v1.
    if lane <= 1
        dbl : u64 <- 0
        if lane == 1
            dbl <- 4194304
        end
        if c == B_ADD
            ret 1310774272 | dbl
        end
        if c == B_SUB
            ret 1319162880 | dbl
        end
        if c == B_MUL
            ret 1847647232 | dbl
        end
        if c == B_DIV
            ret 1847655424 | dbl
        end
    end
    sz : u64 <- 0
    if lane == 3
        sz <- 1
    elif lane == 4
        sz <- 2
    elif lane == 5
        sz <- 3
    end
    if c == B_ADD
        ret 1310753792 | (sz << 22)
    end
    if c == B_SUB
        ret 1847624704 | (sz << 22)
    end
    if c == B_MUL
        ret 1310759936 | (sz << 22)
    end
    if c == B_AND
        ret 1310727168
    end
    if c == B_OR
        ret 1319115776
    end
    ret 1847598080
end

proc a_vload2(ob: rw ref Oir, mc: ref Mach, i: u64)
    -- `ldr q0, [x9]`, `ldr q1, [x10]`
    ins := ins_at(ob, i)
    a_ld(ob, mc, 9, ins.a)
    a_ld(ob, mc, 10, ins.b)
    aw(ob, 1035993088 | (9 << 5))
    aw(ob, 1035993088 | (10 << 5) | 1)
end

proc a_vbin(ob: rw ref Oir, mc: ref Mach, i: u64)
    ins := ins_at(ob, i)
    a_vload2(ob, mc, i)
    aw(ob, a_vop(ins.c, ins.val) | (1 << 16))
    a_lea_slot(ob, 9, ins.w)
    aw(ob, 1031798784 | (9 << 5))
    a_st(ob, mc, 9, i)
end

proc a_vcmp(ob: rw ref Oir, mc: ref Mach, i: u64)
    -- cmeq/fcmeq into lane masks, `uminv b0` (all ones only when every lane
    -- was equal; a NaN lane is not), `umov w9, v0.b[0]` against 255.
    ins := ins_at(ob, i)
    a_vload2(ob, mc, i)
    lane := ins.val
    if lane == 0
        aw(ob, 1310778368 | (1 << 16))
    elif lane == 1
        aw(ob, 1314972672 | (1 << 16))
    else
        sz : u64 <- 0
        if lane == 3
            sz <- 1
        elif lane == 4
            sz <- 2
        elif lane == 5
            sz <- 3
        end
        aw(ob, 1847626752 | (sz << 22) | (1 << 16))
    end
    aw(ob, 1848748032)
    aw(ob, 234961929)
    a_imm(ob, 10, 255)
    a_cmp(ob, 9, 10)
    if ins.c == B_EQ
        a_cset(ob, 9, AC_EQ)
    else
        a_cset(ob, 9, AC_NE)
    end
    a_st(ob, mc, 9, i)
end

proc a_atomic(ob: rw ref Oir, mc: ref Mach, i: u64)
    -- ldar/stlr for a load and a store; every read-modify-write an
    -- exclusive pair `ldaxr`/`stlxr` retried until it holds (the strongest
    -- order, which every weaker one may take); `cas` compares at the type's
    -- own extension and answers whether it swapped.
    ins := ins_at(ob, i)
    kind := ins.bop
    sz := ins.c % 16
    sg := ins.c / 16
    size : u64 <- 3
    if sz == 1
        size <- 0
    elif sz == 2
        size <- 1
    elif sz == 4
        size <- 2
    end
    a_ld(ob, mc, 9, ins.a)
    if kind == 0
        aw(ob, 148896768 | (size << 30) | (9 << 5) | 12)
        a_extend(ob, 12, 12, sz * 8, sg)
        a_st(ob, mc, 12, i)
        ret
    end
    a_ld(ob, mc, 10, ins.b)
    if kind == 1
        aw(ob, 144702464 | (size << 30) | (9 << 5) | 10)
        ret
    end
    if kind == 8
        a_ld(ob, mc, 11, ins.val)
        -- loop: ldaxr x12; extend; cmp; b.ne fail; stlxr w14, x11; cbnz
        -- w14, loop; x9 = 1; b done; fail: clrex; x9 = 0; done:
        top := ob.ncode
        aw(ob, 140508160 | (size << 30) | (9 << 5) | 12)
        a_extend(ob, 12, 12, sz * 8, sg)
        a_cmp(ob, 12, 10)
        aw(ob, 1409286144 | (5 << 5) | AC_NE)
        aw(ob, 134282240 | (size << 30) | (14 << 16) | (9 << 5) | 11)
        back := (ob.ncode - top) / 4
        aw(ob, 889192448 | ((524288 - back) << 5) | 14)
        a_movz(ob, 9, 1, 0)
        aw(ob, 335544320 | 3)
        aw(ob, 3573755999)
        a_movz(ob, 9, 0, 0)
        a_st(ob, mc, 9, i)
        ret
    end
    -- loop: ldaxr x12; x13 = x12 op x10; stlxr w14, x13; cbnz w14, loop
    aw(ob, 140508160 | (size << 30) | (9 << 5) | 12)
    if kind == 2
        a_rrr(ob, 2332033024, 13, 12, 10)
    elif kind == 3
        a_rrr(ob, 3405774848, 13, 12, 10)
    elif kind == 4
        a_rrr(ob, 2315255808, 13, 12, 10)
    elif kind == 5
        a_rrr(ob, 2852126720, 13, 12, 10)
    elif kind == 6
        a_rrr(ob, 3388997632, 13, 12, 10)
    else
        a_mov(ob, 13, 10)
    end
    aw(ob, 134282240 | (size << 30) | (14 << 16) | (9 << 5) | 13)
    aw(ob, 889192448 | ((524288 - 3) << 5) | 14)
    a_extend(ob, 12, 12, sz * 8, sg)
    a_st(ob, mc, 12, i)
end

-- Blocks, procedures, the program ------------------------------------------

proc a_jump(ob: rw ref Oir, mc: rw ref Mach, s: u64)
    add_fix(mc, ob.ncode, AF_JUMP, s)
    aw(ob, 335544320)
end

proc a_edge_copies(ob: rw ref Oir, mc: ref Mach, b: u64, s: u64)
    -- The parallel copies of the phis of `s` on the edge from `b`, through
    -- the scratch words, exactly as compiler/x64.oli `edge_copies`.
    if nphi_of(ob, s) == 0
        ret
    end
    sb := blk_at(ob, s)
    j := pred_index(ob, s, b)
    last := sb.first + sb.n
    k : u64 <- 0
    i : u64 <- sb.first
    while i < last
        ins := ins_at(ob, i)
        if ins.op == O_DEAD
            i <- i + 1
            continue
        end
        if ins.op != O_PHI
            i <- last
        else
            pa := phiarg_at(ob, ins.a + j)
            a_ld(ob, mc, 9, pa.val)
            a_str_slot(ob, 9, scratch_slot(mc, k))
            k <- k + 1
            i <- i + 1
        end
    end
    k <- 0
    i <- sb.first
    while i < last
        ins2 := ins_at(ob, i)
        if ins2.op == O_DEAD
            i <- i + 1
            continue
        end
        if ins2.op != O_PHI
            i <- last
        else
            a_ldr_slot(ob, 9, scratch_slot(mc, k))
            a_st(ob, mc, 9, i)
            k <- k + 1
            i <- i + 1
        end
    end
end

proc a_ret(ob: rw ref Oir, mc: rw ref Mach, b: u64)
    bk := blk_at(ob, b)
    if mc.curnone == 1
        -- The end of a `calls none` or `never` body is unreachable: `udf`.
        aw(ob, 0)
        ret
    end
    if mc.curnever == 1
        aw(ob, 0)
        ret
    end
    if mc.curentry == 1
        -- The entry's result is the exit status: exit_group(x0).
        if bk.tc > 0
            a_ld(ob, mc, 0, bk.ta)
        else
            a_movz(ob, 0, 0, 0)
        end
        a_movz(ob, 8, 94, 0)
        aw(ob, 3556769793)
        ret
    end
    if bk.tc > 0
        a_ld(ob, mc, 0, bk.ta)
    else
        a_movz(ob, 0, 0, 0)
    end
    if bk.tc == 2
        a_ld(ob, mc, 1, bk.tb)
    end
    a_save_regs(ob, mc, 1)
    -- mov sp, x29; ldp x29, x30, [sp], #16; ret
    aw(ob, 2432697279)
    aw(ob, 2831252477)
    aw(ob, 3596551104)
end

proc a_term(ob: rw ref Oir, mc: rw ref Mach, b: u64)
    permit os.syscall
    bk := blk_at(ob, b)
    if bk.top == O_RET
        a_ret(ob, mc, b)
        ret
    end
    if bk.top == O_JMP
        a_edge_copies(ob, mc, b, bk.ta)
        if bk.ta != next_live(ob, mc, b)
            a_jump(ob, mc, bk.ta)
        end
        ret
    end
    -- A branch: `cbz` to the false edge (through a pad when it carries
    -- copies), the true edge's copies, and its jump.
    a_ld(ob, mc, 9, bk.ta)
    pad : u64 <- 0
    if nphi_of(ob, bk.tc) > 0
        pad <- BLK_MAX + mc.npad
        if pad >= LBL_MAX
            put(2, "olic: label table exhausted\n")
            os.syscall(60, 4)
        end
        mc.npad <- mc.npad + 1
        add_fix(mc, ob.ncode, AF_COND, pad)
    else
        add_fix(mc, ob.ncode, AF_COND, bk.tc)
    end
    aw(ob, 3019898889)
    a_edge_copies(ob, mc, b, bk.tb)
    if pad > 0
        a_jump(ob, mc, bk.tb)
        l := lbl_at(mc, pad)
        l.pos <- ob.ncode
        a_edge_copies(ob, mc, b, bk.tc)
        a_jump(ob, mc, bk.tc)
        ret
    end
    if bk.tb != next_live(ob, mc, b)
        a_jump(ob, mc, bk.tb)
    end
end

proc a_blk(pg: rw ref Prog, ob: rw ref Oir, mc: rw ref Mach, b: u64)
    bk := blk_at(ob, b)
    l := lbl_at(mc, b)
    l.pos <- ob.ncode
    i : u64 <- bk.first
    last := bk.first + bk.n
    while i < last
        ins := ins_at(ob, i)
        if ins.op != O_PHI
            if ins.op != O_DEAD
                note_line(pg, ob, mc, i)
                a_ins(pg, ob, mc, i)
            end
        end
        i <- i + 1
    end
    a_term(ob, mc, b)
end

proc a_none_regs(ob: rw ref Oir, op: ref OProc) -> word
    -- Registers x19-x28 for the values of a frameless procedure, in order;
    -- 0 when there are more values than registers, or a phi.
    mc0 : u64 <- 0
    k : u64 <- 0
    i : u64 <- op.first
    last := op.first + op.n
    while i < last
        ins := ins_at(ob, i)
        if ins.op == O_PHI
            ret 0
        end
        if ins.op != O_DEAD
            if defines_value(ins.op) == 1
                if k >= 10
                    ret 0
                end
                mc0 <- mc0 + 1
                k <- k + 1
            end
        end
        i <- i + 1
    end
    ret 1
end

proc a_none_assign(ob: rw ref Oir, mc: rw ref Mach, op: ref OProc)
    -- The assignment a_none_regs checked is possible: value k gets x(19+k).
    k : u64 <- 0
    i : u64 <- op.first
    last := op.first + op.n
    while i < last
        ins := ins_at(ob, i)
        cell_set(mc.loc, i, 0)
        if ins.op != O_DEAD
            if defines_value(ins.op) == 1
                cell_set(mc.loc, i, 101 + 19 + k)
                k <- k + 1
            end
        end
        i <- i + 1
    end
end

proc a_proc(pg: rw ref Prog, ob: rw ref Oir, mc: rw ref Mach, q: u64)
    op := oproc_at(ob, q)
    mc.curloc <- op.nwords
    mc.curtmp <- op.ntmp
    mc.curnval <- op.n
    mc.curfirst <- op.first
    mc.curentry <- op.isentry
    mc.curlast <- op.bfirst + op.nblk
    mc.curnphi <- op.nphi
    mc.curend <- op.first + op.n
    mc.curq <- q
    mc.curnone <- op.nocalls
    mc.curnever <- op.isnever
    mc.curint <- op.isint
    mc.lastline <- 0
    op.codepos <- ob.ncode
    note_proc_line(pg, ob, mc, op)
    if op.isentry == 1
        mc.entrypos <- ob.ncode
    end
    if op.nocalls == 1
        -- `calls none` (a freestanding entry): no prologue, no frame; each
        -- value in one of x19-x28, which a frame would never need here.
        if a_none_regs(ob, op) == 0
            a_refuse(pg, ob, mc)
            ret
        end
        a_none_assign(ob, mc, op)
        bn : u64 <- op.bfirst
        while bn < mc.curlast
            if live_blk(ob, bn) == 1
                a_blk(pg, ob, mc, bn)
            end
            bn <- bn + 1
        end
        ret
    end
    if op.isint == 1
        -- An exception handler is an ordinary procedure: its slot of the
        -- vector table saves what it may clobber and returns with `eret`.
        -- An object file has no place for the table.
        mc.wantvec <- 1
        if mc.objmode == 1
            a_refuse(pg, ob, mc)
            ret
        end
    end
    -- The linear scan of compiler/x64.oli over the callee-saved registers
    -- (OIR_SPEC §7); a value it leaves out lives in its frame word.
    alloc_proc(ob, mc, op)
    -- stp x29, x30, [sp, #-16]!; mov x29, sp; sub sp, sp, frame (16-aligned)
    aw(ob, 2847898621)
    aw(ob, 2432697341)
    w : u64 <- mc.curloc + op.ntmp + op.n + op.nphi + op.nsave
    if w % 2 == 1
        w <- w + 1
    end
    a_imm(ob, 16, w * 8)
    aw(ob, 3408946175)
    if op.isentry == 0
        a_save_regs(ob, mc, 0)
    end
    b : u64 <- op.bfirst
    while b < mc.curlast
        if live_blk(ob, b) == 1
            a_blk(pg, ob, mc, b)
        end
        b <- b + 1
    end
end

proc a_or32(ob: rw ref Oir, pos: u64, v: u64)
    -- Fold `v` into the instruction word at `pos`.
    c := ob.code
    w : u64 <- u64(c[pos]) | (u64(c[pos + 1]) << 8) | (u64(c[pos + 2]) << 16) | (u64(c[pos + 3]) << 24)
    patch32(ob, pos, w | v)
end

proc a_rel(target: u64, here: u64, nb: u64) -> u64
    -- (target - here) / 4 as an `nb`-bit two's complement field.
    one : u64 <- 1
    mask := (one << nb) - 1
    if target >= here
        ret ((target - here) >> 2) & mask
    end
    ret ((one << nb) - ((here - target) >> 2)) & mask
end

proc a_apply_fixes(ob: rw ref Oir, mc: ref Mach, database: u64)
    codebase := database + ob.ndata
    i : u64 <- 0
    while i < mc.nfix
        f := fix_at(mc, i)
        here := codebase + f.pos
        k : u64 <- f.kind
        skip : u64 <- 0
        if mc.objmode == 1
            -- An object file: what lies in another section, or outside the
            -- file, is the linker's (compiler/elf.oli a64_build_rela).
            if k == AF_ADR
                skip <- 1
            elif k == AF_ADRP
                skip <- 1
            elif k == AF_CALL
                opx := oproc_at(ob, f.target)
                if opx.isextern == 1
                    skip <- 1
                end
            end
        end
        if skip == 1
            k <- 0
        end
        if k == AF_CALL
            opc := oproc_at(ob, f.target)
            a_or32(ob, f.pos, a_rel(codebase + opc.codepos, here, 26))
        elif k == AF_JUMP
            l := lbl_at(mc, f.target)
            a_or32(ob, f.pos, a_rel(codebase + l.pos, here, 26))
        elif k == AF_COND
            l2 := lbl_at(mc, f.target)
            a_or32(ob, f.pos, a_rel(codebase + l2.pos, here, 19) << 5)
        elif k == AF_TRAP
            a_or32(ob, f.pos, a_rel(codebase + mc.trappos, here, 26))
        elif k == AF_VEC
            -- adr: the vector table, a code offset.
            tv := codebase + mc.vecpos
            onev : u64 <- 1
            offv : u64 <- 0
            if tv >= here
                offv <- tv - here
            else
                offv <- (onev << 21) - (here - tv)
            end
            offv <- offv & ((onev << 21) - 1)
            a_or32(ob, f.pos, ((offv & 3) << 29) | ((offv >> 2) << 5))
        elif k == AF_ADR
            -- adr: a byte offset, immlo in bits 29-30, immhi in 5-23.
            t := database + f.target
            one : u64 <- 1
            off : u64 <- 0
            if t >= here
                off <- t - here
            else
                off <- (one << 21) - (here - t)
            end
            off <- off & ((one << 21) - 1)
            a_or32(ob, f.pos, ((off & 3) << 29) | ((off >> 2) << 5))
        elif k == AF_ADRP
            -- adrp: the page difference; the `add` after it the low twelve bits.
            t2 := mc.dbase + f.target
            one2 : u64 <- 1
            pg1 := t2 >> 12
            pg0 := here >> 12
            po : u64 <- 0
            if pg1 >= pg0
                po <- pg1 - pg0
            else
                po <- (one2 << 21) - (pg0 - pg1)
            end
            po <- po & ((one2 << 21) - 1)
            a_or32(ob, f.pos, ((po & 3) << 29) | ((po >> 2) << 5))
            a_or32(ob, f.pos + 4, (t2 & 4095) << 10)
        end
        i <- i + 1
    end
end

-- Exception vectors (design 0025) ---------------------------------------------

proc a_sysenc(r: u64) -> u64
    -- op1, CRn, CRm and op2 of a system register, in place in `mrs`/`msr`:
    -- 10 VBAR_EL1, 11 CNTV_CTL_EL0, 12 CNTV_TVAL_EL0, 13 CNTFRQ_EL0,
    -- 14 ESR_EL1, 15 ELR_EL1, 16 FAR_EL1, 18 CPACR_EL1, 19 SPSR_EL1.
    if r == 10
        ret 49152
    end
    if r == 11
        ret 254752
    end
    if r == 12
        ret 254720
    end
    if r == 13
        ret 253952
    end
    if r == 14
        ret 20992
    end
    if r == 15
        ret 16416
    end
    if r == 16
        ret 24576
    end
    if r == 18
        ret 4160
    end
    ret 16384
end

proc a_sys(ob: rw ref Oir, rd: u64, enc: u64, rt: u64)
    -- `mrs xt, reg` (rd 1) or `msr reg, xt` (rd 0); op0 is 3 for all.
    aw(ob, 3575119872 | (rd << 21) | enc | rt)
end

proc a_pair(ob: rw ref Oir, base: u64, r1: u64, r2: u64, off: u64)
    -- stp/ldp (base 0xA9000000/0xA9400000 for x, 0xAD000000/0xAD400000
    -- for q) with sp: `off` already scaled to the register size.
    aw(ob, base | (off << 15) | (r2 << 10) | (31 << 5) | r1)
end

proc a_vec_slot(pg: ref Prog, pi: u64) -> u64
    -- The slot of a handler: N of its `section ".vector.N"`, 0 to 15; 16
    -- when it names none.
    s := proc_sect(pg, pi)
    if starts_with(s, ".vector.") == 0
        ret 16
    end
    if s.len < 9
        ret 16
    end
    if s.len > 10
        ret 16
    end
    v : u64 <- 0
    i : u64 <- 8
    while i < s.len
        c := u64(s[i])
        if c < 48
            ret 16
        end
        if c > 57
            ret 16
        end
        v <- v * 10 + (c - 48)
        i <- i + 1
    end
    if v > 15
        ret 16
    end
    ret v
end

proc a_vec_handler(pg: ref Prog, ob: ref Oir, slot: u64) -> u64
    -- The procedure (plus one) whose handler fills `slot`, or 0.
    q : u64 <- 0
    while q < ob.nproc
        op := oproc_at(ob, q)
        if op.isint == 1
            if a_vec_slot(pg, op.pi) == slot
                ret q + 1
            end
        end
        q <- q + 1
    end
    ret 0
end

proc a_fp_skip(ob: rw ref Oir)
    -- `mrs x9, cpacr_el1; tbz x9, #20, +20`: past the four `stp`/`ldp` of
    -- v0-v7 when EL1 may not touch the FP registers (CPACR_EL1.FPEN, off
    -- after reset): the interrupted code cannot have used them, and the
    -- access would trap.
    a_sys(ob, 1, a_sysenc(18), 9)
    aw(ob, 916455593)
end

proc a_vec_stub(ob: rw ref Oir, mc: rw ref Mach, q: u64)
    -- Save x0-x18, x30, ELR_EL1, SPSR_EL1 and, when the FP unit is on,
    -- v0-v7 (what the handler may clobber: the back end keeps floats in
    -- v0-v7) in 304 bytes of the
    -- stack, x0 their address, `bl` the handler, restore, `eret`.
    aw(ob, 3506750463)
    k : u64 <- 0
    while k < 9
        a_pair(ob, 2835349504, 2 * k, 2 * k + 1, 2 * k)
        k <- k + 1
    end
    a_pair(ob, 2835349504, 18, 30, 18)
    a_sys(ob, 1, a_sysenc(15), 9)
    a_sys(ob, 1, a_sysenc(19), 10)
    a_pair(ob, 2835349504, 9, 10, 20)
    a_fp_skip(ob)
    k <- 0
    while k < 4
        a_pair(ob, 2902458368, 2 * k, 2 * k + 1, 11 + 2 * k)
        k <- k + 1
    end
    -- mov x0, sp; bl handler
    aw(ob, 2432697312)
    add_fix(mc, ob.ncode, AF_CALL, q)
    aw(ob, 2483027968)
    a_fp_skip(ob)
    k <- 0
    while k < 4
        a_pair(ob, 2906652672, 2 * k, 2 * k + 1, 11 + 2 * k)
        k <- k + 1
    end
    a_pair(ob, 2839543808, 9, 10, 20)
    a_sys(ob, 0, a_sysenc(15), 9)
    a_sys(ob, 0, a_sysenc(19), 10)
    k <- 0
    while k < 9
        a_pair(ob, 2839543808, 2 * k, 2 * k + 1, 2 * k)
        k <- k + 1
    end
    a_pair(ob, 2839543808, 18, 30, 18)
    -- add sp, sp, #304; eret
    aw(ob, 2433008639)
    aw(ob, 3600745440)
end

proc a_vectors(pg: rw ref Prog, ob: rw ref Oir, mc: rw ref Mach, database: u64)
    -- The table VBAR_EL1 names: 2 KiB aligned, sixteen slots of 128 bytes
    -- in the architecture's order. A slot with a handler branches to its
    -- stub after the table; one without stops the CPU in `wfi`.
    q : u64 <- 0
    while q < ob.nproc
        op := oproc_at(ob, q)
        if op.isint == 1
            s := a_vec_slot(pg, op.pi)
            bad : u64 <- 0
            if s == 16
                bad <- 1
            elif a_vec_handler(pg, ob, s) != q + 1
                bad <- 1
            end
            if bad == 1
                -- No slot, or a slot another handler already has.
                mc.curq <- q
                a_refuse(pg, ob, mc)
            end
        end
        q <- q + 1
    end
    while (database + ob.ndata + ob.ncode) % 2048 != 0
        aw(ob, 0)
    end
    gv := sect_add(ob, ".text.vectors", 0)
    sv := sect_at(ob, gv)
    sv.start <- ob.ncode
    mc.vecpos <- ob.ncode
    slot : u64 <- 0
    while slot < 16
        h := a_vec_handler(pg, ob, slot)
        if h > 0
            -- b stub, patched below
            aw(ob, 335544320)
        else
            -- wfi; b .-4
            aw(ob, 3573751935)
            aw(ob, 402653183)
        end
        while ob.ncode < mc.vecpos + (slot + 1) * 128
            aw(ob, 0)
        end
        slot <- slot + 1
    end
    slot <- 0
    while slot < 16
        h2 := a_vec_handler(pg, ob, slot)
        if h2 > 0
            sp := mc.vecpos + slot * 128
            a_or32(ob, sp, a_rel(ob.ncode, sp, 26))
            a_vec_stub(ob, mc, h2 - 1)
        end
        slot <- slot + 1
    end
    sv.size <- ob.ncode - sv.start
end

proc a64_lower_all(pg: rw ref Prog, ob: rw ref Oir, mc: rw ref Mach, database: u64)
    -- The code starts on an instruction boundary: the read-only data before
    -- it is padded to sixteen bytes — in the image, or in an object file,
    -- where it follows the 64-byte header.
    mc.a64 <- 1
    mc.objmode <- pg.objmode
    if pg.objmode == 1
        while ob.ndata % 16 != 0
            data_byte(ob, 0)
        end
    else
        while (database + ob.ndata) % 16 != 0
            data_byte(ob, 0)
        end
    end
    i : u64 <- 0
    while i < LBL_MAX
        l := lbl_at(mc, i)
        l.pos <- 0
        i <- i + 1
    end
    mc.fstand <- pg.fstanding
    mc.trapproc <- 0
    tp := proc_traps(pg)
    if tp >= 0
        mc.trapproc <- u64.bits(tp) + 1
    end
    g : u64 <- 0
    while g < ob.nsect
        sg := sect_at(ob, g)
        if sg.kind == 0
            sg.start <- ob.ncode
            q : u64 <- 0
            while q < ob.nproc
                opq := oproc_at(ob, q)
                if opq.isextern == 0
                    if view_eq(proc_sect(pg, opq.pi), sect_name(ob, g))
                        opq.sect <- g
                        a_proc(pg, ob, mc, q)
                        opq.codeend <- ob.ncode
                    end
                end
                q <- q + 1
            end
            sg.size <- ob.ncode - sg.start
        end
        g <- g + 1
    end
    if mc.ntrap > 0
        gt := sect_add(ob, ".text.trap", 0)
        st := sect_at(ob, gt)
        st.start <- ob.ncode
        a_trap_routine(ob, mc)
        st.size <- ob.ncode - st.start
    end
    if mc.wantvec == 1
        if mc.objmode == 0
            a_vectors(pg, ob, mc, database)
        end
    end
    mc.dbase <- ob.base + page_up(database - ob.base + ob.ndata + ob.ncode)
    a_apply_fixes(ob, mc, database)
end
