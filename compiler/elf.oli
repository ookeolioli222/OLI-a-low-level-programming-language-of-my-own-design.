module olic.elf
-- The ELF64 writer (docs/ABI.md §4): a static, non-PIE executable with one
-- loadable segment holding the whole image.
--
-- Image: header (64) | program headers (56 each) | statics | code, and, when
-- the program has static places, a second segment on the next page: their
-- initialised bytes in the file (`.data`) and the zero ones as memory past
-- the file (`.bss`). The first segment is mapped read+execute at the load
-- address (`ob.base`: 0x400000, or what a `-- load:` line says) with
-- `p_offset = 0`, so a file offset and a virtual address differ by exactly
-- that; the second is mapped read+write at the same distance.
-- After the image come the tables that are not loaded: `.symtab` (ABI.md
-- §4: every procedure as `module.name`, `STB_LOCAL` unless `pub`, an
-- `export` clause as a second, global name; every static as `module.name`
-- in `.data`, `.bss` or `.rodata`; the trap routine as `olic.trap`), its
-- `.strtab`, `.shstrtab`, and the section headers — null, `.rodata`, one
-- per code section group in the image's order (`.text.boot`, `.text`, the
-- named ones, `.text.trap`), `.data`, one per zero-static group (`.bss`,
-- `.bss.boot`, …), `.symtab`, `.strtab`, `.shstrtab` — so that `nm`,
-- `readelf -S` and `objdump -d` read the image as it is (stage 28: the
-- groups and their order come from the target profile).

EHDR_SIZE := 64
PHDR_SIZE := 56
HDR_SIZE := 120

proc hdr_size(ob: ref Oir) -> u64
    -- One program header, or two when there is a writable segment.
    if ob.dsize + ob.bsize > 0
        ret EHDR_SIZE + PHDR_SIZE * 2
    end
    ret HDR_SIZE
end

proc put_u8(b: rw view u8, off: u64, v: u64)
    b[off] <- u8.wrap(v)
end

proc put_u16(b: rw view u8, off: u64, v: u64)
    b[off] <- u8.wrap(v)
    b[off + 1] <- u8.wrap(v >> 8)
end

proc put_u32(b: rw view u8, off: u64, v: u64)
    put_u16(b, off, v)
    put_u16(b, off + 2, v >> 16)
end

proc put_u64v(b: rw view u8, off: u64, v: u64)
    put_u32(b, off, v)
    put_u32(b, off + 4, v >> 32)
end

proc elf_header(b: rw view u8, epoint: u64, total: u64, base: u64)
    i : u64 <- 0
    while i < b.len
        b[i] <- 0
        i <- i + 1
    end
    put_u8(b, 0, 127)
    put_u8(b, 1, 69)
    put_u8(b, 2, 76)
    put_u8(b, 3, 70)
    put_u8(b, 4, 2)
    put_u8(b, 5, 1)
    put_u8(b, 6, 1)
    put_u16(b, 16, 2)
    put_u16(b, 18, 62)
    put_u32(b, 20, 1)
    put_u64v(b, 24, epoint)
    put_u64v(b, 32, EHDR_SIZE)
    put_u16(b, 52, EHDR_SIZE)
    put_u16(b, 54, PHDR_SIZE)
    put_u16(b, 56, 1)
    put_u32(b, 64, 1)
    put_u32(b, 68, 5)
    put_u64v(b, 72, 0)
    put_u64v(b, 80, base)
    put_u64v(b, 88, base)
    put_u64v(b, 96, total)
    put_u64v(b, 104, total)
    put_u64v(b, 112, 4096)
end

proc data_phdr(b: rw view u8, dofs: u64, filesz: u64, memsz: u64, base: u64)
    -- The second program header: PT_LOAD, read+write, at the page after the
    -- first segment in both the file and memory.
    o : u64 <- EHDR_SIZE + PHDR_SIZE
    put_u32(b, o, 1)
    put_u32(b, o + 4, 6)
    put_u64v(b, o + 8, dofs)
    put_u64v(b, o + 16, base + dofs)
    put_u64v(b, o + 24, base + dofs)
    put_u64v(b, o + 32, filesz)
    put_u64v(b, o + 40, memsz)
    put_u64v(b, o + 48, 4096)
end

SYM_SIZE := 24
SHDR_SIZE := 64
NSECT := 8
SHSTR_LEN := 52
SYMTAB_MAX := 16384
STRTAB_MAX := 1048576

layout Elfw
    -- The symbol table under construction: entries, names, and where the
    -- sections lie in the file, for the values of the symbols.
    symtab : rw view u8
    strtab : rw view u8
    nsym : u64
    nstr : u64
    base : u64
    rodoff : u64
    textoff : u64
    dofs : u64
    hasdata : u64
    bssadj : u64
    secidx : rw view u8
    datasec : u64
end

proc str_put(w: rw ref Elfw, s: view u8)
    permit os.syscall
    if w.nstr + s.len + 1 > STRTAB_MAX
        put(2, "olic: symbol names exhausted\n")
        os.syscall(60, 4)
    end
    t := w.strtab
    i : u64 <- 0
    while i < s.len
        t[w.nstr + i] <- s[i]
        i <- i + 1
    end
    w.nstr <- w.nstr + s.len
end

proc str_term(w: rw ref Elfw)
    t := w.strtab
    t[w.nstr] <- 0
    w.nstr <- w.nstr + 1
end

proc add_sym(w: rw ref Elfw, nameoff: u64, info: u64, shndx: u64, value: u64, sz: u64)
    -- One Elf64_Sym: name, info (binding and type), other, section, value,
    -- size.
    permit os.syscall
    if w.nsym >= SYMTAB_MAX
        put(2, "olic: symbol table exhausted\n")
        os.syscall(60, 4)
    end
    t := w.symtab
    o := w.nsym * SYM_SIZE
    put_u32(t, o, nameoff)
    put_u8(t, o + 4, info)
    put_u8(t, o + 5, 0)
    put_u16(t, o + 6, shndx)
    put_u64v(t, o + 8, value)
    put_u64v(t, o + 16, sz)
    w.nsym <- w.nsym + 1
end

proc qualified(pg: ref Prog, w: rw ref Elfw, mi: u64, name: view u8) -> u64
    -- `module.name` appended to the string table; its offset.
    cx := mod_ctx(pg, mi)
    root := node_at(cx, cx.root)
    off := w.nstr
    str_put(w, mod_text(cx, root.t0, root.t1))
    str_put(w, ".")
    str_put(w, name)
    str_term(w)
    ret off
end

proc sym_procs(pg: ref Prog, ob: ref Oir, w: rw ref Elfw, want_pub: u64)
    -- Every procedure with the binding `want_pub` names: `STB_LOCAL` (0)
    -- unless `pub`, `STB_GLOBAL` (1); type `STT_FUNC` (2), in `.text` (2).
    q : u64 <- 0
    while q < ob.nproc
        op := oproc_at(ob, q)
        v := proc_at(pg, op.pi)
        cx := mod_ctx(pg, v.mod)
        nd := node_at(cx, v.node)
        ispub : u64 <- 0
        if nd.sub == 1
            ispub <- 1
        end
        if op.isextern == 1
            ispub <- 2
        end
        if ispub == want_pub
            off := qualified(pg, w, v.mod, tok_text(cx, nd.t0))
            add_sym(w, off, 2 + want_pub * 16, cell_get(w.secidx, op.sect), w.base + w.textoff + op.codepos, op.codeend - op.codepos)
        end
        if want_pub == 1
            sym_export(pg, w, op)
        end
        q <- q + 1
    end
end

proc sym_export(pg: ref Prog, w: rw ref Elfw, op: ref OProc)
    -- An `export` clause: a second, global symbol at the same address — the
    -- bare name, or the string the clause gives.
    v := proc_at(pg, op.pi)
    cx := mod_ctx(pg, v.mod)
    nd := node_at(cx, v.node)
    k : u64 <- kid1(cx, v.node)
    while k != 0
        kn := node_at(cx, k)
        if kn.kind == N_CLAUSE
            if kn.sub == C_EXPORT
                off := w.nstr
                sk := kid1(cx, k)
                if sk == 0
                    str_put(w, tok_text(cx, nd.t0))
                else
                    sn := node_at(cx, sk)
                    st := tok_text(cx, sn.t0)
                    if st.len >= 2
                        se := st.len - 1
                        str_put(w, st[1..se])
                    else
                        str_put(w, st)
                    end
                end
                str_term(w)
                add_sym(w, off, 18, cell_get(w.secidx, op.sect), w.base + w.textoff + op.codepos, op.codeend - op.codepos)
            end
        end
        k <- sibling(cx, k)
    end
end

proc sym_trap(ob: ref Oir, mc: ref Mach, w: rw ref Elfw)
    -- The trap routine, when the program has a trap site: `olic.trap`, local.
    if mc.ntrap == 0
        ret
    end
    off := w.nstr
    str_put(w, "olic.trap")
    str_term(w)
    tg := sect_find(ob, ".text.trap", 0)
    ts : u64 <- 2
    if tg >= 0
        ts <- cell_get(w.secidx, u64.bits(tg))
    end
    add_sym(w, off, 2, ts, w.base + w.textoff + mc.trappos, ob.ncode - mc.trappos)
end

proc sym_statics(pg: ref Prog, ob: ref Oir, w: rw ref Elfw)
    -- Every static place: `STT_OBJECT` (1), global, in `.data` (3), `.bss`
    -- (4) or `.rodata` (1), with its size.
    k : u64 <- 0
    while k < ob.ndat
        d := dat_at(ob, k)
        v := val_at(pg, d.val)
        cx := mod_ctx(pg, v.mod)
        vn := node_at(cx, v.node)
        off := qualified(pg, w, v.mod, tok_text(cx, vn.t0))
        sh : u64 <- cell_get(w.secidx, d.sect)
        adj : u64 <- w.bssadj
        if d.init == 1
            sh <- w.datasec
            adj <- 0
        end
        add_sym(w, off, 17, sh, w.base + w.dofs + d.off - adj, d.size)
        k <- k + 1
    end
    vi : u64 <- 0
    while vi < pg.nval
        v2 := val_at(pg, vi)
        -- A static placed in the read-only segment, or an aggregate
        -- constant: both are in `rmap`.
        r := rodata_of(ob, vi)
        if r >= 0
            st := stat_at(ob, u64.bits(r))
            cx2 := mod_ctx(pg, v2.mod)
            vn2 := node_at(cx2, v2.node)
            off2 := qualified(pg, w, v2.mod, tok_text(cx2, vn2.t0))
            add_sym(w, off2, 17, 1, w.base + w.rodoff + st.off, st.len)
        end
        vi <- vi + 1
    end
end

-- Debug information (DWARF 4, ABI.md §7) ------------------------------------
-- `.debug_line`: one sequence over the code, a row per change of source
-- line (from the line table `note_line` kept while lowering), the files
-- named after the modules (`a.b` is `a/b.oli`). `.debug_info` with
-- `.debug_abbrev`: one compile unit (the root module, its code range, the
-- line table) and one subprogram per procedure with its name and range —
-- what `addr2line`, `objdump --dwarf` and `gdb` need to name a line.

layout Dbg
    ab : rw view u8
    nab : u64
    info : rw view u8
    ninfo : u64
    line : rw view u8
    nline : u64
    -- The offsets of the type entries in .debug_info: 0..8 the base types,
    -- 9 `void *`, 10..18 pointers to the base types, 19..28 the view
    -- structures by element type, then from 30 per item its structure and
    -- a pointer to it.
    tys : rw view u8
end

DBG_MAX := 4194304

proc db_u8(b: rw view u8, off: u64, v: u64) -> u64
    b[off] <- u8.wrap(v)
    ret off + 1
end

proc db_uleb(b: rw view u8, off: u64, v: u64) -> u64
    o : u64 <- off
    x : u64 <- v
    loop
        grp := x & 127
        x <- x >> 7
        if x != 0
            b[o] <- u8.wrap(grp + 128)
        else
            b[o] <- u8.wrap(grp)
        end
        o <- o + 1
        if x == 0
            break
        end
    end
    ret o
end

proc db_sleb(b: rw view u8, off: u64, v: u64) -> u64
    -- A signed LEB128 of the two's-complement word `v`: seven bits a byte,
    -- the word shifted arithmetically (bit operations only, so the genesis
    -- compiler's signed division never enters), until what is left is all
    -- zeros under a clear sign bit or all ones under a set one.
    o : u64 <- off
    x : u64 <- v
    loop
        grp := x & 127
        neg := (x >> 63) & 1
        x <- x >> 7
        if neg == 1
            x <- x | 18302628885633695744
        end
        more : u64 <- 1
        if x == 0
            if grp < 64
                more <- 0
            end
        end
        if x == 18446744073709551615
            if grp >= 64
                more <- 0
            end
        end
        if more == 1
            b[o] <- u8.wrap(grp + 128)
        else
            b[o] <- u8.wrap(grp)
        end
        o <- o + 1
        if more == 0
            break
        end
    end
    ret o
end

proc db_str(b: rw view u8, off: u64, s: view u8) -> u64
    i : u64 <- 0
    while i < s.len
        b[off + i] <- s[i]
        i <- i + 1
    end
    b[off + s.len] <- 0
    ret off + s.len + 1
end

proc db_modfile(pg: ref Prog, b: rw view u8, off: u64, mi: u64) -> u64
    -- `a.b` as `a/b.oli`, terminated.
    cx := mod_ctx(pg, mi)
    root := node_at(cx, cx.root)
    nm := mod_text(cx, root.t0, root.t1)
    o : u64 <- off
    i : u64 <- 0
    while i < nm.len
        if nm[i] == 46
            b[o] <- 47
        else
            b[o] <- nm[i]
        end
        o <- o + 1
        i <- i + 1
    end
    ret db_str(b, o, ".oli")
end

proc dbg_abbrev(d: rw ref Dbg)
    b := d.ab
    o : u64 <- 0
    -- 1: compile_unit, with children: producer, language, name, low_pc,
    -- high_pc (a length), stmt_list.
    o <- db_uleb(b, o, 1)
    o <- db_uleb(b, o, 17)
    o <- db_u8(b, o, 1)
    o <- db_uleb(b, o, 37)
    o <- db_uleb(b, o, 8)
    o <- db_uleb(b, o, 19)
    o <- db_uleb(b, o, 5)
    o <- db_uleb(b, o, 3)
    o <- db_uleb(b, o, 8)
    o <- db_uleb(b, o, 17)
    o <- db_uleb(b, o, 1)
    o <- db_uleb(b, o, 18)
    o <- db_uleb(b, o, 7)
    o <- db_uleb(b, o, 16)
    o <- db_uleb(b, o, 23)
    o <- db_u8(b, o, 0)
    o <- db_u8(b, o, 0)
    -- 2: subprogram, with children (its parameters and variables): name,
    -- low_pc, high_pc, frame_base (an exprloc: rbp).
    o <- db_uleb(b, o, 2)
    o <- db_uleb(b, o, 46)
    o <- db_u8(b, o, 1)
    o <- db_attr(b, o, 3, 8)
    o <- db_attr(b, o, 17, 1)
    o <- db_attr(b, o, 18, 7)
    o <- db_attr(b, o, 64, 24)
    o <- db_attr(b, o, 0, 0)
    -- 3 variable, 4 formal_parameter: name, type, location (exprloc).
    o <- db_abbr_var(b, o, 3, 52, 1)
    o <- db_abbr_var(b, o, 4, 5, 1)
    -- 12 variable, 13 formal_parameter without a location: promoted to a
    -- register by `mem2reg`, which the debug information does not follow.
    o <- db_abbr_var(b, o, 12, 52, 0)
    o <- db_abbr_var(b, o, 13, 5, 0)
    -- 5 base_type: name, encoding (data1), byte_size (data1).
    o <- db_uleb(b, o, 5)
    o <- db_uleb(b, o, 36)
    o <- db_u8(b, o, 0)
    o <- db_attr(b, o, 3, 8)
    o <- db_attr(b, o, 62, 11)
    o <- db_attr(b, o, 11, 11)
    o <- db_attr(b, o, 0, 0)
    -- 6 pointer_type to void: byte_size; 7 pointer_type: byte_size, type.
    o <- db_uleb(b, o, 6)
    o <- db_uleb(b, o, 15)
    o <- db_u8(b, o, 0)
    o <- db_attr(b, o, 11, 11)
    o <- db_attr(b, o, 0, 0)
    o <- db_uleb(b, o, 7)
    o <- db_uleb(b, o, 15)
    o <- db_u8(b, o, 0)
    o <- db_attr(b, o, 11, 11)
    o <- db_attr(b, o, 73, 19)
    o <- db_attr(b, o, 0, 0)
    -- 8 array_type, with children: type; 9 subrange_type: count (data8).
    o <- db_uleb(b, o, 8)
    o <- db_uleb(b, o, 1)
    o <- db_u8(b, o, 1)
    o <- db_attr(b, o, 73, 19)
    o <- db_attr(b, o, 0, 0)
    o <- db_uleb(b, o, 9)
    o <- db_uleb(b, o, 33)
    o <- db_u8(b, o, 0)
    o <- db_attr(b, o, 55, 7)
    o <- db_attr(b, o, 0, 0)
    -- 10 structure_type, with children: name, byte_size (data8);
    -- 11 member: name, type, data_member_location (data8).
    o <- db_uleb(b, o, 10)
    o <- db_uleb(b, o, 19)
    o <- db_u8(b, o, 1)
    o <- db_attr(b, o, 3, 8)
    o <- db_attr(b, o, 11, 7)
    o <- db_attr(b, o, 0, 0)
    o <- db_uleb(b, o, 11)
    o <- db_uleb(b, o, 13)
    o <- db_u8(b, o, 0)
    o <- db_attr(b, o, 3, 8)
    o <- db_attr(b, o, 73, 19)
    o <- db_attr(b, o, 56, 7)
    o <- db_attr(b, o, 0, 0)
    o <- db_u8(b, o, 0)
    d.nab <- o
end

proc db_attr(b: rw view u8, off: u64, attr: u64, form: u64) -> u64
    o := db_uleb(b, off, attr)
    ret db_uleb(b, o, form)
end

proc db_abbr_var(b: rw view u8, off: u64, code: u64, tag: u64, hasloc: u64) -> u64
    o : u64 <- db_uleb(b, off, code)
    o <- db_uleb(b, o, tag)
    o <- db_u8(b, o, 0)
    o <- db_attr(b, o, 3, 8)
    o <- db_attr(b, o, 73, 19)
    if hasloc == 1
        o <- db_attr(b, o, 2, 24)
    end
    ret db_attr(b, o, 0, 0)
end

proc dw_base_name(k: u64) -> view u8
    if k == 0
        ret "u8"
    end
    if k == 1
        ret "u16"
    end
    if k == 2
        ret "u32"
    end
    if k == 3
        ret "u64"
    end
    if k == 4
        ret "s8"
    end
    if k == 5
        ret "s16"
    end
    if k == 6
        ret "s32"
    end
    if k == 7
        ret "s64"
    end
    ret "bool"
end

proc dbg_types(pg: ref Prog, d: rw ref Dbg, off: u64) -> u64
    -- The type entries every variable refers to, recorded in `d.tys`.
    b := d.info
    o : u64 <- off
    k : u64 <- 0
    while k < 9
        cell_set(d.tys, k, o)
        o <- db_uleb(b, o, 5)
        o <- db_str(b, o, dw_base_name(k))
        enc : u64 <- 7
        if k >= 4
            enc <- 5
        end
        if k == 8
            enc <- 2
        end
        o <- db_u8(b, o, enc)
        sz : u64 <- 8
        if k % 4 == 0
            sz <- 1
        elif k % 4 == 1
            sz <- 2
        elif k % 4 == 2
            sz <- 4
        end
        if k == 8
            sz <- 1
        end
        o <- db_u8(b, o, sz)
        k <- k + 1
    end
    cell_set(d.tys, 9, o)
    o <- db_uleb(b, o, 6)
    o <- db_u8(b, o, 8)
    k <- 0
    while k < 9
        cell_set(d.tys, 10 + k, o)
        o <- db_uleb(b, o, 7)
        o <- db_u8(b, o, 8)
        put_u32(b, o, cell_get(d.tys, k))
        o <- o + 4
        k <- k + 1
    end
    -- A view local, one per element type (19 + code, the last `void`): two
    -- frame words, the length in the lower one and the address above it
    -- (the frame grows down; the address is word 0).
    k <- 0
    while k < 10
        cell_set(d.tys, 19 + k, o)
        o <- db_uleb(b, o, 10)
        o <- db_str(b, o, "view")
        put_u64v(b, o, 16)
        o <- o + 8
        pt : u64 <- cell_get(d.tys, 9)
        if k < 9
            pt <- cell_get(d.tys, 10 + k)
        end
        o <- db_data8(b, db_member(b, o, "addr", pt), 8)
        o <- db_data8(b, db_member(b, o, "len", cell_get(d.tys, 3)), 0)
        o <- db_u8(b, o, 0)
        k <- k + 1
    end
    -- Every layout: its fields of an integer or `bool` type at their
    -- offsets (ABI.md 3); a field of another type is left out.
    it : u64 <- 0
    while it < pg.nitem
        item := item_at(pg, it)
        if item.kind == 0
            cx := mod_ctx(pg, item.mod)
            nd := node_at(cx, item.node)
            cell_set(d.tys, 30 + it * 2, o)
            o <- db_uleb(b, o, 10)
            o <- db_str(b, o, tok_text(cx, nd.t0))
            put_u64v(b, o, item.size)
            o <- o + 8
            f : u64 <- 0
            while f < item.nfld
                fr := fld_at(pg, item.first + f)
                fcx := mod_ctx(pg, fr.mod)
                fn := node_at(fcx, fr.node)
                tn := node_at(fcx, kid1(fcx, fr.node))
                if tn.t1 == tn.t0 + 1
                    fb := dv_base(tok_text(fcx, tn.t0))
                    if fb >= 0
                        mo := db_member(b, o, tok_text(fcx, fn.t0), cell_get(d.tys, u64.bits(fb)))
                        o <- db_data8(b, mo, fr.off)
                    end
                end
                f <- f + 1
            end
            o <- db_u8(b, o, 0)
            cell_set(d.tys, 31 + it * 2, o)
            o <- db_uleb(b, o, 7)
            o <- db_u8(b, o, 8)
            put_u32(b, o, cell_get(d.tys, 30 + it * 2))
            o <- o + 4
        end
        it <- it + 1
    end
    ret o
end

proc db_member(b: rw view u8, off: u64, name: view u8, ty: u64) -> u64
    -- A member's tag, name and type; its offset (data8) is the caller's.
    o : u64 <- db_uleb(b, off, 11)
    o <- db_str(b, o, name)
    put_u32(b, o, ty)
    ret o + 4
end

proc db_data8(b: rw view u8, off: u64, v: u64) -> u64
    put_u64v(b, off, v)
    ret off + 8
end

proc dbg_vars(pg: ref Prog, ob: ref Oir, d: rw ref Dbg, off: u64, q: u64) -> u64
    -- The parameters and variables of procedure `q`: each with its type
    -- and, when it kept its frame words, `DW_OP_fbreg` to the first of its
    -- bytes (the frame base is rbp; a local's bytes start at its last
    -- word, `rbp - 8 * (off + words)`).
    b := d.info
    o : u64 <- off
    i : u64 <- 0
    while i < ob.ndvar
        if dv_get(ob, i, DV_Q) == q
            if o + 256 < DBG_MAX
                o <- dbg_var(pg, ob, d, o, i)
            end
        end
        i <- i + 1
    end
    ret o
end

proc dbg_var(pg: ref Prog, ob: ref Oir, d: rw ref Dbg, off: u64, i: u64) -> u64
    b := d.info
    o : u64 <- off
    k := dv_get(ob, i, DV_KIND)
    c := dv_get(ob, i, DV_CODE)
    ty : u64 <- 0
    if k == DVK_BASE
        ty <- cell_get(d.tys, c)
    elif k == DVK_PTR
        if c == 9
            ty <- cell_get(d.tys, 9)
        else
            ty <- cell_get(d.tys, 10 + c)
        end
    elif k == DVK_VIEW
        ty <- cell_get(d.tys, 19 + c)
    elif k == DVK_LAYOUT
        ty <- cell_get(d.tys, 30 + c * 2)
    elif k == DVK_LREF
        ty <- cell_get(d.tys, 31 + c * 2)
    else
        -- An array of a base type: its own type entry, here.
        ty <- o
        o <- db_uleb(b, o, 8)
        put_u32(b, o, cell_get(d.tys, c))
        o <- o + 4
        o <- db_uleb(b, o, 9)
        put_u64v(b, o, dv_get(ob, i, DV_COUNT))
        o <- o + 8
        o <- db_u8(b, o, 0)
    end
    kept := dv_get(ob, i, DV_KEPT)
    code : u64 <- 3
    if dv_get(ob, i, DV_PARAM) == 1
        code <- 4
    end
    if kept == 0
        code <- code + 9
    end
    cx := mod_ctx(pg, dv_get(ob, i, DV_MOD))
    o <- db_uleb(b, o, code)
    o <- db_str(b, o, tok_text(cx, dv_get(ob, i, DV_NAME)))
    put_u32(b, o, ty)
    o <- o + 4
    if kept == 1
        -- exprloc: its length, DW_OP_fbreg (0x91), the signed offset.
        lenpos := o
        o <- o + 1
        o <- db_u8(b, o, 145)
        disp := 8 * (dv_get(ob, i, DV_OFF) + dv_get(ob, i, DV_WORDS))
        o <- db_sleb(b, o, 18446744073709551615 - (disp - 1))
        put_u8(b, lenpos, o - lenpos - 1)
    end
    ret o
end

proc dbg_info(pg: ref Prog, ob: ref Oir, d: rw ref Dbg, codeaddr: u64)
    b := d.info
    o : u64 <- 11
    o <- db_uleb(b, o, 1)
    o <- db_str(b, o, "olic")
    put_u16(b, o, 32768)
    o <- o + 2
    o <- db_modfile(pg, b, o, 0)
    put_u64v(b, o, codeaddr)
    o <- o + 8
    put_u64v(b, o, ob.ncode)
    o <- o + 8
    put_u32(b, o, 0)
    o <- o + 4
    o <- dbg_types(pg, d, o)
    q : u64 <- 0
    while q < ob.nproc
        op := oproc_at(ob, q)
        if op.isextern == 0
            if o + 64 + STRTAB_MAX / 64 < DBG_MAX
                v := proc_at(pg, op.pi)
                cx := mod_ctx(pg, v.mod)
                nd := node_at(cx, v.node)
                root := node_at(cx, cx.root)
                o <- db_uleb(b, o, 2)
                o <- db_modpre(b, o, mod_text(cx, root.t0, root.t1))
                o <- db_str(b, o, tok_text(cx, nd.t0))
                put_u64v(b, o, codeaddr + op.codepos)
                o <- o + 8
                put_u64v(b, o, op.codeend - op.codepos)
                o <- o + 8
                -- frame_base: DW_OP_reg6 (rbp).
                o <- db_u8(b, o, 1)
                if pg.arch64 == 1
                    -- DW_OP_reg29 (x29): the same frame layout as rbp's.
                    o <- db_u8(b, o, 109)
                else
                    o <- db_u8(b, o, 86)
                end
                if op.nocalls == 0
                    o <- dbg_vars(pg, ob, d, o, q)
                end
                o <- db_u8(b, o, 0)
            end
        end
        q <- q + 1
    end
    o <- db_u8(b, o, 0)
    -- The unit header: length (after itself), version 4, abbrev offset,
    -- address size.
    put_u32(b, 0, o - 4)
    put_u16(b, 4, 4)
    put_u32(b, 6, 0)
    put_u8(b, 10, 8)
    d.ninfo <- o
end

proc db_modpre(b: rw view u8, off: u64, m: view u8) -> u64
    -- `module.` in front of a name; the offset after the dot.
    o : u64 <- off
    i : u64 <- 0
    while i < m.len
        b[o] <- m[i]
        o <- o + 1
        i <- i + 1
    end
    b[o] <- 46
    ret o + 1
end

proc dbg_line(pg: ref Prog, ob: ref Oir, mc: ref Mach, d: rw ref Dbg, codeaddr: u64)
    b := d.line
    o : u64 <- 10
    o <- db_u8(b, o, 1)
    o <- db_u8(b, o, 1)
    o <- db_u8(b, o, 1)
    o <- db_u8(b, o, 251)
    o <- db_u8(b, o, 14)
    o <- db_u8(b, o, 13)
    o <- db_u8(b, o, 0)
    o <- db_u8(b, o, 1)
    o <- db_u8(b, o, 1)
    o <- db_u8(b, o, 1)
    o <- db_u8(b, o, 1)
    o <- db_u8(b, o, 0)
    o <- db_u8(b, o, 0)
    o <- db_u8(b, o, 0)
    o <- db_u8(b, o, 1)
    o <- db_u8(b, o, 0)
    o <- db_u8(b, o, 0)
    o <- db_u8(b, o, 1)
    o <- db_u8(b, o, 0)
    mi : u64 <- 0
    while mi < pg.nmod
        o <- db_modfile(pg, b, o, mi)
        o <- db_u8(b, o, 0)
        o <- db_u8(b, o, 0)
        o <- db_u8(b, o, 0)
        mi <- mi + 1
    end
    o <- db_u8(b, o, 0)
    put_u32(b, 6, o - 10)
    -- The program: the code's address, then a row per record.
    o <- db_u8(b, o, 0)
    o <- db_uleb(b, o, 9)
    o <- db_u8(b, o, 2)
    put_u64v(b, o, codeaddr)
    o <- o + 8
    pos : u64 <- 0
    line : u64 <- 1
    file : u64 <- 1
    k : u64 <- 0
    while k < mc.nline
        if o + 64 >= DBG_MAX
            break
        end
        rpos := cell_get(mc.lines, k * 3)
        rline := cell_get(mc.lines, k * 3 + 1)
        rfile := cell_get(mc.lines, k * 3 + 2) + 1
        if rfile != file
            o <- db_u8(b, o, 4)
            o <- db_uleb(b, o, rfile)
            file <- rfile
        end
        if rpos != pos
            o <- db_u8(b, o, 2)
            o <- db_uleb(b, o, rpos - pos)
            pos <- rpos
        end
        if rline != line
            o <- db_u8(b, o, 3)
            -- The delta as a two's-complement word, without a wrapping
            -- subtraction the genesis compiler does not have.
            delta : u64 <- 0
            if rline >= line
                delta <- rline - line
            else
                delta <- 18446744073709551615 - (line - rline - 1)
            end
            o <- db_sleb(b, o, delta)
            line <- rline
        end
        o <- db_u8(b, o, 1)
        k <- k + 1
    end
    if ob.ncode > pos
        o <- db_u8(b, o, 2)
        o <- db_uleb(b, o, ob.ncode - pos)
    end
    o <- db_u8(b, o, 0)
    o <- db_uleb(b, o, 1)
    o <- db_u8(b, o, 1)
    put_u32(b, 0, o - 4)
    put_u16(b, 4, 4)
    d.nline <- o
end

proc dbg_build(pg: ref Prog, ob: ref Oir, mc: ref Mach, z: zone, codeaddr: u64) -> rw ref Dbg
    d := z.make(Dbg)
    d.ab <- z.bytes(512)
    d.tys <- z.bytes((30 + ITEM_MAX * 2) * Cell.size)
    d.info <- z.bytes(DBG_MAX)
    d.line <- z.bytes(DBG_MAX)
    dbg_abbrev(d)
    dbg_info(pg, ob, d, codeaddr)
    dbg_line(pg, ob, mc, d, codeaddr)
    ret d
end

proc round8(n: u64) -> u64
    ret (n + 7) / 8 * 8
end

proc shs_name(b: rw view u8, off: u64, s: view u8) -> u64
    -- A section name into `.shstrtab`; the offset after its terminator.
    i : u64 <- 0
    while i < s.len
        b[off + i] <- s[i]
        i <- i + 1
    end
    b[off + s.len] <- 0
    ret off + s.len + 1
end

proc shdr_kind(b: rw view u8, idx: u64, name: u64, kind: u64, flags: u64)
    o := idx * SHDR_SIZE
    put_u32(b, o, name)
    put_u32(b, o + 4, kind)
    put_u64v(b, o + 8, flags)
end

proc shdr_place(b: rw view u8, idx: u64, va: u64, off: u64, sz: u64)
    o := idx * SHDR_SIZE
    put_u64v(b, o + 16, va)
    put_u64v(b, o + 24, off)
    put_u64v(b, o + 32, sz)
end

proc shdr_link(b: rw view u8, idx: u64, link: u64, info: u64)
    o := idx * SHDR_SIZE
    put_u32(b, o + 40, link)
    put_u32(b, o + 44, info)
end

proc shdr_align(b: rw view u8, idx: u64, al: u64, entsize: u64)
    o := idx * SHDR_SIZE
    put_u64v(b, o + 48, al)
    put_u64v(b, o + 56, entsize)
end

proc write_elf(pg: rw ref Prog, ob: ref Oir, mc: ref Mach, z: zone)
    hs := hdr_size(ob)
    total := hs + ob.ndata + ob.ncode
    epoint := ob.base + hs + ob.ndata + mc.entrypos
    w := z.make(Elfw)
    w.symtab <- z.bytes(SYMTAB_MAX * SYM_SIZE)
    w.strtab <- z.bytes(STRTAB_MAX)
    w.secidx <- z.bytes(SECT_MAX * Cell.size)
    w.nsym <- 1
    w.nstr <- 1
    zt := w.symtab
    zi : u64 <- 0
    while zi < SYM_SIZE
        zt[zi] <- 0
        zi <- zi + 1
    end
    zs := w.strtab
    zs[0] <- 0
    w.base <- ob.base
    w.rodoff <- hs
    w.textoff <- hs + ob.ndata
    w.hasdata <- 0
    w.bssadj <- 0
    w.dofs <- total
    if ob.dsize + ob.bsize > 0
        w.hasdata <- 1
        w.dofs <- page_up(total)
    end
    -- The sections: null, .rodata, the code groups, .data, the zero
    -- groups, .symtab, .strtab, .shstrtab — the groups in the image's own
    -- order (FREESTANDING.md §2).
    ncode : u64 <- 0
    nbss : u64 <- 0
    g : u64 <- 0
    while g < ob.nsect
        sg := sect_at(ob, g)
        if sg.kind == 0
            cell_set(w.secidx, g, 2 + ncode)
            ncode <- ncode + 1
        end
        g <- g + 1
    end
    w.datasec <- 2 + ncode
    g <- 0
    while g < ob.nsect
        sg2 := sect_at(ob, g)
        if sg2.kind == 1
            cell_set(w.secidx, g, w.datasec + 1 + nbss)
            nbss <- nbss + 1
        end
        g <- g + 1
    end
    symsec := w.datasec + 1 + nbss
    nsect := symsec + 6
    dbg := dbg_build(pg, ob, mc, z, ob.base + w.textoff)
    -- The local symbols first, as ELF orders them, then the global ones.
    sym_procs(pg, ob, w, 0)
    sym_trap(ob, mc, w)
    nlocal := w.nsym
    sym_procs(pg, ob, w, 1)
    sym_statics(pg, ob, w)
    -- The section names.
    shs := z.bytes(SNAME_MAX + 128)
    shs[0] <- 0
    nameoff := z.bytes(SECT_MAX * Cell.size)
    n1 : u64 <- shs_name(shs, 1, ".rodata")
    g <- 0
    while g < ob.nsect
        sg3 := sect_at(ob, g)
        if sg3.kind == 0
            cell_set(nameoff, g, n1)
            n1 <- shs_name(shs, n1, sect_name(ob, g))
        end
        g <- g + 1
    end
    ndata := n1
    n1 <- shs_name(shs, n1, ".data")
    g <- 0
    while g < ob.nsect
        sg4 := sect_at(ob, g)
        if sg4.kind == 1
            cell_set(nameoff, g, n1)
            n1 <- shs_name(shs, n1, sect_name(ob, g))
        end
        g <- g + 1
    end
    nsym := n1
    n1 <- shs_name(shs, n1, ".symtab")
    nstr := n1
    n1 <- shs_name(shs, n1, ".strtab")
    nshs := n1
    n1 <- shs_name(shs, n1, ".shstrtab")
    nabb := n1
    n1 <- shs_name(shs, n1, ".debug_abbrev")
    ninf := n1
    n1 <- shs_name(shs, n1, ".debug_info")
    nlin := n1
    n1 <- shs_name(shs, n1, ".debug_line")
    shslen := n1
    -- The tables after the image, each on an eight-byte boundary.
    imgend : u64 <- total
    if w.hasdata == 1
        imgend <- w.dofs + ob.dsize
    end
    symoff := round8(imgend)
    stroff := symoff + w.nsym * SYM_SIZE
    shstroff := stroff + w.nstr
    aboff := shstroff + shslen
    infoff := aboff + dbg.nab
    linoff := infoff + dbg.ninfo
    shoff := round8(linoff + dbg.nline)
    hdr := z.bytes(hs)
    elf_header(hdr, epoint, total, ob.base)
    if pg.arch64 == 1
        -- EM_AARCH64
        put_u16(hdr, 18, 183)
    end
    put_u64v(hdr, 40, shoff)
    put_u16(hdr, 58, SHDR_SIZE)
    put_u16(hdr, 60, nsect)
    put_u16(hdr, 62, symsec + 2)
    if w.hasdata == 1
        put_u16(hdr, 56, 2)
        data_phdr(hdr, w.dofs, ob.dsize, ob.dsize + ob.bsize, ob.base)
    end
    put(1, hdr)
    d := ob.data
    put(1, d[..ob.ndata])
    c := ob.code
    put(1, c[..ob.ncode])
    if w.hasdata == 1
        if w.dofs > total
            pad := z.bytes(w.dofs - total)
            put(1, pad)
        end
        db := ob.dbytes
        put(1, db[..ob.dsize])
    end
    if symoff > imgend
        pad2 := z.bytes(symoff - imgend)
        put(1, pad2)
    end
    st := w.symtab
    put(1, st[..w.nsym * SYM_SIZE])
    sb := w.strtab
    put(1, sb[..w.nstr])
    put(1, shs[..shslen])
    dab := dbg.ab
    put(1, dab[..dbg.nab])
    dinf := dbg.info
    put(1, dinf[..dbg.ninfo])
    dlin := dbg.line
    put(1, dlin[..dbg.nline])
    if shoff > linoff + dbg.nline
        pad3 := z.bytes(shoff - linoff - dbg.nline)
        put(1, pad3)
    end
    sh := z.bytes(nsect * SHDR_SIZE)
    zi2 : u64 <- 0
    while zi2 < nsect * SHDR_SIZE
        sh[zi2] <- 0
        zi2 <- zi2 + 1
    end
    shdr_kind(sh, 1, 1, 1, 2)
    shdr_place(sh, 1, ob.base + hs, hs, ob.ndata)
    shdr_link(sh, 1, 0, 0)
    shdr_align(sh, 1, 8, 0)
    g <- 0
    while g < ob.nsect
        sg5 := sect_at(ob, g)
        si := cell_get(w.secidx, g)
        if sg5.kind == 0
            shdr_kind(sh, si, cell_get(nameoff, g), 1, 6)
            shdr_place(sh, si, ob.base + w.textoff + sg5.start, w.textoff + sg5.start, sg5.size)
            shdr_link(sh, si, 0, 0)
            shdr_align(sh, si, pg.sectalign, 0)
        else
            shdr_kind(sh, si, cell_get(nameoff, g), 8, 3)
            shdr_place(sh, si, ob.base + w.dofs + sg5.start, w.dofs + ob.dsize, sg5.size)
            shdr_link(sh, si, 0, 0)
            shdr_align(sh, si, 8, 0)
        end
        g <- g + 1
    end
    shdr_kind(sh, w.datasec, ndata, 1, 3)
    if w.hasdata == 1
        shdr_place(sh, w.datasec, ob.base + w.dofs, w.dofs, ob.dsize)
    else
        shdr_place(sh, w.datasec, 0, total, 0)
    end
    shdr_link(sh, w.datasec, 0, 0)
    shdr_align(sh, w.datasec, 8, 0)
    shdr_kind(sh, symsec, nsym, 2, 0)
    shdr_place(sh, symsec, 0, symoff, w.nsym * SYM_SIZE)
    shdr_link(sh, symsec, symsec + 1, nlocal)
    shdr_align(sh, symsec, 8, SYM_SIZE)
    shdr_kind(sh, symsec + 1, nstr, 3, 0)
    shdr_place(sh, symsec + 1, 0, stroff, w.nstr)
    shdr_link(sh, symsec + 1, 0, 0)
    shdr_align(sh, symsec + 1, 1, 0)
    shdr_kind(sh, symsec + 2, nshs, 3, 0)
    shdr_place(sh, symsec + 2, 0, shstroff, shslen)
    shdr_link(sh, symsec + 2, 0, 0)
    shdr_align(sh, symsec + 2, 1, 0)
    shdr_kind(sh, symsec + 3, nabb, 1, 0)
    shdr_place(sh, symsec + 3, 0, aboff, dbg.nab)
    shdr_link(sh, symsec + 3, 0, 0)
    shdr_align(sh, symsec + 3, 1, 0)
    shdr_kind(sh, symsec + 4, ninf, 1, 0)
    shdr_place(sh, symsec + 4, 0, infoff, dbg.ninfo)
    shdr_link(sh, symsec + 4, 0, 0)
    shdr_align(sh, symsec + 4, 1, 0)
    shdr_kind(sh, symsec + 5, nlin, 1, 0)
    shdr_place(sh, symsec + 5, 0, linoff, dbg.nline)
    shdr_link(sh, symsec + 5, 0, 0)
    shdr_align(sh, symsec + 5, 1, 0)
    put(1, sh)
end

-- Object files -------------------------------------------------------------------
-- `-- output: object` (ABI.md §6): the same sections, at address 0 each,
-- no program headers, `e_type` ET_REL, and `.rela.text` with one entry per
-- absolute address the executable would have had patched — `R_X86_64_64`
-- or `R_X86_64_32S` against the section symbol of what it names — and one
-- `R_X86_64_PLT32` per call to an `extern` procedure, an undefined global
-- symbol under its bare name. The entry procedure, when there is one, is
-- also `_start`, for `ld` without a C runtime.

NSECT_OBJ := 9
SHSTR_OBJ := 63
RELA_SIZE := 24
RELA_MAX := 262144

proc sym_sections(w: rw ref Elfw)
    -- `STT_SECTION` symbols 1..4 for `.rodata`, `.text`, `.data`, `.bss`:
    -- what the relocations of the object refer to.
    k : u64 <- 1
    while k <= 4
        add_sym(w, 0, 3, k, 0, 0)
        k <- k + 1
    end
end

proc sym_externs(pg: ref Prog, ob: ref Oir, w: rw ref Elfw)
    -- Every `extern proc`: global, no type, undefined, under its bare name;
    -- the index goes to its `OProc` for the relocations.
    q : u64 <- 0
    while q < ob.nproc
        op := oproc_at(ob, q)
        if op.isextern == 1
            v := proc_at(pg, op.pi)
            cx := mod_ctx(pg, v.mod)
            nd := node_at(cx, v.node)
            off := w.nstr
            str_put(w, tok_text(cx, nd.t0))
            str_term(w)
            op.symidx <- w.nsym
            add_sym(w, off, 16, 0, 0, 0)
        end
        q <- q + 1
    end
end

proc sym_start(pg: ref Prog, ob: ref Oir, mc: ref Mach, w: rw ref Elfw)
    if pg.entrynode == 0
        ret
    end
    off := w.nstr
    str_put(w, "_start")
    str_term(w)
    add_sym(w, off, 18, 2, mc.entrypos, 0)
end

proc put_rela(b: rw view u8, n: u64, pos: u64, info: u64, addend: u64)
    o := n * RELA_SIZE
    put_u64v(b, o, pos)
    put_u64v(b, o + 8, info)
    put_u64v(b, o + 16, addend)
end

proc a64_build_rela(ob: ref Oir, mc: ref Mach, rb: rw view u8) -> u64
    -- The AArch64 object's relocations (ELF for the Arm 64-bit
    -- Architecture): R_AARCH64_CALL26 (283) for a call to an `extern`
    -- procedure, R_AARCH64_ADR_PREL_LO21 (274) for an `adr` into .rodata,
    -- and for an `adrp`+`add` into .data or .bss the pair
    -- R_AARCH64_ADR_PREL_PG_HI21 (275) and R_AARCH64_ADD_ABS_LO12_NC (277).
    permit os.syscall
    n : u64 <- 0
    i : u64 <- 0
    while i < mc.nfix
        f := fix_at(mc, i)
        if n + 2 >= RELA_MAX
            put(2, "olic: relocation table exhausted\n")
            os.syscall(60, 4)
        end
        if f.kind == AF_CALL
            opc := oproc_at(ob, f.target)
            if opc.isextern == 1
                put_rela(rb, n, f.pos, opc.symidx * 4294967296 + 283, 0)
                n <- n + 1
            end
        elif f.kind == AF_ADR
            put_rela(rb, n, f.pos, 4294967296 + 274, f.target)
            n <- n + 1
        elif f.kind == AF_ADRP
            sym : u64 <- 3
            off : u64 <- f.target
            if f.target >= ob.dsize
                sym <- 4
                off <- f.target - ob.dsize
            end
            put_rela(rb, n, f.pos, sym * 4294967296 + 275, off)
            put_rela(rb, n + 1, f.pos + 4, sym * 4294967296 + 277, off)
            n <- n + 2
        end
        i <- i + 1
    end
    ret n
end

proc build_rela(ob: ref Oir, mc: ref Mach, rb: rw view u8) -> u64
    -- The relocations, from the fixes the executable would have patched:
    -- `r_info` is the symbol index shifted by 32 over the type.
    permit os.syscall
    if mc.a64 == 1
        ret a64_build_rela(ob, mc, rb)
    end
    n : u64 <- 0
    i : u64 <- 0
    while i < mc.nfix
        f := fix_at(mc, i)
        if n >= RELA_MAX
            put(2, "olic: relocation table exhausted\n")
            os.syscall(60, 4)
        end
        if f.kind == 2
            put_rela(rb, n, f.pos, 4294967296 + 1, f.target)
            n <- n + 1
        elif f.kind == 8
            put_rela(rb, n, f.pos, 4294967296 + 11, f.target)
            n <- n + 1
        elif f.kind == 5
            op5 := oproc_at(ob, f.target)
            put_rela(rb, n, f.pos, 2 * 4294967296 + 1, op5.codepos)
            n <- n + 1
        elif f.kind == 10
            -- `lea r, [rip + .rodata + off]`: PC32 against .rodata.
            put_rela(rb, n, f.pos, 4294967296 + 2, pc_addend(f.target))
            n <- n + 1
        elif f.kind == 11
            data_rela(ob, rb, n, f)
            n <- n + 1
        elif f.kind == 9
            -- `addr32` of a procedure: `R_X86_64_32` against .text.
            op9 := oproc_at(ob, f.target)
            put_rela(rb, n, f.pos, 2 * 4294967296 + 10, op9.codepos)
            n <- n + 1
        elif f.kind == 4
            data_rela(ob, rb, n, f)
            n <- n + 1
        elif f.kind == 6
            data_rela(ob, rb, n, f)
            n <- n + 1
        elif f.kind == 7
            data_rela(ob, rb, n, f)
            n <- n + 1
        elif f.kind == 0
            op0 := oproc_at(ob, f.target)
            if op0.isextern == 1
                put_rela(rb, n, f.pos, op0.symidx * 4294967296 + 4, 18446744073709551612)
                n <- n + 1
            end
        end
        i <- i + 1
    end
    ret n
end

proc data_rela(ob: ref Oir, rb: rw view u8, n: u64, f: ref Fix)
    -- An address in the writable segment: `.data` below `dsize`, `.bss`
    -- from there on, each from its own start; an imm64 (kinds 4 and 6) is
    -- `R_X86_64_64`, a disp32 (kind 7) `R_X86_64_32S`.
    kind : u64 <- 1
    if f.kind == 7
        kind <- 11
    end
    off : u64 <- f.target
    sym : u64 <- 3
    if f.target >= ob.dsize
        off <- f.target - ob.dsize
        sym <- 4
    end
    if f.kind == 11
        -- rip-relative (`lea r, [rip + …]`): PC32, the addend less the four
        -- bytes of the displacement itself.
        put_rela(rb, n, f.pos, sym * 4294967296 + 2, pc_addend(off))
        ret
    end
    put_rela(rb, n, f.pos, sym * 4294967296 + kind, off)
end

proc pc_addend(off: u64) -> u64
    -- `off - 4` as a two's-complement word.
    if off >= 4
        ret off - 4
    end
    ret 18446744073709551612 + off
end

proc obj_header(b: rw view u8, shoff: u64)
    i : u64 <- 0
    while i < b.len
        b[i] <- 0
        i <- i + 1
    end
    put_u8(b, 0, 127)
    put_u8(b, 1, 69)
    put_u8(b, 2, 76)
    put_u8(b, 3, 70)
    put_u8(b, 4, 2)
    put_u8(b, 5, 1)
    put_u8(b, 6, 1)
    put_u16(b, 16, 1)
    put_u16(b, 18, 62)
    put_u32(b, 20, 1)
    put_u64v(b, 40, shoff)
    put_u16(b, 52, EHDR_SIZE)
    put_u16(b, 58, SHDR_SIZE)
    put_u16(b, 60, NSECT_OBJ)
    put_u16(b, 62, 7)
end

proc write_object(pg: rw ref Prog, ob: ref Oir, mc: ref Mach, z: zone)
    w := z.make(Elfw)
    w.symtab <- z.bytes(SYMTAB_MAX * SYM_SIZE)
    w.strtab <- z.bytes(STRTAB_MAX)
    w.nsym <- 1
    w.nstr <- 1
    zt := w.symtab
    zi : u64 <- 0
    while zi < SYM_SIZE
        zt[zi] <- 0
        zi <- zi + 1
    end
    zs := w.strtab
    zs[0] <- 0
    w.base <- 0
    w.rodoff <- 0
    w.textoff <- 0
    w.dofs <- 0
    w.hasdata <- 1
    w.bssadj <- ob.dsize
    w.secidx <- z.bytes(SECT_MAX * Cell.size)
    w.datasec <- 3
    og : u64 <- 0
    while og < ob.nsect
        osg := sect_at(ob, og)
        if osg.kind == 0
            cell_set(w.secidx, og, 2)
        else
            cell_set(w.secidx, og, 4)
        end
        og <- og + 1
    end
    sym_sections(w)
    sym_procs(pg, ob, w, 0)
    sym_trap(ob, mc, w)
    nlocal := w.nsym
    sym_procs(pg, ob, w, 1)
    sym_statics(pg, ob, w)
    sym_start(pg, ob, mc, w)
    sym_externs(pg, ob, w)
    rb := z.bytes(RELA_MAX * RELA_SIZE)
    nrela := build_rela(ob, mc, rb)
    -- File: header, .rodata, .text, .data, then the tables, each on an
    -- eight-byte boundary, and the section headers last.
    rodoff : u64 <- 64
    textoff := rodoff + ob.ndata
    dataoff := textoff + ob.ncode
    imgend := dataoff + ob.dsize
    symoff := round8(imgend)
    stroff := symoff + w.nsym * SYM_SIZE
    shstroff := stroff + w.nstr
    relaoff := round8(shstroff + SHSTR_OBJ)
    shoff := round8(relaoff + nrela * RELA_SIZE)
    hdr := z.bytes(EHDR_SIZE)
    obj_header(hdr, shoff)
    if mc.a64 == 1
        -- EM_AARCH64
        put_u16(hdr, 18, 183)
    end
    put(1, hdr)
    d := ob.data
    put(1, d[..ob.ndata])
    c := ob.code
    put(1, c[..ob.ncode])
    db := ob.dbytes
    put(1, db[..ob.dsize])
    if symoff > imgend
        pad := z.bytes(symoff - imgend)
        put(1, pad)
    end
    st := w.symtab
    put(1, st[..w.nsym * SYM_SIZE])
    sb := w.strtab
    put(1, sb[..w.nstr])
    shs := z.bytes(SHSTR_OBJ)
    shs[0] <- 0
    n1 := shs_name(shs, 1, ".rodata")
    n2 := shs_name(shs, n1, ".text")
    n3 := shs_name(shs, n2, ".data")
    n4 := shs_name(shs, n3, ".bss")
    n5 := shs_name(shs, n4, ".symtab")
    n6 := shs_name(shs, n5, ".strtab")
    n7 := shs_name(shs, n6, ".shstrtab")
    _n8 := shs_name(shs, n7, ".rela.text")
    put(1, shs)
    if relaoff > shstroff + SHSTR_OBJ
        pad2 := z.bytes(relaoff - shstroff - SHSTR_OBJ)
        put(1, pad2)
    end
    if nrela > 0
        put(1, rb[..nrela * RELA_SIZE])
    end
    if shoff > relaoff + nrela * RELA_SIZE
        pad3 := z.bytes(shoff - relaoff - nrela * RELA_SIZE)
        put(1, pad3)
    end
    sh := z.bytes(NSECT_OBJ * SHDR_SIZE)
    zi2 : u64 <- 0
    while zi2 < NSECT_OBJ * SHDR_SIZE
        sh[zi2] <- 0
        zi2 <- zi2 + 1
    end
    shdr_kind(sh, 1, 1, 1, 2)
    shdr_place(sh, 1, 0, rodoff, ob.ndata)
    shdr_link(sh, 1, 0, 0)
    shdr_align(sh, 1, 8, 0)
    shdr_kind(sh, 2, n1, 1, 6)
    shdr_place(sh, 2, 0, textoff, ob.ncode)
    shdr_link(sh, 2, 0, 0)
    shdr_align(sh, 2, 16, 0)
    shdr_kind(sh, 3, n2, 1, 3)
    shdr_place(sh, 3, 0, dataoff, ob.dsize)
    shdr_link(sh, 3, 0, 0)
    shdr_align(sh, 3, 8, 0)
    shdr_kind(sh, 4, n3, 8, 3)
    shdr_place(sh, 4, 0, imgend, ob.bsize)
    shdr_link(sh, 4, 0, 0)
    shdr_align(sh, 4, 8, 0)
    shdr_kind(sh, 5, n4, 2, 0)
    shdr_place(sh, 5, 0, symoff, w.nsym * SYM_SIZE)
    shdr_link(sh, 5, 6, nlocal)
    shdr_align(sh, 5, 8, SYM_SIZE)
    shdr_kind(sh, 6, n5, 3, 0)
    shdr_place(sh, 6, 0, stroff, w.nstr)
    shdr_link(sh, 6, 0, 0)
    shdr_align(sh, 6, 1, 0)
    shdr_kind(sh, 7, n6, 3, 0)
    shdr_place(sh, 7, 0, shstroff, SHSTR_OBJ)
    shdr_link(sh, 7, 0, 0)
    shdr_align(sh, 7, 1, 0)
    shdr_kind(sh, 8, n7, 4, 64)
    shdr_place(sh, 8, 0, relaoff, nrela * RELA_SIZE)
    shdr_link(sh, 8, 5, 2)
    shdr_align(sh, 8, 8, RELA_SIZE)
    put(1, sh)
end
