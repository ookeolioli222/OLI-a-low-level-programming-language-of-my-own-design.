module olic.show_oir
-- `olic --show-oir`: the OIR built from the typed body, in blocks, before
-- any pass has run — `--show-oir=raw` of docs/OIR_SPEC.md §1. Places are
-- still places here; `--show-ssa` is the same program after `mem2reg`.
-- The verifier runs first, so what is printed is a form that passed §8.

proc start -> s32
    entry
    permit os.syscall
    zone z 4294967296
        src := read_all(z, SRC_MAX)
        pg := prog_new(z)
        analyze(pg, z, src)
        if pg.nerr > 0
            ret 1
        end
        ob := oir_new(z)
        build_oir(pg, ob)
        if pg.nerr > 0
            ret 1
        end
        -- The form is printed even when it fails the verifier: the message
        -- names the instruction, and the form is what shows why. The exit
        -- status 4 still says it is not one to trust.
        bad := verify_oir(pg, ob)
        print_oir(pg, ob)
        if bad > 0
            ret 4
        end
        ret 0
    end
end
