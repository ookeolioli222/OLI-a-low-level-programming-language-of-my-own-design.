module fibonacci
import std.os

proc write(v : view u8)
    permit os.syscall
    os.syscall(os.WRITE, 1, v.addr, v.len)
end

proc fib(n : u64) -> u64
    if n < 2
        ret n
    end
    ret fib(n - 1) + fib(n - 2)
end

proc main -> s32
    entry
    permit os.syscall
    answer := fib(10)
    if answer != 55
        ret 1
    end
    write("fib(10)=55\n")
    ret 0
end