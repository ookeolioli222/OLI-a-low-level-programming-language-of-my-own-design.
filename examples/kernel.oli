-- target: freestanding
-- profile: examples/x86_64-kernel.oli-target
module kernel
import core.x64
import core.x64.paging
import core.frames
-- M3 (docs/FREESTANDING.md §8) and the first steps of M4: a flat kernel
-- image for QEMU or GRUB — a Multiboot2 header and a Multiboot 1 header
-- (the a.out kludge QEMU's `-kernel` needs) in `.text.boot`, an entry that is the 32-bit code a Multiboot loader
-- jumps to (page tables and a GDT built by hand, long mode entered, a far
-- jump to `start64`), then its own stack, a line on COM1 through port
-- places (`port.u8[n] <- b`), the same line in the VGA text buffer through
-- an `mmio` view, `cpuid` through a machine block, an interrupt descriptor
-- table with `calls interrupt` handlers on vector 3 (reached by a software
-- `int 3`) and vector 32 (the timer: the 8259 PICs remapped, the 8253 PIT at
-- 100 Hz, `sti`), its own page tables (the first gigabyte identity-mapped
-- in two-megabyte pages, `core.x64.paging`, installed with
-- `arch.x64.cr3 <- …`), the physical frames the loader's memory map
-- reports as RAM in a bitmap (`core.frames`), one of them allocated,
-- written, read back and released, a kernel heap — a zone laid `at` a
-- megabyte of frames from the same allocator, records made in it and the
-- frames given back when the zone ends — a wait of one second in `hlt`,
-- then a byte to
-- QEMU's isa-debug-exit port (it exits with status 33; on a machine
-- without that device the write goes nowhere) and `hlt` forever. No
-- system calls, no libc: nothing in the image but this program.
--
--   bin/olic examples/kernel.oli -o kernel.elf
--   qemu-system-x86_64 -kernel kernel.elf -serial stdio -display none \
--       -device isa-debug-exit,iobase=0x501,iosize=1

layout Multiboot2
    magic : u32
    arch : u32
    len : u32
    checksum : u32
    end_type : u16
    end_flags : u16
    end_size : u32
end

header : Multiboot2 <- Multiboot2 { magic: 0xE85250D6, arch: 0, len: 24, checksum: 0x17ADAF12, end_type: 0, end_flags: 0, end_size: 8 }
    section ".text.boot"
    align 8

stack : [16K]u8
    section ".bss.boot"
    align 16

idt : [256]core.x64.IdtGate
    align 16

idtr : core.x64.TablePointer

ticks : u64

pml4 : [512]u64
    align 4096

pdpt : [512]u64
    align 4096

pd : [512]u64
    align 4096

-- The trampoline's own tables and descriptors: the first gigabyte in
-- two-megabyte pages, a null, a 64-bit code and a data descriptor.
boot_pml4 : [512]u64
    align 4096

boot_pdpt : [512]u64
    align 4096

boot_pd : [512]u64
    align 4096

gdt : [3]u64
    align 8

gdtr : core.x64.TablePointer

-- The physical address of the loader's information structure, saved by
-- the trampoline from ebx before anything else runs.
mb_info : u32

-- One bit per four-kilobyte frame of the first gigabyte (core.frames).
frame_map : [32K]u8

proc mb1 -> never
    -- The Multiboot 1 header QEMU's `-kernel` looks for (it loads no 64-bit
    -- ELF by its program headers, so the a.out kludge, flags bit 16, tells
    -- it directly: the file goes to 0x100000 — the profile's load address,
    -- header_addr is this procedure — up to 2 MiB is the kernel's (.bss and
    -- room), and the entry is `start`). Never called; GRUB takes either
    -- this or the Multiboot2 header above with the ELF entry.
    calls none
    section ".text.boot"
    permit cpu.asm
    machine x64
        bytes 0x02, 0xB0, 0xAD, 0x1B
        bytes 0x00, 0x00, 0x01, 0x00
        bytes 0xFE, 0x4F, 0x51, 0xE4
        addr32 mb1
        bytes 0x00, 0x00, 0x10, 0x00
        bytes 0x00, 0x00, 0x00, 0x00
        bytes 0x00, 0x00, 0x20, 0x00
        addr32 start
    end
end

proc start -> never
    -- A Multiboot loader enters here in 32-bit protected mode, paging off,
    -- flat segments. Written as the bytes of 32-bit instructions (the
    -- encoder writes 64-bit code; `mov [static], r32`, a `jnz` to a label
    -- and `addr32` are the same bytes in both modes): the page tables
    -- filled, cr3, cr4.PAE, EFER.LME, the GDT and its pointer written,
    -- cr0.PG|PE, then the far jump into the 64-bit `start64`.
    entry
    calls none
    section ".text.boot"
    permit cpu.asm
    machine x64
        bytes 0xFA
        mov [mb_info], ebx
        bytes 0xB8
        addr32 boot_pdpt
        bytes 0x83, 0xC8, 0x03
        mov [boot_pml4], eax
        bytes 0xB8
        addr32 boot_pd
        bytes 0x83, 0xC8, 0x03
        mov [boot_pdpt], eax
        bytes 0xBF
        addr32 boot_pd
        bytes 0xBA, 0x83, 0x00, 0x00, 0x00
        bytes 0xB9, 0x00, 0x02, 0x00, 0x00
    .fill:
        bytes 0x89, 0x17
        bytes 0xC7, 0x47, 0x04, 0x00, 0x00, 0x00, 0x00
        bytes 0x81, 0xC2, 0x00, 0x00, 0x20, 0x00
        bytes 0x83, 0xC7, 0x08
        bytes 0x49
        jnz .fill
        bytes 0xB8
        addr32 boot_pml4
        bytes 0x0F, 0x22, 0xD8
        bytes 0x0F, 0x20, 0xE0
        bytes 0x83, 0xC8, 0x20
        bytes 0x0F, 0x22, 0xE0
        bytes 0xB9, 0x80, 0x00, 0x00, 0xC0
        bytes 0x0F, 0x32
        bytes 0x0D, 0x00, 0x01, 0x00, 0x00
        bytes 0x0F, 0x30
        bytes 0xBF
        addr32 gdt
        bytes 0xC7, 0x47, 0x08, 0x00, 0x00, 0x00, 0x00
        bytes 0xC7, 0x47, 0x0C, 0x00, 0x9A, 0x20, 0x00
        bytes 0xC7, 0x47, 0x10, 0x00, 0x00, 0x00, 0x00
        bytes 0xC7, 0x47, 0x14, 0x00, 0x92, 0x00, 0x00
        bytes 0xBE
        addr32 gdtr
        bytes 0x66, 0xC7, 0x06, 0x17, 0x00
        bytes 0x89, 0x7E, 0x02
        bytes 0xC7, 0x46, 0x06, 0x00, 0x00, 0x00, 0x00
        bytes 0x0F, 0x01, 0x16
        bytes 0x0F, 0x20, 0xC0
        bytes 0x0D, 0x01, 0x00, 0x00, 0x80
        bytes 0x0F, 0x22, 0xC0
        bytes 0xEA
        addr32 start64
        bytes 0x08, 0x00
    end
end

proc start64 -> never
    -- Long mode, cs = the trampoline's code descriptor: the data segments
    -- from the same GDT, the stack, no frame, and `main`.
    calls none
    section ".text.boot"
    permit cpu.control, cpu.halt, memory.raw
    arch.x64.segments(code: 0x08, data: 0x10)
    cpu.stack <- addr u8 (u64(stack.addr) + 16K)
    cpu.frame <- addr u8 (0)
    cpu.call(main)
    loop
        cpu.halt()
    end
end

proc on_trap(_kind : core.TrapKind, _site : core.Site) -> never
    traps
    permit cpu.halt
    loop
        cpu.halt()
    end
end

proc outb(pn : u16, value : u8)
    permit io.port
    port.u8[pn] <- value
end

proc serial_write(s : view u8)
    each c in s
        outb(0x3F8, c)
    end
end

proc vga_write(s : view u8)
    -- The VGA text buffer as device memory: every store volatile and
    -- bounds-checked against the 80x25 cells (`mem.mmio`, capability
    -- `memory.mmio`).
    permit memory.mmio
    vga := mem.mmio(u8, 0xB8000, 4000)
    i : uword <- 0
    while i < s.len
        vga[i * 2] <- s[i]
        vga[i * 2 + 1] <- 0x0F
        i <- i + 1
    end
end

proc on_int3(frame : ref core.x64.InterruptFrame)
    calls interrupt
    permit cpu.interrupt
    serial_write("int 3 at ")
    serial_hex(frame.rip)
    serial_write("\n")
end

proc paging_init()
    -- The first gigabyte identity-mapped in two-megabyte pages: one entry
    -- of the PML4, one of the PDPT, all 512 of the page directory; then the
    -- tables installed in cr3 and read back through it.
    permit cpu.control
    flags := paging.PRESENT | paging.WRITABLE
    pml4[0] <- paging.make_entry(physaddr(u64(pdpt.addr)), flags)
    pdpt[0] <- paging.make_entry(physaddr(u64(pd.addr)), flags)
    paging.identity_2m(pd[..], 0, flags)
    arch.x64.cr3 <- physaddr(u64(pml4.addr))
    if u64.bits(arch.x64.cr3) != u64(pml4.addr)
        serial_write("paging: cr3 differs\n")
    end
end

proc pic_init()
    -- The two 8259s remapped to vectors 32..47 (ICW1 to ICW4 on each), then
    -- every line masked but IRQ 0, the timer.
    permit io.port
    port.u8[0x20] <- 0x11
    port.u8[0xA0] <- 0x11
    port.u8[0x21] <- 32
    port.u8[0xA1] <- 40
    port.u8[0x21] <- 4
    port.u8[0xA1] <- 2
    port.u8[0x21] <- 1
    port.u8[0xA1] <- 1
    port.u8[0x21] <- 0xFE
    port.u8[0xA1] <- 0xFF
end

proc pit_init(hz : u32)
    -- Channel 0 of the 8253, both bytes of the divisor, square wave (mode
    -- 3), at `hz` interrupts a second.
    permit io.port
    divisor := 1193182 / hz
    port.u8[0x43] <- 0x36
    port.u8[0x40] <- u8.wrap(divisor)
    port.u8[0x40] <- u8.wrap(divisor >> 8)
end

proc on_timer(_frame : ref core.x64.InterruptFrame)
    calls interrupt
    permit cpu.interrupt, io.port
    ticks <- ticks + 1
    port.u8[0x20] <- 0x20
end

proc serial_hex(v : u64)
    -- Sixteen hex digits, most significant first.
    shift : u64 <- 64
    while shift > 0
        shift <- shift - 4
        d := u8.wrap((v >> shift) & 15)
        if d < 10
            outb(0x3F8, 48 + d)
        else
            outb(0x3F8, 87 + d)
        end
    end
end

proc serial_dec(v : u64)
    -- Decimal, no leading zeros.
    if v >= 10
        serial_dec(v / 10)
    end
    outb(0x3F8, u8.wrap(48 + v % 10))
end

proc memory_init()
    -- The RAM the loader reported, less the first two megabytes (the BIOS
    -- area, the loader's tables and this image with its .bss); then one
    -- frame taken, written and read through its physical address (the
    -- first gigabyte is identity-mapped), and given back.
    permit memory.raw
    frames.init(frame_map[..])
    n := frames.load_multiboot(frame_map[..], u64(mb_info))
    frames.reserve_range(frame_map[..], 0, 0x200000)
    serial_write("memory: ")
    serial_dec(n)
    serial_write(" regions, ")
    serial_dec(frames.count_free(frame_map[..]))
    serial_write(" frames free\n")
    a := frames.alloc(frame_map[..])
    if a < 0x200000
        serial_write("frame: none\n")
        ret
    end
    [addr u64 (a)] <- 0x0123456789ABCDEF
    [addr u64 (a + 4088)] <- a
    if [addr u64 (a)] == 0x0123456789ABCDEF
        if [addr u64 (a + 4088)] == a
            serial_write("frame: ")
            serial_hex(a)
            serial_write(" written and read\n")
        end
    end
    frames.release(frame_map[..], a)
end

layout Record
    id : u64
    square : u64
    next : u64
end

HEAP_FRAMES : u64 := 256

proc heap_demo()
    -- The kernel heap (KERNEL_PROGRAMMING.md 4): a megabyte of contiguous
    -- frames from core.frames, a zone `at` their physical address (the
    -- first gigabyte is identity-mapped), a thousand records made in it
    -- and chained, then `try_bytes` refused at the limit instead of a
    -- trap; at `end` the zone is gone and the frames go back.
    permit memory.raw
    free0 := frames.count_free(frame_map[..])
    base := frames.alloc_run(frame_map[..], HEAP_FRAMES)
    if base == 0
        serial_write("heap: no frames\n")
        ret
    end
    total : u64 <- 0
    made : u64 <- 0
    refused : u64 <- 0
    zone kheap 1M at addr u8 (base)
        first : u64 <- 0
        i : u64 <- 0
        while i < 1000
            r := kheap.make(Record)
            r.id <- i
            r.square <- i * i
            r.next <- first
            first <- u64(addr u8 (r))
            made <- made + 1
            i <- i + 1
        end
        p : u64 <- first
        while p != 0
            total <- total + [addr u64 (p + 8)]
            p <- [addr u64 (p + 16)]
        end
        spare := kheap.bytes(4096)
        spare[4095] <- 1
        big := kheap.try_bytes(1M) else spare[..0]
        if big.len == 0
            refused <- 1
        end
    end
    frames.release_run(frame_map[..], base, HEAP_FRAMES)
    serial_write("heap: ")
    serial_dec(made)
    serial_write(" records at ")
    serial_hex(base)
    serial_write(", sum of squares ")
    serial_dec(total)
    if refused == 1
        serial_write(", 1M refused")
    end
    if frames.count_free(frame_map[..]) == free0
        serial_write(", frames returned")
    end
    serial_write("\n")
end

proc set_gate(vector : uword, handler : u64)
    -- An interrupt gate (type 0xE, present, ring 0) in the kernel's own
    -- code segment, 0x08 of the GDT the trampoline built.
    idt[vector].offset_lo <- u16.wrap(handler)
    idt[vector].selector <- 8
    idt[vector].ist <- 0
    idt[vector].kind <- 0x8E
    idt[vector].offset_mid <- u16.wrap(handler >> 16)
    idt[vector].offset_hi <- u32.wrap(handler >> 32)
    idt[vector].reserved <- 0
end

proc install_idt()
    permit cpu.asm, cpu.interrupt, cpu.control
    h : u64 <- 0
    machine x64
        mov rax, on_int3
        out rax -> h
    end
    set_gate(3, h)
    t : u64 <- 0
    machine x64
        mov rax, on_timer
        out rax -> t
    end
    set_gate(32, t)
    idtr.limit <- 256 * 16 - 1
    idtr.base <- u64(idt.addr)
    arch.x64.idt <- ref idtr
end

proc cpu_vendor_word() -> u32
    id := cpu.id(0)
    ret id.b
end

proc main -> never
    permit cpu.halt, cpu.asm, cpu.interrupt
    outb(0x3F9, 0)
    outb(0x3FB, 0x80)
    outb(0x3F8, 3)
    outb(0x3F9, 0)
    outb(0x3FB, 3)
    serial_write("Oli-- kernel\n")
    vga_write("Oli-- kernel")
    v := cpu_vendor_word()
    if v == 0x756E6547
        serial_write("cpu: GenuineIntel\n")
    elif v == 0x68747541
        serial_write("cpu: AuthenticAMD\n")
    else
        serial_write("cpu: other\n")
    end
    paging_init()
    memory_init()
    heap_demo()
    install_idt()
    machine x64
        int 3
    end
    serial_write("back from int 3\n")
    pic_init()
    pit_init(100)
    cpu.interrupts(on)
    while ticks < 100
        cpu.halt()
    end
    serial_write("timer: 100 ticks\n")
    outb(0x501, 0x10)
    loop
        cpu.halt()
    end
end
