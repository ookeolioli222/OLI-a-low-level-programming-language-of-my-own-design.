-- target: freestanding
-- load: 0x100000
module kernel
import core.x64
-- M3 (docs/FREESTANDING.md §8) and the first step of M4: a flat kernel
-- image for QEMU or GRUB — a Multiboot2 header in `.text.boot`, its own
-- entry with no frame, its own stack, a line on COM1 through port I/O, the
-- same line in the VGA text buffer through raw stores, `cpuid` through a
-- machine block, an interrupt descriptor table with a `calls interrupt`
-- handler on vector 3 that a software `int 3` reaches, then `hlt` forever.
-- No system calls, no libc: nothing in the image but this program.
--
--   bin/olic examples/kernel.oli -o kernel.elf
--   qemu-system-x86_64 -kernel kernel.elf -serial stdio -display none

layout Multiboot2
    magic : u32
    arch : u32
    len : u32
    checksum : u32
    end_type : u16
    end_flags : u16
    end_size : u32
end

header : Multiboot2 <- Multiboot2 { magic: 0xE85250D6, arch: 0, len: 24, checksum: 0x17ADAF12, end_type: 0, end_flags: 0, end_size: 8 }
    section ".text.boot"
    align 8

stack : [16K]u8
    section ".bss.boot"
    align 16

idt : [256]core.x64.IdtGate
    align 16

idtr : core.x64.TablePointer

proc start -> never
    entry
    calls none
    section ".text.boot"
    permit cpu.asm
    machine x64
        lea rsp, [stack + 16K]
        xor ebp, ebp
        call kernel.main
        hlt
    end
end

proc on_trap(_kind : core.TrapKind, _site : core.Site) -> never
    traps
    permit cpu.halt
    loop
        cpu.halt()
    end
end

proc outb(pn : u32, value : u8)
    permit cpu.asm
    machine x64
        in edx <- pn
        in eax <- u32(value)
        out dx, al
    end
end

proc serial_write(s : view u8)
    each c in s
        outb(0x3F8, c)
    end
end

proc vga_write(s : view u8)
    permit memory.raw
    i : uword <- 0
    while i < s.len
        [addr u8 (0xB8000 + i * 2)] <- s[i]
        [addr u8 (0xB8001 + i * 2)] <- 0x0F
        i <- i + 1
    end
end

proc on_int3(frame : ref core.x64.InterruptFrame)
    calls interrupt
    permit cpu.interrupt
    serial_write("int 3 at ")
    serial_hex(frame.rip)
    serial_write("\n")
end

proc serial_hex(v : u64)
    -- Sixteen hex digits, most significant first.
    shift : u64 <- 64
    while shift > 0
        shift <- shift - 4
        d := u8.wrap((v >> shift) & 15)
        if d < 10
            outb(0x3F8, 48 + d)
        else
            outb(0x3F8, 87 + d)
        end
    end
end

proc set_gate(vector : uword, handler : u64)
    -- An interrupt gate (type 0xE, present, ring 0) in the kernel code
    -- segment the boot loader left in cs (Multiboot2: 0x08 is conventional
    -- for a flat 64-bit segment set up by the loader's GDT).
    idt[vector].offset_lo <- u16.wrap(handler)
    idt[vector].selector <- 8
    idt[vector].ist <- 0
    idt[vector].kind <- 0x8E
    idt[vector].offset_mid <- u16.wrap(handler >> 16)
    idt[vector].offset_hi <- u32.wrap(handler >> 32)
    idt[vector].reserved <- 0
end

proc install_idt()
    permit cpu.asm, cpu.interrupt
    h : u64 <- 0
    machine x64
        mov rax, on_int3
        out rax -> h
    end
    set_gate(3, h)
    idtr.limit <- 256 * 16 - 1
    idtr.base <- u64(idt.addr)
    machine x64
        lidt [idtr]
    end
end

proc cpu_vendor_word() -> u32
    permit cpu.asm
    b : u32 <- 0
    machine x64
        in eax <- 0
        cpuid
        out ebx -> b
        clobber ecx, edx
    end
    ret b
end

proc main -> never
    permit cpu.halt, cpu.asm
    outb(0x3F9, 0)
    outb(0x3FB, 0x80)
    outb(0x3F8, 3)
    outb(0x3F9, 0)
    outb(0x3FB, 3)
    serial_write("Oli-- kernel\n")
    vga_write("Oli-- kernel")
    v := cpu_vendor_word()
    if v == 0x756E6547
        serial_write("cpu: GenuineIntel\n")
    elif v == 0x68747541
        serial_write("cpu: AuthenticAMD\n")
    else
        serial_write("cpu: other\n")
    end
    install_idt()
    machine x64
        int 3
    end
    serial_write("back from int 3\n")
    loop
        cpu.halt()
    end
end
