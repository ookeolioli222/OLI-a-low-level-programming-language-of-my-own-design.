module mov32
-- The lines of genesis/2-asm/tests/mov32.oli, in a hosted V0 program; the bytes
-- olic emits for the block must equal mov32.hex, the assembler's hand-derived
-- canonical encoding. Not executed.
proc start -> s32
    entry
    permit cpu.asm
    machine x64
        mov eax, 0xffffffff
        mov ecx, -2147483648
        mov edx, 42
        mov ebx, eax
        mov esp, ecx
        mov ebp, edx
        mov esi, ebx
        mov edi, esp
        mov r8d, ebp
        mov r9d, esi
        mov r10d, edi
        mov r11d, r8d
        mov r12d, r9d
        mov r13d, r10d
        mov r14d, r11d
        mov r15d, r12d
        mov eax, r13d
        mov ecx, r14d
        mov edx, r15d
        mov r15d, 42
        mov r8d, [r9+r10*2]
        mov [r12+r13*4-8], r14d
        mov [rsp], eax
        mov edx, [rbp]
        ret
    end
    ret 0
end
