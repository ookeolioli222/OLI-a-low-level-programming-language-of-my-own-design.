proc f(_x : own u8)
end
proc g
    calls interrupt
end
proc main -> s32
    entry
    permit cpu.control
    x : u8 <- 1
    x <~ 2
    _p := port u8 (0x3F8)
    _f : f32 := 1
    _v := mem.mmio(u16, 0xB8000, 10)
    arch.x64.segments(0x33)
    ret s32(x)
end
