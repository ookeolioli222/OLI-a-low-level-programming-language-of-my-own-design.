proc take(h : own u64)
    _x := u64(h)
end
proc leak(h : own u64)
end
proc main -> s32
    entry
    a := own u64 (1)
    take(a)
    take(a)
    b := own u64 (2)
    p : u64 <- 0
    p <~ b
    c : own u64
    c <~ own u64 (3)
    c <~ own u64 (4)
    d : own u64 <- own u64 (5)
    e := own u64 (6)
    if p == 0
        take(e)
    end
    f := own u64 (7)
    while p < 1
        take(f)
        p <- p + 1
    end
    g := own u64 (8)
    take(c)
    take(d)
    take(f)
    ret 0
end
