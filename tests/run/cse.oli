module cse
-- The pass of OIR_SPEC §6 that removes a check by dominance: the same
-- operation on the same operands, or the same check, stands earlier on every
-- path, so the later one computes the same value and cannot trap first.
-- The exit status is the number of the check that failed; 42 when every one
-- held.

proc twice(v: view u8, i: uword) -> u64
    -- Two reads of the same element: one bounds check, the second is proved.
    ret u64(v[i]) + u64(v[i])
end

proc square_sum(a: u64, b: u64) -> u64
    -- The same sum twice: one addition, one overflow check.
    ret (a + b) * (a + b)
end

proc pick(a: u64, b: u64, c: bool) -> u64
    -- The sum in the entry block dominates both arms.
    s := a + b
    if c
        ret s + (a + b)
    end
    ret a + b
end

proc start -> s32
    entry
    if twice("abc", 1) != 196
        ret 1
    end
    if square_sum(3, 4) != 49
        ret 2
    end
    if pick(5, 6, true) != 22
        ret 3
    end
    if pick(5, 6, false) != 11
        ret 4
    end
    ret 42
end
