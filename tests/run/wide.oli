module wide
-- Fallible results that do not fit the register pair (ABI.md §2): a view,
-- a layout or a wide `choice` as the value, a `choice` or a layout wider
-- than a word as the failure — the caller owns an area of its frame, the
-- callee fills it (tag, then the payload) and hands its address back in
-- rax. `else` and `case` read the area; `else fail` copies the failure on.
-- A `choice` wider than a word is otherwise held like a layout by value:
-- its image in memory, reached by its address, copied into a local, a
-- parameter or a result. The exit status is the number of the check that
-- failed; 42 when every one held.

choice Big
    nothing
    detail { code : u64, extra : u64 }
end

layout Pair
    a : u64
    b : u64
end

layout Sm
    a : u32
    b : u32
end

proc find(v : view u8, c : u8) -> view u8 or Big
    i : uword <- 0
    while i < v.len
        if v[i] == c then ret v[i..]
        i <- i + 1
    end
    fail detail { code: 7, extra: 9 }
end

proc first_word(s : view u8) -> view u8 or none
    i : uword <- 0
    while i < s.len
        if s[i] == 32 then ret s[..i]
        i <- i + 1
    end
    fail
end

proc pick(x : u64) -> u64 or Big
    if x == 0 then fail nothing
    if x > 100 then fail detail { code: x, extra: x + 1 }
    ret x * 2
end

proc relay(x : u64) -> u64 or Big
    v := pick(x) else fail
    ret v + 1
end

-- A layout wider than a word as the value: through the area.
proc mk_pair(x : u64) -> Pair or none
    if x == 0 then fail
    ret Pair { a: x, b: x + 1 }
end

proc relay_pair(x : u64) -> Pair or none
    p := mk_pair(x) else fail
    ret Pair { a: p.b, b: p.a }
end

-- A layout of a word as the value: its word in rdx.
proc mk_small(x : u32) -> Sm or none
    if x == 0 then fail
    ret Sm { a: x, b: x + 1 }
end

-- A layout of a word as the value and a wide choice as the failure.
proc mk_sm(x : u32) -> Sm or Big
    if x == 0 then fail nothing
    if x > 100 then fail detail { code: u64(x), extra: 0 }
    ret Sm { a: x, b: x * 2 }
end

-- A wide choice as the value.
proc mk_big(x : u64) -> Big or none
    if x == 0 then fail
    if x > 100 then ret nothing
    ret detail { code: x, extra: x * 3 }
end

-- A layout wider than a word as the failure.
proc fp(x : u64) -> u64 or Pair
    if x == 0 then fail Pair { a: 1, b: 2 }
    ret x
end

proc relay_fp(x : u64) -> u64 or Pair
    v := fp(x) else fail
    ret v + 1
end

-- A view as the failure: two words in the area, relayed by `else fail`.
proc f_view(x : u64) -> u64 or view u8
    if x > 100 then fail "too big"
    ret x
end

proc g_view(x : u64) -> u64 or view u8
    v := f_view(x) else fail
    ret v + 1
end

-- A wide choice as a plain value: a result, a parameter, a case over it.
proc mk_choice(x : u64) -> Big
    if x == 0 then ret nothing
    ret detail { code: x, extra: x + x }
end

proc sum_of(c : Big) -> u64
    r : u64 <- 0
    case c
    when detail { code, extra }
        r <- code + extra
    when nothing
        r <- 1
    end
    ret r
end

proc start -> s32
    entry
    r := find("hello", 108) else "?"
    if r.len != 3 then ret 1
    if r[0] != 108 then ret 2
    q := find("abc", 122) else "?"
    if q.len != 1 then ret 3
    case find("abc", 122)
    when ok v
        ret 4
    when fail detail { code, extra }
        if code != 7 then ret 5
        if extra != 9 then ret 6
    when fail nothing
        ret 7
    end
    w := first_word("ab cd") else ""
    if w.len != 2 then ret 8
    if w[1] != 98 then ret 9
    e := first_word("abcd") else ""
    if e.len != 0 then ret 10
    case pick(5)
    when ok v2
        if v2 != 10 then ret 11
    when fail
        ret 12
    end
    case relay(500)
    when ok v3
        ret 13
    when fail detail { code, extra }
        if code != 500 then ret 14
        if extra != 501 then ret 15
    when fail nothing
        ret 16
    end
    case relay(0)
    when ok v4
        ret 17
    when fail nothing
    when fail detail { code, extra }
        ret 18
    end
    p := mk_pair(3) else Pair { a: 0, b: 0 }
    if p.a != 3 then ret 19
    if p.b != 4 then ret 20
    p0 := mk_pair(0) else Pair { a: 77, b: 78 }
    if p0.a != 77 then ret 21
    case mk_pair(5)
    when ok pp
        if pp.b != 6 then ret 22
    when fail
        ret 23
    end
    rp := relay_pair(10) else Pair { a: 0, b: 0 }
    if rp.a != 11 then ret 24
    if rp.b != 10 then ret 25
    r0 := relay_pair(0) else Pair { a: 5, b: 5 }
    if r0.b != 5 then ret 26
    s := mk_small(9) else Sm { a: 0, b: 0 }
    if s.a != 9 then ret 27
    if s.b != 10 then ret 28
    s0 := mk_small(0) else Sm { a: 1, b: 2 }
    if s0.b != 2 then ret 29
    t := mk_sm(4) else Sm { a: 0, b: 0 }
    if t.a != 4 then ret 30
    if t.b != 8 then ret 31
    case mk_sm(200)
    when ok t2
        ret 32
    when fail detail { code, extra }
        if code != 200 then ret 33
    when fail nothing
        ret 34
    end
    g := mk_big(7) else nothing
    case g
    when detail { code, extra }
        if code != 7 then ret 35
        if extra != 21 then ret 36
    when nothing
        ret 37
    end
    case mk_big(0)
    when ok g2
        ret 38
    when fail
    end
    case fp(0)
    when ok f0
        ret 39
    when fail
    end
    f1 := relay_fp(4) else 0
    if f1 != 5 then ret 40
    h := detail { code: 1, extra: 2 }
    if sum_of(h) != 3 then ret 41
    if sum_of(mk_choice(9)) != 27 then ret 41
    if sum_of(mk_choice(0)) != 1 then ret 41
    case g_view(5)
    when ok gv
        if gv != 6 then ret 41
    when fail
        ret 41
    end
    case g_view(500)
    when ok gv2
        ret 41
    when fail
    end
    ret 42
end
