module procs
import std.os
-- M2: recursion, six parameters, view parameters and writing to stdout.
proc fib(n: u64) -> u64
    if n < 2
        ret n
    end
    ret fib(n - 1) + fib(n - 2)
end
proc six(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64) -> u64
    ret a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6
end
proc write(v: view u8)
    permit os.syscall
    os.syscall(os.WRITE, 1, v.addr, v.len)
end
proc start -> s32
    entry
    permit os.syscall
    if fib(10) != 55
        ret 1
    end
    if six(1, 1, 1, 1, 1, 1) != 21
        ret 2
    end
    write("procs ok\n")
    write("second\tline\n")
    ret 0
end
