module args
-- M2: arguments past the six registers go on the stack (ABI.md §1); a view
-- that does not fit in the registers left goes to the stack whole while the
-- next integer still takes a register (§2, the SysV rule); the stack is
-- realigned around a call with an odd count; and arguments that are calls
-- themselves, in a procedure that received stack arguments itself, all
-- land where they belong.

proc seven(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64) -> u64
    ret a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7
end

proc nine(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, i: u64) -> u64
    ret g * 100 + h * 10 + i
end

proc split(a: u64, b: u64, c: u64, d: u64, e: u64, v: view u8, g: u64) -> u64
    -- `v` needs two words with one register left: the whole view goes to the
    -- stack and `g` takes the sixth register.
    ret u64(v.len) * 1000 + u64(v[0]) * 10 + g
end

proc inner(x: u64, y: u64) -> u64
    ret x - y
end

proc outer(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64) -> u64
    ret inner(g, h) + inner(seven(1, 1, 1, 1, 1, 1, 1), 0)
end

proc start -> s32
    entry
    if seven(1, 2, 3, 4, 5, 6, 7) != 140
        ret 1
    end
    if nine(0, 0, 0, 0, 0, 0, 4, 5, 6) != 456
        ret 2
    end
    if split(0, 0, 0, 0, 0, "abc", 9) != 3979
        ret 3
    end
    if outer(0, 0, 0, 0, 0, 0, 50, 8) != 70
        ret 4
    end
    if seven(inner(3, 2), inner(4, 2), 3, 4, 5, 6, inner(9, 2)) != 140
        ret 5
    end
    ret 42
end
