module frames
-- M2: array places in a frame — `name : [N]T` inside a procedure starts as
-- zero, reads as the writable view of its bytes (`.len`, `[i]`, `each`, a
-- view argument, `Name.at`), and two procedures each with their own array
-- keep their own words. The exit status is the number of the check that
-- failed, or 42.

layout Header
    magic : u32
    len : u16
end

proc sum(v: view u8) -> u64
    t : u64 <- 0
    each b in v
        t <- t + u64(b)
    end
    ret t
end

proc scratch(k: u8) -> u64
    -- Its own array, filled and summed; called twice so the frame is reused.
    tmp : [8]u8
    i : uword <- 0
    while i < tmp.len
        tmp[i] <- k
        i <- i + 1
    end
    ret sum(tmp)
end

proc start -> s32
    entry
    buf : [16]u8
    if buf[3] != 0
        ret 1
    end
    buf[0] <- 5
    buf[15] <- 7
    if buf.len != 16
        ret 2
    end
    if sum(buf) != 12
        ret 3
    end
    n : u64 <- 0
    each b in buf
        n <- n + u64(b)
    end
    if n != 12
        ret 4
    end
    h := Header.at(buf)
    h.magic <- 9
    if buf[0] != 9
        ret 5
    end
    words : [4]u64
    if words[3] != 0
        ret 6
    end
    words[1] <- 40
    words[2] <- 2
    if words[1] + words[2] != 42
        ret 7
    end
    if scratch(3) != 24
        ret 8
    end
    if scratch(1) != 8
        ret 9
    end
    -- The arrays of this frame were not touched by the callee's.
    if buf[15] != 7
        ret 10
    end
    if words[1] != 40
        ret 11
    end
    ret 42
end
