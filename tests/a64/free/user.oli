-- target: freestanding
-- profile: tests/a64/free/virt.oli-target
module auser
import core.a64
-- User mode on bare-metal AArch64 (design 0025). The kernel installs its
-- vector table, gives EL0 a stack (`arch.a64.sp_el0`), sets SPSR_EL1 to
-- EL0t (`arch.a64.spsr <- 0`) and enters `user_main` with
-- `arch.a64.eret(user_main)`. At EL0 the program can do nothing to the
-- machine by itself: it prints through `arch.a64.svc(v)`, which traps to
-- slot 8 (synchronous, lower EL, AArch64), where `on_user` serves the
-- request from the saved x0 and answers in it. A read of VBAR_EL1 from EL0
-- is compiled (the compiler grants the capability) but refused by the CPU
-- as an undefined instruction: the kernel counts it and moves ELR past it.
-- Request 300 ends the program.

stack : [16K]u8
    align 16

user_stack : [8K]u8
    align 16

served : u64
refused : u64
refused_class : u64

PUTC_LIMIT := 256
COUNT := 257
EXIT := 300

proc start -> never
    entry
    calls none
    permit cpu.control, cpu.halt, memory.raw
    cpu.stack <- addr u8 (u64(stack.addr) + 16K)
    cpu.call(main)
    loop
        cpu.halt()
    end
end

proc putc(c : u8)
    permit memory.mmio
    uart := mem.mmio(u32, 0x09000000, 16)
    while (uart[6] >> 5) & 1 == 1
    end
    uart[0] <- u32(c)
end

proc puts(s : view u8)
    each c in s
        putc(c)
    end
end

proc putu(v : u64)
    if v >= 10
        putu(v / 10)
    end
    putc(u8.wrap(48 + v % 10))
end

proc on_user(frame : rw ref core.a64.ExceptionFrame)
    -- Slot 8: every synchronous exception taken from EL0.
    calls interrupt
    section ".vector.8"
    permit cpu.interrupt, cpu.control, cpu.halt
    class := arch.a64.esr >> 26
    if class == 0x15
        -- SVC: the request in x0, the answer back in x0; ELR already
        -- points past the `svc`.
        served <- served + 1
        req := frame.x0
        if req < PUTC_LIMIT
            putc(u8.wrap(req))
            frame.x0 <- 0
        elif req == COUNT
            frame.x0 <- served
        elif req == EXIT
            puts("kernel: user exited after ")
            putu(served)
            puts(" calls, ")
            putu(refused)
            puts(" refused (class ")
            putu(refused_class)
            puts(")\n")
            loop
                cpu.halt()
            end
        end
    else
        -- Anything else EL0 did wrong: noted, and skipped.
        refused <- refused + 1
        refused_class <- class
        frame.elr <- frame.elr + 4
    end
end

proc uputs(s : view u8)
    each c in s
        _r := arch.a64.svc(u64(c))
    end
end

proc uputu(v : u64)
    if v >= 10
        uputu(v / 10)
    end
    _r := arch.a64.svc(48 + v % 10)
end

proc user_main -> never
    -- Runs at EL0: nothing here touches a device or a system register
    -- successfully.
    permit cpu.control
    uputs("hello from EL0\n")
    _v := arch.a64.vbar
    n := arch.a64.svc(COUNT)
    uputs("the kernel has served ")
    uputu(n)
    uputs(" calls\n")
    _e := arch.a64.svc(EXIT)
    loop
    end
end

proc main -> never
    permit cpu.control, cpu.halt
    arch.a64.vbar <- arch.a64.vectors
    arch.a64.sp_el0 <- u64(user_stack.addr) + 8K
    -- SPSR_EL1.M = 0: EL0 with SP_EL0; DAIF clear.
    arch.a64.spsr <- 0
    puts("kernel: entering EL0\n")
    arch.a64.eret(user_main)
    loop
        cpu.halt()
    end
end
